<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teste de Spritesheets - SpriteCollab</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #1a1a1a;
            color: #f0f0f0;
            padding: 20px;
        }
        .container { max-width: 1400px; margin: 0 auto; }
        h1 {
            color: #4da6ff;
            margin-bottom: 20px;
            text-align: center;
        }
        .controls {
            background: #2a2a2a;
            border: 1px solid #404040;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 15px;
            align-items: end;
        }
        .control-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #bbb;
        }
        input {
            padding: 10px;
            background: #1a1a1a;
            border: 1px solid #404040;
            border-radius: 6px;
            color: #f0f0f0;
            font-size: 1rem;
        }
        input:focus {
            outline: none;
            border-color: #4da6ff;
            box-shadow: 0 0 8px rgba(77, 166, 255, 0.3);
        }
        button {
            padding: 10px 20px;
            background: #4da6ff;
            color: #000;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.2s;
        }
        button:hover {
            background: #66b3ff;
        }
        button:active {
            transform: scale(0.98);
        }

        .viewer-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .spritesheet-panel {
            background: #2a2a2a;
            border: 1px solid #404040;
            border-radius: 8px;
            padding: 15px;
        }
        .spritesheet-panel h2 {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: #4da6ff;
        }

        #spritesheetContainer {
            background: #000;
            border: 2px solid #404040;
            border-radius: 6px;
            padding: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            position: relative;
            overflow: auto;
        }

        #spritesheetContainer img {
            max-width: 100%;
            height: auto;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        .info-panel {
            background: #2a2a2a;
            border: 1px solid #404040;
            border-radius: 8px;
            padding: 15px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }

        .info-item {
            background: #1a1a1a;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #404040;
        }

        .info-label {
            font-size: 0.85rem;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 1.2rem;
            font-weight: 600;
            color: #4da6ff;
            margin-top: 5px;
            word-break: break-all;
        }

        .poses-list {
            background: #1a1a1a;
            border: 1px solid #404040;
            border-radius: 6px;
            padding: 10px;
            margin-top: 15px;
            max-height: 300px;
            overflow-y: auto;
        }

        .pose-item {
            padding: 8px;
            background: #2a2a2a;
            border-radius: 4px;
            margin-bottom: 8px;
            font-size: 0.9rem;
            cursor: pointer;
            border: 1px solid #404040;
            transition: all 0.2s;
        }

        .pose-item:hover {
            background: #404040;
            border-color: #4da6ff;
        }

        .pose-item.active {
            background: #4da6ff;
            color: #000;
            font-weight: 600;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #999;
        }

        .error {
            background: #3d1a1a;
            border: 1px solid #8b3a3a;
            color: #ff6b6b;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .success {
            background: #1a3d1a;
            border: 1px solid #3a8b3a;
            color: #6bff6b;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        canvas {
            display: none;
        }

        @media (max-width: 1024px) {
            .viewer-container {
                grid-template-columns: 1fr;
            }
            .controls {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎨 Visualizador de Spritesheets - SpriteCollab</h1>

        <div id="alertContainer"></div>

        <div class="controls">
            <div class="control-group">
                <label>Pokémon (ID ou Nome)</label>
                <input type="text" id="pokemonInput" placeholder="001 ou Bulbasaur" value="001">
            </div>
            <div class="control-group">
                <label>Forma</label>
                <input type="text" id="formaInput" placeholder="Normal" value="Normal">
            </div>
            <div class="control-group">
                <label>Gênero</label>
                <select id="genderSelect" style="padding: 10px; background: #1a1a1a; border: 1px solid #404040; border-radius: 6px; color: #f0f0f0;">
                    <option value="M">Macho</option>
                    <option value="F">Fêmea</option>
                </select>
            </div>
            <button onclick="loadSpritesheet()">Carregar Spritesheet</button>
        </div>

        <div class="viewer-container">
            <div class="spritesheet-panel">
                <h2>Spritesheet Completo</h2>
                <div id="spritesheetContainer" class="loading">
                    Digite um Pokémon e clique em "Carregar Spritesheet"
                </div>
            </div>

            <div class="info-panel">
                <h2>Informações</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Pokémon</div>
                        <div class="info-value" id="infoPokemon">-</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">URL do Spritesheet</div>
                        <div class="info-value" id="infoUrl" style="font-size: 0.85rem; font-family: monospace;">-</div>
                    </div>
                </div>

                <div style="margin-top: 15px;">
                    <label style="display: block; margin-bottom: 10px;">Poses Disponíveis</label>
                    <div class="poses-list" id="posesList">
                        Carregue um spritesheet para ver as poses
                    </div>
                </div>

                <div style="margin-top: 15px;">
                    <button onclick="downloadSpritesheet()" style="width: 100%; margin-bottom: 10px;">⬇️ Baixar Spritesheet</button>
                    <button onclick="copySpritesheetUrl()" style="width: 100%; background: #666;">📋 Copiar URL</button>
                </div>
            </div>
        </div>
    </div>

    <canvas id="canvas" width="80" height="80"></canvas>

    <script>
        const SPRITECOLLAB_BASE = 'https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/pokemon';

        function showAlert(message, type = 'info') {
            const container = document.getElementById('alertContainer');
            const alertEl = document.createElement('div');
            alertEl.className = type === 'error' ? 'error' : type === 'success' ? 'success' : 'error';
            alertEl.textContent = message;
            container.appendChild(alertEl);
            setTimeout(() => alertEl.remove(), 5000);
        }

        function getPokemonNumber(input) {
            // Se for número, retorna formatado
            if (/^\d+$/.test(input)) {
                return input.padStart(3, '0');
            }
            // Se for nome, mapear para número (simplificado)
            const pokemonMap = {
                'bulbasaur': '001', 'ivysaur': '002', 'venusaur': '003',
                'charmander': '004', 'charmeleon': '005', 'charizard': '006',
                'squirtle': '007', 'wartortle': '008', 'blastoise': '009',
                // Adicione mais conforme necessário
            };
            return pokemonMap[input.toLowerCase()] || input.padStart(3, '0');
        }

        async function loadSpritesheet() {
            const pokemonInput = document.getElementById('pokemonInput').value.trim();
            const forma = document.getElementById('formaInput').value.trim() || 'Normal';
            const gender = document.getElementById('genderSelect').value;

            if (!pokemonInput) {
                showAlert('Digite um Pokémon válido', 'error');
                return;
            }

            const pokemonNum = getPokemonNumber(pokemonInput);
            const spriteGender = gender === 'F' ? 'F' : '';

            // Tenta combinações diferentes
            const urls = [
                `${SPRITECOLLAB_BASE}/${pokemonNum}/${forma}/${spriteGender}[00].png`,
                `${SPRITECOLLAB_BASE}/${pokemonNum}/${forma}/[00].png`,
                `${SPRITECOLLAB_BASE}/${pokemonNum}/Normal/[00].png`
            ];

            const container = document.getElementById('spritesheetContainer');
            container.innerHTML = '<div class="loading">Carregando spritesheet...</div>';

            let loaded = false;
            for (const url of urls) {
                try {
                    const response = await fetch(url, { method: 'HEAD' });
                    if (response.ok) {
                        displaySpritesheet(url, pokemonNum, forma);
                        loaded = true;
                        break;
                    }
                } catch (e) {
                    // Continua tentando
                }
            }

            if (!loaded) {
                container.innerHTML = '<div style="color: #ff6b6b; padding: 20px;">❌ Spritesheet não encontrado. Verifique o Pokémon e a forma.</div>';
                showAlert('Spritesheet não encontrado para este Pokémon', 'error');
            }
        }

        function displaySpritesheet(url, pokemonNum, forma) {
            const container = document.getElementById('spritesheetContainer');
            container.innerHTML = '';

            const img = document.createElement('img');
            img.src = url;
            img.alt = `Spritesheet de ${pokemonNum}`;

            img.onload = () => {
                container.appendChild(img);
                document.getElementById('infoPokemon').textContent = `Pokémon #${pokemonNum}`;
                document.getElementById('infoUrl').textContent = url;
                generatePosesList(img.width, img.height);
                showAlert(`✓ Spritesheet carregado (${img.width}x${img.height}px)`, 'success');
            };

            img.onerror = () => {
                container.innerHTML = '<div style="color: #ff6b6b; padding: 20px;">❌ Erro ao carregar a imagem</div>';
                showAlert('Erro ao carregar o spritesheet', 'error');
            };
        }

        function generatePosesList(width, height) {
            const tileSize = 80;
            const cols = Math.floor(width / tileSize);
            const rows = Math.floor(height / tileSize);
            const totalPoses = cols * rows;

            const posesList = document.getElementById('posesList');
            posesList.innerHTML = '';

            const poseNames = [
                'Idle', 'Walk 1', 'Walk 2', 'Ataque',
                'Hit', 'Hurt', 'Sleep', 'Special',
                'Cry', 'Chant', 'Tumble', 'Faint'
            ];

            for (let i = 0; i < totalPoses; i++) {
                const row = Math.floor(i / cols);
                const col = i % cols;
                const poseName = poseNames[i] || `Pose ${i}`;
                
                const poseEl = document.createElement('div');
                poseEl.className = 'pose-item';
                poseEl.textContent = `[${i.toString().padStart(2, '0')}] ${poseName} (${col}, ${row})`;
                poseEl.onclick = () => {
                    document.querySelectorAll('.pose-item').forEach(el => el.classList.remove('active'));
                    poseEl.classList.add('active');
                    extractPose(i, col, row);
                };
                posesList.appendChild(poseEl);
            }
        }

        function extractPose(index, col, row) {
            const img = document.querySelector('#spritesheetContainer img');
            if (!img) return;

            const canvas = document.getElementById('canvas');
            const ctx = canvas.getContext('2d');
            const tileSize = 80;

            canvas.width = tileSize;
            canvas.height = tileSize;

            ctx.drawImage(
                img,
                col * tileSize, row * tileSize, tileSize, tileSize,
                0, 0, tileSize, tileSize
            );

            const extractedUrl = canvas.toDataURL('image/png');
            console.log(`Pose [${index}] extraída:`, extractedUrl);
            showAlert(`✓ Pose [${index}] extraída com sucesso!`, 'success');
        }

        function downloadSpritesheet() {
            const url = document.getElementById('infoUrl').textContent;
            if (url === '-') {
                showAlert('Carregue um spritesheet primeiro', 'error');
                return;
            }
            const a = document.createElement('a');
            a.href = url;
            a.download = 'spritesheet.png';
            a.click();
        }

        function copySpritesheetUrl() {
            const url = document.getElementById('infoUrl').textContent;
            if (url === '-') {
                showAlert('Carregue um spritesheet primeiro', 'error');
                return;
            }
            navigator.clipboard.writeText(url).then(() => {
                showAlert('✓ URL copiada para a área de transferência!', 'success');
            });
        }

        // Carrega Bulbasaur por padrão ao abrir
        window.addEventListener('load', () => {
            loadSpritesheet();
        });
    </script>
</body>
</html>
