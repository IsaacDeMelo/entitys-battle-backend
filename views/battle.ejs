        const BAG_ITEM_META = {
            captureCube: { type: 'consumable', name: 'Capture Cube', icon: '/items/catchcube.svg', desc: 'Arremesse para tentar capturar uma criatura selvagem.' },
            levelUpCrystal: { type: 'consumable', name: 'Level Crystal', icon: '/items/levelupcrystal.svg', desc: 'Cristal raro que eleva o nível de uma criatura.' },
            key_example: { type: 'key', name: 'Chave (exemplo)', icon: '/items/key.svg', desc: 'Item-chave de exemplo.' }
        };

        async function openBattleBag() {
            const menu = document.getElementById('action-menu');
            const moves = document.getElementById('moves-view');
            const bag = document.getElementById('bag-container');
            const cont = document.getElementById('bagContent');
            if (!bag || !cont) return;
            if (menu) menu.classList.add('is-hidden');
            if (moves) moves.classList.add('is-hidden');
            bag.classList.add('is-visible');
            cont.innerHTML = 'Carregando...';
            try {
                const res = await fetch('/api/me?userId=<%= realUserId %>');
                const data = await res.json();
                const bagCounts = (data.bag && typeof data.bag === 'object') ? data.bag : {};
                const keyItems = Array.isArray(data.keyItems) ? data.keyItems : [];

                const items = [];
                for (const [id, meta] of Object.entries(BAG_ITEM_META)) {
                    if (meta.type === 'key') {
                        if (keyItems.includes(id)) items.push({ id, count: 1, isKey: true, meta });
                    } else {
                        const n = Number(bagCounts[id]) || 0;
                        if (n > 0) items.push({ id, count: n, isKey: false, meta });
                    }
                }

                if (items.length === 0) {
                    cont.innerHTML = '<div class="bag-item-grid"><div style="grid-column:1/-1;color:#9aa3b2;font-family:\'Press Start 2P\',cursive;font-size:0.5rem;text-align:center;">Mochila vazia.</div></div>';
                    return;
                }

                let html = '<div class="bag-item-grid">';
                for (const it of items) {
                    const canUse = it.id === 'captureCube' && it.count > 0;
                    const useBtn = canUse
                        ? '<button class="bag-use-btn" onclick="event.stopPropagation();useCatchballFromBag()">Usar</button>'
                        : '';
                    const badge = (it.count > 1 || it.isKey)
                        ? '<span class="bag-item-count">' + (it.isKey ? 'KEY' : 'x' + it.count) + '</span>'
                        : '';
                    html += '<div class="bag-item-card" onclick="this.classList.toggle(\'open\')">'
                        + badge
                        + '<img class="bag-item-icon" src="' + it.meta.icon + '" alt="' + it.meta.name + '" onerror="this.style.visibility=\'hidden\'">'
                        + '<span class="bag-item-name">' + it.meta.name + '</span>'
                        + '<div class="item-info"><span class="item-desc">' + it.meta.desc + '</span>' + useBtn + '</div>'
                        + '</div>';
                }
                html += '</div>';
                cont.innerHTML = html;
            } catch(e) { cont.innerHTML = 'Erro.'; }
        }
        async function useCatchballFromBag() {
            if (battleMode !== 'wild') { showToast('Apenas em batalhas selvagens.'); return; }
            if(!confirm('Usar uma Catchball agora?')) return; 
            try {
                closeBattleBag(); 
                
                // Inicia request e animação em paralelo para evitar delay percepido
                const reqPromise = fetch('/api/turn', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ battleId, action: 'catch' }) }).then(r => r.json());
                
                // Passa a promise para a animação lidar com a sincronia
                const data = await playCaptureAnimation(p2RawId, reqPromise);
                
                if(!data) { showToast('Erro na conexão.'); return; }

                if(data.events) await playEvents(data.events); 
                
                if(data.captured) { 
                    if(data.sentToPC) showToast('Enviado para o PC!');
                    else showToast('Capturado!');
                    setTimeout(()=>{ window.location.href = returnUrl; }, 1000); 
                    return; 
                } 
            } catch(e) { console.error(e); showToast('Erro.'); }
        }
        
