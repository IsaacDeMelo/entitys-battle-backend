<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Batalha</title>
    <link rel="preload" as="image" href="/uploads/catchcube.gif">
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/scripts/common.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Roboto:wght@500;900&display=swap" rel="stylesheet">
   <style>
    :root { --bg-color: #202020; --hp-high: #4fd05c; --hp-mid: #f6b93b; --hp-low: #e55039; }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
    body { margin: 0; padding: 0; background: var(--bg-color); color: white; font-family: 'Roboto', sans-serif; overflow: hidden; width: 100vw; height: 100dvh; display: flex; flex-direction: column; align-items: center; }
    
    #global-loader { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.5s ease-out; }
    .spinner { width: 50px; height: 50px; border: 5px solid rgba(255, 255, 255, 0.1); border-top: 5px solid #3498db; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px; }
    .loading-text { font-family: 'Press Start 2P', cursive; font-size: 0.8rem; color: #f1c40f; animation: pulse 1.5s infinite; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    
    /* --- CORREÇÃO DO BACKGROUND AQUI --- */
    .arena { 
        flex: 1; 
        /* Verifica se é base64/url ou arquivo local */
        background: url('<%= (bgImage.startsWith("http") || bgImage.startsWith("data:")) ? bgImage : "/uploads/" + bgImage %>') no-repeat center center; 
        background-position: calc(var(--bgPosX, 50) * 1%) calc(var(--bgPosY, 50) * 1%);
        /* Zoom: 100 = tamanho base, >100 aproxima, <100 afasta */
        background-size: calc(var(--bgZoom, 100) * 1%) auto;
        position: relative; 
        overflow: hidden; 
        z-index: 10; 
        image-rendering: pixelated; 
        width: 100%;
        max-width: 420px;
    }

    .bottom-panel { width: 100%; max-width: 420px; margin: 0 auto; }
    #bleachers, #chat-container { width: 100%; max-width: 420px; margin: 0 auto; }

    /* Editor do battle background (admin) */
    #bgEditor {
        position: fixed;
        left: 12px;
        top: 12px;
        z-index: 10050;
        background: rgba(15, 15, 20, 0.92);
        border: 2px solid #555;
        border-radius: 10px;
        padding: 10px;
        width: min(360px, calc(100vw - 24px));
        display: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        font-family: 'Press Start 2P', cursive;
    }
    #bgEditor h4 { margin: 0 0 10px 0; font-size: 0.65rem; color: #f1c40f; }
    #bgEditor .row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; margin-bottom: 8px; }
    #bgEditor label { font-size: 0.5rem; color: #e2e8f0; }
    #bgEditor input[type="range"] { width: 100%; }
    #bgEditor .val { font-size: 0.55rem; color: #fff; min-width: 52px; text-align: right; }
    #bgEditor .btns { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 8px; }
    #bgEditor button {
        background: #1e293b;
        color: #fff;
        border: 2px solid #64748b;
        border-radius: 8px;
        padding: 10px 8px;
        font-family: inherit;
        font-size: 0.55rem;
        cursor: pointer;
        box-shadow: 0 4px 0 rgba(0,0,0,0.5);
    }
    #bgEditor button:active { transform: translateY(2px); box-shadow: 0 2px 0 rgba(0,0,0,0.5); }
    #bgEditor .hint { font-size: 0.5rem; color: #94a3b8; line-height: 1.4; margin-top: 6px; }
    
     .hud-panel { position: absolute; background: rgba(15, 15, 20, 0.85); backdrop-filter: blur(4px); padding: 8px 12px; border-radius: 12px; border: 2px solid #555; z-index: 30; width: min(200px, 48vw); font-family: 'Press Start 2P', cursive; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
     .hud-p2 { bottom: 15px; right: 15px; top: auto; border-bottom-right-radius: 0; border-left: none; border-right: 5px solid #e74c3c; text-align: right; }
     .hud-p1 { top: 15px; left: 15px; border-top-left-radius: 0; border-right: none; border-left: 5px solid #3498db; text-align: left; }
    .poke-name { display: flex; align-items: baseline; gap: 6px; font-size: 0.55rem; margin-bottom: 5px; color: #fff; text-shadow: 1px 1px 0 #000; text-transform: uppercase; letter-spacing: 0.5px; min-width: 0; }
    .poke-name > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .poke-lv { font-size: 0.45rem; color: #f1c40f; flex: none; white-space: nowrap; }
    .trainer-sub { font-size: 0.45rem; color: #bbb; margin-bottom: 5px; text-transform: uppercase; font-family: sans-serif; font-weight: bold; letter-spacing: 1px; }
    .bar-container { width: 100%; height: 8px; background: #333; border-radius: 5px; overflow: hidden; border: 1px solid #000; margin-bottom: 4px; position: relative; }
    .hp-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #2ecc71, #27ae60); transition: width 0.5s ease-out; }
    .en-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #f1c40f, #f39c12); transition: width 0.5s ease-out; }
    .xp-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #3498db, #2980b9); transition: width 0.5s ease-out; box-shadow: 0 0 5px rgba(52, 152, 219, 0.5); }
    .stat-text { font-size: 0.5rem; color: #ddd; text-shadow: 1px 1px 0 #000; display: block; margin-top: 2px; }
    
    .fighter { 
        position: absolute; 
        width: 240px; 
        height: 120px; 
        display: flex; 
        align-items: flex-end; 
        z-index: 20; 
        pointer-events: none; 
        top: calc(50% - 10px); 
        transform: translateY(-50%); 
        transition: opacity 0.5s; 
    }
    
    .fighter.p2-position { right: 10%; justify-content: flex-end; }
    .fighter.p2-position .trainer { order: 2; margin-left: -20px; z-index: 23; background-position-y: 33.33%; } 
    .fighter.p2-position .sprite { order: 1; z-index: 22; }
    .fighter.p1-position { left: 10%; justify-content: flex-start; }
    .fighter.p1-position .trainer { order: 1; margin-right: -20px; z-index: 23; background-position-y: 66.66%; }
    .fighter.p1-position .sprite { order: 2; z-index: 22; transform: scaleX(-1); }

    .sprite { 
        position: relative; 
        width: 110px; 
        height: 110px; 
        transition: transform 0.2s; 
        margin-bottom: 5px; 
    }
    .sprite img { width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; filter: drop-shadow(0 5px 5px rgba(0,0,0,0.5)); animation: breathe 3s infinite ease-in-out; opacity: 0; transition: opacity 0.2s ease-out; }
    .sprite img.attack { animation: attackBump 0.3s ease-in-out; }
    @keyframes attackBump {
        0% { transform: translateX(0); }
        25% { transform: translateX(20px); }
        50% { transform: translateX(-10px); }
        100% { transform: translateX(0); }
    }
    @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
    .sprite img.hurt { filter: brightness(2) saturate(0) sepia(1) hue-rotate(-50deg); animation: shake 0.4s; }
    .sprite img.status-dmg { filter: brightness(0.8) sepia(1) hue-rotate(240deg) saturate(3); }
    
    .trainer { 
        position: relative; 
        width: 50px; 
        height: 50px; 
        background-size: 400% auto; 
        image-rendering: pixelated; 
        margin-bottom: 15px; 
        top: 5px; 
        transition: transform 0.2s; 
    }

    .victory-trainer {
        width: 80px; height: 80px; margin-bottom: 8px; top: 0; background-size: 400% auto;
    }

    <% for(let i = 1; i <= 20; i++) { %> .trainer[data-skin="char<%= i %>"] { background-image: url('/uploads/char<%= i %>.png'); } <% } %>
    .trainer[data-skin="char1"] { background-image: url('/uploads/char1.png'); }
    .trainer.frame-1 { background-position-x: -100%; }
    .atk-particle { position: absolute, pointer-events: none, z-index: 2000, animation: particleFly 0.5s forwards, width: 30px, height: 30px, border-radius: 50%, border: 2px solid rgba(255,255,255,0.8), }
    @keyframes particleFly { 0% { transform: translate(0,0) scale(0.2); opacity: 1; } 100% { transform: translate(var(--tx), var(--ty)) scale(2); opacity: 0; } }
    .impact-effect { position: absolute; width: 120px; height: 120px; z-index: 2000; pointer-events: none; border-radius: 50%; opacity: 0; mix-blend-mode: screen; }
    .impact-effect::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 3px solid rgba(255,255,255,0.6); animation: impact-ring 0.5s ease-out forwards; }
    .impact-pop { animation: impactPop 0.45s forwards; }
    @keyframes impactPop { 0% { transform: scale(0.3); opacity: 1; } 50% { transform: scale(1.1); opacity: 0.85; } 100% { transform: scale(1.45); opacity: 0; } }
    @keyframes impact-ring { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.8); opacity: 0; } }
    
    /* Efeitos visuais dos 10 tipos originais */
    .effect-beast { background: radial-gradient(circle, #d4a574, #8b6f47); box-shadow: 0 0 20px #d4a574; }
    .effect-flame { background: radial-gradient(circle, #f1c40f, #e74c3c); box-shadow: 0 0 20px #e67e22; }
    .effect-aqua { background: radial-gradient(circle, #3498db, #2980b9); box-shadow: 0 0 20px #3498db; }
    .effect-forest { background: radial-gradient(circle, #2ecc71, #27ae60); box-shadow: 0 0 20px #2ecc71; }
    .effect-sky { background: radial-gradient(circle, #74b9ff, #5dade2); box-shadow: 0 0 20px #74b9ff; }
    .effect-earth { background: radial-gradient(circle, #d35400, #e67e22); box-shadow: 0 0 15px #d35400; }
    .effect-mystic { background: radial-gradient(circle, #e056fd, #be2edd); box-shadow: 0 0 20px #e056fd; }
    .effect-shadow { background: radial-gradient(circle, #2d3436, #000); box-shadow: 0 0 15px #9b59b6; }
    .effect-metal { background: radial-gradient(circle, #bdc3c7, #95a5a6); box-shadow: 0 0 15px #bdc3c7; }
    .effect-venom { background: radial-gradient(circle, #8e44ad, #9b59b6); box-shadow: 0 0 15px #8e44ad; }
    
    .command-bubble { position: absolute; top: -50px; left: 50%; transform: translateX(-50%) scale(0); background: #fff; color: #000; padding: 10px 15px; border-radius: 20px; border: 2px solid #000; font-family: 'Press Start 2P'; font-size: 0.6rem; white-space: nowrap; z-index: 100; opacity: 0; transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); pointer-events: none; box-shadow: 4px 4px 0 rgba(0,0,0,0.3); }
    .command-bubble.show { opacity: 1; transform: translateX(-50%) scale(1); top: -70px; }
    .floating-text { font-family: 'Press Start 2P'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.5rem; text-shadow: 3px 3px 0 #000; animation: popUp 1.2s forwards; z-index: 100; pointer-events: none; width: 300px; text-align: center; }
    @keyframes popUp { 0% { opacity: 0; margin-top: 0; transform: translate(-50%, -50%) scale(0.5); } 20% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); } 100% { opacity: 0; margin-top: -150px; transform: translate(-50%, -50%) scale(1); } }
    .damage-text { color: #ff4757; -webkit-text-stroke: 1px #800; } 
    .heal-text { color: #2ed573; -webkit-text-stroke: 1px #050; } 
    .resist-text { color: #bdc3c7; font-size: 0.9rem; margin-top: -30px !important; }
    .super-text { color: #f1c40f; font-size: 1rem; margin-top: -30px !important; text-shadow: 2px 2px 0 #c0392b; }
    .status-text { color: #9b59b6; font-size: 1rem; margin-top: -50px !important; text-shadow: 2px 2px 0 #000; }
    .bottom-panel { width: 100%; height: auto; background: #1a1a2e; border-top: 4px solid #3498db; z-index: 50; padding-bottom: env(safe-area-inset-bottom); position: relative; box-shadow: 0 -5px 20px rgba(0,0,0,0.5); }
    .controls-panel { grid-template-columns: 1fr 1fr; gap: 10px; padding: 15px; }
    .battle-log { padding: 15px; overflow-y: auto; font-family: monospace; font-size: 14px; color: #ecf0f1; height: 180px; background: #111; line-height: 1.5; }
    .log-entry { margin-bottom: 8px; border-bottom: 1px solid #333; padding-bottom: 4px; }
    .move-btn { --accent: #9aa6b2; background: #101722; border: 1px solid #2a3645; color: #e5e7eb; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.12s, box-shadow 0.12s, border-color 0.12s; padding: 8px 10px 8px 14px; position: relative; overflow: hidden; height: 70px; min-height: 70px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03), 0 3px 0 #0b0f16; }
    .move-btn::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--accent); opacity: 0.9; }
    .move-btn strong { font-size: 0.65rem; margin-bottom: 2px; text-transform: uppercase; line-height: 1.1; text-align: center; word-wrap: break-word; }
    .move-btn small { font-size: 0.55rem; color: #b7c2cf; font-weight: 700; letter-spacing: 0.3px; }
    .move-btn:hover { border-color: #3a4656; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05), 0 4px 0 #0b0f16; }
    .move-btn:active { transform: translateY(1px); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02), 0 2px 0 #0b0f16; }
    .move-btn:disabled { opacity: 0.5; pointer-events: none; filter: grayscale(1); }

    /* Ícone pequeno do tipo do ataque (substitui emojis dos golpes) */
    .move-title { display: inline-flex; align-items: center; gap: 6px; }
    .move-type-icon {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.45);
        box-shadow: 0 0 0 2px rgba(0,0,0,0.35) inset;
        flex: none;
    }
    .move-type-beast { background: #d4a574; }
    .move-type-flame { background: #e67e22; }
    .move-type-aqua { background: #3498db; }
    .move-type-forest { background: #2ecc71; }
    .move-type-sky { background: #74b9ff; }
    .move-type-earth { background: #d35400; }
    .move-type-mystic { background: #e056fd; }
    .move-type-shadow { background: #2d3436; }
    .move-type-metal { background: #bdc3c7; }
    .move-type-venom { background: #8e44ad; }
    .rest-btn { grid-column: span 2; --accent: #3fbf7f; background: #0f1f16; border-color: #1f4d33; }
    #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(8, 10, 14, 0.9); z-index: 999; display: none; flex-direction: column; justify-content: center; align-items: center; animation: fadeIn 0.3s; backdrop-filter: blur(6px); }
    
    .victory-container { max-width: 520px; width: 92%; background: rgba(10, 12, 18, 0.85); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 22px; box-shadow: 0 20px 50px rgba(0,0,0,0.55); }
    .victory-title { font-family: 'Press Start 2P'; text-align: left; color: #e5e7eb; margin: 0 0 18px 0; font-size: 1.05rem; letter-spacing: 1px; text-shadow: none; }
    @keyframes title-bounce { 0% { opacity: 0; transform: translateY(8px); } 100% { opacity: 1; transform: translateY(0); } }
    
    .battle-comparison { display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: center; margin-bottom: 18px; }
    .fighter-result { position: relative; }
    .fighter-result.winner { animation: none; }
    .fighter-result.loser { animation: none; opacity: 0.7; }
    
    .fighter-crown { display: none; }
    
    .fighter-avatar { position: relative; width: 100%; aspect-ratio: 1; background: rgba(255,255,255,0.03); border-radius: 10px; padding: 10px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.08); overflow: hidden; }
    .fighter-result.winner .fighter-avatar { border-color: rgba(255,255,255,0.18); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06); }
    .fighter-result.loser .fighter-avatar { filter: grayscale(0.9); }
    
    .fighter-monster { width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; filter: drop-shadow(0 6px 12px rgba(0,0,0,0.45)); }
    .fighter-result.winner .fighter-monster { animation: none; }
    
    .fighter-name { font-family: 'Press Start 2P'; font-size: 0.65rem; text-align: center; margin-top: 10px; color: #e5e7eb; background: rgba(0,0,0,0.35); padding: 6px 8px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08); }
    .fighter-result.winner .fighter-name { color: #f8fafc; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.06); }
    
    .vs-badge { font-size: 0.7rem; font-family: 'Press Start 2P'; color: #94a3b8; text-shadow: none; transform: none; opacity: 0.9; }
    
    .rewards-section { background: rgba(255,255,255,0.03); border-radius: 10px; padding: 14px; margin-bottom: 16px; border: 1px solid rgba(255,255,255,0.06); animation: none; }
    @keyframes rewards-fade { 0% { opacity: 0; } 100% { opacity: 1; } }
    
    .rewards-title { font-family: 'Press Start 2P'; font-size: 0.7rem; color: #cbd5f5; text-align: left; margin-bottom: 10px; letter-spacing: 0.6px; }
    .rewards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .reward-item { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.02); padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06); animation: none; }
    .reward-item:nth-child(1) { border-left: 2px solid rgba(255,255,255,0.18); }
    .reward-item:nth-child(2) { border-left: 2px solid rgba(255,255,255,0.18); }
    @keyframes reward-pop { 0% { opacity: 0; } 100% { opacity: 1; } }
    
    .reward-icon { display: none; }
    .reward-text { flex: 1; }
    .reward-label { font-size: 0.6rem; color: #9aa3b2; text-transform: uppercase; letter-spacing: 0.4px; }
    .reward-value { font-family: 'Press Start 2P'; font-size: 0.7rem; color: #e5e7eb; margin-top: 2px; }
    
    .xp-bar-container { margin-top: 12px; animation: none; }
    .xp-bar-label { font-size: 0.6rem; color: #9aa3b2; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }
    .xp-bar { height: 8px; background: rgba(0,0,0,0.5); border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); position: relative; }
    .xp-bar-fill { height: 100%; background: linear-gradient(90deg, #94a3b8, #cbd5f5); border-radius: 8px; transition: width 1s ease-out; box-shadow: none; position: relative; overflow: hidden; }
    .xp-bar-fill::after { display: none; }
    @keyframes xp-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    @keyframes xp-fade { 0% { opacity: 0; } 100% { opacity: 1; } }
    
    .level-up-badge { font-family: 'Press Start 2P'; font-size: 0.6rem; background: rgba(255,255,255,0.06); padding: 3px 8px; border-radius: 8px; color: #e5e7eb; animation: none; border: 1px solid rgba(255,255,255,0.1); }
    @keyframes level-badge-pop { 0% { opacity: 0; } 100% { opacity: 1; } }
    
    .btn-restart { background: #111827; color: #e5e7eb; padding: 12px 18px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); font-family: 'Press Start 2P'; font-size: 0.75rem; cursor: pointer; transition: border-color 0.2s, background 0.2s; box-shadow: none; text-transform: uppercase; animation: none; }
    @keyframes btn-fade { 0% { opacity: 0; } 100% { opacity: 1; } }
    .btn-restart:hover { border-color: rgba(255,255,255,0.25); background: #0f172a; }
    .btn-restart:active { transform: translateY(1px); }
    .spectator-banner { position: absolute; bottom: 0; width: 100%; text-align: center; background: rgba(0,0,0,0.8); color: #f1c40f; padding: 10px; font-family: 'Press Start 2P'; font-size: 0.8rem; pointer-events: none; z-index: 50; letter-spacing: 2px; }
    .catchball { position: absolute; width: 24px; height: 24px; background-image: url('/uploads/catchcube.gif'); background-size: contain; background-repeat: no-repeat; z-index: 2000; pointer-events: none; transform-origin: center center; }
    .flash-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #fff; opacity: 0; pointer-events: none; z-index: 500; transition: opacity 0.15s; }
    .flash-overlay.impact { opacity: 0.35; }
    .flash-overlay.impact-strong { opacity: 0.55; background: #ffe9bf; }
    .flash-overlay.active { opacity: 0.9; }
    .absorbed-state { filter: brightness(10) sepia(1) hue-rotate(-50deg) saturate(5) !important; transform: scale(0) !important; transition: transform 0.4s ease-in, filter 0.1s !important; }
    .catchball.captured-lock { filter: brightness(0.6); }
    .capture-star { position: absolute; font-size: 30px; color: gold; text-shadow: 0 0 5px orange; animation: star-pop 0.6s ease-out forwards; z-index: 2200; }
    @keyframes star-pop { 0% { transform: scale(0); opacity: 0; } 50% { transform: scale(1.5); opacity: 1; } 100% { transform: scale(1) translateY(-30px); opacity: 0; } }
    #switchModal { position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 3000; display: none; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
    .switch-box { background: #2c3e50; border: 2px solid #e74c3c; padding: 25px; border-radius: 15px; width: 90%; max-width: 450px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
    .switch-title { font-family: 'Press Start 2P'; color: #f1c40f; margin-bottom: 25px; font-size: 0.9rem; line-height: 1.6; text-shadow: 2px 2px 0 #000; }
    .switch-item { display: flex; align-items: center; gap: 15px; padding: 12px; border: 1px solid #444; background: #222; margin-bottom: 10px; cursor: pointer; border-radius: 8px; transition: 0.2s; text-align: left; }
    .switch-item:hover { background: #333; border-color: #3498db; transform: translateX(5px); }
    .switch-sprite { width: 50px; height: 50px; image-rendering: pixelated; object-fit: contain; }
     /* === MENU DE AÇÕES / ATAQUES / MOCHILA (em painel) === */
     .is-hidden { display: none !important; }
     .battle-move-menu { display: none; }
     .battle-move-menu.is-visible { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; animation: slideUp 0.2s ease-out; }
     @keyframes slideUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
     .moves-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; grid-column: 1 / -1; }
     .move-btn-back { grid-column: 1 / -1; height: 38px; background: #161b22; border: 1px solid #2a3645; justify-content: center; font-size: 0.6rem; opacity: 0.85; color: #cfd8e3; }
     .move-btn-back:active { opacity: 1; }
     .action-btn { background: linear-gradient(180deg, #1e2530, #161b22); border: 1px solid #2a3645; color: #e5e7eb; border-radius: 8px; height: 70px; font-family: 'Press Start 2P', cursive; font-size: 0.6rem; text-transform: uppercase; cursor: pointer; transition: all 0.12s; box-shadow: 0 3px 0 #0b0f16; display: flex; align-items: center; justify-content: center; letter-spacing: 0.5px; }
     .action-btn:active { transform: translateY(1px); box-shadow: 0 2px 0 #0b0f16; }
     .action-btn:disabled { opacity: 0.5; pointer-events: none; }
     .action-attack { grid-column: 1 / -1; height: 70px; background: linear-gradient(180deg, #e74c3c, #c0392b); border-color: #922; color: #fff; font-size: 0.75rem; letter-spacing: 1px; }
     .action-btn.btn-bag { background: linear-gradient(180deg, #f39c12, #d35400); border-color: #a04000; color: #fff; }
     .bag-inner { grid-column: 1 / -1; background: rgba(0,0,0,0.4); border: 1px solid #2a3645; border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
      .bag-inner .bag-row { display: flex; gap: 6px; }
      .bag-inner .bag-item { flex: 1; background: #161b22; padding: 10px 6px; border-radius: 8px; font-size: 0.55rem; text-align: center; border: 1px solid #2a3645; color: #9aa3b2; font-family: 'Press Start 2P', cursive; line-height: 1.6; }
      .bag-inner .bag-item strong { color: #f1c40f; font-size: 0.8rem; display: block; margin-top: 2px; }
      .bag-inner .bag-actions { display: flex; gap: 6px; }
      .bag-item-grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      .bag-item-card { position: relative; background: linear-gradient(180deg, #1e2530, #141922); border: 1px solid #2a3645; border-radius: 10px; padding: 10px 8px; display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; transition: border-color 0.12s, transform 0.1s; box-shadow: 0 3px 0 #0b0f16; text-align: center; }
      .bag-item-card:active { transform: translateY(1px); box-shadow: 0 2px 0 #0b0f16; }
      .bag-item-card.open { border-color: #f39c12; }
      .bag-item-card.is-empty { opacity: 0.55; }
      .bag-item-card .bag-item-icon { width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated; }
      .bag-item-card .bag-item-name { font-family: 'Press Start 2P', cursive; font-size: 0.5rem; color: #e5e7eb; line-height: 1.5; }
      .bag-item-card .bag-item-count { position: absolute; top: 4px; right: 4px; background: #0b0f16; border: 1px solid #2a3645; border-radius: 10px; font-family: 'Press Start 2P', cursive; font-size: 0.45rem; color: #f1c40f; padding: 2px 5px; }
      .bag-item-card .item-info { grid-column: 1 / -1; display: none; flex-direction: column; gap: 6px; width: 100%; }
      .bag-item-card.open .item-info { display: flex; }
      .bag-item-card .item-desc { font-family: 'Press Start 2P', cursive; font-size: 0.45rem; color: #9aa3b2; line-height: 1.6; }
      .bag-item-card .bag-use-btn { height: 34px; border-radius: 8px; border: 1px solid #922; background: linear-gradient(180deg, #e74c3c, #c0392b); color: #fff; font-family: 'Press Start 2P', cursive; font-size: 0.5rem; text-transform: uppercase; cursor: pointer; }
      .bag-item-card .bag-use-btn:disabled { opacity: 0.5; pointer-events: none; }
    .deploy-ball { position: absolute; width: 24px; height: 24px; background-image: url('/uploads/catchcube.gif'); background-size: contain; background-repeat: no-repeat; z-index: 100; pointer-events: none; }
    
    /* === SISTEMA DE COMBO & HIT MARKERS === */
    .combo-badge { 
        position: absolute; 
        top: 8%; 
        left: 50%; 
        transform: translateX(-50%); 
        font-family: 'Press Start 2P', cursive; 
        font-size: 1.4rem; 
        color: #f39c12; 
        text-shadow: 0 0 10px #e67e22, 2px 2px 0 #000; 
        animation: pulse-glow 0.8s infinite, bounce-in 0.3s ease-out; 
        z-index: 200; 
        pointer-events: none; 
        letter-spacing: 2px; 
    }
    
    .combo-badge.combo-2 { color: #3498db; text-shadow: 0 0 15px #3498db, 2px 2px 0 #000; }
    .combo-badge.combo-3 { color: #9b59b6; text-shadow: 0 0 20px #9b59b6, 2px 2px 0 #000; font-size: 1.6rem; }
    .combo-badge.combo-4 { color: #e74c3c; text-shadow: 0 0 25px #e74c3c, 2px 2px 0 #000; font-size: 1.8rem; }
    .combo-badge.combo-max { color: #f1c40f; text-shadow: 0 0 30px #f1c40f, 0 0 50px #e67e22, 2px 2px 0 #000; font-size: 2rem; animation: pulse-glow 0.5s infinite, rainbow 2s infinite, bounce-in 0.3s ease-out; }
    
    @keyframes pulse-glow { 0%, 100% { transform: translateX(-50%) scale(1); } 50% { transform: translateX(-50%) scale(1.1); } }
    @keyframes bounce-in { 0% { transform: translateX(-50%) translateY(-20px) scale(0); opacity: 0; } 60% { transform: translateX(-50%) translateY(0px) scale(1.2); } 100% { transform: translateX(-50%) translateY(0px) scale(1); opacity: 1; } }
    @keyframes rainbow { 0% { filter: hue-rotate(0deg); } 100% { filter: hue-rotate(360deg); } }
    
    .momentum-bar { 
        position: absolute; 
        bottom: 35px; 
        left: 50%; 
        transform: translateX(-50%); 
        width: 180px; 
        height: 12px; 
        background: rgba(0,0,0,0.7); 
        border-radius: 20px; 
        border: 2px solid rgba(255,255,255,0.3); 
        overflow: hidden; 
        z-index: 25; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.5); 
    }
    
    .momentum-fill { 
        height: 100%; 
        background: linear-gradient(90deg, #3498db, #f39c12, #e74c3c); 
        transition: width 0.4s ease-out; 
        box-shadow: 0 0 15px rgba(241, 196, 15, 0.8); 
        animation: shimmer 1.5s infinite; 
    }
    
    @keyframes shimmer { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    
    .hit-marker { 
        position: absolute; 
        font-family: 'Press Start 2P', cursive; 
        font-size: 1.8rem; 
        font-weight: bold; 
        z-index: 300; 
        pointer-events: none; 
        animation: hit-pop 1s ease-out forwards; 
        text-shadow: 3px 3px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000; 
    }
    
    .hit-marker.damage { color: #ff4757; }
    .hit-marker.super-effective { 
        color: #2ecc71; 
        font-size: 2.2rem; 
        text-shadow: 0 0 20px #2ecc71, 3px 3px 0 #000; 
    }
    .hit-marker.not-effective { 
        color: #95a5a6; 
        font-size: 1.4rem; 
    }
    
    @keyframes hit-pop { 
        0% { transform: translateY(0) scale(0.5); opacity: 0; } 
        20% { transform: translateY(-10px) scale(1.3); opacity: 1; } 
        100% { transform: translateY(-80px) scale(1); opacity: 0; } 
    }
    
    /* Screen Shake */
    @keyframes shake-screen { 
        0%, 100% { transform: translate(0, 0); } 
        10%, 30%, 50%, 70%, 90% { transform: translate(-4px, 2px); } 
        20%, 40%, 60%, 80% { transform: translate(4px, -2px); } 
    }
    @keyframes shake-screen-strong { 
        0%, 100% { transform: translate(0, 0); } 
        10%, 30%, 50%, 70%, 90% { transform: translate(-7px, 4px); } 
        20%, 40%, 60%, 80% { transform: translate(7px, -4px); } 
    }
    @keyframes arena-pulse {
        0% { filter: brightness(1) saturate(1); }
        50% { filter: brightness(1.15) saturate(1.2); }
        100% { filter: brightness(1) saturate(1); }
    }
    
    .arena.shake { animation: shake-screen 0.4s; }
    .arena.shake-strong { animation: shake-screen-strong 0.45s; }
    .arena.pulse { animation: arena-pulse 0.35s ease-out; }
    
    /* Partículas Melhoradas por Tipo */
    .particle { 
        position: absolute; 
        pointer-events: none; 
        z-index: 250; 
        border-radius: 50%; 
    }
    
    .particle.flame { 
        width: 10px; 
        height: 10px; 
        background: radial-gradient(circle, #f1c40f, #e74c3c); 
        box-shadow: 0 0 15px #e67e22; 
        animation: particle-rise 0.8s ease-out forwards; 
    }
    
    .particle.aqua { 
        width: 8px; 
        height: 12px; 
        background: linear-gradient(180deg, #3498db, #2980b9); 
        box-shadow: 0 0 10px #3498db; 
        border-radius: 50% 50% 50% 0; 
        animation: particle-fall 0.8s ease-in forwards; 
    }
    
    .particle.forest { 
        width: 6px; 
        height: 10px; 
        background: linear-gradient(90deg, #2ecc71, #27ae60); 
        box-shadow: 0 0 10px #2ecc71; 
        border-radius: 50% 0 50% 50%; 
        animation: particle-swirl 1s ease-out forwards; 
    }
    
    .particle.sky { 
        width: 3px; 
        height: 20px; 
        background: linear-gradient(180deg, #fff, #74b9ff); 
        box-shadow: 0 0 15px #74b9ff; 
        border-radius: 2px; 
        animation: particle-lightning 0.3s ease-out forwards; 
    }
    
    .particle.venom { 
        width: 12px; 
        height: 12px; 
        background: radial-gradient(circle, #8e44ad, #9b59b6); 
        box-shadow: 0 0 15px #8e44ad; 
        animation: particle-bubble 1.2s ease-out forwards; 
    }
    
    .particle.beast { 
        width: 10px; 
        height: 10px; 
        background: radial-gradient(circle, #95a5a6, #7f8c8d); 
        box-shadow: 0 0 10px #95a5a6; 
        animation: particle-swirl 1s ease-out forwards; 
    }
    
    .particle.earth { 
        width: 12px; 
        height: 8px; 
        background: linear-gradient(90deg, #d4a574, #a67c52); 
        box-shadow: 0 0 10px #d4a574; 
        border-radius: 20%; 
        animation: particle-fall 0.9s ease-in forwards; 
    }
    
    .particle.metal { 
        width: 8px; 
        height: 8px; 
        background: linear-gradient(135deg, #bdc3c7, #95a5a6); 
        box-shadow: 0 0 15px #bdc3c7, inset 0 0 5px #7f8c8d; 
        animation: particle-swirl 1s ease-out forwards; 
    }
    
    .particle.mystic { 
        width: 10px; 
        height: 10px; 
        background: radial-gradient(circle, #e91e63, #9c27b0); 
        box-shadow: 0 0 20px #e91e63; 
        animation: particle-swirl 1.1s ease-out forwards; 
    }
    
    .particle.shadow { 
        width: 14px; 
        height: 14px; 
        background: radial-gradient(circle, #34495e, #2c3e50); 
        box-shadow: 0 0 20px rgba(0,0,0,0.8); 
        animation: particle-swirl 1s ease-out forwards; 
    }
    
    .move-btn.physical { --accent: #ef6b6b; }
    .move-btn.special { --accent: #5dade2; }
    .move-btn.status { --accent: #b487d6; }
    
    .move-category-badge {
        font-size: 0.55rem;
        padding: 2px 5px;
        border-radius: 4px;
        display: inline-block;
        margin-right: 4px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5f5;
    }
    .move-category-badge.physical { color: #ef6b6b; border-color: rgba(239, 107, 107, 0.5); }
    .move-category-badge.special { color: #5dade2; border-color: rgba(93, 173, 226, 0.5); }
    .move-category-badge.status { color: #b487d6; border-color: rgba(180, 135, 214, 0.5); }
    
    /* === ANIMAÇÕES DE VITÓRIA/DERROTA === */
    .confetti {
        position: fixed;
        pointer-events: none;
        z-index: 980;
        border-radius: 2px;
    }
    
    @keyframes confetti-fall {
        0% {
            opacity: 1;
            transform: translateY(-20px) rotateZ(0deg);
        }
        100% {
            opacity: 0;
            transform: translateY(100vh) rotateZ(720deg);
        }
    }
    
    @keyframes winner-glow {
        0%, 100% {
            filter: drop-shadow(0 0 15px currentColor) brightness(1);
        }
        50% {
            filter: drop-shadow(0 0 35px currentColor) brightness(1.3);
        }
    }
    
    @keyframes float-up {
        0% {
            opacity: 0;
            transform: translateY(30px) scale(0.8);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    
    @keyframes podium-enter {
        0% {
            opacity: 0;
            transform: rotateY(180deg) scale(0.5);
        }
        60% {
            transform: rotateY(-10deg) scale(1.05);
        }
        100% {
            opacity: 1;
            transform: rotateY(0) scale(1);
        }
    }
    
    @keyframes loser-fade {
        0% {
            opacity: 0.6;
            transform: scale(0.9);
        }
        100% {
            opacity: 0.3;
            transform: scale(0.85) translateY(10px);
            filter: grayscale(0.7);
        }
    }
    
    #overlay.victory-show { animation: victory-fade-in 0.35s ease-out forwards; }
    
    @keyframes victory-fade-in { 0% { opacity: 0; backdrop-filter: blur(0px); } 100% { opacity: 1; backdrop-filter: blur(6px); } }
    
    #result-title.animate-in { animation: float-up 0.35s ease-out forwards; }
    
    .winner-box.animate-in { animation: podium-enter 0.4s ease-out forwards; }
    
    .winner-box.animate-in #win-name,
    .winner-box.animate-in #win-name,
    .winner-box.animate-in #win-trainer { animation: none; }
    
    .loser-box.animate-in { animation: loser-fade 0.35s ease-out forwards; }
    
    .btn-restart.animate-in { animation: float-up 0.35s ease-out 0.1s backwards; }
    
    .btn-restart:hover { transform: translateY(-1px); box-shadow: none !important; }
    
    .btn-restart:active { transform: translateY(1px); box-shadow: none !important; }
    
    /* === MELHOR ANIMAÇÃO DE DEPLOY === */
    @keyframes deploy-epic {
        0% {
            opacity: 0;
            transform: scale(0) rotate(-180deg);
            filter: brightness(3) blur(10px);
        }
        50% {
            opacity: 1;
            transform: scale(1.2) rotate(10deg);
            filter: brightness(1.5) blur(2px);
        }
        100% {
            opacity: 1;
            transform: scale(1) rotate(0deg);
            filter: brightness(1) blur(0px);
        }
    }
    
    .sprite.deploy-epic {
        animation: deploy-epic 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    
    @keyframes particle-rise { 
        0% { transform: translateY(0) scale(1); opacity: 1; } 
        100% { transform: translateY(-100px) scale(0.2); opacity: 0; } 
    }
    
    @keyframes particle-fall { 
        0% { transform: translateY(-50px) scale(1); opacity: 1; } 
        100% { transform: translateY(100px) scale(0.5); opacity: 0; } 
    }
    
    @keyframes particle-swirl { 
        0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; } 
        100% { transform: translate(var(--dx, 50px), var(--dy, -80px)) rotate(720deg) scale(0); opacity: 0; } 
    }
    
    @keyframes particle-lightning { 
        0% { transform: translateY(0) scaleY(0); opacity: 1; } 
        50% { transform: translateY(0) scaleY(1); opacity: 1; } 
        100% { transform: translateY(80px) scaleY(0); opacity: 0; } 
    }
    
    @keyframes particle-bubble { 
        0% { transform: translateY(0) scale(0.5); opacity: 1; } 
        50% { transform: translateY(-60px) scale(1); opacity: 0.7; } 
        100% { transform: translateY(-120px) scale(1.5); opacity: 0; } 
    }
</style>
</head>
<body>
    <div id="global-loader">
        <div class="spinner"></div>
        <div class="loading-text">PREPARANDO ARENA...</div>
    </div>

    <div class="arena" id="arena" style="--bgPosX:<%= (Number.isFinite(bgPosX) ? bgPosX : 50) %>; --bgPosY:<%= (Number.isFinite(bgPosY) ? bgPosY : 50) %>; --bgZoom:<%= (Number.isFinite(bgZoom) ? bgZoom : 100) %>;">
        <div class="flash-overlay" id="flashOverlay"></div>
        <div class="status-msg" id="statusMsg" style="display:none; position:absolute; top:50%; width:100%; text-align:center; color:#fff; font-family:'Press Start 2P'; font-size:0.8rem; text-shadow:2px 2px 0 #000; z-index:500;">Aguardando...</div>
        <% if(isSpectator) { %> <div class="spectator-banner">MODO ESPECTADOR - APENAS OBSERVANDO</div> <% } %>

        <div id="bgEditor">
            <h4>AJUSTAR FUNDO DA BATALHA</h4>
            <div class="row">
                <label for="bgPosX">POS X</label>
                <div class="val"><span id="bgPosXVal">50</span>%</div>
            </div>
            <input id="bgPosX" type="range" min="0" max="100" step="1" value="50" />

            <div class="row" style="margin-top:8px;">
                <label for="bgPosY">POS Y</label>
                <div class="val"><span id="bgPosYVal">50</span>%</div>
            </div>
            <input id="bgPosY" type="range" min="0" max="100" step="1" value="50" />

            <div class="row" style="margin-top:8px;">
                <label for="bgZoom">ZOOM</label>
                <div class="val"><span id="bgZoomVal">100</span>%</div>
            </div>
            <input id="bgZoom" type="range" min="50" max="250" step="5" value="100" />

            <div class="btns">
                <button id="bgSave" type="button">SALVAR</button>
                <button id="bgReset" type="button">RESET</button>
                <button id="bgClose" type="button">FECHAR</button>
            </div>
            <div class="hint">Dica: no modo de edição, você pode arrastar o dedo/mouse na arena para ajustar o recorte.</div>
        </div>

        <div class="hud-panel hud-p1">
            <div class="poke-name"><span id="p1-name"><%= p1.name || '???' %></span> <span class="poke-lv">Lv.<span id="p1-lv"><%= (Number.isFinite(p1.level) ? p1.level : (parseInt(p1.level, 10) || 1)) %></span></span></div>
            <div class="trainer-sub"><%= p1.playerName || 'Você' %></div>
            <div class="bar-container"><div class="hp-fill" id="hp-bar-p1"></div></div>
            <div class="stat-text"><span id="hp-val-p1"><%= p1.hp %></span>/<span id="max-hp-p1"><%= p1.maxHp %></span></div>
            <% if(!isSpectator) { %>
                <div class="bar-container" style="height:5px; margin-top:4px; border-color:#555;"><div class="en-fill" id="en-bar-p1"></div></div>
                <div class="stat-text" style="color:#f1c40f; font-size:0.5rem;">EN: <span id="en-val-p1"><%= p1.energy %></span></div>
                <!-- Barra de XP -->
                <div class="bar-container" style="height:4px; margin-top:6px; border-color:#2980b9; background:#1a252f;"><div class="xp-fill" id="xp-bar-p1"></div></div>
                <div class="stat-text" style="color:#3498db; font-size:0.45rem;">XP: <span id="xp-val-p1"><%= p1.xp || 0 %></span>/<span id="xp-max-p1"><%= p1.xpToNext || 100 %></span></div>
            <% } %>
        </div>

        <div class="hud-panel hud-p2">
            <div class="poke-name"><span id="p2-name"><%= p2.name || '???' %></span> <span class="poke-lv">Lv.<span id="p2-lv"><%= (Number.isFinite(p2.level) ? p2.level : (parseInt(p2.level, 10) || 1)) %></span></span></div>
            <% if(battleMode !== 'wild') { %> <div class="trainer-sub"><%= p2.playerName || 'Oponente' %></div>
            <% } else { %> <div class="trainer-sub">Selvagem</div> <% } %>
            <div class="bar-container"><div class="hp-fill" id="hp-bar-p2"></div></div>
            <div class="stat-text" style="text-align:right"><span id="hp-val-p2"><%= p2.hp %></span>/<span id="max-hp-p2"><%= p2.maxHp %></span></div>
        </div>

        <div class="fighter p2-position" id="fighter-p2">
            <div class="command-bubble" id="bubble-p2"></div>
            <div class="trainer" id="trainer-p2" 
                 data-skin="<%= p2.skin || 'char1' %>" 
                  style="<% const p2Skin = (p2 && p2.skin) ? String(p2.skin) : 'char1'; const p2Url = (p2.isCustomSkin || (p2Skin && (p2Skin.startsWith('http') || p2Skin.startsWith('data:')))) ? p2Skin : ((/^char\d+$/i.test(p2Skin)) ? ('/uploads/' + p2Skin + '.png') : ('/skins/' + p2Skin + '.png')); %>background-image: url('<%= p2Url %>');<%= battleMode === 'wild' ? 'opacity:0;' : '' %>">
            </div>
            <div class="sprite" id="sprite-p2">
                <img src="<%= (p2.sprite.startsWith('http') || p2.sprite.startsWith('data:')) ? p2.sprite : '/uploads/' + p2.sprite %>">
            </div>
        </div>

        <div class="fighter p1-position" id="fighter-p1">
            <div class="command-bubble" id="bubble-p1"></div>
            <div class="trainer" id="trainer-p1" data-skin="<%= p1.skin %>" style="<% const p1Skin = (p1 && p1.skin) ? String(p1.skin) : 'char1'; const p1Url = (p1.isCustomSkin || (p1Skin && (p1Skin.startsWith('http') || p1Skin.startsWith('data:')))) ? p1Skin : ((/^char\d+$/i.test(p1Skin)) ? ('/uploads/' + p1Skin + '.png') : ('/skins/' + p1Skin + '.png')); %>background-image: url('<%= p1Url %>');"></div>
            <div class="sprite" id="sprite-p1">
                <img src="<%= (p1.sprite.startsWith('http') || p1.sprite.startsWith('data:')) ? p1.sprite : '/uploads/' + p1.sprite %>">
            </div>
        </div>

        <% if(battleMode === 'wild') { %>
            <div id="floatingBagBtn">
                <div id="floatingBagIcon" class="floating-bag-button" onclick="openBattleBag()">🎒</div>
                <div id="hud-money" class="floating-hud-money">0</div>
            </div>
        <% } %>

        <div id="overlay">
            <div class="victory-container">
                <h1 class="victory-title" id="result-title">VITÓRIA!</h1>
                
                <div class="battle-comparison">
                    <div class="fighter-result winner" id="winner-box">
                        <div class="fighter-crown">👑</div>
                        <div class="fighter-avatar">
                                    <div id="win-trainer" class="trainer victory-trainer" data-skin=""></div>
                        </div>
                        <div class="fighter-name" id="win-name"></div>
                    </div>
                    
                    <div class="vs-badge">VS</div>
                    
                    <div class="fighter-result loser" id="loser-box">
                        <div class="fighter-avatar">
                            <div id="lose-trainer" class="trainer victory-trainer" data-skin=""></div>
                        </div>
                        <div class="fighter-name" id="lose-name"></div>
                    </div>
                </div>
                
                <div class="rewards-section">
                    <div class="rewards-title">RECOMPENSAS</div>
                    <div class="rewards-grid">
                        <div class="reward-item">
                            <div class="reward-icon">💰</div>
                            <div class="reward-text">
                                <div class="reward-label">Créditos</div>
                                <div class="reward-value" id="reward-money">+0</div>
                            </div>
                        </div>
                        <div class="reward-item">
                            <div class="reward-icon">⚡</div>
                            <div class="reward-text">
                                <div class="reward-label">Experiência</div>
                                <div class="reward-value" id="reward-exp">+0</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="xp-bar-container" id="xp-bar-container" style="display:none;">
                        <div class="xp-bar-label">
                            <span>Nível</span>
                            <span class="level-up-badge" id="level-display">5 → 6</span>
                        </div>
                        <div class="xp-bar">
                            <div class="xp-bar-fill" id="xp-bar-fill" style="width:0%"></div>
                        </div>
                    </div>
                </div>
                
                <button type="button" class="btn-restart" onclick="window.location.href='<%= returnUrl %>'">CONTINUAR</button>
            </div>
        </div>
    </div>

    <% if(isSpectator) { %>
        <div id="bleachers"></div>
        <div id="chat-container">
            <input type="text" id="chatInput" placeholder="Chat..." style="width:80%; padding:10px;">
            <button id="chatSend">OK</button>
        </div>
    <% } else { %>
        <div class="bottom-panel">
            <% if (battleMode === 'online' || battleMode === 'manual' || battleMode === 'wild') { %>
                <div class="controls-panel" id="controlsPanel">
                    <div id="action-menu" class="battle-move-menu is-visible">
                        <button class="action-btn action-attack" data-cost="0" onclick="showBattleMoves()">Atacar</button>
                        <button class="action-btn" data-cost="0" onclick="openSwitchSelector(false)">Equipe</button>
                        <button class="action-btn" data-cost="0" onclick="openBattleBag()">Mochila</button>
                        <% if (battleMode === 'wild') { %>
                            <button class="action-btn" data-cost="0" onclick="sendAction('catch')">Capturar</button>
                        <% } %>
                        <button class="action-btn" data-cost="0" onclick="sendAction('run')">Fugir</button>
                    </div>
                    <div id="moves-view" class="battle-move-menu">
                        <button type="button" class="move-btn move-btn-back" onclick="showBattleMenu()">
                            <strong class="move-title"><span>← Voltar</span></strong>
                        </button>
                        <div id="moves-container" class="moves-grid">
                            <% p1.moves.forEach(move => { %>
                                <button class="move-btn <%= move.category || 'physical' %>" data-cost="<%= move.cost || 0 %>" onclick="sendAction('move', '<%= move.id %>')" id="btn-<%= move.id %>">
                                    <strong class="move-title">
                                        <span class="move-category-badge <%= move.category || 'physical' %>"><%= (move.category || 'physical').slice(0,3).toUpperCase() %></span>
                                        <span class="move-type-icon move-type-<%= (move.element || 'beast') %>"></span>
                                        <span><%= move.name %></span>
                                    </strong>
                                    <small><%= move.cost %> EN</small>
                                </button>
                            <% }) %>
                            <% for (let i = p1.moves.length; i < 4; i++) { %>
                                <button class="move-btn move-btn-empty" disabled>
                                    <strong class="move-title"><span>—</span></strong>
                                    <small>—</small>
                                </button>
                            <% } %>
                        </div>
                    </div>
                    <div id="bag-container" class="battle-move-menu">
                        <button type="button" class="move-btn move-btn-back" onclick="closeBattleBag()">
                            <strong class="move-title"><span>← Voltar</span></strong>
                        </button>
                        <div id="bagContent" class="bag-inner"></div>
                    </div>
                </div>
            <% } else { %>
                <div class="battle-log" id="logBox"></div>
            <% } %>
        </div>
    <% } %>

    <div id="switchModal">
        <div class="switch-box">
            <div class="switch-title" id="switchTitle">SEU POKÉMON DESMAIOU!<br>Escolha outro ou desista.</div>
            <div id="switchList" style="text-align:left;"></div>
            <button class="btn-restart" style="background:linear-gradient(180deg, #e74c3c, #c0392b); margin-top:20px; width:100%; box-shadow:none; border:2px solid #900;" onclick="forfeitBattle()">DESISTIR DA BATALHA</button>
        </div>
    </div>

    <script>
        history.pushState(null, null, location.href); window.onpopstate = function () { history.go(1); }; window.onpageshow = function(event) { if (event.persisted) { window.location.reload(); } };
        
        // Usar socket global persistente do common.js
        const socket = window.gameSocket || io();
        const battleMode = "<%= battleMode %>";
        const battleId = "<%= battleId %>";
        const initialData = <%- battleData %>;
        const myRoleId = "<%= myRoleId %>"; 
        const realUserId = "<%= realUserId %>"; 
        const isSpectator = <%= isSpectator ? 'true' : 'false' %>;
        const returnUrl = "<%- returnUrl %>"; 
        
        let p1RawId = <%- JSON.stringify(p1.instanceId || '') %>; 
        let p2RawId = <%- JSON.stringify(p2.instanceId || '') %>;
        let p1Mon = <%- JSON.stringify(p1.name || '') %>; 
        let p2Mon = <%- JSON.stringify(p2.name || '') %>;
        
        let p1CurHp = Number(<%= p1.hp %>); 
        let p2CurHp = Number(<%= p2.hp %>);
        let p1MaxHp = Number(<%= p1.maxHp %>);
        let p2MaxHp = Number(<%= p2.maxHp %>);

        let currentEnergy = parseInt("<%= p1.energy %>");
        let canAct = true; 
        const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));
        function resolveImg(src) { return (src.startsWith('http') || src.startsWith('data:')) ? src : '/uploads/' + src; }

        function resolveSkinUrl(skin) {
            if (!skin) return '';
            try {
                const s = String(skin || '');
                if (s.startsWith('http') || s.startsWith('data:')) return s;
                if (/^char\d+$/i.test(s)) return '/uploads/' + s + '.png';
                return '/skins/' + s + '.png';
            } catch (_) { return ''; }
        }

        function applyTrainerSkin(side, skin) {
            const trainerEl = document.getElementById(`trainer-${side}`);
            if (!trainerEl) return;
            const url = resolveSkinUrl(skin);
            if (skin != null) trainerEl.setAttribute('data-skin', String(skin || ''));
            if (url) trainerEl.style.backgroundImage = `url('${url}')`;
        }

        function applyTrainerName(side, name) {
            try {
                const hud = document.querySelector(`.hud-${side} .trainer-sub`);
                if (!hud) return;
                hud.innerText = name || (side === 'p1' ? 'Você' : 'Oponente');
            } catch (_) {}
        }

        function renderMoveBtnInner(move) {
            const element = (move && move.element) ? String(move.element) : 'beast';
            const name = (move && move.name) ? String(move.name) : '';
            const cost = (move && move.cost != null) ? String(move.cost) : '0';
            const safeEl = element.replace(/[^a-z0-9_-]/gi, '').toLowerCase() || 'beast';
            const title = safeEl.toUpperCase();
            const category = (move && move.category) ? String(move.category) : 'physical';
            const safeCat = category.replace(/[^a-z0-9_-]/gi, '').toLowerCase() || 'physical';
            const catLabel = safeCat.slice(0, 3).toUpperCase();
            return `<strong class="move-title"><span class="move-category-badge ${safeCat}">${catLabel}</span><span class="move-type-icon move-type-${safeEl}" title="${title}"></span><span>${name}</span></strong><small>${cost} EN</small>`;
        }

        function getMoveCategory(move) {
            const category = (move && move.category) ? String(move.category) : 'physical';
            const safeCat = category.replace(/[^a-z0-9_-]/gi, '').toLowerCase();
            return safeCat || 'physical';
        }

        function setHudNameLevel(side, name, level) {
            const nameEl = document.getElementById(`${side}-name`);
            const levelEl = document.getElementById(`${side}-lv`);
            if (nameEl && name) nameEl.innerText = name;
            const levelNum = Number(level);
            if (levelEl && Number.isFinite(levelNum)) levelEl.innerText = levelNum;
        }

        let p1Data = { name: "<%= p1.playerName %>", skin: "<%= p1.skin %>", sprite: resolveImg("<%= p1.sprite %>"), mon: "<%= p1.name %>" };
        let p2Data = { name: "<%= p2.playerName %>", skin: "<%= p2.skin %>", sprite: resolveImg("<%= p2.sprite %>"), mon: "<%= p2.name %>", isCustom: <%= p2.isCustomSkin ? 'true' : 'false' %> };

        if (isSpectator) { socket.emit('join_spectator', { roomId: battleId }); }
        if(battleMode === 'online' && !isSpectator) { socket.emit('join_room', battleId); }

        function getSide(actorId) {
            const aid = String(actorId || '');
            if (aid === String(p1RawId)) return 'p1';
            if (aid === String(p2RawId)) return 'p2';
            if (aid.startsWith('wild_') || aid.startsWith('npc_')) return 'p2';
            return 'p1';
        }

        async function speak(actorId, moveName) {
            const side = getSide(actorId);
            const bubble = document.getElementById(`bubble-${side}`);
            const trainer = document.getElementById(`trainer-${side}`);
            const monName = (side === 'p1') ? p1Mon : p2Mon;
            if(bubble) {
                bubble.innerText = (moveName === 'rest') ? `${monName}, volte!` : `${monName}, ${moveName}!`;
                bubble.classList.add('show');
            }
            if(trainer) { animateTrainerCommand(trainer).catch(()=>{}); }
            await wait(1000); 
            if(bubble) bubble.classList.remove('show');
        }

        async function animateTrainerCommand(trainerEl) {
            try {
                trainerEl.classList.add('frame-1'); await wait(180);
                trainerEl.classList.remove('frame-1'); await wait(120);
                trainerEl.classList.add('frame-1'); await wait(180);
                trainerEl.classList.remove('frame-1');
            } catch (e) {}
        }
        
        async function animateThrow(trainerEl) {
            if (!trainerEl) return;
            trainerEl.classList.add('frame-1');
            await wait(250); 
            trainerEl.classList.remove('frame-1'); 
        }

        async function returnPokemon(side) {
            const fighterDiv = document.getElementById(`fighter-${side}`);
            const spriteImg = document.querySelector(`#sprite-${side} img`);
            const trainer = document.getElementById(`trainer-${side}`);
            const sprite = document.getElementById(`sprite-${side}`);
            
            if(!spriteImg || !fighterDiv || !trainer || !sprite) return;

            if (side === 'p2' && battleMode === 'wild') {
                spriteImg.classList.add('anim-faint-wild');
                await wait(1000);
                return;
            }

            spriteImg.style.opacity = ''; spriteImg.style.transform = '';
            void spriteImg.offsetWidth;
            spriteImg.classList.add('anim-recall'); 
            
            await wait(600);

            const ball = document.createElement('div'); ball.className = 'deploy-ball';
            fighterDiv.appendChild(ball);

            const tRect = trainer.getBoundingClientRect(); const mRect = sprite.getBoundingClientRect(); const fRect = fighterDiv.getBoundingClientRect();
            const startX = (mRect.left - fRect.left) + (mRect.width / 2) - 10;
            const startY = (mRect.top - fRect.top) + (mRect.height / 2) + 20;
            const handOffsetX = (side === 'p1') ? (tRect.width * 0.8) : (tRect.width * 0.2);
            const endX = (tRect.left - fRect.left) + handOffsetX;
            const endY = (tRect.top - fRect.top) + (tRect.height * 0.5);

            ball.style.left = startX + 'px'; ball.style.top = startY + 'px';

            const deltaX = endX - startX; const deltaY = endY - startY;
            await ball.animate([{ transform: 'translate(0,0) scale(0.6)', opacity: 1 }, { transform: `translate(${deltaX * 0.5}px, ${deltaY - 30}px) scale(0.6)`, offset: 0.5 }, { transform: `translate(${deltaX}px, ${deltaY}px) scale(0)`, opacity: 0 }], { duration: 550, easing: 'ease-in-out', fill: 'forwards' }).finished;
            ball.remove();
        }

        // --- FUNÇÃO DE DEPLOY ROBUSTA ---
        async function deployPokemon(side, isWild = false) {
            const fighterDiv = document.getElementById(`fighter-${side}`);
            const spriteDiv = document.getElementById(`sprite-${side}`);
            const spriteImg = spriteDiv ? spriteDiv.querySelector('img') : null;
            const trainerDiv = document.getElementById(`trainer-${side}`);

            if (!spriteImg || !fighterDiv) return;

            try {
                // Limpa estados anteriores
                spriteImg.classList.remove('anim-pop-out', 'anim-wild-appear', 'anim-recall', 'anim-faint-wild');
                spriteImg.style.opacity = '0'; 
                spriteImg.style.filter = ''; spriteImg.style.transform = '';

                if (isWild) {
                    await wait(300);
                    spriteImg.classList.add('anim-wild-appear');
                    // Garante visibilidade no próximo frame
                    requestAnimationFrame(() => spriteImg.style.opacity = '1'); 
                    return;
                }

                if (trainerDiv) animateThrow(trainerDiv);
                await wait(200);

                const ball = document.createElement('div'); ball.className = 'deploy-ball';
                fighterDiv.appendChild(ball);

                const tRect = trainerDiv.getBoundingClientRect(); const mRect = spriteDiv.getBoundingClientRect(); const fRect = fighterDiv.getBoundingClientRect();
                const handOffsetX = (side === 'p1') ? (tRect.width * 0.8) : (tRect.width * 0.2);
                let startX = (tRect.left - fRect.left) + handOffsetX; 
                let startY = (tRect.top - fRect.top) + (tRect.height * 0.5);
                let endX = (mRect.left - fRect.left) + (mRect.width / 2) - 10;
                let endY = (mRect.top - fRect.top) + (mRect.height / 2) + 20;

                ball.style.left = startX + 'px'; ball.style.top = startY + 'px';
                await wait(50);

                const deltaX = endX - startX; const deltaY = endY - startY;
                
                // Animação da pokebola com tratamento de erro (caso falhe, não para o script)
                try {
                    await ball.animate([{ transform: 'translate(0, 0) scale(0.5)' }, { transform: `translate(${deltaX * 0.5}px, ${deltaY - 80}px) scale(0.8)`, offset: 0.5 }, { transform: `translate(${deltaX}px, ${deltaY}px) scale(0.6)` }], { duration: 450, easing: 'linear', fill: 'forwards' }).finished;
                } catch(e) {}
                
                ball.remove();
                
                // Aplicar animação épica de deploy (sem partículas)
                spriteImg.classList.add('deploy-epic');
            
            } catch(e) {
                console.error("Erro na animação deploy", e);
            } finally {
                // GARANTIA FINAL: Se algo der errado, torna o pokemon visível
                setTimeout(() => { 
                    if(spriteImg) spriteImg.style.opacity = '1'; 
                }, 50);
            }
        }

        function createProjectile(fromSide, toSide, cssClass) {
            const fromEl = document.getElementById(`sprite-${fromSide}`);
            const toEl = document.getElementById(`sprite-${toSide}`);
            if(!fromEl || !toEl) return;
            const rf = fromEl.getBoundingClientRect(); const rt = toEl.getBoundingClientRect();
            const sX = rf.left + rf.width / 2, sY = rf.top + rf.height / 2;
            const eX = rt.left + rt.width / 2, eY = rt.top + rt.height / 2;
            const part = document.createElement('div'); part.className = `atk-particle ${cssClass}`;
            part.style.left = sX + 'px'; part.style.top = sY + 'px';
            part.style.setProperty('--tx', (eX - sX) + 'px'); part.style.setProperty('--ty', (eY - sY) + 'px');
            document.body.appendChild(part); setTimeout(() => part.remove(), 500);
        }

        function createImpact(targetSide, cssClass, customX = null, customY = null) {
            const spriteEl = document.getElementById(`sprite-${targetSide}`);
            const fighterDiv = document.getElementById(`fighter-${targetSide}`);
            if(!spriteEl && !fighterDiv) return;

            const impact = document.createElement('div'); impact.className = `impact-effect impact-pop ${cssClass}`;
            const parent = document.body;

            if (customX !== null && customY !== null) {
                impact.style.left = (customX - 60) + 'px';
                impact.style.top = (customY - 60) + 'px';
                parent.appendChild(impact);
            } else {
                const ref = (fighterDiv || spriteEl).getBoundingClientRect();
                const centerX = ref.left + ref.width / 2;
                const centerY = ref.top + ref.height / 2 + 12; // levemente mais baixo
                impact.style.left = (centerX - 60) + 'px';
                impact.style.top = (centerY - 60) + 'px';
                parent.appendChild(impact);
            }
            setTimeout(() => impact.remove(), 500);
        }

        function playMoveAnimation(attackerSide, defenderSide, type, category, moveType) {
            try { console.debug('[Anim]', { attackerSide, defenderSide, type }); } catch(e) {}
            const atkSprite = document.getElementById(`sprite-${attackerSide}`);
            const defSprite = document.getElementById(`sprite-${defenderSide}`);
            if(!atkSprite) return;
            const atkImg = atkSprite.querySelector('img');
            const defImg = defSprite ? defSprite.querySelector('img') : null;
            if(atkImg) {
                atkImg.classList.remove('attack','hurt','shake');
                atkImg.classList.add('attack');
                setTimeout(() => { try { if(atkImg) atkImg.classList.remove('attack'); } catch(e){} }, 360);
            }
            if (category === 'special') {
                const elemClass = `effect-${(type || 'beast').toLowerCase()}`;
                setTimeout(() => { createProjectile(attackerSide, defenderSide, elemClass); }, 100);
                pulseArena();
            }
            if(defImg) {
                setTimeout(() => {
                    try {
                        if(!defImg) return;
                        defImg.classList.remove('hurt','shake');
                        defImg.classList.add('shake'); 
                        setTimeout(() => { try { if(defImg) { defImg.classList.remove('shake'); } } catch(e){} }, 420);
                    } catch(e) {}
                }, 220);
            }
        }

        function updateBar(actorId, cur, max, type) { 
            const side = getSide(actorId);
            const pct = Math.max(0, (cur / max) * 100); 
            const fill = document.getElementById(`${type}-bar-${side}`); 
            if(fill) {
                fill.style.width = pct + '%'; 
                if(type === 'hp') {
                    const txt = document.getElementById(`hp-val-${side}`);
                    const maxTxt = document.getElementById(`max-hp-${side}`); 
                    if(txt) txt.innerText = Math.max(0, cur);
                    if(maxTxt) maxTxt.innerText = max;
                }
                // Atualizar XP
                if(type === 'xp' && side === 'p1' && !isSpectator) {
                    const xpTxt = document.getElementById('xp-val-p1');
                    const xpMaxTxt = document.getElementById('xp-max-p1');
                    if(xpTxt) xpTxt.innerText = Math.floor(cur);
                    if(xpMaxTxt) xpMaxTxt.innerText = Math.floor(max);
                }
            }
            if(type === 'hp') { if(side === 'p1') p1CurHp = Number(cur); else p2CurHp = Number(cur); }
            if(type === 'en' && side === 'p1' && !isSpectator) { currentEnergy = cur; document.getElementById('en-val-p1').innerText = cur; updateButtons(); } 
        }

        function updateButtons() { 
            if(isSpectator) return; 
            document.querySelectorAll('.move-btn:not(.rest-btn)').forEach(btn => { 
                const small = btn.querySelector('small');
                if(small) { const cost = parseInt(small.innerText); btn.disabled = (currentEnergy < cost); }
            }); 
        }
        
        function setControlsState(enabled) { 
            if(isSpectator) return; 
            const panel = document.getElementById('controlsPanel'); if(!panel) return; 
            panel.style.opacity = enabled ? "1" : "0.5"; 
            const btns = panel.querySelectorAll('button'); btns.forEach(b => b.disabled = !enabled); 
            canAct = !!enabled;
            if(enabled) updateButtons(); 
        }
        
        async function playEvents(events) { 
            let lastMoveElement = 'beast';
            for (let evt of events) { 
                if (evt.type === 'INIT') continue; 
                const actorIdRaw = evt.actorId || evt.attackerId || evt.attacker || evt.actor || null;
                const targetIdRaw = evt.targetId || evt.target || evt.defenderId || evt.defender || null;

                if (evt.type === 'MSG') {
                    try { if(evt.text) showToast(evt.text); } catch(e) {}
                    const lb = document.getElementById('logBox'); if(lb) { const div = document.createElement('div'); div.className = 'log-entry'; div.innerText = evt.text; lb.appendChild(div); lb.scrollTop = lb.scrollHeight; }
                    await wait(200); continue;
                }
                const actorSide = getSide(actorIdRaw); const targetSide = getSide(targetIdRaw);

                if (evt.type === 'USE_MOVE') { 
                    lastMoveElement = evt.moveElement || 'beast';
                    if (battleMode === 'wild' && actorSide === 'p2') { await wait(500); } 
                    else { await speak(actorIdRaw, evt.moveName); }
                    playMoveAnimation(actorSide, targetSide, evt.moveElement || 'beast', evt.moveCategory, evt.moveType);
                    if(!isSpectator && actorSide === 'p1') updateBar(actorIdRaw, evt.newEnergy, <%= energyConfig.maxEnergy %>, 'en'); 
                    await wait(300); 
                } else if (evt.type === 'ATTACK_HIT') { 
                    createImpact(targetSide, `effect-${lastMoveElement.toLowerCase()}`);
                    triggerImpactFlash(evt.damage > 80 ? 'strong' : 'soft');
                    
                    // Hit Marker simples
                    const hitMarker = document.createElement('div');
                    hitMarker.className = 'hit-marker damage';
                    hitMarker.innerText = `-${evt.damage}`;
                    
                    if (evt.isEffective) {
                        hitMarker.classList.add('super-effective');
                        hitMarker.innerText += ' ⚡';
                    } else if (evt.isNotEffective) {
                        hitMarker.classList.add('not-effective');
                    }
                    
                    const fighter = document.getElementById(`fighter-${targetSide}`);
                    if (fighter) {
                        const fRect = fighter.getBoundingClientRect();
                        hitMarker.style.left = (fRect.left + fRect.width / 2 - 35) + 'px';
                        hitMarker.style.top = (fRect.top + fRect.height / 2 + 28) + 'px';
                    }
                    
                    document.body.appendChild(hitMarker);
                    setTimeout(() => hitMarker.remove(), 1500);
                    
                    // Screen Shake em ataques fortes
                    if (evt.damage > 80) {
                        screenShake('strong');
                        if (navigator.vibrate) {
                            navigator.vibrate([30, 10, 30]);
                        }
                    } else if (evt.damage > 40) {
                        screenShake();
                    }
                    
                    // Partículas melhoradas por tipo
                    const fxLevel = evt.damage > 80 ? 3 : (evt.isEffective ? 2 : 1);
                    createParticles(targetSide, lastMoveElement.toLowerCase(), fxLevel);
                    
                    await wait(500);
                    const maxHp = (targetSide === 'p1') ? p1MaxHp : p2MaxHp; 
                    updateBar(targetIdRaw, evt.newHp, maxHp, 'hp'); 
                    if (evt.newHp <= 0) { await wait(200); await returnPokemon(targetSide); } await wait(500);
                } else if (evt.type === 'HEAL') { 
                    await speak(actorIdRaw, 'Cura'); updateBar(actorIdRaw, evt.newHp, (actorSide === 'p1' ? p1MaxHp : p2MaxHp), 'hp'); 
                    const txt = document.createElement('div'); txt.className = 'floating-text heal-text'; txt.innerText = `+${evt.amount}`; 
                    document.getElementById(`fighter-${actorSide}`).appendChild(txt); setTimeout(() => txt.remove(), 1000); await wait(500); 
                } 
                else if (evt.type === 'STATUS_DAMAGE') {
                    const fd = document.getElementById(`fighter-${targetSide}`);
                    const t = document.createElement('div'); t.className = 'floating-text status-text'; t.innerText = `-${evt.damage}`; fd.appendChild(t); setTimeout(() => t.remove(), 1000);
                    const maxHp = (targetSide === 'p1') ? p1MaxHp : p2MaxHp; 
                    updateBar(targetIdRaw, evt.newHp, maxHp, 'hp');
                    if (evt.newHp <= 0) { await wait(200); await returnPokemon(targetSide); } await wait(800);
                }
                else if (evt.type === 'REST') {
                    await speak(actorIdRaw, 'rest');
                    if(actorSide === 'p1' && !isSpectator) updateBar(actorIdRaw, evt.newEnergy, <%= energyConfig.maxEnergy %>, 'en');
                    const txt = document.createElement('div'); txt.className = 'floating-text heal-text'; txt.innerText = `+${<%= energyConfig.restBonus %>} EN`; txt.style.color = "#f1c40f";
                    document.getElementById(`fighter-${actorSide}`).appendChild(txt); setTimeout(() => txt.remove(), 1000); await wait(500);
                }
                else if (evt.type === 'ENERGY_RESTORED') {
                    // Regeneração de energia no início do turno
                    if (!isSpectator) {
                        updateBar(p1RawId, evt.p1Energy, <%= energyConfig.maxEnergy %>, 'en');
                        
                        // Efeito visual de regeneração
                        const txt = document.createElement('div'); 
                        txt.className = 'floating-text heal-text'; 
                        txt.innerText = `⚡+${evt.restored} EN`; 
                        txt.style.color = "#3498db";
                        document.getElementById('fighter-p1').appendChild(txt); 
                        setTimeout(() => txt.remove(), 800);
                    }
                    await wait(300);
                }
                else if (evt.type === 'SWITCH_ANIM') {
                    const side = (evt.side === 'p1') ? 'p1' : 'p2';
                    const bubble = document.getElementById(`bubble-${side}`);
                    if(bubble) {
                        bubble.innerText = `Volte! Vai ${evt.newName}!`;
                        bubble.classList.add('show');
                        setTimeout(() => bubble.classList.remove('show'), 1500);
                    }
                    await returnPokemon(side);
                    await wait(500);
                }
            } 
        }

        function playCaptureAnimation(targetId, resultPromise) {
            return new Promise(async (resolve) => {
                let ball = null;
                try {
                    const side = getSide(targetId); const targetSprite = document.getElementById(`sprite-${side}`); const trainerEl = document.getElementById('trainer-p1');
                    if(!targetSprite || !trainerEl) { 
                        // Se elementos não existem, só espera o request e retorna.
                        try { return resolve(await resultPromise); } catch(e){ return resolve(null); }
                    }

                    // 1. SETUP E ANIMAÇÃO DE ARREMESSO IMEDIATA
                    const tRect = trainerEl.getBoundingClientRect(); const startX = tRect.left + (tRect.width * 0.8), startY = tRect.top + (tRect.height * 0.4);
                    const mRect = targetSprite.getBoundingClientRect(); const targetX = mRect.left + (mRect.width / 2) - 10, targetY = mRect.top + (mRect.height / 2) - 10;
                    animateThrow(trainerEl); await wait(150);
                    
                    ball = document.createElement('div'); ball.className = 'catchball'; ball.style.left = startX + 'px'; ball.style.top = startY + 'px'; document.body.appendChild(ball);
                    const deltaX = targetX - startX, deltaY = targetY - startY;
                    
                    // Bola viaja até o monstro
                    await ball.animate([
                        { transform: `translate(0, 0) rotate(0deg) scale(0.6)` }, 
                        { transform: `translate(${deltaX * 0.6}px, ${deltaY - 150}px) rotate(360deg) scale(0.7)`, offset: 0.6 }, 
                        { transform: `translate(${deltaX}px, ${deltaY}px) rotate(720deg) scale(0.6)` }
                    ], { duration: 600, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)', fill: 'forwards' }).finished;

                    // 2. AGUARDAR RESPOSTA DO SERVIDOR 
                    let data;
                    try { data = await resultPromise; } catch(e) { if(ball) ball.remove(); resolve(null); return; }

                    if (!data || !data.threw) {
                        // Não gastou a bola ou erro (status msg)
                        const bounceAnim = ball.animate([
                            { transform: `translate(${deltaX}px, ${deltaY}px) rotate(720deg) scale(0.6)`, opacity: 1 }, 
                            { transform: `translate(${deltaX - 40}px, ${deltaY + 40}px) rotate(600deg) scale(0.6)`, opacity: 0 }
                        ], { duration: 300, easing: 'ease-out', fill: 'forwards' });
                        await bounceAnim.finished;
                        if(ball) ball.remove();
                        resolve(data);
                        return;
                    }
                    
                    const isSuccessful = data.captured;
                    const numShakes = (typeof data.shakes === 'number') ? data.shakes : (isSuccessful ? 3 : 0);

                    // 3. EFEITO DE ABSORÇÃO
                    const flash = document.getElementById('flashOverlay'); 
                    if(flash) flash.classList.add('active'); 
                    setTimeout(() => flash && flash.classList.remove('active'), 150);
                    targetSprite.classList.add('absorbed-state'); 
                    await wait(200);

                    // 4. BOLA CAI NO CHÃO
                    const groundY = mRect.bottom - 50; 
                    const dropDistY = groundY - targetY; 
                    const finalTX = deltaX;
                    const finalTY = deltaY + dropDistY;

                    await ball.animate([
                        { transform: `translate(${deltaX}px, ${deltaY}px) rotate(720deg) scale(0.6)` }, 
                        { transform: `translate(${finalTX}px, ${finalTY}px) rotate(720deg) scale(0.6)` }
                    ], { duration: 350, easing: 'ease-in', fill: 'forwards' }).finished;
                    
                    // 5. SHAKES (Baseado nos dados reais)
                    const doShake = async () => {
                         await ball.animate([
                            { transform: `translate(${finalTX}px, ${finalTY}px) scale(0.6) rotate(0deg)` }, 
                            { transform: `translate(${finalTX}px, ${finalTY}px) scale(0.6) rotate(-25deg)`, offset: 0.25 }, 
                            { transform: `translate(${finalTX}px, ${finalTY}px) scale(0.6) rotate(25deg)`, offset: 0.75 }, 
                            { transform: `translate(${finalTX}px, ${finalTY}px) scale(0.6) rotate(0deg)` }
                        ], { duration: 400 }).finished;
                        await wait(500);
                    };

                    const shakesToAnim = Math.min(numShakes, 3);
                    for(let i=0; i<shakesToAnim; i++) { await doShake(); }

                    if (isSuccessful) {
                        ball.classList.add('captured-lock');
                        const ballVisualX = startX + finalTX;
                        const ballVisualY = startY + finalTY;
                        for(let i=0; i<3; i++) { 
                            const s = document.createElement('div'); s.className = 'capture-star'; s.innerText = '★'; 
                            s.style.left = (ballVisualX + 10 + (i*15 - 15)) + 'px'; s.style.top = (ballVisualY - 20) + 'px'; 
                            document.body.appendChild(s); 
                            setTimeout(() => s.remove(), 700); 
                            await wait(100); 
                        }
                        await wait(800); 
                    } else {
                        // Falha
                        const bounceAnim = ball.animate([
                            { transform: `translate(${finalTX}px, ${finalTY}px) rotate(720deg) scale(0.6)`, opacity: 1 }, 
                            { transform: `translate(${finalTX - 80}px, ${finalTY - 100}px) rotate(600deg) scale(0.6)`, opacity: 0 }
                        ], { duration: 450, easing: 'ease-out', fill: 'forwards' });
                        targetSprite.style.filter = "brightness(2) sepia(1) hue-rotate(-50deg) saturate(5)"; 
                        setTimeout(() => targetSprite.style.filter = "", 150);
                        await bounceAnim.finished; 
                        targetSprite.classList.remove('absorbed-state');
                        if(ball) ball.remove(); 
                    }
                    resolve(data);

                } catch (e) { console.error(e); if(ball) ball.remove(); resolve(null); }
            });
        }

        async function sendAction(type, moveId) { 
            if (!canAct) return; 
            setControlsState(false); 
            if (battleMode === 'online') { 
                if (type === 'move') { 
                    document.getElementById('statusMsg').innerText = "Aguardando oponente..."; 
                    document.getElementById('statusMsg').style.display = "block"; 
                    socket.emit('online_action', { roomId: battleId, action: 'move', value: moveId, playerId: realUserId }); 
                } else if (type === 'run') {
                    document.getElementById('statusMsg').innerText = "Desistindo..."; 
                    document.getElementById('statusMsg').style.display = "block"; 
                    socket.emit('online_action', { roomId: battleId, action: 'forfeit', value: '', playerId: realUserId }); 
                }
            } else { 
                const res = await fetch('/api/turn', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ battleId, action: type, moveId }) }); 
                const data = await res.json(); 
                
                if (data.switched) {
                    if (data.p2Switched) {
                        if (data.events) await playEvents(data.events);
                        await wait(500);
                        p2RawId = data.p2State.instanceId;
                        p2Mon = data.p2State.name;
                        p2CurHp = data.p2State.hp;
                        p2MaxHp = data.p2State.maxHp;
                        p2Data.name = data.p2State.playerName;
                        p2Data.sprite = resolveImg(data.p2State.sprite);
                        p2Data.mon = data.p2State.name;
                        p2Data.skin = data.p2State.skin;
                        applyTrainerName('p2', data.p2State.playerName);
                        applyTrainerSkin('p2', data.p2State.skin);
                        setHudNameLevel('p2', p2Mon, data.p2State.level);
                        document.getElementById('max-hp-p2').innerText = p2MaxHp;
                        const s2 = document.querySelector('#sprite-p2 img');
                        s2.src = resolveImg(data.p2State.sprite);
                        deployPokemon('p2', false);
                        updateBar(p2RawId, p2CurHp, p2MaxHp, 'hp');
                    } else {
                        await wait(500);
                        p1RawId = data.newP1Id; 
                        p1Mon = data.p1State.name; 
                        p1CurHp = data.p1State.hp; 
                        p1MaxHp = data.p1State.maxHp; 
                        currentEnergy = data.p1State.energy;
                        applyTrainerName('p1', data.p1State.playerName);
                        applyTrainerSkin('p1', data.p1State.skin);
                        setHudNameLevel('p1', p1Mon, data.p1State.level);
                        document.getElementById('max-hp-p1').innerText = data.p1State.maxHp;
                        document.querySelector('#sprite-p1 img').src = resolveImg(data.p1State.sprite); 
                        deployPokemon('p1', false); 
                        updateBar(p1RawId, p1CurHp, data.p1State.maxHp, 'hp'); 
                        updateBar(p1RawId, currentEnergy, 100, 'en'); 
                        const mc = document.getElementById('moves-container'); mc.innerHTML = ''; 
                        data.p1State.moves.forEach(move => { 
                            const btn = document.createElement('button'); btn.className = `move-btn ${getMoveCategory(move)}`; 
                            btn.onclick = () => sendAction('move', move.id); 
                            btn.innerHTML = renderMoveBtnInner(move);
                            mc.appendChild(btn); 
                        });
                        if (data.events) await playEvents(data.events); 
                    }
                    setControlsState(true); 
                    showBattleMenu();
                    return; 
                }
                
                // Se servidor informou npcDefeatedId, atualiza lista local e solicita disengage
                if (data && data.npcDefeatedId) {
                    try {
                        const nid = String(data.npcDefeatedId);
                        if (typeof window !== 'undefined' && typeof window.markNpcDefeated === 'function') {
                            try { window.markNpcDefeated(nid); } catch (_) { /* ignore */ }
                        } else {
                            window.DEFEATED_NPCS = Array.isArray(window.DEFEATED_NPCS) ? window.DEFEATED_NPCS : [];
                            if (!window.DEFEATED_NPCS.includes(nid)) window.DEFEATED_NPCS.push(nid);
                            try { fetch('/api/npc/disengage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ npcId: nid }) }).catch(()=>{}); } catch(_) {}
                        }
                    } catch(_) {}
                }

                if (type === 'catch' && data && data.threw) await playCaptureAnimation(p2RawId, data.captured, data.shakes || 0);
                if (data.events) await playEvents(data.events); 
                if (data && data.npcDefeatedId) {
                    try {
                        const nid = String(data.npcDefeatedId);
                        if (typeof window !== 'undefined' && typeof window.markNpcDefeated === 'function') {
                            try { window.markNpcDefeated(nid); } catch (_) {}
                        } else {
                            window.DEFEATED_NPCS = Array.isArray(window.DEFEATED_NPCS) ? window.DEFEATED_NPCS : [];
                            if (!window.DEFEATED_NPCS.includes(nid)) window.DEFEATED_NPCS.push(nid);
                        }
                    } catch (e) {}
                }
                if (data.forceSwitch) { showSwitchModal(data.switchable, true); return; }
                if(data.captured) { showToast('Capturado!'); setTimeout(() => { window.location.href = returnUrl; }, 1000); return; }
                else if (data.fled) { showToast("Fugiu!"); window.location.href = returnUrl; } 
                else if(data.finished) { endGame(data.winnerId, data); } 
                else { 
                    if (data.p1State) {
                        updateBar(p1RawId, data.p1State.hp, p1MaxHp, 'hp'); 
                        if(data.p1State.energy !== undefined) {
                            updateBar(p1RawId, data.p1State.energy, <%= energyConfig.maxEnergy %>, 'en');
                        }
                        // ATUALIZAR XP BAR
                        if(data.p1State.xp !== undefined && data.p1State.xpToNext !== undefined) {
                            updateBar(p1RawId, data.p1State.xp, data.p1State.xpToNext, 'xp');
                        }
                    }
                    if (data.p2State) updateBar(p2RawId, data.p2State.hp, p2MaxHp, 'hp'); 
                    setControlsState(true); 
                    showBattleMenu();
                } 
            } 
        }

        async function fetchSwitchableTeam() {
            const res = await fetch('/api/me?userId=' + encodeURIComponent(realUserId));
            const data = await res.json().catch(() => ({}));
            const team = Array.isArray(data && data.team) ? data.team : [];
            return team.filter(p => p && Number(p.hp) > 0 && String(p.instanceId || '') !== String(p1RawId || ''));
        }

        function showSwitchModal(list, isForced = false) {
            const modal = document.getElementById('switchModal');
            const listDiv = document.getElementById('switchList');
            const title = document.getElementById('switchTitle');
            const forfeitBtn = document.querySelector('#switchModal .btn-restart');
            listDiv.innerHTML = '';

            if (title) {
                title.innerHTML = isForced
                    ? 'SEU POKÉMON DESMAIOU!<br>Escolha outro ou desista.'
                    : 'ESCOLHA UM MONSTRO PARA TROCAR<br><span style="font-size:0.7rem;color:#cfd8e3">Você perde este turno.</span>';
            }
            if (forfeitBtn) forfeitBtn.style.display = isForced ? 'block' : 'none';
            
            list.forEach(p => {
                const item = document.createElement('div');
                item.className = 'switch-item';
                item.innerHTML = `<img src="${resolveImg(p.sprite)}" class="switch-sprite"> <div><div style="color:#f1c40f;font-weight:bold;">${p.name} <span style="font-size:0.7rem;color:#ccc">Lv.${p.level}</span></div><div style="font-size:0.7rem;">HP: ${p.hp}/${p.maxHp}</div></div>`;
                item.onclick = () => performSwitch(p.instanceId, !!isForced);
                listDiv.appendChild(item);
            });
            modal.style.display = 'flex';
        }

        async function openSwitchSelector(isForced = false) {
            try {
                if (isSpectator || (!isForced && !canAct)) return;
                const list = await fetchSwitchableTeam();
                if (!Array.isArray(list) || list.length === 0) {
                    if (typeof showToast === 'function') showToast('Sem monstros disponíveis para troca.', { bg: '#e74c3c' });
                    return;
                }
                showSwitchModal(list, !!isForced);
            } catch (_) {
                if (typeof showToast === 'function') showToast('Erro ao carregar time para troca.', { bg: '#e74c3c' });
            }
        }

        async function performSwitch(newPokeId, isForced = false) {
            document.getElementById('switchModal').style.display = 'none';
            if (!isForced) setControlsState(false);
            
            if (battleMode === 'online') {
                socket.emit('online_action', { 
                    roomId: battleId, 
                    action: 'switch', 
                    value: newPokeId, 
                    playerId: realUserId 
                });
                document.getElementById('statusMsg').innerText = "Aguardando oponente..."; 
                document.getElementById('statusMsg').style.display = "block";
            } else {
                const res = await fetch('/api/turn', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ battleId, action: 'switch', moveId: newPokeId, isForced }) 
                }); 
                const data = await res.json();
                if (!isForced) {
                    p1RawId = data.newP1Id; p1Mon = data.p1State.name; p1CurHp = data.p1State.hp; p1MaxHp = data.p1State.maxHp; currentEnergy = data.p1State.energy;
                    setHudNameLevel('p1', p1Mon, data.p1State.level); document.getElementById('max-hp-p1').innerText = data.p1State.maxHp;
                    document.querySelector('#sprite-p1 img').src = resolveImg(data.p1State.sprite); 
                    deployPokemon('p1', false); 
                    updateBar(p1RawId, p1CurHp, data.p1State.maxHp, 'hp'); 
                    updateBar(p1RawId, currentEnergy, 100, 'en'); 
                    const mc = document.getElementById('moves-container'); mc.innerHTML = ''; 
                    data.p1State.moves.forEach(move => { 
                        const btn = document.createElement('button'); btn.className = `move-btn ${getMoveCategory(move)}`; 
                        btn.onclick = () => sendAction('move', move.id); 
                        btn.innerHTML = renderMoveBtnInner(move);
                        mc.appendChild(btn); 
                    });
                    if (data.events) await playEvents(data.events); 
                }
                setControlsState(true);
            }
        }

        function forfeitBattle() {
            document.getElementById('switchModal').style.display = 'none';
            if (battleMode === 'online') {
                socket.emit('online_action', { 
                    roomId: battleId, 
                    action: 'forfeit', 
                    playerId: realUserId 
                });
            } else {
                endGame(p2RawId); 
            }
        }

        let __battleEnded = false;
        function endGame(winnerId, srvData = {}) { 
            if (__battleEnded) return;
            __battleEnded = true;
            if (battleMode === 'wild') { showToast("Batalha finalizada!"); window.location.href = returnUrl; return; }

            const bottomPanel = document.querySelector('.bottom-panel'); if(bottomPanel) bottomPanel.style.display = 'none'; 
            const overlay = document.getElementById('overlay'); 
            const title = document.getElementById('result-title'); 
            const winName = document.getElementById('win-name'); 
            const loseName = document.getElementById('lose-name'); 
            const winMon = document.getElementById('win-trainer'); 
            const loseMon = document.getElementById('lose-trainer'); 
            const rewardMoney = document.getElementById('reward-money');
            const rewardExp = document.getElementById('reward-exp');
            const xpContainer = document.getElementById('xp-bar-container');
            const xpFill = document.getElementById('xp-bar-fill');
            const levelDisplay = document.getElementById('level-display');
            
            let isP1Win = false;
            if (battleMode === 'online') { isP1Win = (String(winnerId) === String(realUserId)); } 
            else { isP1Win = (String(winnerId) === String(p1RawId)); }

            const winner = isP1Win ? p1Data : p2Data; 
            const loser = isP1Win ? p2Data : p1Data; 
            
            // Mostrar treinadores na tela de vitória (usar skin do jogador/treinador)
            function resolveSkinUrl(skin) {
                if (!skin) return '';
                try {
                    const s = String(skin || '');
                    if (s.startsWith('http') || s.startsWith('data:')) return s;
                    if (/^char\d+$/i.test(s)) return '/uploads/' + s + '.png';
                    return '/skins/' + s + '.png';
                } catch (e) { return '' }
            }

            winName.innerText = winner.name || winner.mon || '';
            loseName.innerText = loser.name || loser.mon || '';
            // substitui as imagens dos monstros pelas imagens dos treinadores
            const winAvatar = resolveSkinUrl(winner.skin || winner.playerSkin || '');
            const loseAvatar = resolveSkinUrl(loser.skin || loser.playerSkin || '');
            if (winMon) {
                winMon.style.backgroundImage = `url('${winAvatar || resolveImg(winner.sprite)}')`;
                winMon.style.backgroundPositionX = '0%';
                // Forçar treinador olhando para frente/baixo na tela de vitória
                winMon.style.backgroundPositionY = '66.66%';
                winMon.setAttribute('data-skin', winner.skin || '');
            }
            if (loseMon) {
                loseMon.style.backgroundImage = `url('${loseAvatar || resolveImg(loser.sprite)}')`;
                loseMon.style.backgroundPositionX = '0%';
                // Forçar treinador olhando para frente/baixo na tela de derrota
                loseMon.style.backgroundPositionY = '66.66%';
                loseMon.setAttribute('data-skin', loser.skin || '');
            }
            
            // Recompensas: prefere valores do servidor quando disponíveis
            const moneyReward = (srvData && (srvData.moneyReward !== undefined)) ? Number(srvData.moneyReward) : Math.floor(Math.random() * 200) + 100;
            const expReward = (srvData && (srvData.expReward !== undefined)) ? Number(srvData.expReward) : Math.floor(Math.random() * 100) + 50;
            
            if (isSpectator) { 
                title.innerText = `VITÓRIA DE ${winner.name}`; 
            } else { 
                if (winnerId === 'draw') { 
                    title.innerText = "EMPATE!"; 
                } else if (isP1Win) { 
                    title.innerText = "VITÓRIA!"; 
                    createConfetti(50);
                    
                    // Anima contadores de recompensa
                    animateCounter(rewardMoney, 0, moneyReward, 1000, '+');
                    animateCounter(rewardExp, 0, expReward, 1200, '+');
                    
                    // Mostra barra de XP com dados do servidor quando disponíveis.
                    // No modo online, o servidor mantém p1/p2 fixos; no client, "p1" é sempre "eu".
                    // Então escolhemos o state certo pelo userId.
                    setTimeout(() => {
                        const pickMyState = () => {
                            if (!srvData) return null;
                            const s1 = srvData.p1State;
                            const s2 = srvData.p2State;
                            if (battleMode !== 'online' && s1) return s1;
                            const ru = String(realUserId || '');
                            if (s1 && String(s1.userId || '') === ru) return s1;
                            if (s2 && String(s2.userId || '') === ru) return s2;
                            return null;
                        };

                        const domLevel = Number(document.getElementById('p1-lv') && document.getElementById('p1-lv').textContent);
                        const domXp = Number(document.getElementById('xp-val-p1') && document.getElementById('xp-val-p1').textContent);
                        const domXpNext = Number(document.getElementById('xp-max-p1') && document.getElementById('xp-max-p1').textContent);

                        const myState = pickMyState();
                        const fallbackXpMax = (() => {
                            const el = document.getElementById('xp-max-p1');
                            const n = el ? Number(el.textContent) : NaN;
                            return Number.isFinite(n) ? n : 100;
                        })();

                        const lvl = Number((myState && myState.level) || (Number.isFinite(domLevel) ? domLevel : 1));
                        const curXp = Number((myState && myState.xp) || (Number.isFinite(domXp) ? domXp : 0));
                        const xpToNext = Number((myState && myState.xpToNext) || (Number.isFinite(domXpNext) ? domXpNext : fallbackXpMax || 100));

                        xpContainer.style.display = 'block';
                        levelDisplay.textContent = `${lvl} → ${lvl + 1}`;
                        setTimeout(() => {
