        function updateComboDisplay(combo, multiplier) {
            const badge = document.getElementById('comboBadge');
            
            if (combo >= 2) {
                badge.style.display = 'block';
                const multiplierPercent = Math.round((multiplier - 1) * 100);
                badge.innerText = `${combo}x COMBO! +${multiplierPercent}% DMG`;
                badge.className = 'combo-badge';
                
                if (combo >= 5) badge.classList.add('combo-5');
                else if (combo >= 4) badge.classList.add('combo-4');
                else if (combo >= 3) badge.classList.add('combo-3');
                else badge.classList.add('combo-2');
            } else {
                badge.style.display = 'none';
            }
        }
        
        function screenShake(strength = 'normal') {
            const arena = document.getElementById('arena');
            if (!arena) return;
            const cls = (strength === 'strong') ? 'shake-strong' : 'shake';
            arena.classList.add(cls);
            setTimeout(() => arena.classList.remove(cls), 450);
        }

        function triggerImpactFlash(strength = 'soft') {
            const flash = document.getElementById('flashOverlay');
            if (!flash) return;
            const cls = (strength === 'strong') ? 'impact-strong' : 'impact';
            flash.classList.add(cls);
            setTimeout(() => flash.classList.remove(cls), 140);
        }

        function pulseArena() {
            const arena = document.getElementById('arena');
            if (!arena) return;
            arena.classList.add('pulse');
            setTimeout(() => arena.classList.remove('pulse'), 360);
        }
        
        function createParticles(targetSide, element, comboLevel) {
            const fighter = document.getElementById(`fighter-${targetSide}`);
            const fRect = fighter.getBoundingClientRect();
            const centerX = fRect.left + fRect.width / 2;
            const centerY = fRect.top + fRect.height / 2;
            
            // Mais partículas para combos maiores
            const particleCount = 5 + (comboLevel * 2);
            
            for (let i = 0; i < particleCount; i++) {
                setTimeout(() => {
                    const particle = document.createElement('div');
                    particle.className = `particle ${element}`;
                    
                    const angle = (Math.PI * 2 / particleCount) * i;
                    const distance = 30 + Math.random() * 40;
                    const dx = Math.cos(angle) * distance;
                    const dy = Math.sin(angle) * distance;
                    
                    particle.style.left = centerX + 'px';
                    particle.style.top = centerY + 'px';
                    particle.style.setProperty('--dx', dx + 'px');
                    particle.style.setProperty('--dy', dy + 'px');
                    
                    document.body.appendChild(particle);
                    
                    setTimeout(() => particle.remove(), 1200);
                }, i * 30);
            }
        }

        // --- Editor do BattleBG (admin) ---
        (function initBattleBgEditor() {
            const canEdit = <%= ((typeof canEditBg !== 'undefined' && canEditBg) ? 'true' : 'false') %>;
            const mapId = <%- JSON.stringify(typeof battleMapId !== 'undefined' ? battleMapId : null) %>;
            const userId = <%- JSON.stringify(typeof realUserId !== 'undefined' ? realUserId : null) %>;

            const params = new URLSearchParams(window.location.search || '');
            const wantEdit = params.get('bgEdit') === '1';
            if (!canEdit || !wantEdit || !mapId || !userId) return;

            const arena = document.getElementById('arena');
            const panel = document.getElementById('bgEditor');
            const rx = document.getElementById('bgPosX');
            const ry = document.getElementById('bgPosY');
            const vx = document.getElementById('bgPosXVal');
            const vy = document.getElementById('bgPosYVal');
            const rz = document.getElementById('bgZoom');
            const vz = document.getElementById('bgZoomVal');
            const btnSave = document.getElementById('bgSave');
            const btnReset = document.getElementById('bgReset');
            const btnClose = document.getElementById('bgClose');
            if (!arena || !panel || !rx || !ry || !vx || !vy || !rz || !vz || !btnSave || !btnReset || !btnClose) return;

            function readVar(name, fallback) {
                const raw = getComputedStyle(arena).getPropertyValue(name);
                const v = parseFloat(raw);
                return Number.isFinite(v) ? v : fallback;
            }

            function apply(x, y, zoom) {
                const px = Math.max(0, Math.min(100, Math.round(x)));
                const py = Math.max(0, Math.min(100, Math.round(y)));
                const pz = Math.max(50, Math.min(250, Math.round(zoom / 5) * 5));
                arena.style.setProperty('--bgPosX', String(px));
                arena.style.setProperty('--bgPosY', String(py));
                arena.style.setProperty('--bgZoom', String(pz));
                rx.value = String(px);
                ry.value = String(py);
                vx.textContent = String(px);
                vy.textContent = String(py);
                rz.value = String(pz);
                vz.textContent = String(pz);
            }

            // Inicializa com o que veio do server
            apply(readVar('--bgPosX', 50), readVar('--bgPosY', 50), readVar('--bgZoom', 100));
            panel.style.display = 'block';

            rx.addEventListener('input', () => apply(parseFloat(rx.value), parseFloat(ry.value), parseFloat(rz.value)));
            ry.addEventListener('input', () => apply(parseFloat(rx.value), parseFloat(ry.value), parseFloat(rz.value)));
            rz.addEventListener('input', () => apply(parseFloat(rx.value), parseFloat(ry.value), parseFloat(rz.value)));

            // Arrastar para ajustar
            let dragging = false;
            let startX = 0, startY = 0;
            let basePosX = 50, basePosY = 50;

            function onDown(e) {
                // Não captura se clicar dentro do painel
                if (e && e.target && panel.contains(e.target)) return;
                dragging = true;
                const p = (e.touches && e.touches[0]) ? e.touches[0] : e;
                startX = p.clientX;
                startY = p.clientY;
                basePosX = parseFloat(rx.value);
                basePosY = parseFloat(ry.value);
            }

            function onMove(e) {
                if (!dragging) return;
                const p = (e.touches && e.touches[0]) ? e.touches[0] : e;
                const dx = p.clientX - startX;
                const dy = p.clientY - startY;
                // Sensibilidade: 2px = 1%
                apply(basePosX + (dx / 2), basePosY + (dy / 2), parseFloat(rz.value));
            }

            function onUp() { dragging = false; }

            arena.addEventListener('mousedown', onDown);
            arena.addEventListener('mousemove', onMove);
            window.addEventListener('mouseup', onUp);
            arena.addEventListener('touchstart', onDown, { passive: true });
            arena.addEventListener('touchmove', onMove, { passive: true });
            window.addEventListener('touchend', onUp);
            window.addEventListener('touchcancel', onUp);

            btnReset.addEventListener('click', () => apply(50, 50, 100));
            btnClose.addEventListener('click', () => {
                panel.style.display = 'none';
            });

            btnSave.addEventListener('click', async () => {
                const x = parseFloat(rx.value);
                const y = parseFloat(ry.value);
                const zoom = parseFloat(rz.value);
                try {
                    const res = await fetch('/api/map/battlebg', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId, mapId, bgPosX: x, bgPosY: y, bgZoom: zoom })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || (data && data.error)) {
                        if (typeof showToast === 'function') showToast(data.error || 'Erro ao salvar.');
                        else alert(data.error || 'Erro ao salvar.');
                        return;
                    }
                    if (typeof showToast === 'function') showToast('Fundo da batalha salvo no mapa!');
                    else alert('Fundo da batalha salvo no mapa!');
                } catch (_) {
                    if (typeof showToast === 'function') showToast('Erro ao salvar.');
                    else alert('Erro ao salvar.');
                }
            });
        })();

        // --- Forçar treinadores olhando para baixo na tela de vitória/derrota ---
        (function initVictoryObserverOnce() {
            if (window.__victoryObserverInitialized) return;
            window.__victoryObserverInitialized = true;

            function setTrainersVictoryDown() {
                const trainers = document.querySelectorAll('.fighter-result .trainer');
                trainers.forEach(tr => {
                    tr.classList.remove('frame-1', 'frame-2', 'frame-3');
                    tr.style.backgroundPosition = '0% 0%';
                });
            }

            const victoryObserver = new MutationObserver(() => {
                if (document.querySelector('.victory-container')) {
                    setTrainersVictoryDown();
                }
            });
            victoryObserver.observe(document.body, { childList: true, subtree: true });
        })();
    </script>
</body>

