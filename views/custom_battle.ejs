<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custom Battle Setup</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #7e22ce 100%);
            font-family: 'Roboto', sans-serif;
            color: #fff;
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        h1 {
            font-family: 'Press Start 2P', cursive;
            font-size: 28px;
            text-shadow: 3px 3px 0 rgba(0,0,0,0.5);
            margin-bottom: 10px;
        }
        
        .subtitle {
            font-size: 16px;
            opacity: 0.9;
        }
        
        .teams-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        @media (max-width: 768px) {
            .teams-container {
                grid-template-columns: 1fr;
            }
        }
        
        .team-panel {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.2);
        }
        
        .team-header {
            font-family: 'Press Start 2P', cursive;
            font-size: 18px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid rgba(255,255,255,0.3);
        }
        
        .player-team { border-left: 4px solid #4ade80; }
        .enemy-team { border-left: 4px solid #f87171; }
        
        .monster-slots {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .monster-slot {
            background: rgba(0,0,0,0.3);
            border-radius: 10px;
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 2px solid transparent;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .monster-slot:hover {
            border-color: rgba(255,255,255,0.5);
            transform: translateX(5px);
        }
        
        .monster-slot.empty {
            opacity: 0.5;
            border-style: dashed;
        }
        
        .slot-number {
            font-family: 'Press Start 2P', cursive;
            font-size: 20px;
            color: #fbbf24;
            min-width: 30px;
        }
        
        .monster-info {
            flex: 1;
        }
        
        .monster-name {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 5px;
        }
        
        .monster-details {
            font-size: 12px;
            opacity: 0.8;
        }
        
        .monster-sprite {
            width: 64px;
            height: 64px;
            image-rendering: pixelated;
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 5px;
        }
        
        .remove-btn {
            background: #ef4444;
            border: none;
            color: white;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }
        
        .remove-btn:hover {
            background: #dc2626;
            transform: scale(1.05);
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            overflow-y: auto;
            padding: 20px;
        }
        
        .modal-content {
            max-width: 900px;
            margin: 20px auto;
            background: linear-gradient(135deg, #1e293b, #334155);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(255,255,255,0.2);
        }
        
        .modal-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 18px;
        }
        
        .close-btn {
            background: #ef4444;
            border: none;
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
        }
        
        .level-input-container {
            margin-bottom: 25px;
            text-align: center;
        }
        
        .level-input-container label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
            font-size: 14px;
        }
        
        .level-input {
            width: 120px;
            padding: 10px;
            font-size: 18px;
            font-weight: bold;
            text-align: center;
            border: 2px solid rgba(255,255,255,0.3);
            background: rgba(0,0,0,0.3);
            color: white;
            border-radius: 8px;
        }
        
        .monsters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            max-height: 500px;
            overflow-y: auto;
            padding: 10px;
        }
        
        .monster-card {
            background: rgba(0,0,0,0.4);
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .monster-card:hover {
            border-color: #4ade80;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(74,222,128,0.3);
        }
        
        .monster-card img {
            width: 80px;
            height: 80px;
            image-rendering: pixelated;
            margin-bottom: 10px;
        }
        
        .monster-card-name {
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .monster-card-type {
            font-size: 12px;
            opacity: 0.8;
            text-transform: uppercase;
        }
        
        .actions-bar {
            text-align: center;
            margin-top: 30px;
            display: flex;
            gap: 20px;
            justify-content: center;
        }
        
        .btn {
            font-family: 'Press Start 2P', cursive;
            font-size: 14px;
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        
        .btn-start {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
        }
        
        .btn-start:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.4);
        }
        
        .btn-start:disabled {
            background: #6b7280;
            cursor: not-allowed;
            transform: none;
        }
        
        .btn-back {
            background: linear-gradient(135deg, #64748b, #475569);
            color: white;
        }
        
        .btn-back:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(100,116,139,0.4);
        }
        
        .error-message {
            background: #ef4444;
            color: white;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 20px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>⚔️ CUSTOM BATTLE ⚔️</h1>
            <p class="subtitle">Monte seu time e teste suas estratégias!</p>
        </header>
        
        <div class="error-message" id="errorMsg"></div>
        
        <div class="teams-container">
            <!-- Player Team -->
            <div class="team-panel player-team">
                <h2 class="team-header">🎮 SEU TIME</h2>
                <div class="monster-slots" id="playerTeam">
                    <div class="monster-slot empty" onclick="openMonsterSelector('player', 0)">
                        <span class="slot-number">1</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                    <div class="monster-slot empty" onclick="openMonsterSelector('player', 1)">
                        <span class="slot-number">2</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                    <div class="monster-slot empty" onclick="openMonsterSelector('player', 2)">
                        <span class="slot-number">3</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Enemy Team -->
            <div class="team-panel enemy-team">
                <h2 class="team-header">💀 TIME INIMIGO</h2>
                <div class="monster-slots" id="enemyTeam">
                    <div class="monster-slot empty" onclick="openMonsterSelector('enemy', 0)">
                        <span class="slot-number">1</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                    <div class="monster-slot empty" onclick="openMonsterSelector('enemy', 1)">
                        <span class="slot-number">2</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                    <div class="monster-slot empty" onclick="openMonsterSelector('enemy', 2)">
                        <span class="slot-number">3</span>
                        <div class="monster-info">
                            <div class="monster-name">Slot Vazio</div>
                            <div class="monster-details">Clique para selecionar</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="actions-bar">
            <button class="btn btn-back" onclick="goBack()">⬅️ VOLTAR</button>
            <button class="btn btn-start" id="startBtn" onclick="startBattle()">⚔️ INICIAR BATALHA</button>
        </div>
    </div>
    
    <!-- Monster Selector Modal -->
    <div class="modal" id="monsterModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Selecione um Monstro</h3>
                <button class="close-btn" onclick="closeModal()">✕ FECHAR</button>
            </div>
            
            <div class="level-input-container">
                <label>Nível do Monstro:</label>
                <input type="number" class="level-input" id="monsterLevel" min="1" max="100" value="50">
            </div>
            
            <div class="monsters-grid" id="monstersGrid">
                <!-- Populated by JS -->
            </div>
        </div>
    </div>
    
    <script>
        const userId = '<%= userId %>';
        const playerSkin = '<%= playerSkin %>';
        const playerName = '<%= playerName %>';
        
        let playerTeam = [null, null, null];
        let enemyTeam = [null, null, null];
        let currentTeam = 'player';
        let currentSlot = 0;
        let allMonsters = [];
        
        // Load all available monsters
        async function loadMonsters() {
            try {
                const res = await fetch('/api/base-entities');
                const data = await res.json();
                allMonsters = data;
            } catch (e) {
                console.error('Erro ao carregar monstros:', e);
            }
        }
        
        function openMonsterSelector(team, slot) {
            currentTeam = team;
            currentSlot = slot;
            
            const grid = document.getElementById('monstersGrid');
            grid.innerHTML = '';
            
            allMonsters.forEach(monster => {
                const card = document.createElement('div');
                card.className = 'monster-card';
                card.onclick = () => selectMonster(monster);
                
                card.innerHTML = `
                    <img src="${monster.sprite}" alt="${monster.name}">
                    <div class="monster-card-name">${monster.name}</div>
                    <div class="monster-card-type">${monster.type}</div>
                `;
                
                grid.appendChild(card);
            });
            
            document.getElementById('monsterModal').style.display = 'block';
        }
        
        function selectMonster(monster) {
            const level = parseInt(document.getElementById('monsterLevel').value) || 50;
            
            const monsterData = {
                baseId: monster.id,
                name: monster.name,
                type: monster.type,
                sprite: monster.sprite,
                level: level,
                baseStats: monster.baseStats,
                movePool: monster.movePool || []
            };
            
            if (currentTeam === 'player') {
                playerTeam[currentSlot] = monsterData;
                renderSlot('playerTeam', currentSlot, monsterData);
            } else {
                enemyTeam[currentSlot] = monsterData;
                renderSlot('enemyTeam', currentSlot, monsterData);
            }
            
            closeModal();
            updateStartButton();
        }
        
        function renderSlot(teamId, slotIndex, monsterData) {
            const container = document.getElementById(teamId);
            const slot = container.children[slotIndex];
            
            if (monsterData) {
                slot.className = 'monster-slot';
                slot.innerHTML = `
                    <span class="slot-number">${slotIndex + 1}</span>
                    <img class="monster-sprite" src="${monsterData.sprite}" alt="${monsterData.name}">
                    <div class="monster-info">
                        <div class="monster-name">${monsterData.name}</div>
                        <div class="monster-details">Nível ${monsterData.level} • ${monsterData.type.toUpperCase()}</div>
                    </div>
                    <button class="remove-btn" onclick="removeMonster('${teamId === 'playerTeam' ? 'player' : 'enemy'}', ${slotIndex})">✕</button>
                `;
            } else {
                slot.className = 'monster-slot empty';
                slot.innerHTML = `
                    <span class="slot-number">${slotIndex + 1}</span>
                    <div class="monster-info">
                        <div class="monster-name">Slot Vazio</div>
                        <div class="monster-details">Clique para selecionar</div>
                    </div>
                `;
            }
            
            // Re-attach onclick
            slot.onclick = () => openMonsterSelector(teamId === 'playerTeam' ? 'player' : 'enemy', slotIndex);
        }
        
        function removeMonster(team, slot) {
            event.stopPropagation();
            if (team === 'player') {
                playerTeam[slot] = null;
                renderSlot('playerTeam', slot, null);
            } else {
                enemyTeam[slot] = null;
                renderSlot('enemyTeam', slot, null);
            }
            updateStartButton();
        }
        
        function updateStartButton() {
            const btn = document.getElementById('startBtn');
            const hasPlayerMonster = playerTeam.some(m => m !== null);
            const hasEnemyMonster = enemyTeam.some(m => m !== null);
            
            btn.disabled = !(hasPlayerMonster && hasEnemyMonster);
        }
        
        function closeModal() {
            document.getElementById('monsterModal').style.display = 'none';
        }
        
        async function startBattle() {
            const errorMsg = document.getElementById('errorMsg');
            errorMsg.style.display = 'none';
            
            const filteredPlayerTeam = playerTeam.filter(m => m !== null);
            const filteredEnemyTeam = enemyTeam.filter(m => m !== null);
            
            if (filteredPlayerTeam.length === 0 || filteredEnemyTeam.length === 0) {
                errorMsg.textContent = 'Ambos os times precisam ter pelo menos 1 monstro!';
                errorMsg.style.display = 'block';
                return;
            }
            
            try {
                const res = await fetch('/api/custom-battle/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userId,
                        playerName,
                        playerSkin,
                        playerTeam: filteredPlayerTeam,
                        enemyTeam: filteredEnemyTeam
                    })
                });
                
                const data = await res.json();
                
                if (data.battleId) {
                    window.location.href = `/battle/${data.battleId}`;
                } else {
                    errorMsg.textContent = data.error || 'Erro ao criar batalha';
                    errorMsg.style.display = 'block';
                }
            } catch (e) {
                errorMsg.textContent = 'Erro ao iniciar batalha: ' + e.message;
                errorMsg.style.display = 'block';
            }
        }
        
        function goBack() {
            window.location.href = `/city?userId=${userId}`;
        }
        
        // Initialize
        window.onload = async () => {
            await loadMonsters();
            updateStartButton();
        };
    </script>
</body>
</html>
