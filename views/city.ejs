        // Keep UI state in sync after any server-side action (shop/box/heal/story/etc).
        // If the Bag overlay is open, it re-renders immediately.
        window.__syncClientStateFromServer = async function(payload) {
            const data = payload || {};
            try {
                if (data && typeof data.money === 'number') {
                    document.body.setAttribute('data-user-money', String(data.money));
                }
                if (data && data.bag && typeof data.bag === 'object') {
