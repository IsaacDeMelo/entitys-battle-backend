        // --- INTERAÇÕES ---
        window.interactWithNPC = function(npc) {
            if (window.__menuOpen) return;
            window.isInteracting = true; window.isMoving = false;

            function endInteraction() {
                window.isInteracting = false;
                window.isMoving = false;
            }

            async function disengageNow() {
                try {
                    if (npc && npc._id) {
                        await fetch('/api/npc/disengage', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ npcId: npc._id })
                        });
                    }
                } catch (_) {}
            }

            // Pausa a patrulha e faz o NPC olhar para o jogador.
            try {
                const myEl = document.getElementById(`p-${window.myId}`);
                if (myEl && npc && npc._id) {
                    fetch('/api/npc/engage', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            npcId: npc._id,
                            playerX: parseFloat(myEl.style.left),
                            playerY: parseFloat(myEl.style.top),
                            pauseMs: 8000
                        })
                    }).catch(() => {});
                }
            } catch (_) {}
            const cleanName = npc.name.replace(/\(kid\)/i, '').trim();
            const defeatedList = window.DEFEATED_NPCS || [];
            const record = defeatedList.find(r => (r === npc._id) || (r.npcId === npc._id));
            
            // Para diálogos condicionais funcionarem, precisamos consultar o backend.
            // Faremos isso dentro de uma função async e aplicaremos após a verificação.
            const svcForInteract = (npc && npc.interact && npc.interact.serviceType) ? String(npc.interact.serviceType).trim() : '';
            const typeForInteract = (npc && npc.npcType) ? String(npc.npcType).trim() : '';
            const isHealNpcForInteract = (svcForInteract === 'heal') || (typeForInteract === 'heal');
            const isShopNpcForInteract = (svcForInteract === 'shop') || (typeForInteract === 'shop');
            const isStarterNpcForInteract = (svcForInteract === 'starter') || (typeForInteract === 'starter');
            const isBoxNpcForInteract = (svcForInteract === 'box') || (typeForInteract === 'box');
            const isServiceNpcForPreview = isHealNpcForInteract || isShopNpcForInteract || isStarterNpcForInteract || isBoxNpcForInteract;
            const hasInteract = isStarterNpcForInteract || !!(npc.interact && npc.interact.enabled);
            const canBattleRaw = npc.team && npc.team.length > 0;
            const isNonBattleNpc = (svcForInteract === 'heal' || svcForInteract === 'shop' || svcForInteract === 'starter' || svcForInteract === 'box')
                || (typeForInteract === 'heal' || typeForInteract === 'shop' || typeForInteract === 'starter' || typeForInteract === 'box');
            const canBattle = !!(canBattleRaw && !isNonBattleNpc);
            
            // Função que resolve o diálogo correto (com condicionais)
            async function resolveDialogueText(key = 'dialogue') {
                // SEMPRE consulta o backend se há diálogos condicionais OU se tem interação
                const hasConditionals = npc.conditionalDialogues && npc.conditionalDialogues.length > 0;
                
                if (hasInteract || hasConditionals) {
                    try {
                        const myEl = document.getElementById(`p-${window.myId}`);
                        const px = myEl ? parseFloat(myEl.style.left) : null;
                        const py = myEl ? parseFloat(myEl.style.top) : null;
                        
                        // IMPORTANTE (serviços): não dispare /api/npc/interact apenas para "montar menu",
                        // pois isso pode executar/alterar estado (cura/loja/starter). Para serviços, fazemos preview via /api/npc/dialogue.
                        if (hasInteract && !isServiceNpcForPreview) {
                            const res = await fetch('/api/npc/interact', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ userId: window.CURRENT_USER_ID, npcId: npc._id, playerX: px, playerY: py })
                            });
                            const data = await res.json().catch(() => ({}));
                            if (data && data.text) return data.text;
                        } else {
                            // Condicionais (ou preview para serviços como heal/shop/starter)
                            const res = await fetch('/api/npc/dialogue', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ userId: window.CURRENT_USER_ID, npcId: npc._id })
                            });
                            const data = await res.json().catch(() => ({}));
                            if (data && data.text) return data.text;
                        }
                    } catch (_) {}
                }
                // Fallback: lógica antiga baseada em cooldown
                let dialogueText = npc.dialogue || 'Olá!';
                if (!record) return dialogueText;
                const defeatedAt = record.defeatedAt || 0; 
                const cooldownMins = npc.cooldownMinutes || 0;
                if (cooldownMins <= 0) { 
                    return npc.winDialogue || "Você já me venceu! Bom trabalho."; 
                } else {
                    const diffMinutes = (Date.now() - defeatedAt) / 60000;
                    if (diffMinutes < cooldownMins) { 
                        return (npc.cooldownDialogue || "Estou descansando...") + ` (${Math.ceil(cooldownMins - diffMinutes)}m)`; 
                    } else { 
                        return npc.dialogue || "Vamos batalhar novamente!"; 
                    }
                }
            }
            
            let showBattleOptions = false;
            if (!record) { showBattleOptions = true; } 
            else {
                const defeatedAt = record.defeatedAt || 0; const cooldownMins = npc.cooldownMinutes || 0;
                if (cooldownMins <= 0) { showBattleOptions = false; } 
                else {
                    const diffMinutes = (Date.now() - defeatedAt) / 60000;
                    if (diffMinutes < cooldownMins) { showBattleOptions = false; } 
                    else { showBattleOptions = true; }
                }
            }

            async function runNpcTalk() {
                try {
                    const myEl = document.getElementById(`p-${window.myId}`);
                    const px = myEl ? parseFloat(myEl.style.left) : null;
                    const py = myEl ? parseFloat(myEl.style.top) : null;
                    const res = await fetch('/api/npc/interact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId: window.CURRENT_USER_ID, npcId: npc._id, playerX: px, playerY: py })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (typeof window.__syncClientStateFromServer === 'function') {
                        await window.__syncClientStateFromServer(data);
                    }
                    const text = (data && data.text) ? data.text : '...';

                    // Fallback robusto para starter:
                    // - Se o NPC é starter mas o backend não retornou action (ou retornou só texto),
                    //   buscamos as opções via /api/starter/options e abrimos o picker.
                    // - Isso evita ficar preso no "FECHAR" e evita o problema de paginação.
                    try {
                        const svcLocal = (npc && npc.interact && npc.interact.serviceType) ? String(npc.interact.serviceType).trim() : '';
                        const typeLocal = (npc && npc.npcType) ? String(npc.npcType).trim() : '';
                        const isStarterNpc = (svcLocal === 'starter') || (typeLocal === 'starter');
                        const hasStarterAction = !!(data && data.action && data.action.type === 'starter');
                        const alreadyDone = !!(data && data.alreadyDone);
                        if (isStarterNpc && !hasStarterAction && !alreadyDone) {
                            const optRes = await fetch(`/api/starter/options?userId=${encodeURIComponent(window.CURRENT_USER_ID)}&npcId=${encodeURIComponent(String(npc._id || ''))}`);
                            const optData = await optRes.json().catch(() => ({}));
                            if (optData && optData.error) {
                                await showRPGDialog(cleanName, npc.skin, optData.error);
                                await disengageNow();
                                return;
                            }
                            if (optData && optData.chosen) {
                                const msg = (npc.interact && npc.interact.alreadyDoneDialogue)
                                    ? npc.interact.alreadyDoneDialogue
                                    : 'Você já escolheu o seu monstro inicial.';
                                await showRPGDialog(cleanName, npc.skin, msg);
                                await disengageNow();
                                return;
                            }

                            const options = Array.isArray(optData && optData.options) ? optData.options.slice(0, 3) : [];
                            if (options.length < 3) {
                                await showRPGDialog(cleanName, npc.skin, 'Erro: opções de starter insuficientes.');
                                await disengageNow();
                                return;
                            }

                            function escapeHtml(s) {
                                return String(s || '')
                                    .replace(/&/g, '&amp;')
                                    .replace(/</g, '&lt;')
                                    .replace(/>/g, '&gt;')
                                    .replace(/"/g, '&quot;')
                                    .replace(/'/g, '&#039;');
                            }
                            const safeHtmlText = escapeHtml(text).replace(/\n/g, '<br>');
                            const choose = await showRPGDialog(cleanName, npc.skin, safeHtmlText, [
                                { text: 'ESCOLHER', value: 'choose', class: 'confirm' },
                                { text: 'SAIR', value: 'exit', class: 'cancel' }
                            ], null, { allowHtml: true });
                            if (choose !== 'choose') {
                                await disengageNow();
                                return;
                            }
                            if (typeof window.__openStarterPicker === 'function') {
                                window.__openStarterPicker({
                                    npcName: cleanName,
                                    npcSkin: npc.skin,
                                    npcId: npc._id,
                                    hintText: 'Escolha seu monstro inicial:',
                                    options
                                });
                            }
                            await disengageNow();
                            return;
                        }
                    } catch (_) {}

                    if (data && data.action && data.action.type === 'starter') {
                        const options = Array.isArray(data.action.options) ? data.action.options.slice(0, 3) : [];
                        if (options.length < 3) {
                            await showRPGDialog(cleanName, npc.skin, 'Erro: opções de starter insuficientes.');
                            await disengageNow();
                            return;
                        }

                        // O showRPGDialog (normal) só mostra botões na ÚLTIMA página.
                        // Para não "sumir" a opção quando o texto quebra em 2 partes, usamos allowHtml
                        // (texto completo rolável + botões sempre visíveis).
                        function escapeHtml(s) {
                            return String(s || '')
                                .replace(/&/g, '&amp;')
                                .replace(/</g, '&lt;')
                                .replace(/>/g, '&gt;')
                                .replace(/"/g, '&quot;')
                                .replace(/'/g, '&#039;');
                        }
                        const safeHtmlText = escapeHtml(text).replace(/\n/g, '<br>');
                        const choose = await showRPGDialog(cleanName, npc.skin, safeHtmlText, [
                            { text: 'ESCOLHER', value: 'choose', class: 'confirm' },
                            { text: 'SAIR', value: 'exit', class: 'cancel' }
                        ], null, { allowHtml: true });
                        if (choose !== 'choose') {
                            await disengageNow();
                            return;
                        }

                        if (typeof window.__openStarterPicker === 'function') {
                            window.__openStarterPicker({
                                npcName: cleanName,
                                npcSkin: npc.skin,
                                npcId: npc._id,
                                hintText: 'Escolha seu monstro inicial:',
                                options
                            });
                        }

                        await disengageNow();
                        return;
                    }

                    await showRPGDialog(cleanName, npc.skin, text, [], () => disengageNow());

                    if (data && data.action && data.action.type === 'shop') {
                        if (typeof window.openNpcShop === 'function') {
                            await window.openNpcShop(data.action.items || [], {
                                npcId: npc._id,
                                npcName: cleanName,
                                npcSkin: npc.skin,
                                userId: window.CURRENT_USER_ID
                            });
                        }
                    }
                } catch (e) {
                    if (typeof showToast === 'function') showToast('Erro ao interagir.', { bg: '#e74c3c' });
                }
                await disengageNow();
            }

            async function runNpcServiceAction(kind) {
                try {
                    const myEl = document.getElementById(`p-${window.myId}`);
                    const px = myEl ? parseFloat(myEl.style.left) : null;
                    const py = myEl ? parseFloat(myEl.style.top) : null;
                    const res = await fetch('/api/npc/interact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId: window.CURRENT_USER_ID, npcId: npc._id, playerX: px, playerY: py })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (typeof window.__syncClientStateFromServer === 'function') {
                        await window.__syncClientStateFromServer(data);
                    }

                    if (kind === 'shop') {
                        const items = (data && data.action && data.action.type === 'shop') ? (data.action.items || []) : [];
                        if (typeof window.openNpcShop === 'function') {
                            await window.openNpcShop(items, {
                                npcId: npc._id,
                                npcName: cleanName,
                                npcSkin: npc.skin,
                                userId: window.CURRENT_USER_ID
                            });
                        }
                    }

                    if (kind === 'starter') {
                        // Botão ESCOLHER já é confirmação; abrir picker direto.
                        let options = (data && data.action && data.action.type === 'starter')
                            ? (Array.isArray(data.action.options) ? data.action.options.slice(0, 3) : [])
                            : [];

                        if (options.length < 3) {
                            try {
                                const optRes = await fetch(`/api/starter/options?userId=${encodeURIComponent(window.CURRENT_USER_ID)}&npcId=${encodeURIComponent(String(npc._id || ''))}`);
                                const optData = await optRes.json().catch(() => ({}));
                                if (optData && optData.error) {
                                    await showRPGDialog(cleanName, npc.skin, optData.error);
                                    await disengageNow();
                                    return;
                                }
                                if (optData && optData.chosen) {
                                    const msg = (npc.interact && npc.interact.alreadyDoneDialogue)
                                        ? npc.interact.alreadyDoneDialogue
                                        : 'Você já escolheu o seu monstro inicial.';
                                    await showRPGDialog(cleanName, npc.skin, msg);
                                    await disengageNow();
                                    return;
                                }
                                options = Array.isArray(optData && optData.options) ? optData.options.slice(0, 3) : [];
                            } catch (_) {}
                        }

                        if (options.length < 3) {
                            await showRPGDialog(cleanName, npc.skin, 'Erro: opções de starter insuficientes.');
                            await disengageNow();
                            return;
                        }

                        if (typeof window.__openStarterPicker === 'function') {
                            window.__openStarterPicker({
                                npcName: cleanName,
                                npcSkin: npc.skin,
                                npcId: npc._id,
                                hintText: 'Escolha seu monstro inicial:',
                                options
                            });
                        }
                    }

                    if (kind === 'box') {
                        const text = (data && data.text)
                            ? data.text
                            : (data && data.error ? 'Não foi possível abrir a box.' : 'Box aberta.');
                        await showRPGDialog(cleanName, npc.skin, text);
                    }
                } catch (e) {
                    if (typeof showToast === 'function') showToast('Erro ao interagir.', { bg: '#e74c3c' });
                }
                await disengageNow();
            }

            function runNpcBattle() {
                performTransition(() => {
                    let mapParam = currentMapId === 'city' ? 'city' : `city?map=${currentMapId}`;
                    fetch('/battle/npc', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            userId: window.CURRENT_USER_ID,
                            npcId: npc._id,
                            currentMap: mapParam,
                            currentX: parseFloat(document.getElementById(`p-${window.myId}`).style.left),
                            currentY: parseFloat(document.getElementById(`p-${window.myId}`).style.top)
                        })
                    })
                    .then(r => r.json())
                    .then(data => { if(data.battleId) window.location.href = '/battle/' + data.battleId; });
                });
            }

            // Evita diálogo duplicado: se o starter já foi escolhido, não precisa de "FALAR".
            let canTalk = hasInteract;
            let dialogueTextForMenu = npc.dialogue || 'Olá!'; // Texto placeholder para o menu inicial
            try {
                const svc = (npc.interact && npc.interact.serviceType) ? String(npc.interact.serviceType).trim() : '';
                const type = (npc && npc.npcType) ? String(npc.npcType).trim() : '';
                const rawChosen = (window.STORY_FLAGS && window.STORY_FLAGS['starter_chosen']);
                const chosen = (rawChosen === true || rawChosen === 1 || rawChosen === '1' || String(rawChosen).trim().toLowerCase() === 'true');
                if (hasInteract && (svc === 'starter' || type === 'starter') && chosen) {
                    canTalk = false;
                    dialogueTextForMenu = (npc.interact && npc.interact.alreadyDoneDialogue)
                        ? npc.interact.alreadyDoneDialogue
                        : 'Você já escolheu o seu monstro inicial.';
                }
            } catch (_) {}

            const hasTalkOption = !!canTalk;
            const hasBattleOption = !!(canBattle && showBattleOptions);
            
            // Se tem condicionais mas não tem interação, ainda pode "falar"
            const hasConditionals = npc.conditionalDialogues && npc.conditionalDialogues.length > 0;
            const canTalkWithConditionals = hasConditionals && !hasInteract;

            // Simplificação: se não há escolha real, normalmente não abre menu.
            // EXCEÇÃO (serviços): mostra botão específico para o jogador confirmar.
            if ((hasTalkOption || canTalkWithConditionals) && !hasBattleOption) {
                if ((isHealNpcForInteract || isShopNpcForInteract || isStarterNpcForInteract || isBoxNpcForInteract) && hasTalkOption && !canTalkWithConditionals) {
                    const boxPriceLabel = (() => {
                        const val = npc && npc.interact && npc.interact.box ? parseInt(npc.interact.box.price, 10) || 0 : 0;
                        return val > 0 ? `ABRIR BOX (${val}$)` : 'ABRIR BOX';
                    })();
                    const primaryBtn = isHealNpcForInteract
                        ? { text: 'CURAR', value: 'heal', class: 'confirm' }
                        : (isShopNpcForInteract
                            ? { text: 'LOJA', value: 'shop', class: 'confirm' }
                            : (isBoxNpcForInteract
                                ? { text: boxPriceLabel, value: 'box', class: 'confirm' }
                                : { text: 'ESCOLHER', value: 'starter', class: 'confirm' }));
                    resolveDialogueText('dialogue').then((dialogueText) => {
                        setDialogImageStyle('pixel');
                        showRPGDialog(cleanName, npc.skin, dialogueText, [
                            primaryBtn,
                            { text: 'SAIR', value: 'exit', class: 'cancel' }
                        ]).then(async (choice) => {
                            window.isInteracting = false;
                            if (choice === 'heal' || choice === 'shop' || choice === 'starter' || choice === 'box') {
                                await runNpcServiceAction(choice);
                                return;
                            }
                            await disengageNow();
                        });
                    });
                    return;
                }

                window.isInteracting = false;
                // Se só tem condicionais, mostra o diálogo diretamente
                if (canTalkWithConditionals && !hasTalkOption) {
                    resolveDialogueText('dialogue').then(dialogueText => {
                        setDialogImageStyle('pixel');
                        showRPGDialog(cleanName, npc.skin, dialogueText, [
                            { text: 'FECHAR', value: 'exit', class: 'cancel' }
                        ]).then(() => {
                            window.isInteracting = false;
                            disengageNow();
                        });
                    });
                } else {
                    runNpcTalk();
                }
                return;
            }
            if (!hasTalkOption && !canTalkWithConditionals && !hasBattleOption) {
                // Resolve o diálogo condicionado antes de exibir
                resolveDialogueText('winDialogue').then(dialogueText => {
                    setDialogImageStyle('pixel');
                    showRPGDialog(cleanName, npc.skin, dialogueText, [], () => { endInteraction(); disengageNow(); });
                });
                return;
            }

            // Caso com escolha real (ex.: treinador com talk + battle): mantém menu.
            // Resolve o diálogo antes de mostrar o menu
            resolveDialogueText('dialogue').then(dialogueText => {
                let buttons = [];
                if (hasTalkOption) {
                    if (isHealNpcForInteract) buttons.push({ text: 'CURAR', value: 'heal', class: 'confirm' });
                    else if (isShopNpcForInteract) buttons.push({ text: 'LOJA', value: 'shop', class: 'confirm' });
                    else if (isStarterNpcForInteract) buttons.push({ text: 'ESCOLHER', value: 'starter', class: 'confirm' });
                    else buttons.push({ text: 'FALAR', value: 'talk', class: 'confirm' });
                }
                if (canTalkWithConditionals && !hasTalkOption) buttons.push({ text: 'FALAR', value: 'talk', class: 'confirm' });
                if (hasBattleOption) buttons.push({ text: 'BATALHAR', value: 'battle', class: 'confirm' });
                buttons.push({ text: 'SAIR', value: 'exit', class: 'cancel' });
                setDialogImageStyle('pixel');
                showRPGDialog(cleanName, npc.skin, dialogueText, buttons, (result) => {
                    if (result === 'exit' || result === true || result === undefined || result === null) {
                        disengageNow();
                    }
                }, { keepOpenForValues: ['talk'] }).then(async (choice) => {
                    window.isInteracting = false;

                    if (choice === 'heal' || choice === 'shop' || choice === 'starter') {
                        await runNpcServiceAction(choice);
                        return;
                    }

                    if (choice === 'talk') {
                        await runNpcTalk();
                        return;
                    }

                    if (choice === 'battle') {
                        runNpcBattle();
                        return;
                    }

                    await disengageNow();
                });
            });
        };

        (function setupStarterPicker() {
            const overlay = document.getElementById('starterPickerOverlay');
            const closeBtn = document.getElementById('starterPickerClose');
            const titleEl = document.getElementById('starterPickerTitle');
            const hintEl = document.getElementById('starterPickerHint');
            const gridEl = document.getElementById('starterPickerGrid');
            if (!overlay || !closeBtn || !titleEl || !hintEl || !gridEl) return;

            function close() {
                overlay.style.display = 'none';
                gridEl.innerHTML = '';
                if (typeof window !== 'undefined') window.isInteracting = false;
            }

            function open(payload) {
                const npcName = payload && payload.npcName ? String(payload.npcName) : 'NPC';
                const npcSkin = payload && payload.npcSkin ? String(payload.npcSkin) : '';
                const npcId = payload && payload.npcId ? String(payload.npcId) : '';
                const hintText = payload && payload.hintText ? String(payload.hintText) : 'Escolha seu monstro inicial:';
                const options = Array.isArray(payload && payload.options) ? payload.options.slice(0, 3) : [];

                if (typeof window !== 'undefined') window.isInteracting = true;
                titleEl.textContent = `ESCOLHA SEU INICIAL — ${npcName}`;
                hintEl.textContent = hintText;
                gridEl.innerHTML = '';

                options.forEach(o => {
                    const baseId = o && o.id ? String(o.id) : '';
                    const name = o && o.name ? String(o.name) : baseId;
                    const sprite = o && o.sprite ? String(o.sprite) : '';
                    const type = o && o.type ? String(o.type).toLowerCase() : 'beast';
                    const baseStats = o && o.baseStats ? o.baseStats : {};

                    const card = document.createElement('button');
                    card.type = 'button';
                    card.className = 'starterCard';
                    card.setAttribute('data-starter-id', baseId);

                    // Sprite Container
                    const spriteContainer = document.createElement('div');
                    spriteContainer.className = 'starterSpriteContainer';
                    
                    const img = document.createElement('img');
                    img.className = 'starterSprite';
                    img.alt = name;
                    if (sprite) img.src = sprite;
                    else img.style.display = 'none';
                    
                    spriteContainer.appendChild(img);

                    // Name
                    const nm = document.createElement('div');
                    nm.className = 'starterName';
                    nm.textContent = name;

                    // Type Badge
                    const typeEl = document.createElement('div');
                    typeEl.className = `starterType type-${type}`;
                    typeEl.textContent = type;

                    // Stats Grid
                    const statsContainer = document.createElement('div');
                    statsContainer.className = 'starterStats';
                    
                    const stats = [
                        { label: 'HP', value: baseStats.hp || 0, icon: '❤️' },
                        { label: 'ATK', value: baseStats.attack || 0, icon: '⚔️' },
                        { label: 'DEF', value: baseStats.defense || 0, icon: '🛡️' },
                        { label: 'SPD', value: baseStats.speed || 0, icon: '⚡' }
                    ];
                    
                    stats.forEach(stat => {
                        const statDiv = document.createElement('div');
                        statDiv.className = 'starterStat';
                        statDiv.innerHTML = `
                            <span class="starterStatLabel">${stat.icon} ${stat.label}</span>
                            <span class="starterStatValue">${stat.value}</span>
                        `;
                        statsContainer.appendChild(statDiv);
                    });

                    card.appendChild(spriteContainer);
                    card.appendChild(nm);
                    card.appendChild(typeEl);
                    card.appendChild(statsContainer);

                    card.onclick = async () => {
                        card.disabled = true;
                        try {
                            const pickRes = await fetch('/api/starter/choose', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ userId: window.CURRENT_USER_ID, baseId, npcId })
                            });
                            const pickData = await pickRes.json().catch(() => ({}));
                            if (pickData && pickData.error) {
                                card.disabled = false;
                                await showRPGDialog(npcName, npcSkin, pickData.error);
                                return;
                            }
                            if (pickData && pickData.storyFlags) window.STORY_FLAGS = pickData.storyFlags;
                            const chosenName = (pickData.picked && pickData.picked.name) ? pickData.picked.name : 'seu monstro';
                            close();
                            await showRPGDialog(npcName, npcSkin, `Você escolheu ${chosenName}! Boa sorte na jornada.`);
                        } catch (e) {
                            card.disabled = false;
                            await showRPGDialog(npcName, npcSkin, 'Erro ao escolher o monstro inicial.');
                        }
                    };

                    gridEl.appendChild(card);
                });

                overlay.style.display = 'flex';
            }

            window.__openStarterPicker = open;
            window.__closeStarterPicker = close;
            closeBtn.onclick = () => close();
        })();

        window.moveToAndTalkToNPC = function(npc) {
            if (window.isMoving || window.isInteracting || window.isTeleporting || window.__menuOpen) return;
            const myPlayer = document.getElementById(`p-${window.myId}`); if (!myPlayer) return;

            function getNpcInteractRange(n) {
                const raw = n && n.interact ? n.interact.range : 0;
                const v = parseFloat(raw);
                return (Number.isFinite(v) && v > 0) ? v : 9;
            }

            // Assim que "aborda" (clica), pausa a patrulha e vira pro jogador.
            try {
                if (npc && npc._id) {
                    fetch('/api/npc/engage', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            npcId: npc._id,
                            playerX: parseFloat(myPlayer.style.left),
                            playerY: parseFloat(myPlayer.style.top),
                            pauseMs: 8000
                        })
                    }).catch(() => {});
                }
            } catch (_) {}

            const currX = parseFloat(myPlayer.style.left);
            const currY = parseFloat(myPlayer.style.top);
            const npcX = (typeof npc.x === 'number') ? npc.x : parseFloat(npc.x);
            const npcY = (typeof npc.y === 'number') ? npc.y : parseFloat(npc.y);
            const dx = npcX - currX;
            const dy = npcY - currY;
            const dist = Math.hypot(dx, dy);

            const interactRange = getNpcInteractRange(npc);

            // Se já está perto, inicia o menu direto.
            if (dist <= interactRange) {
                if (window.__menuOpen) return;
                interactWithNPC(npc);
                return;
            }


            // Pathfinding simples em grade (1%): evita o "caminho bloqueado" quando há rota ao redor.
            // Objetivo: chegar em qualquer ponto alcançável dentro de interactRange.
            function isPointBlocked(px, py) {
                const hitWall = getActiveCollisionMap().some(rect => px >= rect.x && px <= (rect.x + rect.w) && py >= rect.y && py <= (rect.y + rect.h));
                if (hitWall) return true;
                const hitStoryBarrier = (Array.isArray(storyBarriersMap) ? storyBarriersMap : []).some(barrier => {
                    if (!barrier || !barrier.requiredFlag) return false;
                    const flagValue = window.STORY_FLAGS && window.STORY_FLAGS[barrier.requiredFlag];
                    if (flagValue) return false;
                    return px >= barrier.x && px <= (barrier.x + barrier.w) && py >= barrier.y && py <= (barrier.y + barrier.h);
                });
                if (hitStoryBarrier) return true;
                const hitNpc = (currentNpcsCache || []).some(n => {
                    if (!n || !n.blocksMovement) return false;
                    const nx = typeof n.x === 'number' ? n.x : 0;
                    const ny = typeof n.y === 'number' ? n.y : 0;
                    return Math.abs(px - nx) <= 2.2 && Math.abs(py - ny) <= 2.2;
                });
                return hitNpc;
            }

            function clampGrid(v) {
                const n = Math.round(parseFloat(v));
                if (!Number.isFinite(n)) return 0;
                return Math.max(0, Math.min(100, n));
            }

            const startGX = clampGrid(currX);
            const startGY = clampGrid(currY);
            const npcGX = clampGrid(npcX);
            const npcGY = clampGrid(npcY);
            const goalRadius = Math.max(1, Math.min(40, Math.floor(interactRange))); // limite defensivo

            // Gera conjunto de células-alvo (dentro do alcance) - limite para não explodir.
            const goalSet = new Set();
            for (let ox = -goalRadius; ox <= goalRadius; ox++) {
                for (let oy = -goalRadius; oy <= goalRadius; oy++) {
                    const gx = npcGX + ox;
                    const gy = npcGY + oy;
                    if (gx < 0 || gx > 100 || gy < 0 || gy > 100) continue;
                    const d = Math.hypot(gx - npcGX, gy - npcGY);
                    if (d > interactRange) continue;
                    if (isPointBlocked(gx, gy)) continue;
                    goalSet.add(`${gx},${gy}`);
                }
            }

            // BFS (grade 101x101)
            const startKey = `${startGX},${startGY}`;
            const q = [{ x: startGX, y: startGY }];
            const visited = new Set([startKey]);
            const parent = new Map();

            let foundKey = null;
            if (goalSet.has(startKey)) foundKey = startKey;

            const dirs = [
                { dx: 1, dy: 0 },
                { dx: -1, dy: 0 },
                { dx: 0, dy: 1 },
                { dx: 0, dy: -1 }
            ];

            while (!foundKey && q.length) {
                const cur = q.shift();
                for (const d of dirs) {
                    const nx = cur.x + d.dx;
                    const ny = cur.y + d.dy;
                    if (nx < 0 || nx > 100 || ny < 0 || ny > 100) continue;
                    const k = `${nx},${ny}`;
                    if (visited.has(k)) continue;
                    if (isPointBlocked(nx, ny)) continue;
                    visited.add(k);
                    parent.set(k, `${cur.x},${cur.y}`);
                    if (goalSet.has(k)) { foundKey = k; break; }
                    q.push({ x: nx, y: ny });
                }
            }

            if (!foundKey) {
                // Se não achou rota, ainda permite falar se já estiver dentro do alcance.
                if (dist <= interactRange) {
                    if (window.__menuOpen) return;
                    interactWithNPC(npc);
                }
                return;
            }

            // Reconstrói caminho (do goal até o start)
            const path = [];
            let walkKey = foundKey;
            while (walkKey && walkKey !== startKey) {
                const parts = walkKey.split(',');
                path.push({ x: parseInt(parts[0], 10), y: parseInt(parts[1], 10) });
                walkKey = parent.get(walkKey);
            }
            path.reverse();

            // Compacta em segmentos retos visíveis (usa getSafeTarget para validar).
            const segments = [];
            let segFromX = currX;
            let segFromY = currY;
            let i = 0;
            while (i < path.length) {
                let best = { x: path[i].x, y: path[i].y };
                for (let j = i; j < path.length; j++) {
                    const cand = { x: path[j].x, y: path[j].y };
                    const safe = getSafeTarget(segFromX, segFromY, cand.x, cand.y);
                    const ok = (Math.hypot(safe.x - cand.x, safe.y - cand.y) < 0.01);
                    if (ok) best = cand;
                    else break;
                }
                segments.push(best);
                segFromX = best.x;
                segFromY = best.y;
                // avança até best
                while (i < path.length && !(path[i].x === best.x && path[i].y === best.y)) i++;
                i++;
                if (segments.length > 80) break; // limite defensivo
            }

            let segIndex = 0;
            window.isMoving = true;

            const step = () => {
                if (window.isInteracting || window.isTeleporting) { window.isMoving = false; return; }
                if (segIndex >= segments.length) {
                    window.isMoving = false;
                    const me = document.getElementById(`p-${window.myId}`);
                    const px = me ? parseFloat(me.style.left) : currX;
                    const py = me ? parseFloat(me.style.top) : currY;
                    const remain = Math.hypot(npcX - px, npcY - py);
                    if (remain <= interactRange) {
                        if (window.__menuOpen) return;
                        interactWithNPC(npc);
                    }
                    return;
                }

                const dest = segments[segIndex++];
                emitMovePlayer(dest.x, dest.y);
                const travelS = calcMoveDurationS(segFromX, segFromY, dest.x, dest.y);
                const travelTime = Math.max(120, travelS * 1000);
                segFromX = dest.x;
                segFromY = dest.y;

                setTimeout(() => {
                    const me = document.getElementById(`p-${window.myId}`);
                    const px = me ? parseFloat(me.style.left) : segFromX;
                    const py = me ? parseFloat(me.style.top) : segFromY;
                    const remain = Math.hypot(npcX - px, npcY - py);
                    if (remain <= interactRange) {
                        window.isMoving = false;
                        if (window.__menuOpen) return;
                        interactWithNPC(npc);
                        return;
                    }
                    step();
                }, travelTime + 60);
            };

            step();
        };

