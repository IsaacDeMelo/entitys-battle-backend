        function getSafeTarget(currX, currY, targetX, targetY) {
            const steps = 25;
            for (let i = 1; i <= steps; i++) {
                const t = i / steps; const px = currX + (targetX - currX) * t; const py = currY + (targetY - currY) * t;
                const hitWall = getActiveCollisionMap().some(rect => px >= rect.x && px <= (rect.x + rect.w) && py >= rect.y && py <= (rect.y + rect.h));
                const hitStoryBarrier = (Array.isArray(storyBarriersMap) ? storyBarriersMap : []).some(barrier => {
                    if (!barrier || !barrier.requiredFlag) return false;
                    const flagValue = window.STORY_FLAGS && window.STORY_FLAGS[barrier.requiredFlag];
                    if (flagValue) return false; // Flag ativada, barreira não bloqueia
                    return px >= barrier.x && px <= (barrier.x + barrier.w) && py >= barrier.y && py <= (barrier.y + barrier.h);
                });
                const hitNpc = (currentNpcsCache || []).some(n => {
                    if (!n || !n.blocksMovement) return false;
                    const nx = typeof n.x === 'number' ? n.x : 0;
                    const ny = typeof n.y === 'number' ? n.y : 0;
                    return Math.abs(px - nx) <= 2.2 && Math.abs(py - ny) <= 2.2;
                });
                const hit = hitWall || hitNpc || hitStoryBarrier;
                if (hit) return { x: currX + (targetX - currX) * ((i - 1) / steps), y: currY + (targetY - currY) * ((i - 1) / steps) };
            }
            return { x: targetX, y: targetY };
        }

        function hasDefeatedNpc(npcId) {
            try {
                const id = String(npcId || '').trim();
                if (!id) return false;
                const list = window.DEFEATED_NPCS || [];
                return (Array.isArray(list) ? list : []).some(r => {
                    if (!r) return false;
                    if (typeof r === 'string') return String(r) === id;
                    return String(r.npcId || '') === id;
                });
            } catch (_) {
                return false;
            }
        }

        function getActiveCollisionMap() {
            const list = Array.isArray(collisionMap) ? collisionMap : [];
            return list.filter(r => {
                const unlockNpcId = r && (r.unlockNpcId || r.unlockAfterNpcId || r.removeAfterNpcId);
                if (!unlockNpcId) return true;
                return !hasDefeatedNpc(unlockNpcId);
            });
        }

        let followerEl = null;
        let followerQueue = [];
        let followerTimer = null;
        let followerAnim = null;

        const SPRITECOLLAB_BASE = 'https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite';
        const POKEAPI_BASE = 'https://pokeapi.co/api/v2/pokemon';
        const spriteCache = new Map();
        const pokeHeightCache = new Map();

        const DIR_TO_ROW = { down: 0, downRight: 1, left: 6, upLeft: 3, up: 4, upRight: 5, right: 2, downLeft: 7 };
        const DIR_MAP = { down: 'down', left: 'left', up: 'up', right: 'right' };

        function padId(n) { return String(n).padStart(4, '0'); }

        function fetchWithTimeout(url, opts = {}, ms = 5000) {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), ms);
            return fetch(url, { ...opts, signal: ctrl.signal }).finally(() => clearTimeout(timer));
        }

        function loadImageWithTimeout(src, ms = 5000) {
            return new Promise((resolve, reject) => {
                const timer = setTimeout(() => reject(new Error('timeout')), ms);
                const i = new Image();
                i.crossOrigin = 'anonymous';
                i.onload = () => { clearTimeout(timer); resolve(i); };
                i.onerror = () => { clearTimeout(timer); reject(new Error('img')); };
                i.src = src;
            });
        }

        async function loadSpriteData(dexOrder) {
            if (!dexOrder || dexOrder <= 0) return null;
            if (spriteCache.has(dexOrder)) return spriteCache.get(dexOrder);
            const id = padId(dexOrder);
            const base = `${SPRITECOLLAB_BASE}/${id}`;
            try {
                const [walkImg, idleImg, xmlRes] = await Promise.all([
                    loadImageWithTimeout(`${base}/Walk-Anim.png`, 6000),
                    loadImageWithTimeout(`${base}/Idle-Anim.png`, 6000).catch(() => null),
                    fetchWithTimeout(`${base}/AnimData.xml`, {}, 6000).then(r => r.ok ? r.text() : Promise.reject('xml'))
                ]);
                const parser = new DOMParser();
                const xml = parser.parseFromString(xmlRes, 'text/xml');
                const parseAnim = (name) => {
                    for (const anim of xml.querySelectorAll('Anim')) {
                        if (anim.querySelector('Name')?.textContent === name) {
                            return {
                                fw: parseInt(anim.querySelector('FrameWidth')?.textContent) || 40,
                                fh: parseInt(anim.querySelector('FrameHeight')?.textContent) || 40,
                                framesPerDir: anim.querySelectorAll('Duration').length || 6
                            };
                        }
                    }
                    return null;
                };
                const walkMeta = parseAnim('Walk');
                const idleMeta = parseAnim('Idle');
                const fw = walkMeta?.fw || 40, fh = walkMeta?.fh || 40;
                const framesPerDir = walkMeta?.framesPerDir || 6;
                const walkData = walkImg ? {
                    img: walkImg, fw: walkMeta?.fw || fw, fh: walkMeta?.fh || fh,
                    framesPerDir: walkMeta?.framesPerDir || framesPerDir,
                    cols: Math.floor(walkImg.width / (walkMeta?.fw || fw)),
                    rows: Math.floor(walkImg.height / (walkMeta?.fh || fh))
                } : null;
                const idleData = idleImg ? {
                    img: idleImg, fw: idleMeta?.fw || fw, fh: idleMeta?.fh || fh,
                    framesPerDir: idleMeta?.framesPerDir || 6,
                    cols: Math.floor(idleImg.width / (idleMeta?.fw || fw)),
                    rows: Math.floor(idleImg.height / (idleMeta?.fh || fh))
                } : null;
                const data = { walk: walkData, idle: idleData, fw, fh, framesPerDir };
                spriteCache.set(dexOrder, data);
                return data;
            } catch (_) {
                spriteCache.set(dexOrder, null);
                return null;
            }
        }

        async function fetchPokeHeight(dexOrder) {
            if (!dexOrder || dexOrder <= 0) return null;
            if (pokeHeightCache.has(dexOrder)) return pokeHeightCache.get(dexOrder);
            try {
                const res = await fetchWithTimeout(`${POKEAPI_BASE}/${dexOrder}`, {}, 5000);
                if (!res.ok) return null;
                const json = await res.json();
                const heightDm = json.height || 10;
                pokeHeightCache.set(dexOrder, heightDm);
                return heightDm;
            } catch (_) {
                pokeHeightCache.set(dexOrder, null);
                return null;
            }
        }

        function calcFollowerSize(heightDm) {
            if (!heightDm) return 40;
            const min = 36, max = 56;
            const size = Math.round(min + (heightDm / 25) * (max - min));
            return Math.max(min, Math.min(max, size));
        }

        function createFollowerCanvas(spriteData, dir, size) {
            size = size || 44;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            canvas.style.width = size + 'px';
            canvas.style.height = size + 'px';
            drawFollowerFrame(canvas, spriteData, 0, dir);
            return canvas;
        }

        function drawFollowerFrame(canvas, spriteData, frameIdx, dir) {
            if (!spriteData || !canvas) return;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.imageSmoothingEnabled = false;
            const row = DIR_TO_ROW[dir] ?? 0;
            const col = frameIdx % spriteData.cols;
            const sx = col * spriteData.fw;
            const sy = row * spriteData.fh;
            const scale = Math.min(canvas.width / spriteData.fw, canvas.height / spriteData.fh);
            const dw = spriteData.fw * scale;
            const dh = spriteData.fh * scale;
            const dx = (canvas.width - dw) / 2;
            const dy = (canvas.height - dh) / 2;
            ctx.drawImage(spriteData.img, sx, sy, spriteData.fw, spriteData.fh, dx, dy, dw, dh);
        }

        class FollowerAnimator {
            constructor(el) {
                this.el = el;
                this.walkData = null;
                this.idleData = null;
                this.currentFrame = 0;
                this.currentDir = 'down';
                this.isPlaying = false;
                this.interval = null;
                this.speed = 180;
                this.canvasSize = 44;
            }
            setSprites(walkData, idleData) {
                this.walkData = walkData;
                this.idleData = idleData || walkData;
                this.currentFrame = 0;
                this.render(true);
            }
            play(dir) {
                const data = this.walkData;
                if (!data) return;
                this.currentDir = dir || this.currentDir;
                if (this.isPlaying) return;
                this.isPlaying = true;
                this.currentFrame = 0;
                this.interval = setInterval(() => {
                    this.currentFrame = (this.currentFrame + 1) % this.walkData.framesPerDir;
                    this.render(false);
                }, this.speed);
            }
            stop() {
                this.isPlaying = false;
                if (this.interval) { clearInterval(this.interval); this.interval = null; }
                this.currentFrame = 0;
                this.render(false);
            }
            setDir(dir) {
                if (this.currentDir === dir) return;
                this.currentDir = dir;
                if (!this.isPlaying) this.render(false);
            }
            render(forceResize) {
                const canvas = this.el.querySelector('canvas');
                if (!canvas) return;
                const data = this.isPlaying ? this.walkData : this.idleData;
                if (!data) return;
                if (forceResize) {
                    canvas.width = this.canvasSize;
                    canvas.height = this.canvasSize;
                    canvas.style.width = this.canvasSize + 'px';
                    canvas.style.height = this.canvasSize + 'px';
                }
                drawFollowerFrame(canvas, data, this.currentFrame, this.currentDir);
            }
        }

        function setFollowingEntityId(id) {
            window.FOLLOWING_ENTITY_ID = id || '';
            setupFollower();
        }
        window.setFollowingEntityId = setFollowingEntityId;

        function getFollowerData() {
            const cache = window.__ME_CACHE;
            if (!cache || !Array.isArray(cache.team)) return null;
            const id = String(window.FOLLOWING_ENTITY_ID || '').trim();
            if (!id) return null;
            return cache.team.find(p => String(p.instanceId) === id) || null;
        }

        function removeFollower() {
            if (followerAnim) { followerAnim.stop(); followerAnim = null; }
            if (followerEl) followerEl.remove();
            followerEl = null;
            followerQueue = [];
            if (followerTimer) { clearInterval(followerTimer); followerTimer = null; }
        }

        async function ensureFollowerElement(data) {
            if (!data) return false;
            const dexOrder = data.dexOrder || 0;
            const [spriteData, heightDm] = await Promise.all([
                dexOrder ? loadSpriteData(dexOrder) : Promise.resolve(null),
                dexOrder ? fetchPokeHeight(dexOrder) : Promise.resolve(null)
            ]);
            const canvasSize = calcFollowerSize(heightDm);

            function positionFollower(el, sz) {
                el.style.marginLeft = -Math.round(sz / 2) + 'px';
                el.style.marginTop = -Math.round(sz * 0.8) + 'px';
            }

            if (!followerEl) {
                followerEl = document.createElement('div');
                followerEl.id = 'follower';
                followerEl.className = 'follower';
                if (spriteData && spriteData.walk) {
                    const canvas = createFollowerCanvas(spriteData.walk, 'down', canvasSize);
                    followerEl.appendChild(canvas);
                    followerAnim = new FollowerAnimator(followerEl);
                    followerAnim.canvasSize = canvasSize;
                    followerAnim.setSprites(spriteData.walk, spriteData.idle);
                    positionFollower(followerEl, canvasSize);
                } else {
                    const img = document.createElement('img');
                    img.src = resolveImg(data.icon || data.sprite);
                    img.alt = data.name || 'Seguidor';
                    followerEl.appendChild(img);
                    positionFollower(followerEl, 72);
                }
                gameArea.appendChild(followerEl);
            } else {
                if (spriteData && spriteData.walk) {
                    let canvas = followerEl.querySelector('canvas');
                    if (!canvas) {
                        const oldImg = followerEl.querySelector('img');
                        if (oldImg) oldImg.remove();
                        canvas = createFollowerCanvas(spriteData.walk, 'down', canvasSize);
                        followerEl.appendChild(canvas);
                        followerAnim = new FollowerAnimator(followerEl);
                    }
                    followerAnim.canvasSize = canvasSize;
                    followerAnim.setSprites(spriteData.walk, spriteData.idle);
                    positionFollower(followerEl, canvasSize);
                } else {
                    const oldCanvas = followerEl.querySelector('canvas');
                    if (oldCanvas) oldCanvas.remove();
                    let img = followerEl.querySelector('img');
                    if (!img) {
                        img = document.createElement('img');
                        followerEl.appendChild(img);
                    }
                    img.src = resolveImg(data.icon || data.sprite);
                    positionFollower(followerEl, 72);
                }
            }
            return true;
        }

        function setupFollower() {
            const data = getFollowerData();
            if (!data) { removeFollower(); return; }
            ensureFollowerElement(data).then(ok => {
                if (!ok) { removeFollower(); return; }
                const me = document.getElementById(`p-${window.myId}`);
                if (me) {
                    const x = parseFloat(me.style.left) || 50;
                    const y = parseFloat(me.style.top) || 50;
                    updateFollowerPosition({ x, y, dir: me.getAttribute('data-dir') || 'down' }, true);
                }
                if (!followerTimer) startFollowerLoop();
            }).catch(() => { removeFollower(); });
        }

        function applyFollowerOffset(pos) {
            let x = pos.x;
            let y = pos.y;
            const dir = pos.dir || 'down';
            if (dir === 'up') { y = y + 6; }
            else if (dir === 'down') { y = y - 3; }
            else if (dir === 'left') { x = x + 8; y = y + 2; }
            else if (dir === 'right') { x = x - 8; y = y + 2; }
            x = Math.max(0, Math.min(100, x));
            y = Math.max(0, Math.min(100, y));
            return { x, y, dir };
        }

        let followerMoving = false;
        let followerMoveTimeout = null;

        function updateFollowerPosition(pos, immediate = false) {
            if (!followerEl) return;
            const next = applyFollowerOffset(pos);
            followerEl.style.transition = immediate ? 'none' : 'top 0.18s linear, left 0.18s linear';
            followerEl.style.left = next.x + '%';
            followerEl.style.top = next.y + '%';
            followerEl.style.zIndex = Math.floor(next.y) - 1;

            if (followerAnim && followerAnim.walkData) {
                followerEl.classList.remove('flip');
                followerAnim.setDir(next.dir);
                if (!followerAnim.isPlaying) followerAnim.play(next.dir);
                followerMoving = true;
                if (followerMoveTimeout) clearTimeout(followerMoveTimeout);
                followerMoveTimeout = setTimeout(() => {
                    if (followerAnim) followerAnim.stop();
                    followerMoving = false;
                }, 250);
            } else {
                if (next.dir === 'right') followerEl.classList.add('flip');
                else if (next.dir === 'left') followerEl.classList.remove('flip');
            }

            followerEl.classList.remove('hop');
            void followerEl.offsetWidth;
            followerEl.classList.add('hop');
            setTimeout(() => { if (followerEl) followerEl.classList.remove('hop'); }, 360);
        }

        function enqueueFollowerPosition(pos) {
            if (!followerEl) return;
            followerQueue.push(pos);
            if (followerQueue.length > 20) followerQueue.shift();
            if (followerQueue.length === 1) updateFollowerPosition(pos);
        }

        function startFollowerLoop() {
            if (followerTimer) return;
            followerTimer = setInterval(() => {
                if (!followerEl) return;
                if (followerQueue.length === 0) return;
                const next = followerQueue.shift();
                updateFollowerPosition(next);
            }, 180);
        }

        const remoteFollowers = new Map();

        async function ensureRemoteFollower(playerId, sprite, name, dexOrder) {
            if (!playerId) return null;
            const hasSpritecollab = dexOrder && dexOrder > 0;
            let entry = remoteFollowers.get(playerId);

            function positionFollower(el, sz) {
                el.style.marginLeft = -Math.round(sz / 2) + 'px';
                el.style.marginTop = -Math.round(sz * 0.8) + 'px';
            }

            if (!entry) {
                const el = document.createElement('div');
                el.className = 'follower';
                el.dataset.ownerId = playerId;
                let anim = null;
                let canvasSize = 44;

                if (hasSpritecollab) {
                    const [spriteData, heightDm] = await Promise.all([
                        loadSpriteData(dexOrder),
                        fetchPokeHeight(dexOrder)
                    ]);
                    canvasSize = calcFollowerSize(heightDm);
                    if (spriteData && spriteData.walk) {
                        const canvas = createFollowerCanvas(spriteData.walk, 'down', canvasSize);
                        el.appendChild(canvas);
                        anim = new FollowerAnimator(el);
                        anim.canvasSize = canvasSize;
                        anim.setSprites(spriteData.walk, spriteData.idle);
                        positionFollower(el, canvasSize);
                    }
                }
                if (!el.querySelector('canvas')) {
                    if (sprite) {
                        const img = document.createElement('img');
                        img.src = resolveImg(sprite);
                        img.alt = name || 'Seguidor';
                        el.appendChild(img);
                        positionFollower(el, 72);
                    }
                }
                gameArea.appendChild(el);
                entry = { el, sprite, anim, dexOrder, canvasSize };
                remoteFollowers.set(playerId, entry);
            } else {
                if (hasSpritecollab && hasSpritecollab !== entry.dexOrder) {
                    const [spriteData, heightDm] = await Promise.all([
                        loadSpriteData(dexOrder),
                        fetchPokeHeight(dexOrder)
                    ]);
                    entry.canvasSize = calcFollowerSize(heightDm);
                    if (spriteData && spriteData.walk) {
                        const oldImg = entry.el.querySelector('img');
                        if (oldImg) oldImg.remove();
                        let canvas = entry.el.querySelector('canvas');
                        if (!canvas) {
                            canvas = createFollowerCanvas(spriteData.walk, 'down', entry.canvasSize);
                            entry.el.appendChild(canvas);
                        }
                        if (!entry.anim) {
                            entry.anim = new FollowerAnimator(entry.el);
                        }
                        entry.anim.canvasSize = entry.canvasSize;
                        entry.anim.setSprites(spriteData.walk, spriteData.idle);
                        entry.dexOrder = dexOrder;
                        positionFollower(entry.el, entry.canvasSize);
                    }
                } else if (!hasSpritecollab && sprite && sprite !== entry.sprite) {
                    const img = entry.el.querySelector('img');
                    if (img) img.src = resolveImg(sprite);
                    entry.sprite = sprite;
                }
            }
            return entry;
        }

        function removeRemoteFollower(playerId) {
            const entry = remoteFollowers.get(playerId);
            if (entry) {
                if (entry.anim) entry.anim.stop();
                if (entry.el) entry.el.remove();
            }
            remoteFollowers.delete(playerId);
        }

        function updateRemoteFollowerPosition(playerId, pos, immediate = false) {
            const entry = remoteFollowers.get(playerId);
            if (!entry || !entry.el) return;
            const next = applyFollowerOffset(pos);
            entry.el.style.transition = immediate ? 'none' : 'top 0.18s linear, left 0.18s linear';
            entry.el.style.left = next.x + '%';
            entry.el.style.top = next.y + '%';
            entry.el.style.zIndex = Math.floor(next.y) - 1;

            if (entry.anim && entry.anim.walkData) {
                entry.el.classList.remove('flip');
                entry.anim.setDir(next.dir);
                if (!entry.anim.isPlaying) entry.anim.play(next.dir);
                if (entry._moveTimeout) clearTimeout(entry._moveTimeout);
                entry._moveTimeout = setTimeout(() => {
                    if (entry.anim) entry.anim.stop();
                }, 250);
            } else {
                if (next.dir === 'right') entry.el.classList.add('flip');
                else if (next.dir === 'left') entry.el.classList.remove('flip');
            }
        }

        function syncRemoteFollower(p) {
            if (!p || !p.id || p.id === window.myId) return;
            if (!p.followerSprite && !p.followerDexOrder) { removeRemoteFollower(p.id); return; }
            ensureRemoteFollower(p.id, p.followerSprite, p.followerName, p.followerDexOrder).catch(() => {});
            updateRemoteFollowerPosition(p.id, { x: p.x, y: p.y, dir: p.direction || 'down' }, true);
        }

        function findNearbyStoryBarrier(x, y, margin = 0) {
            const list = Array.isArray(storyBarriersMap) ? storyBarriersMap : [];
            const m = Number.isFinite(margin) ? Math.max(0, margin) : 0;
            return list.find(barrier => {
                if (!barrier || !barrier.requiredFlag) return false;
                return x >= (barrier.x - m)
                    && x <= (barrier.x + barrier.w + m)
                    && y >= (barrier.y - m)
                    && y <= (barrier.y + barrier.h + m);
            }) || null;
        }

        let __itemCatalogCache = null;
        let __itemCatalogById = null;
        let __barrierPromptContext = null;

        async function loadItemCatalogCache() {
            if (__itemCatalogCache) return __itemCatalogCache;
            try {
                const res = await fetch('/api/items/catalog');
                const json = await res.json().catch(() => ({}));
                __itemCatalogCache = (json && json.success && Array.isArray(json.items)) ? json.items : [];
            } catch (_) {
                __itemCatalogCache = [];
            }
            __itemCatalogById = new Map((__itemCatalogCache || []).map(it => [String(it.id), String(it.name || it.id || '')]));
            return __itemCatalogCache;
        }

        function getItemNameFromCache(itemId) {
            if (!__itemCatalogById || !itemId) return '';
            return __itemCatalogById.get(String(itemId)) || '';
        }

        function openBarrierPrompt(flagId, itemId) {
            const overlay = document.getElementById('barrierPromptOverlay');
            const nameEl = document.getElementById('barrierPromptName');
            const iconEl = document.getElementById('barrierPromptIcon');
            const btnUse = document.getElementById('barrierPromptUse');
            const btnCancel = document.getElementById('barrierPromptCancel');
            if (!overlay || !nameEl || !iconEl || !btnUse || !btnCancel) return;

            __barrierPromptContext = { flagId, itemId };
            window.__barrierPromptActive = true;
            window.__lastBarrierPromptAt = Date.now();

            nameEl.textContent = itemId || 'Item';
            iconEl.src = itemId ? `/api/items/icon/${encodeURIComponent(itemId)}.png` : '';

            btnUse.disabled = false;
            btnUse.textContent = 'USAR';

            btnUse.onclick = async () => {
                if (!__barrierPromptContext) return;
                btnUse.disabled = true;
                btnUse.textContent = 'AGUARDE';
                try {
                    const resp = await fetch('/api/map/use-key', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userId: USER_ID,
                            flagId: __barrierPromptContext.flagId,
                            itemId: __barrierPromptContext.itemId,
                            qty: 1
                        })
                    });
                    const data = await resp.json().catch(() => ({}));
                    if (data && data.success) {
                        if (typeof showToast === 'function') showToast('Barreira removida.');
                        if (typeof window.__syncClientStateFromServer === 'function') {
                            await window.__syncClientStateFromServer(data);
                        } else {
                            if (data.bag) window.USER_BAG = data.bag;
                            if (Array.isArray(data.keyItems)) window.USER_KEY_ITEMS = data.keyItems;
                            if (data.storyFlags) window.STORY_FLAGS = data.storyFlags;
                        }
                        try { renderMapObjects && renderMapObjects(); } catch (_) {}
                        closeBarrierPrompt();
                        return;
                    }

                    if (data && data.needsItem) {
                        if (typeof showToast === 'function') showToast('Voce nao possui o item necessario.', { bg: '#e74c3c' });
                    } else {
                        if (typeof showToast === 'function') showToast('Nao foi possivel usar o item.', { bg: '#e74c3c' });
                    }
                } catch (e) {
                    console.error(e);
                    if (typeof showToast === 'function') showToast('Erro ao usar item.', { bg: '#e74c3c' });
                } finally {
                    btnUse.disabled = false;
                    btnUse.textContent = 'USAR';
                }
            };

            btnCancel.onclick = () => closeBarrierPrompt();

            overlay.style.display = 'flex';

            loadItemCatalogCache().then(() => {
                const label = getItemNameFromCache(itemId);
