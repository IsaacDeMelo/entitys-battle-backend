        function markMapReady() {
            const overlay = document.getElementById('transitionOverlay');
            if (!overlay) return;
            const finish = () => requestAnimationFrame(() => overlay.classList.add('hidden'));
            const gate = window.__bootGatePromise;
            if (gate && typeof gate.then === 'function') {
                gate.then(finish).catch(finish);
            } else {
                finish();
            }
        }

        function performTransition(onMidPoint) {
            if(window.isTeleporting) return;
            window.isTeleporting = true; window.isMoving = false;
            window.__transitionNavigating = false;
            const overlay = document.getElementById('transitionOverlay');
            overlay.classList.remove('hidden'); 
            const FADE_MS = 280;
            setTimeout(async () => {
                try {
                    await onMidPoint();
                } finally {
                    // Se não houver navegação (portal bloqueado etc), volta com fade-out suave.
                    if (!window.__transitionNavigating) {
                        overlay.classList.add('hidden');
                        setTimeout(() => { window.isTeleporting = false; }, FADE_MS);
                    }
                }
            }, FADE_MS);
        }

        function formatMoney(value) {
            const amount = Number.isFinite(value) ? value : (parseInt(value, 10) || 0);
