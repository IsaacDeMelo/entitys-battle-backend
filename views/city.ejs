        function configureStoryBarrier(barrier) {
            const existingFlag = String(barrier.requiredFlag || '').trim();
            const existingItem = String(barrier.requiredItemId || barrier.requiredKey || barrier.requiredKeyId || '').trim();
            const defaultType = existingItem ? 'item' : 'flag';
            const typeRaw = prompt('Tipo de barreira (flag/item)?', defaultType);
            if (typeRaw === null) return null;
            const type = String(typeRaw || '').trim().toLowerCase();

            let flagId = existingFlag;
            let itemId = existingItem;

            if (type === 'item') {
                const itemRaw = prompt('ID do item necessario:', existingItem || '');
                if (itemRaw === null) return null;
                const itemTrim = String(itemRaw || '').trim();
                if (!itemTrim) { alert('ID do item nao pode ser vazio!'); return null; }
                itemId = itemTrim;
                if (!flagId) flagId = `barrier_${Date.now()}`;
            } else {
                const flagRaw = prompt('Nome da StoryFlag necessaria para passar:', existingFlag || '');
                if (flagRaw === null) return null;
                const flagTrim = String(flagRaw || '').trim();
                if (!flagTrim) { alert('Nome da flag nao pode ser vazio!'); return null; }
                flagId = flagTrim;
                itemId = '';
            }

            const color = prompt('Cor da barreira (ex: yellow). Deixe vazio para padrao:', barrier.color || 'yellow');
            if (color !== null) {
                if (String(color).trim()) barrier.color = String(color).trim().toLowerCase();
                else delete barrier.color;
            }

            barrier.requiredFlag = flagId;
            if (itemId) barrier.requiredItemId = itemId; else delete barrier.requiredItemId;
            delete barrier.requiredKey;
            delete barrier.requiredKeyId;
            return barrier;
        }

        function configureGrassPatch(grassPatch) {
            const currentKey = String(grassPatch.encounterKey || '').trim();
            const currentRate = Number.isFinite(grassPatch.encounterRate) ? grassPatch.encounterRate : 0.08;
            const currentLabel = String(grassPatch.label || '').trim();

            const keyRaw = prompt('Chave de encontro da grama. Ex: city_garden. Vazio = usar o mapa atual:', currentKey);
            if (keyRaw === null) return null;
            const encounterKey = String(keyRaw || '').trim();

            const rateRaw = prompt('Chance de encontro desta grama (0.00 a 1.00):', String(currentRate));
            if (rateRaw === null) return null;
            const parsedRate = parseFloat(rateRaw);
            if (!Number.isFinite(parsedRate) || parsedRate < 0 || parsedRate > 1) {
                alert('A chance de encontro deve ficar entre 0.00 e 1.00');
                return null;
            }

            const labelRaw = prompt('Nome curto da zona (opcional):', currentLabel);
            if (labelRaw === null) return null;

            if (encounterKey) grassPatch.encounterKey = encounterKey;
            else delete grassPatch.encounterKey;

            grassPatch.encounterRate = parsedRate;

            const label = String(labelRaw || '').trim();
            if (label) grassPatch.label = label;
            else delete grassPatch.label;

            return grassPatch;
        }

