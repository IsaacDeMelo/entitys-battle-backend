                        const MAP = { 'pokeball':'poke-ball','capturecube':'poke-ball','capture_cube':'poke-ball','rarecandy':'rare-candy','rare-candy':'rare-candy','levelupcrystal':'rare-candy' };
                        const slug = MAP[raw] || raw.replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
                        return `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/${slug}.png`;
                    })();
                    items.push({ id, name, icon, qty: n });
