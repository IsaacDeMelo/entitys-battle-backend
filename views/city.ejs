        function renderNpcEditorList() {
            const el = document.getElementById('npcEditorListItems');
            if (!el) return;
            el.innerHTML = '';
            const list = (currentNpcsCache || []).slice();
            if (list.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'npcHint';
                empty.innerText = 'Nenhum NPC neste mapa.';
                el.appendChild(empty);
                return;
            }
            
            // Agrupa NPCs por tipo
            const grouped = {
                trainer: [], quest: [], starter: [], heal: [], shop: [], box: [], decor: []
            };
            
            list.forEach(n => {
                const type = inferNpcTypeFromNpc(n);
                if (grouped[type]) grouped[type].push(n);
                else grouped.decor.push(n);
            });
            
            // Renderiza cada grupo
            Object.keys(npcTypeConfig).forEach(type => {
                if (grouped[type].length > 0) {
                    const config = npcTypeConfig[type];
                    const header = document.createElement('div');
                    header.className = 'npc-group-header';
                    header.style.backgroundColor = config.bg;
                    header.style.borderLeftColor = config.color;
                    header.style.color = config.color;
                    header.innerHTML = `${config.icon} ${config.text} <span style="opacity:0.6">(${grouped[type].length})</span>`;
                    el.appendChild(header);
                    
                    grouped[type].sort((a, b) => (a.y || 0) - (b.y || 0)).forEach(n => {
                        const item = document.createElement('div');
                        item.className = 'npc-list-item' + (npcEditorSelectedId === n._id ? ' active' : '');
                        const name = (n.name || 'NPC').replace(/\(kid\)/i, '').trim();
                        item.innerHTML = `<div style="font-weight:600;margin-bottom:3px;">${escapeHtml(name)}</div><div style="font-size:0.7rem;opacity:0.7;">X:${n.x} Y:${n.y}</div>`;
                        item.onclick = () => loadNpcToEditor(n._id);
                        el.appendChild(item);
                    });
                }
            });
        }

        function escapeHtml(str) {
            return String(str || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

