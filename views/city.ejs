            trainer: { icon: '⚔️', text: 'TREINADOR', color: '#e74c3c', bg: 'rgba(231, 76, 60, 0.2)' },
            starter: { icon: '🎁', text: 'INICIAL', color: '#9b59b6', bg: 'rgba(155, 89, 182, 0.2)' },
            heal: { icon: '💚', text: 'CURANDEIRO', color: '#2ecc71', bg: 'rgba(46, 204, 113, 0.2)' },
            shop: { icon: '🛒', text: 'LOJA', color: '#f39c12', bg: 'rgba(243, 156, 18, 0.2)' },
            box: { icon: '🎲', text: 'BOX / GACHA', color: '#16a085', bg: 'rgba(22, 160, 133, 0.2)' }
