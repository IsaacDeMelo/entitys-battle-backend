                    else ITEM_CATALOG_BAG = [];
                } catch (_) { ITEM_CATALOG_BAG = []; }
            }

            const getMeta = (id) => {
                if (!ITEM_CATALOG_BAG) return null;
                return ITEM_CATALOG_BAG.find(it => String(it.id) === String(id)) || null;
            };

            const items = [];

            // Itens da mochila (bag)
            for (const [id, qty] of Object.entries(bag)) {
                const n = parseInt(qty, 10);
                if (Number.isFinite(n) && n > 0) {
                    const meta = getMeta(id);
                    const name = (meta && meta.name) ? meta.name : String(id);
                    const icon = (() => {
                        if (meta && meta.iconUrl) return meta.iconUrl;
                        if (meta && meta.icon) return meta.icon;
                        if (meta && meta.hasIcon) return `/api/items/icon/${encodeURIComponent(id)}.png`;
