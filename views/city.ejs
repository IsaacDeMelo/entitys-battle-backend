            bottom: calc(max(20px, env(safe-area-inset-bottom) + 15px) + 78px);
            width: 92%;
            max-width: 420px;
            z-index: 9000;
            display: block;
            height: 140px;
            pointer-events: none;
        }
        body.menu-open #controlsDock { z-index: 9000; }

        #controlsDock * { pointer-events: auto; }

        /* Some UI fica invisível enquanto desenha o mapa no modo dev */
