        async function handleObjectInteraction(obj) {
            window.isInteracting = true; window.isMoving = false;
            let customImg = obj.image || null;
            if(customImg) setDialogImageStyle('full'); else setDialogImageStyle('pixel');

            let toastMsg = '';
            let toastOpts = null;

            // Se o objeto dá um item, chama a API antes para checar unicidade
            if (obj.type === 'item' || obj.type === 'both') {
                if (obj.itemId) {
                    try {
                        const mapId = (window.mapConfig && window.mapConfig.mapId) ? window.mapConfig.mapId : '';
                        const resp = await fetch('/api/map/interact', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ userId: USER_ID, mapId, obj })
                        });
                        const data = await resp.json().catch(() => ({}));

                        if (data && data.alreadyDone) {
                            if (typeof showToast === 'function') showToast('Nada aqui.', { bg: '#aaa' });
                            // Atualiza estados cliente
                            if (data && data.bag) window.USER_BAG = data.bag;
                            if (data && Array.isArray(data.keyItems)) window.USER_KEY_ITEMS = data.keyItems;
                            if (data && data.storyFlags) window.STORY_FLAGS = data.storyFlags;
