            // Itens-chave
            for (const id of keys) {
                if (!items.find(it => it.id === id)) {
                    const metaKey = getMeta(id) || { name: id, hasIcon: false };
                    const iconKey = metaKey.iconUrl || metaKey.icon || (metaKey.hasIcon ? `/api/items/icon/${encodeURIComponent(id)}.png` : (()=>{ const raw=String(id||'').toLowerCase(); const MAP={'pokeball':'poke-ball'}; const slug=MAP[raw]||raw.replace(/[^a-z0-9]+/g,'-'); return `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/${slug}.png`; })());
                    items.push({ id, name: metaKey.name || id, icon: iconKey, qty: 1 });
