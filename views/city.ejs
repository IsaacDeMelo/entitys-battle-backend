        async function navigateToMapClientSide(targetMapId, targetX, targetY) {
            if (window.isTeleporting) return;
            window.isTeleporting = true;
            window.isMoving = false;
            window.__transitionNavigating = false;

            // Fecha todos os modais abertos antes de navegar
            if (typeof closeAllModals === 'function') closeAllModals();

            const overlay = document.getElementById('transitionOverlay');
            if (overlay) overlay.classList.remove('hidden');
            
            try {
                // Carrega dados do novo mapa
                const newMapData = await fetchMapData(targetMapId);
                if (!newMapData) {
                    console.warn('[MAP NAV] Falha ao carregar dados do mapa:', targetMapId);
                    window.isTeleporting = false;
                    return;
                }

                // Aguarda ~150ms para o fade-out completar
                await new Promise(r => setTimeout(r, 280));

                // ===== Atualiza dados globais do mapa =====
                currentMapId = targetMapId;
                window.currentMapId = currentMapId;
                mapConfig = newMapData;
                __pendingWildEncounter = null;
                updateAreaHud();
                collisionMap = newMapData.collisions || [];
                grassMap = newMapData.grass || [];
                interactsMap = newMapData.interacts || [];
                portalsMap = newMapData.portals || [];
                storyBarriersMap = newMapData.storyBarriers || [];
                objectsMap = newMapData.objects || [];

                // ===== Limpa NPCs antigos da tela =====
                document.querySelectorAll('.npc-entity').forEach(el => el.remove());
                currentNpcsCache = [];

                // ===== Atualiza visuals do mapa =====
                applyMapVisuals(mapConfig);

                // ===== Coloca player no novo mapa =====
                const myEl = document.getElementById(`p-${window.myId}`);
                if (myEl) {
                    myEl.style.left = targetX + '%';
                    myEl.style.top = targetY + '%';
                }

                // ===== Avisa servidor que entrou no novo mapa =====
                socket.emit('enter_map', { 
                    userId: window.CURRENT_USER_ID, 
                    name: myName, 
                    skin: mySkin, 
                    map: targetMapId, 
                    x: targetX, 
                    y: targetY, 
                    direction: 'down' 
                });

                // ===== Fade-in =====
                if (overlay) overlay.classList.add('hidden');
                setTimeout(() => { window.isTeleporting = false; }, 280);

            } catch (error) {
                console.error('[MAP NAV] Erro na navegação:', error);
                if (overlay) overlay.classList.add('hidden');
                window.isTeleporting = false;
            }
        }

        socket.on('npcs_list', (npcs) => {
            const list = Array.isArray(npcs) ? npcs : [];
            currentNpcsCache = list;

            const seen = new Set();
            list.forEach(npc => {
                if (!npc || !npc._id) return;
                const npcId = String(npc._id);
                seen.add(npcId);

                let div = document.getElementById(`npc-${npcId}`);
                const isNew = !div;
                if (!div) {
                    div = document.createElement('div');
                    div.className = 'player npc-entity';
                    div.id = `npc-${npcId}`;
                    div.onclick = (e) => {
                        e.stopPropagation();
                        const latest = (currentNpcsCache || []).find(n => String(n._id) === npcId) || npc;
                        if (devMode) {
                            if (currentTool === 'moveNpc') selectNpcToMove(npcId);
                        } else {
                            moveToAndTalkToNPC(latest);
                        }
                    };
                    gameArea.appendChild(div);
                }

                // Skin / label / flags
                const isKid = npc.name && String(npc.name).toLowerCase().includes('(kid)');
                div.classList.toggle('kid-scale', !!isKid);

                const rawNpcSkin = String(npc.skin || '').trim();
                const skinUrl = (rawNpcSkin && (rawNpcSkin.startsWith('http') || rawNpcSkin.startsWith('data:')))
                    ? rawNpcSkin
                    : (rawNpcSkin ? `/skins/${encodeURIComponent(rawNpcSkin)}.png` : '');
                if (div.dataset.skinUrl !== skinUrl) {
                    div.style.backgroundImage = skinUrl ? `url('${skinUrl}')` : 'none';
                    div.dataset.skinUrl = skinUrl;
                }

                const displayName = String(npc.name || 'NPC').replace(/\(kid\)/i, '').trim();
                let label = div.querySelector('.player-name');
                if (!label) {
                    label = document.createElement('div');
                    label.className = 'player-name';
                    div.appendChild(label);
                }
                if (label.innerText !== displayName) label.innerText = displayName;

                // Movement (smooth + walking)
                const targetX = (typeof npc.x === 'number') ? npc.x : parseFloat(npc.x) || 50;
                const targetY = (typeof npc.y === 'number') ? npc.y : parseFloat(npc.y) || 50;
                const currentLeft = parseFloat(div.style.left);
                const currentTop = parseFloat(div.style.top);
                const nowTs = Date.now();
                const isPaused = npc._pauseUntil && nowTs < npc._pauseUntil;

                if (isPaused) {
                    div.style.transition = 'none';
                    div.style.left = targetX + '%';
                    div.style.top = targetY + '%';
                    div.classList.remove('walking');
                    setNpcIdleFrame(div);
                    if (div.walkTimeout) { clearTimeout(div.walkTimeout); div.walkTimeout = null; }
                } else if (isNew || !Number.isFinite(currentLeft) || !Number.isFinite(currentTop)) {
                    div.style.transition = 'none';
                    div.style.left = targetX + '%';
                    div.style.top = targetY + '%';
                } else {
                    const distance = Math.hypot(targetX - currentLeft, targetY - currentTop);

                    // Se veio um salto grande (ex: admin move), não anima atravessando o mapa.
                    if (distance > 25) {
                        div.style.transition = 'none';
                        div.style.left = targetX + '%';
                        div.style.top = targetY + '%';
                        div.classList.remove('walking');
                        setNpcIdleFrame(div);
                    } else {
                        // O servidor emite posições de patrol a cada ~350ms. Se usarmos duration por MOVEMENT_SPEED,
                        // a transição fica curtíssima (ex: 30-50ms) e o resto do tempo “para”, dando sensação travada.
                        const duration = distance > 0 ? Math.max((distance / MOVEMENT_SPEED), NPC_SERVER_TICK_S) : 0;
                        div.style.transition = `top ${duration}s linear, left ${duration}s linear`;
                        void div.offsetWidth;
                        div.style.left = targetX + '%';
                        div.style.top = targetY + '%';
                        if (duration > 0.01) {
                            div.classList.add('walking');
                            if (div.walkTimeout) clearTimeout(div.walkTimeout);
                            div.walkTimeout = setTimeout(() => {
                                div.classList.remove('walking');
                                setNpcIdleFrame(div);
                            }, (duration * 1000) + 50);
                        }
                    }
                }

                div.style.zIndex = Math.floor(targetY);
                div.setAttribute('data-dir', npc.direction || 'down');

                // Preserve dev selection highlight
                div.classList.toggle('dev-selected', devMode && selectedNpcId === npcId);
            });

            document.querySelectorAll('.npc-entity').forEach(el => {
                const id = (el.id || '').replace('npc-', '');
                if (!seen.has(id)) el.remove();
            });
        });

