        function npcPathAddFromPortalExit() {
            const portals = Array.isArray(portalsMap) ? portalsMap : [];
            if (!portals.length) {
                alert('Nenhum portal disponível neste mapa.');
                return;
            }
            const labelFor = (p, idx) => {
                const dest = p.targetMap || p.toMap || p.destMap || p.mapTarget || p.mapId || p.to || '';
                return `${idx + 1}) ${(p.name || p.id || 'portal')} -> ${dest || 'destino'}`;
            };
            const choice = prompt('Escolha o portal (número):\n' + portals.map(labelFor).join('\n'));
            const idx = parseInt(choice, 10) - 1;
            if (!Number.isFinite(idx) || idx < 0 || idx >= portals.length) return;
            const p = portals[idx];
            const destMap = p.targetMap || p.toMap || p.destMap || p.mapTarget || p.mapId || p.to || currentMapId;
            const destX = clamp01_100(p.targetX ?? p.toX ?? p.x ?? p.cx ?? 50);
            const destY = clamp01_100(p.targetY ?? p.toY ?? p.y ?? p.cy ?? 50);
            npcEdPathState.points.push({
                x: destX,
                y: destY,
                waitMs: 0,
                map: destMap || currentMapId,
                viaPortalId: p.id || p.name || ''
            });
            npcPathRender();
        }

        function npcInteractMovePickByClick() {
            npcBeginClickCapture('CLIQUE PARA ESCOLHER O DESTINO DO NPC', (x, y) => {
                const nx = clamp01_100(document.getElementById('npcEdX').value);
                const ny = clamp01_100(document.getElementById('npcEdY').value);
                const dx = parseFloat((clamp01_100(x) - nx).toFixed(1));
                const dy = parseFloat((clamp01_100(y) - ny).toFixed(1));
                document.getElementById('npcEdInteractDx').value = String(dx);
                document.getElementById('npcEdInteractDy').value = String(dy);
            });
        }

        function npcPathRender() {
            const rows = document.getElementById('npcEdPatrolPathRows');
            const loopEl = document.getElementById('npcEdPatrolPathLoop');
            if (loopEl) loopEl.checked = !!npcEdPathState.loop;
            if (!rows) return;
            rows.innerHTML = '';

            if (!npcEdPathState.points || npcEdPathState.points.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'npcHint';
                empty.innerText = 'Nenhum ponto.';
                rows.appendChild(empty);
                return;
            }

            npcEdPathState.points.forEach((p, idx) => {
                const line = document.createElement('div');
                line.style.display = 'flex';
                line.style.gap = '8px';
                line.style.alignItems = 'center';

                const label = document.createElement('div');
                label.className = 'npcHint';
                label.style.minWidth = '60px';
                label.innerText = `#${idx + 1}`;

                const mapIn = document.createElement('input');
                mapIn.type = 'text';
                mapIn.value = p.map || currentMapId;
                mapIn.style.width = '120px';
                mapIn.placeholder = 'map id';
                mapIn.onchange = () => {
                    npcEdPathState.points[idx].map = mapIn.value.trim();
                };

                const xIn = document.createElement('input');
                xIn.type = 'number';
                xIn.step = '0.5';
                xIn.value = p.x;
                xIn.style.width = '90px';
                xIn.onchange = () => {
                    npcEdPathState.points[idx].x = clamp01_100(xIn.value);
                    npcPathRender();
                };

                const yIn = document.createElement('input');
                yIn.type = 'number';
                yIn.step = '0.5';
                yIn.value = p.y;
                yIn.style.width = '90px';
                yIn.onchange = () => {
                    npcEdPathState.points[idx].y = clamp01_100(yIn.value);
                    npcPathRender();
                };

                const waitIn = document.createElement('input');
                waitIn.type = 'number';
                waitIn.step = '50';
                waitIn.min = '0';
                waitIn.value = p.waitMs || 0;
                waitIn.style.width = '90px';
                waitIn.onchange = () => {
                    const v = Math.max(0, parseInt(waitIn.value, 10) || 0);
                    npcEdPathState.points[idx].waitMs = v;
                };

                const rm = document.createElement('button');
                rm.type = 'button';
                rm.className = 'npcBtn';
                rm.innerText = 'remover';
                rm.onclick = () => {
                    npcEdPathState.points.splice(idx, 1);
                    npcPathRender();
                };

                line.appendChild(label);
                line.appendChild(document.createTextNode('map'));
                line.appendChild(mapIn);
                line.appendChild(document.createTextNode('x'));
                line.appendChild(xIn);
                line.appendChild(document.createTextNode('y'));
                line.appendChild(yIn);
                line.appendChild(document.createTextNode('wait ms'));
                line.appendChild(waitIn);
                line.appendChild(rm);
                rows.appendChild(line);
            });
        }

