    <!-- DADOS -->
    <script>
        let mapConfig = <%- JSON.stringify(mapData) %>;
        // Garante visibilidade global para outros blocos
        window.mapConfig = mapConfig;
        if (!mapConfig.foregroundImage) mapConfig.foregroundImage = '';
        let collisionMap = mapConfig.collisions || [];
        let grassMap = mapConfig.grass || [];
        let interactsMap = mapConfig.interacts || [];
        let portalsMap = mapConfig.portals || [];
        let storyBarriersMap = mapConfig.storyBarriers || [];
        let objectsMap = mapConfig.objects || [];
        
        if (!mapConfig.spawnPoint) mapConfig.spawnPoint = null;

        const gameAreaEl = document.getElementById('gameArea');

        // --- Cache leve de mapas/imagens para acelerar troca de portal ---
        const MAP_CACHE_KEY = 'city_map_cache_v1';
        function loadMapCache() {
            try { return JSON.parse(sessionStorage.getItem(MAP_CACHE_KEY) || '{}'); } catch (_) { return {}; }
        }
        function saveMapCache(obj) {
            try { sessionStorage.setItem(MAP_CACHE_KEY, JSON.stringify(obj)); } catch (_) {}
        }

        function setMapCache(mapId, data) {
            if (!mapId || !data) return;
            const cache = loadMapCache();
            cache[mapId] = { ts: Date.now(), data };
            // Limita a poucas entradas para não crescer demais
            const keys = Object.keys(cache);
            if (keys.length > 5) {
                const sorted = keys.sort((a, b) => (cache[a].ts || 0) - (cache[b].ts || 0));
                const toRemove = sorted.slice(0, Math.max(0, keys.length - 5));
                toRemove.forEach(k => delete cache[k]);
            }
            saveMapCache(cache);
        }

        function getMapCache(mapId, maxAgeMs = 60000) {
            if (!mapId) return null;
            const cache = loadMapCache();
            const entry = cache[mapId];
            if (!entry) return null;
            if (!entry.ts || (Date.now() - entry.ts) > maxAgeMs) return null;
            return entry.data;
        }

        function preloadImage(url) {
            return new Promise((resolve) => {
                if (!url) return resolve();
                const img = new Image();
                img.onload = () => resolve();
                img.onerror = () => resolve();
                img.src = url;
            });
        }

        async function fetchMapData(mapId) {
            const cached = getMapCache(mapId);
            if (cached) return cached;
            try {
                const res = await fetch(`/api/map/${encodeURIComponent(mapId)}`);
                if (!res.ok) throw new Error('map fetch failed');
                const data = await res.json();
                setMapCache(mapId, data);
                return data;
            } catch (_) {
                return null;
            }
        }

        async function preloadMapAssets(mapId) {
            // Usa GameCache global se disponível para assets críticos
            if (!mapId) return;
            const data = await fetchMapData(mapId);
            if (!data) return;
            const bg = data.bgImage || '';
            const fg = data.foregroundImage || '';
            const tasks = [];
            const looksLikeUrl = (s) => typeof s === 'string' && (s.startsWith('http') || s.startsWith('/uploads/') || s.startsWith('data:'));
            
            // Tenta precarregar apenas com timeout mínimo (200ms) para não bloquear navegação
            if (looksLikeUrl(bg)) tasks.push(window.GameCache?.preloadImage?.(bg) || preloadImage(bg));
            if (looksLikeUrl(fg)) tasks.push(window.GameCache?.preloadImage?.(fg) || preloadImage(fg));
            
            if (tasks.length) {
                const PRELOAD_TIMEOUT_MS = 150; // Bem curto - prioriza fluidez sobre esperar carregar
                await Promise.race([
                    Promise.all(tasks),
                    new Promise(res => setTimeout(res, PRELOAD_TIMEOUT_MS))
                ]);
            }
        }

        // --- SISTEMA SPA: CARREGA E RENDERIZA MAPA SEM RELOAD ---
        async function loadMapDataFull(mapId, targetX, targetY) {
            try {
                let url = `/api/map/${encodeURIComponent(mapId)}/full?userId=${window.CURRENT_USER_ID}`;
                if (targetX !== undefined && targetY !== undefined) {
                    url += `&x=${targetX}&y=${targetY}`;
                }
                const res = await fetch(url);
                if (!res.ok) throw new Error('Failed to load map data');
                return await res.json();
            } catch (e) {
                console.error('Erro ao carregar dados do mapa:', e);
                return null;
            }
        }

        async function transitionToMap(mapId, targetX, targetY) {
            // Fecha todos os modais abertos antes de navegar
            if (typeof closeAllModals === 'function') closeAllModals();

            // Mostra overlay de transição
            const overlay = document.getElementById('transitionOverlay');
            if (overlay) {
                overlay.classList.remove('hidden');
            }

            try {
                // Carrega dados do novo mapa
                const mapFullData = await loadMapDataFull(mapId, targetX, targetY);
                if (!mapFullData || !mapFullData.map) {
                    throw new Error('Dados do mapa inválidos');
                }

                // Atualiza config global do mapa
                mapConfig = mapFullData.map;
                collisionMap = mapConfig.collisions || [];
                grassMap = mapConfig.grass || [];
                interactsMap = mapConfig.interacts || [];
                portalsMap = mapConfig.portals || [];
                storyBarriersMap = mapConfig.storyBarriers || [];
                objectsMap = mapConfig.objects || [];

                // Aplica visuais do novo mapa
                applyMapVisuals(mapConfig);

                // Re-renderiza todos os objetos do mapa usando função existente
                if (typeof renderMapObjects === 'function') {
                    renderMapObjects();
                }

                // Remove NPCs antigos do DOM
                const oldNpcs = document.querySelectorAll('.npc-entity');
                oldNpcs.forEach(npc => npc.remove());

                // Limpa registros de NPCs globais
                if (window.npcEntities) {
                    window.npcEntities = [];
                }
                if (window.npcRegistry) {
                    window.npcRegistry.clear();
                }

                // Renderiza novos NPCs
                if (mapFullData.npcs && Array.isArray(mapFullData.npcs)) {
                    mapFullData.npcs.forEach(npc => {
                        // Cria o elemento do NPC no DOM
                        const npcEl = document.createElement('div');
                        npcEl.className = 'player npc-entity';
                        npcEl.setAttribute('data-skin', npc.skin || 'char1');
                        npcEl.setAttribute('data-dir', npc.direction || 'down');
                        npcEl.setAttribute('data-npc-id', npc.id);
                        npcEl.style.left = npc.x + '%';
                        npcEl.style.top = npc.y + '%';

                        // Nome do NPC
                        const nameEl = document.createElement('div');
                        nameEl.className = 'player-name';
                        nameEl.textContent = npc.name || 'NPC';
                        npcEl.appendChild(nameEl);

                        // Adiciona ao DOM
                        gameArea.appendChild(npcEl);

                        // Registra no sistema global de NPCs
                        if (!window.npcEntities) window.npcEntities = [];
                        window.npcEntities.push({
                            id: npc.id,
                            el: npcEl,
                            data: npc,
                            x: npc.x,
                            y: npc.y
                        });

                        // Event listener para interação
                        npcEl.addEventListener('click', (e) => {
                            e.stopPropagation();
                            if (typeof handleNpcClick === 'function') {
                                handleNpcClick(npc);
                            }
                        });

                        // Patrulha (se houver)
                        if (npc.patrolRoute && npc.patrolRoute.length > 0 && typeof startNpcPatrol === 'function') {
                            startNpcPatrol(npc.id, npc.patrolRoute);
                        }
                    });
                }

                // Move player para nova posição
                const spawnX = (mapFullData.spawn && mapFullData.spawn.x) ? mapFullData.spawn.x : 50;
                const spawnY = (mapFullData.spawn && mapFullData.spawn.y) ? mapFullData.spawn.y : 50;

                // Atualiza posição do player local
                const playerEl = document.querySelector(`#p-${window.myId}`);
                if (playerEl) {
                    playerEl.style.left = spawnX + '%';
                    playerEl.style.top = spawnY + '%';
                }

                // Notifica o servidor da mudança de mapa via socket (entra no novo mapa)
                socket.emit('enter_map', {
                    userId: window.CURRENT_USER_ID,
                    name: myName,
                    skin: mySkin,
                    map: mapId,
                    x: spawnX,
                    y: spawnY,
                    direction: (playerEl && playerEl.getAttribute('data-dir')) ? playerEl.getAttribute('data-dir') : 'down'
                });

                // Atualiza variável global do mapa atual
                currentMapId = mapId;
                window.currentMapId = currentMapId;
                updateAreaHud();

                // Atualiza URL sem reload
                const newUrl = `/city?map=${mapId}&userId=${window.CURRENT_USER_ID}`;
                window.history.pushState({ mapId, x: spawnX, y: spawnY }, '', newUrl);

                // Remove overlay após delay
                setTimeout(() => {
                    if (overlay) overlay.classList.add('hidden');
                }, 300);

                return true;
            } catch (e) {
                console.error('Erro na transição de mapa:', e);
                if (overlay) overlay.classList.add('hidden');
                // Fallback: usa navegação tradicional
                const extra = (targetX !== undefined && targetY !== undefined) ? `&x=${targetX}&y=${targetY}` : '';
                window.location.href = `/city?map=${mapId}&userId=${window.CURRENT_USER_ID}${extra}`;
                return false;
            }
        }
        
        function applyMapVisuals(config) {
            const bg = (config && config.bgImage) ? `url('${config.bgImage}')` : '';
            gameAreaEl.style.backgroundImage = bg;

            const fgEl = document.getElementById('foreground-layer');
            if (fgEl) {
                const fg = (config && config.foregroundImage) ? `url('${config.foregroundImage}')` : '';
                fgEl.style.backgroundImage = fg;
                fgEl.style.display = fg ? 'block' : 'none';
            }
            const w = config.width || 100;
            const h = config.height || 100;
            gameAreaEl.style.width = w + '%';
            gameAreaEl.style.height = h + '%';
            if (w < 100 || h < 100) gameAreaEl.classList.add('indoor-mode'); else gameAreaEl.classList.remove('indoor-mode');
            
            const dl = document.getElementById('darkness-layer');
            if(dl) dl.style.opacity = config.darknessLevel || 0;
        }

        applyMapVisuals(mapConfig);

        // Defaults para posicionamento do fundo de batalha (recorte no battle.ejs)
        if (!Number.isFinite(mapConfig.battleBgPosX)) mapConfig.battleBgPosX = 50;
        if (!Number.isFinite(mapConfig.battleBgPosY)) mapConfig.battleBgPosY = 50;

        (function initBattleBgPosUi() {
            const panel = document.getElementById('battleBgPosPanel');
            const xr = document.getElementById('battleBgPosXRange');
            const xn = document.getElementById('battleBgPosXNum');
            const yr = document.getElementById('battleBgPosYRange');
            const yn = document.getElementById('battleBgPosYNum');
            if (!panel || !xr || !xn || !yr || !yn) return;

            function clamp01to100(v, fallback) {
                const n = parseFloat(v);
                if (!Number.isFinite(n)) return fallback;
                return Math.max(0, Math.min(100, n));
            }

            function syncFromConfig() {
                const x = clamp01to100(mapConfig.battleBgPosX, 50);
                const y = clamp01to100(mapConfig.battleBgPosY, 50);
                xr.value = String(Math.round(x));
                xn.value = String(Math.round(x));
                yr.value = String(Math.round(y));
                yn.value = String(Math.round(y));
            }

            function applyX(v) {
                const x = clamp01to100(v, 50);
                mapConfig.battleBgPosX = x;
                xr.value = String(Math.round(x));
                xn.value = String(Math.round(x));
            }

            function applyY(v) {
                const y = clamp01to100(v, 50);
                mapConfig.battleBgPosY = y;
                yr.value = String(Math.round(y));
                yn.value = String(Math.round(y));
            }

            xr.addEventListener('input', () => applyX(xr.value));
            xn.addEventListener('input', () => applyX(xn.value));
            yr.addEventListener('input', () => applyY(yr.value));
            yn.addEventListener('input', () => applyY(yn.value));

            xr.addEventListener('change', () => { if (typeof showToast === 'function') showToast('Posição X do fundo de batalha atualizada (salve o mapa).'); });
            yr.addEventListener('change', () => { if (typeof showToast === 'function') showToast('Posição Y do fundo de batalha atualizada (salve o mapa).'); });

            // Exibe o painel só para admins (o container existe apenas nesse caso)
            panel.style.display = 'flex';
            syncFromConfig();
        })();
    </script>

    <script>
        // Esta página tem renderer próprio de NPC (suave + animado).
        window.DISABLE_GLOBAL_NPC_RENDER = true;
