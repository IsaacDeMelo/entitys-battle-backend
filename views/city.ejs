        window.__bootGatePromise = (async () => {
            const tasks = [];
            try {
                const meReq = fetch(`/api/me?userId=${encodeURIComponent(window.CURRENT_USER_ID)}`)
                    .then(r => r.json())
                    .then(d => {
                        if (d && !d.error) {
                            window.__ME_CACHE = d;
                            if (d.bag) window.USER_BAG = d.bag;
                            if (d.keyItems) window.USER_KEY_ITEMS = d.keyItems;
                            if (d.storyFlags) window.STORY_FLAGS = d.storyFlags;
                            if (typeof d.followingEntityId === 'string') window.FOLLOWING_ENTITY_ID = d.followingEntityId;
                            try { setupFollower(); } catch (_) {}
                        }
                    })
                    .catch(() => {});
                tasks.push(meReq);
            } catch (_) {}

            try {
                tasks.push(preloadMapAssets(currentMapId));
            } catch (_) {}

            await Promise.allSettled(tasks);
        })();

        function setDialogImageStyle(mode) {
            setTimeout(() => {
                const imgEl = document.getElementById('rpgPortrait');
                if (imgEl) {
                    if (mode === 'pixel') {
                        imgEl.style.backgroundSize = '400% auto'; imgEl.style.backgroundPosition = '0 0'; imgEl.style.imageRendering = 'pixelated';
                    } else {
                        imgEl.style.backgroundSize = 'contain'; imgEl.style.backgroundPosition = 'center'; imgEl.style.imageRendering = 'auto';
                    }
                }
