        function closeBarrierPrompt() {
            const overlay = document.getElementById('barrierPromptOverlay');
            if (overlay) overlay.style.display = 'none';
            window.__barrierPromptActive = false;
            __barrierPromptContext = null;
        }

        function maybePromptStoryBarrier(x, y, margin = 0) {
            if (window.__barrierPromptActive) return false;
            if (window.__lastBarrierPromptAt && (Date.now() - window.__lastBarrierPromptAt) < 1200) return false;

            const hitBarrier = findNearbyStoryBarrier(x, y, margin);
            if (!hitBarrier || !hitBarrier.requiredFlag) return false;

            const flag = hitBarrier.requiredFlag;
            const flagActive = (window.STORY_FLAGS && window.STORY_FLAGS[flag]);
            if (flagActive) return false;

            const keys = Array.isArray(window.USER_KEY_ITEMS) ? window.USER_KEY_ITEMS.slice() : [];
            const bagItems = (window.USER_BAG && typeof window.USER_BAG === 'object')
                ? Object.keys(window.USER_BAG).filter(k => (window.USER_BAG[k] || 0) > 0)
                : [];

            if (keys.length === 0 && bagItems.length === 0) return false;

            const requiredItem = hitBarrier.requiredItemId || hitBarrier.requiredKey || hitBarrier.requiredKeyId || null;
            let useId = null;
            if (requiredItem) {
                const rid = String(requiredItem).trim();
                if (keys.includes(rid) || (window.USER_BAG && window.USER_BAG[rid] && (window.USER_BAG[rid] > 0))) {
                    useId = rid;
                }
            }
            if (!useId) useId = keys.length > 0 ? keys[0] : bagItems[0];
            openBarrierPrompt(flag, useId);
            return true;
        }

        function checkTriggers(x, y) {
            if (window.isTeleporting) return;
            if (isPortalCooldownActive()) return;

            // Se estiver perto de uma barreira, oferece usar item
            maybePromptStoryBarrier(x, y, 1.6);

            const portal = portalsMap.find(p => x >= p.x && x <= (p.x + p.w) && y >= p.y && y <= (p.y + p.h));
            if (portal) {
                performTransition(async () => {
                    const bag = window.USER_BAG || {};
                    const keys = window.USER_KEY_ITEMS || [];

                    const getInvCount = (id) => {
                        if (!id) return 0;
                        if (Array.isArray(keys) && keys.includes(id)) return 1;
                        const raw = bag[id];
                        const n = parseInt(raw, 10);
                        return Number.isFinite(n) ? n : 0;
                    };

                    const reqKey = (portal.requiresKeyItem || '').trim();
                    const reqItem = (portal.requiresItemId || portal.requiresItem || '').trim();
                    const reqQty = Math.max(1, parseInt(portal.requiresItemQty, 10) || 1);

                    if (reqKey && !(Array.isArray(keys) && keys.includes(reqKey))) {
                        if (typeof showToast === 'function') showToast(portal.lockedText || `Precisa do item-chave: ${reqKey}`, { bg: '#e74c3c' });
                        return;
                    }

                    if (reqItem && getInvCount(reqItem) < reqQty) {
                        if (typeof showToast === 'function') showToast(portal.lockedText || `Precisa de ${reqQty}x ${reqItem}`, { bg: '#e74c3c' });
                        return;
                    }

                    if (portal.consumesItem && reqItem) {
                        try {
                            const res = await fetch('/api/inventory/consume', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ userId: window.CURRENT_USER_ID, itemId: reqItem, qty: reqQty })
                            });
                            const data = await res.json().catch(() => ({}));
                            if (data && data.success) {
                                if (typeof window.__syncClientStateFromServer === 'function') {
                                    await window.__syncClientStateFromServer(data);
                                } else {
                                    if (data.bag) window.USER_BAG = data.bag;
                                    if (data.keyItems) window.USER_KEY_ITEMS = data.keyItems;
                                    if (data.storyFlags) window.STORY_FLAGS = data.storyFlags;
                                }
                            } else {
                                if (typeof showToast === 'function') showToast(portal.lockedText || 'Não foi possível usar o item.', { bg: '#e74c3c' });
                                return;
                            }
                        } catch (e) {
                            if (typeof showToast === 'function') showToast('Erro ao usar item.', { bg: '#e74c3c' });
                            return;
                        }
                    }

                    let extra = '';
                    if (portal.targetX !== undefined && portal.targetY !== undefined && !isNaN(portal.targetX)) {
                        extra = `&x=${portal.targetX}&y=${portal.targetY}`;
                    }
                    
                    // Precarrega assets do mapa alvo
                    preloadMapAssets(portal.targetMap).catch(() => {});
                    setPortalCooldown(1300);
                    window.__transitionNavigating = true;
                    
                    // USA TRANSIÇÃO SPA ao invés de reload de página
                    const targetX = portal.targetX !== undefined ? portal.targetX : undefined;
                    const targetY = portal.targetY !== undefined ? portal.targetY : undefined;
                    
                    // Tenta transição SPA primeiro
                    const success = await transitionToMap(portal.targetMap, targetX, targetY);
                    
                    // Se falhar, usa fallback tradicional (já está no transitionToMap)
                    if (!success) {
                        console.log('SPA transition failed, using traditional navigation');
                    }
                    
                    window.__transitionNavigating = false;
                });
            }
        }

        // --- CONTROLES ---
        gameViewport.addEventListener('mousedown', (e) => {
            // Captura de clique (usado pelo editor de NPC: rota e mover após item)
            if (window.__devClickCapture && typeof window.__devClickCapture.onPick === 'function') {
                // Botão direito cancela
                if (e.button === 2) {
                    e.preventDefault();
                    e.stopPropagation();
                    npcCancelClickCapture();
                    return;
                }
                e.stopPropagation();
                const rect = gameArea.getBoundingClientRect();
                const clickX = parseFloat((((e.clientX - rect.left)/rect.width)*100).toFixed(1));
                const clickY = parseFloat((((e.clientY - rect.top)/rect.height)*100).toFixed(1));
                const cap = window.__devClickCapture;
                window.__devClickCapture = null;

                // UI: volta pro editor se ele estava aberto
                try {
                    const pm = document.getElementById('previewMsg');
                    if (pm) pm.style.display = 'none';
                    document.getElementById('gameArea').classList.remove('preview-mode');
                    document.getElementById('gameArea').classList.remove('dev-click-capture');
                } catch (_) {}
                if (cap && cap.restoreNpcEditor) {
                    try { document.getElementById('npcEditorOverlay').style.display = 'flex'; } catch (_) {}
                }
                // Restaura tool anterior
                if (cap && cap.prevTool !== undefined) {
                    currentTool = cap.prevTool;
                }

                try { cap.onPick(clickX, clickY); } catch (_) {}
                return;
            }

            if (devMode) {
                if (currentTool === 'moveNpc' && selectedNpcId) {
                    e.stopPropagation();
                    const rect = gameArea.getBoundingClientRect(); 
                    const clickX = parseFloat((((e.clientX - rect.left)/rect.width)*100).toFixed(1)); 
                    const clickY = parseFloat((((e.clientY - rect.top)/rect.height)*100).toFixed(1));
                    teleportNpc(clickX, clickY);
                    return;
                }
                
                if (pendingPortalData) {
                    e.stopPropagation();
                    const rect = gameArea.getBoundingClientRect(); 
                    const clickX = parseFloat((((e.clientX - rect.left)/rect.width)*100).toFixed(1)); 
                    const clickY = parseFloat((((e.clientY - rect.top)/rect.height)*100).toFixed(1));

                    const patch = {
                        ...pendingPortalData.rect,
                        targetMap: pendingPortalData.mapId,
                        targetX: clickX,
                        targetY: clickY
                    };

                    const editIndex = pendingPortalData.editIndex;
                    if (editIndex !== null && editIndex !== undefined && portalsMap[editIndex]) {
                        portalsMap[editIndex] = { ...portalsMap[editIndex], ...patch };
                    } else {
                        portalsMap.push(patch);
                    }
                    
                    pendingPortalData = null;
                    applyMapVisuals(mapConfig); 
                    document.getElementById('previewMsg').style.display = 'none';
                    document.getElementById('gameArea').classList.remove('preview-mode');
                    document.querySelectorAll('.player').forEach(p => p.style.display = 'block');
                    
                    showToast((editIndex !== null && editIndex !== undefined) ? "Portal atualizado!" : "Portal criado!");
                    renderMapObjects();
                    return;
                }

                if (currentTool === 'spawn') {
                    e.stopPropagation();
                    const rect = gameArea.getBoundingClientRect(); 
                    const clickX = parseFloat((((e.clientX - rect.left)/rect.width)*100).toFixed(1)); 
                    const clickY = parseFloat((((e.clientY - rect.top)/rect.height)*100).toFixed(1));
                    mapConfig.spawnPoint = { x: clickX, y: clickY };
                    showToast("Spawn Padrão Definido!", {bg:'#2ecc71'});
                    renderMapObjects();
                    return;
                }

                if (currentTool && currentTool !== 'moveNpc') { handleDevClick(e); return; }
            }
            // CLICK-TO-MOVE DESATIVADO (usar apenas D-pad). Mantido aqui comentado para reativar facilmente.
            // handleInput(e);
        });

