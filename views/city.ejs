        function handleInput(e, targetElement = null) {
            const target = targetElement || e.target;
            if (target.closest('#chatBar') || window.isTeleporting || window.isInteracting || window.__virtualPadHolding || window.__menuOpen) return;
            if (target.closest('#virtualPadWrap')) return;
            if (target.closest('.npc-entity')) return;

            const rect = gameArea.getBoundingClientRect();
            const rawX = ((e.clientX - rect.left) / rect.width) * 100;
            const rawY = ((e.clientY - rect.top) / rect.height) * 100;
            let targetX = Math.max(0, Math.min(100, rawX));
            let targetY = Math.max(0, Math.min(100, rawY));

            const marker = document.createElement('div');
            marker.style.position = 'fixed'; marker.style.width = '10px'; marker.style.height = '10px';
            marker.style.background = 'rgba(255,255,255,0.5)'; marker.style.borderRadius = '50%'; marker.style.zIndex = '99999';
            marker.style.left = (e.clientX - 5) + 'px'; marker.style.top = (e.clientY - 5) + 'px'; marker.style.pointerEvents = 'none';
            document.body.appendChild(marker); setTimeout(() => marker.remove(), 300);

            const hitObj = interactsMap.find(obj => targetX >= obj.x && targetX <= (obj.x + obj.w) && targetY >= obj.y && targetY <= (obj.y + obj.h));

            // Clique numa Story Barrier? se sim, oferece usar item-chave (se houver)
            try {
                if (maybePromptStoryBarrier(targetX, targetY, 0)) return;
            } catch (_) {}
            const myPlayer = document.getElementById(`p-${window.myId}`); if (!myPlayer) return;
            const currX = parseFloat(myPlayer.style.left); const currY = parseFloat(myPlayer.style.top);
            // Para clique no chão, limita o tamanho do passo (um clique não pode atravessar o mapa)
            let desiredX = targetX;
            let desiredY = targetY;
            if (!hitObj) {
                const dxPct = desiredX - currX;
                const dyPct = desiredY - currY;
                try {
                    const rectPx = gameArea.getBoundingClientRect();
                    const dxPx = dxPct * (rectPx.width / 100);
                    const dyPx = dyPct * (rectPx.height / 100);
                    const distPx = Math.hypot(dxPx, dyPx);
                    const MAX_CLICK_MOVE_PX = 140;
                    if (distPx > MAX_CLICK_MOVE_PX && distPx > 0) {
                        const r = MAX_CLICK_MOVE_PX / distPx;
                        desiredX = currX + dxPct * r;
                        desiredY = currY + dyPct * r;
                    }
                } catch (_) {}
            }

            let safeDest = getSafeTarget(currX, currY, desiredX, desiredY);
            // Threshold em PIXELS (evita "cliques curtos" virarem movimento 0 e não animarem)
            let distPx = 0;
            try {
                const rectPx = gameArea.getBoundingClientRect();
                const dxPx = (safeDest.x - currX) * (rectPx.width / 100);
                const dyPx = (safeDest.y - currY) * (rectPx.height / 100);
                distPx = Math.hypot(dxPx, dyPx);
            } catch (_) {
                distPx = 0;
            }
            if (!(distPx > 2)) return;

            const travelS = calcMoveDurationS(currX, currY, safeDest.x, safeDest.y);
            const travelTime = Math.max(120, travelS * 1000);

            // Direção + animação já no primeiro toque
            try {
                const dx = safeDest.x - currX;
                const dy = safeDest.y - currY;
                let dir = 'down';
                if (Math.abs(dx) > Math.abs(dy)) dir = dx > 0 ? 'right' : 'left';
                else dir = dy > 0 ? 'down' : 'up';
                myPlayer.setAttribute('data-dir', dir);
                myPlayer.classList.add('walking');
                enqueueFollowerPosition({ x: safeDest.x, y: safeDest.y, dir });
                // Se o servidor não responder (ou o movimento for bloqueado), evita ficar "estátua" com animação presa
                if (myPlayer.__preWalkTimeout) clearTimeout(myPlayer.__preWalkTimeout);
                myPlayer.__preWalkTimeout = setTimeout(() => {
                    try {
                        if (!window.__virtualPadHolding) myPlayer.classList.remove('walking');
                    } catch (_) {}
                }, Math.max(300, Math.min(2000, travelTime + 250)));
            } catch (_) {}

            window.isMoving = true;
            setTimeout(() => { window.isMoving = false; }, Math.min(6000, travelTime + 200));
            // Marca que o próximo movimento recebido do servidor deve ter easing (só para clique)
            window.__useEaseForNextMove = true;
            emitMovePlayer(safeDest.x, safeDest.y);

            if (hitObj) {
                setTimeout(() => {
                    window.isMoving = false;
                    try { myPlayer.classList.remove('walking'); } catch (_) {}
                    const newPx = parseFloat(myPlayer.style.left); const newPy = parseFloat(myPlayer.style.top);
                    const inRange = (newPx >= hitObj.x - 5 && newPx <= (hitObj.x + hitObj.w) + 5 && newPy >= hitObj.y - 5 && newPy <= (hitObj.y + hitObj.h) + 5);
                    if (inRange) handleObjectInteraction(hitObj); else if(typeof showToast === 'function') showToast("Muito longe...", {bg: '#e74c3c'});
                }, travelTime);
              } else {
                  const hitGrass = grassMap.find(g => safeDest.x >= g.x && safeDest.x <= g.x + g.w && safeDest.y >= g.y && safeDest.y <= g.y + g.h);
                  if (hitGrass) {
                          updateAreaHud(hitGrass);
                    __pendingWildEncounter = {
                        encounterKey: String(hitGrass.encounterKey || '').trim(),
                        grassId: String(hitGrass.label || hitGrass.encounterKey || 'grass_generic').trim() || 'grass_generic'
                    };
                    const encounterRate = Number.isFinite(hitGrass.encounterRate) ? hitGrass.encounterRate : undefined;
                    setTimeout(() => socket.emit('check_encounter', { grassId: __pendingWildEncounter.grassId, encounterRate }), travelTime);
                      } else {
                          __pendingWildEncounter = null;
                          updateAreaHud();
                  }
            }
        }

        const chatIn = document.getElementById('chatInput');
        document.getElementById('chatSend').onclick = () => { if(chatIn.value.trim()) { socket.emit('send_chat', chatIn.value); chatIn.value=''; } };
        if(isAdmin) document.getElementById('adminToolbar').style.display = 'flex';

        // START (menu)
        (function setupStartMenu() {
            const startBtn = document.getElementById('startBtn');
            const overlay = document.getElementById('startMenuOverlay');
            if (!startBtn || !overlay) return;
            function open() { overlay.style.display = 'flex'; window.__menuOpen = true; document.body.classList.add('menu-open'); }
            function close() { overlay.style.display = 'none'; window.__menuOpen = false; document.body.classList.remove('menu-open'); }
            window.__closeStartMenu = close;
