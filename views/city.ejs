                            return;
                        }

                        if (data && data.success && data.added) {
                            toastMsg = data.added.storage === 'keyItems'
                                ? `Recebeu o item-chave ${obj.itemId}!`
                                : `Você recebeu ${obj.qty||1}x ${obj.itemId}!`;
                            toastOpts = { bg: '#f1c40f', color: '#000' };
                        } else if (data && data.success && !data.added) {
                            toastMsg = 'Obrigado.';
                            toastOpts = { bg: '#bbb' };
                        } else if (data && data.error) {
                            console.warn('map/interact error', data.error);
                        }

                        // Atualiza estados cliente
                        if (data && data.bag) window.USER_BAG = data.bag;
                        if (data && Array.isArray(data.keyItems)) window.USER_KEY_ITEMS = data.keyItems;
                        if (data && data.storyFlags) window.STORY_FLAGS = data.storyFlags;
                    } catch (e) {
                        console.error(e);
                    }
                }
            }

            if (obj.messages && obj.messages.length > 0) {
                for (let msg of obj.messages) { await showRPGDialog('Sistema', customImg, msg); }
            } else {
                if (obj.type !== 'item') await showRPGDialog('Sistema', customImg, "Você encontrou algo interessante.");
