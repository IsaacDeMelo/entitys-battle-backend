        // --- SOCKETS ---
        socket.on('connect', () => { 
            window.myId = socket.id; 
            socket.emit('enter_map', { userId: window.CURRENT_USER_ID, name: myName, skin: mySkin, map: currentMapId, x: startX, y: startY, direction: startDir }); 
        });

        socket.on('map_state', (players) => { 
            document.querySelectorAll('.player:not(.npc-entity)').forEach(el => { if(el.id !== `p-${window.myId}`) el.remove(); });
            remoteFollowers.forEach((_, id) => removeRemoteFollower(id));
            players.forEach(p => { if(p.id !== window.myId) createPlayerElement(p); else { const myEl = document.getElementById(`p-${window.myId}`); if(myEl && !window.isMoving) { myEl.style.left = p.x + '%'; myEl.style.top = p.y + '%'; } } });
            if (!document.getElementById(`p-${window.myId}`)) { createPlayerElement({ id: window.myId, name: myName, skin: mySkin, x: startX, y: startY, direction: startDir }); }
            setupFollower();
            markMapReady();
        });
        
        socket.on('player_joined', (p) => { if(p.id !== window.myId) createPlayerElement(p); });

        socket.on('player_following_updated', (data) => {
            if (!data || !data.id || data.id === window.myId) return;
            const el = document.getElementById(`p-${data.id}`);
            const x = el ? parseFloat(el.style.left) : 50;
            const y = el ? parseFloat(el.style.top) : 50;
            const direction = el ? (el.getAttribute('data-dir') || 'down') : 'down';
            syncRemoteFollower({
                id: data.id,
                x: Number.isFinite(x) ? x : 50,
                y: Number.isFinite(y) ? y : 50,
                direction,
                followerSprite: data.followerSprite,
                followerName: data.followerName,
                followerDexOrder: data.followerDexOrder || 0
            });
        });
        
        socket.on('player_moved', (data) => {
            const el = document.getElementById(`p-${data.id}`);
            if (el) {
                const incomingSeq = Number(data.seq) || 0;
                if (data.id === window.myId) {
                    // Descarta ecos atrasados quando o D-pad está ativo
                    if (incomingSeq && __lastMoveSeqReceived && incomingSeq < __lastMoveSeqReceived) return;
                }
                // Se estamos usando predição local no D-pad, o servidor pode ecoar exatamente
                // o mesmo alvo e re-aplicar a mesma transição a cada tick, causando "vibração".
                // Evita reprocessar quando não há mudança real de destino.
                const recentlyReleased = __virtualPadReleasedAt && (Date.now() - __virtualPadReleasedAt) < 600;
                if (data.id === window.myId && (window.__virtualPadHolding || recentlyReleased)) {
                    const curL = parseFloat(el.style.left);
                    const curT = parseFloat(el.style.top);
                    if (Number.isFinite(curL) && Number.isFinite(curT)) {
                        // Ignora posições que "puxem para trás" durante o D-pad (pacote atrasado)
                        const dir = (el.getAttribute('data-dir') || data.direction || 'down').toLowerCase();
                        const distBack = Math.hypot(curL - data.x, curT - data.y);
                        if (distBack > 0.8) {
                            const behind = (dir === 'up' && data.y > curT)
                                || (dir === 'down' && data.y < curT)
                                || (dir === 'left' && data.x > curL)
                                || (dir === 'right' && data.x < curL);
                            if (behind) {
                                // Não atualiza o seq porque este pacote foi descartado
                                return;
                            }
                        }

                        const sameX = Math.abs(curL - data.x) < 0.001;
                        const sameY = Math.abs(curT - data.y) < 0.001;
                        if (sameX && sameY) {
                            el.setAttribute('data-dir', data.direction);
                            if (data.id === window.myId) enqueueFollowerPosition({ x: data.x, y: data.y, dir: data.direction });
                            // Mesmo ignorando o eco (predição local), ainda precisamos checar portais.
                            if (data.id === window.myId) {
                                window.isMoving = false;
                                try { checkTriggers(data.x, data.y); } catch (_) {}
                            }
                            return;
                        }
                    }
                }
                // Se a animação foi iniciada no clique antes do servidor responder, limpa o timeout local
                if (data.id === window.myId && el.__preWalkTimeout) {
                    clearTimeout(el.__preWalkTimeout);
                    el.__preWalkTimeout = null;
                }
                const currentLeft = parseFloat(el.style.left) || 50; const currentTop = parseFloat(el.style.top) || 50;
                let duration = calcMoveDurationS(currentLeft, currentTop, data.x, data.y);
                // Durante o D-pad, evita micro-durações que deixam o movimento "travado".
                if (data.id === window.myId && window.__virtualPadHolding) {
                    const minDur = typeof window.__virtualPadTickS === 'number' ? window.__virtualPadTickS : 0;
                    if (minDur > 0) duration = Math.max(duration, minDur);
                }
                // Mantém remotos suaves: usa o tick do servidor como duração mínima
                if (data.id !== window.myId) {
                    const minTick = typeof window.__virtualPadTickS === 'number' ? window.__virtualPadTickS : 0.14;
                    duration = Math.max(duration, minTick);
                }
                let easing = 'linear';
                // Suaviza o início apenas quando o movimento foi disparado por clique/toque (1 vez)
                if (data.id === window.myId && window.__useEaseForNextMove) {
                    // Curva com início mais lento (evita "arrancada")
                    easing = 'cubic-bezier(0.30, 0.00, 0.60, 1.00)';
                    window.__useEaseForNextMove = false;
                }
                el.style.transition = `top ${duration}s ${easing}, left ${duration}s ${easing}`; 
                void el.offsetWidth; el.style.left = data.x + '%'; el.style.top = data.y + '%'; el.style.zIndex = Math.floor(data.y); el.setAttribute('data-dir', data.direction);
                if (data.id === window.myId) enqueueFollowerPosition({ x: data.x, y: data.y, dir: data.direction });
                else updateRemoteFollowerPosition(data.id, { x: data.x, y: data.y, dir: data.direction });
                if (duration > 0) { 
                    if (!el.classList.contains('walking')) el.classList.add('walking'); 
                    if (el.walkTimeout) clearTimeout(el.walkTimeout); 
                    el.walkTimeout = setTimeout(() => { 
                        // Se estiver segurando o D-pad, mantém a animação ligada.
                        if (!(data.id === window.myId && window.__virtualPadHolding)) {
                            el.classList.remove('walking');
                        }
                        if (data.id === window.myId) { window.isMoving = false; checkTriggers(data.x, data.y); }
                    }, duration * 1000); 
                } else if(data.id === window.myId) { window.isMoving = false; }
                if (data.id === window.myId && incomingSeq) {
                    __lastMoveSeqReceived = Math.max(__lastMoveSeqReceived, incomingSeq);
                }
            }
        });
        
