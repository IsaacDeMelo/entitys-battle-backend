        // --- CONTROLE VIRTUAL (TESTE) ---
        (function setupVirtualPad() {
            const wrap = document.getElementById('virtualPadWrap');
            const interactBtn = document.getElementById('virtualPadInteract');
            const bBtn = document.getElementById('virtualPadB');
            if (!wrap) return;

            // Sem botão ON/OFF: controle sempre ativo
            const enabled = true;

            const state = {
                dir: null,
                rafId: null,
                vx: null,
                vy: null,
                startedAt: 0,
                lastTs: 0,
                accMs: 0,
                activePointers: new Map(),
                order: [],
                currentPointerId: null
            };

            // Tick do D-pad (ms). Mantém o passo coerente com MOVEMENT_SPEED pra ficar linear.
            const TICK_MS = 140;
            window.__virtualPadTickS = TICK_MS / 1000;

            function stop() {
                window.__virtualPadHolding = false;
                __virtualPadReleasedAt = Date.now();
                state.dir = null;
                state.vx = null;
                state.vy = null;
                state.startedAt = 0;
                state.lastTs = 0;
                state.accMs = 0;
                state.activePointers.clear();
                state.order = [];
                state.currentPointerId = null;
                if (state.rafId) {
                    cancelAnimationFrame(state.rafId);
                    state.rafId = null;
                }

                const myPlayer = document.getElementById(`p-${window.myId}`);
                if (myPlayer) myPlayer.classList.remove('walking');
            }

            function pickCurrentDir() {
                for (let i = state.order.length - 1; i >= 0; i--) {
                    const pid = state.order[i];
                    const d = state.activePointers.get(pid);
                    if (d) {
                        state.currentPointerId = pid;
                        return d;
                    }
                }
                state.currentPointerId = null;
                return null;
            }

            function setDir(dir, pointerId) {
                if (!dir) return;
                window.__virtualPadHolding = true;
                state.dir = dir;
                state.currentPointerId = pointerId;
                state.startedAt = Date.now();
                if (!state.rafId) {
                    state.lastTs = 0;
                    state.accMs = 0;
                    state.rafId = requestAnimationFrame(loop);
                }
            }

            function loop(ts) {
                if (!window.__virtualPadHolding || !state.dir) {
                    state.rafId = null;
                    return;
                }
                if (!state.lastTs) state.lastTs = ts;
                const delta = ts - state.lastTs;
                state.lastTs = ts;
                state.accMs = Math.min(1000, state.accMs + delta);

                while (state.accMs >= TICK_MS) {
                    step(state.dir);
                    state.accMs -= TICK_MS;
                    if (!window.__virtualPadHolding || !state.dir) break;
                }

                state.rafId = requestAnimationFrame(loop);
            }

            function step(dir) {
                if (!enabled) return;
                if (window.isTeleporting || window.isInteracting || window.__menuOpen) return;

                const myPlayer = document.getElementById(`p-${window.myId}`);
                if (!myPlayer) return;

                // Posição "virtual" (alvo) para evitar travar em passos
                const currX = (state.vx === null || state.vx === undefined) ? parseFloat(myPlayer.style.left) : state.vx;
                const currY = (state.vy === null || state.vy === undefined) ? parseFloat(myPlayer.style.top) : state.vy;

                // Passo baseado em pixels (mantém velocidade igual na horizontal/vertical)
                let STEP_X = 0;
                let STEP_Y = 0;
                try {
                    const rect = gameArea.getBoundingClientRect();
                    let stepPx = PLAYER_MOVE_PX_PER_S * (TICK_MS / 1000);
                    // Ramp-up de aceleração no começo da arrancada do D-pad
                    const now = Date.now();
                    if (!state.startedAt) state.startedAt = now;
                    const elapsed = now - state.startedAt;
                    const ramp = Math.max(0, Math.min(1, elapsed / 250));
                    const factor = 0.55 + (0.45 * ramp); // começa ~55% e chega em 100%
                    stepPx = stepPx * factor;
                    STEP_X = rect.width > 0 ? (stepPx / rect.width) * 100 : 0;
                    STEP_Y = rect.height > 0 ? (stepPx / rect.height) * 100 : 0;
                    // garante um mínimo pra não travar em telas muito grandes
                    STEP_X = Math.max(0.35, STEP_X);
                    STEP_Y = Math.max(0.35, STEP_Y);
                } catch (_) {
                    STEP_X = 0.6;
                    STEP_Y = 0.6;
                }
                // D-pad deve ser linear (sem easing)
                window.__useEaseForNextMove = false;
                let desiredX = currX;
                let desiredY = currY;
                if (dir === 'up') desiredY -= STEP_Y;
                if (dir === 'down') desiredY += STEP_Y;
                if (dir === 'left') desiredX -= STEP_X;
                if (dir === 'right') desiredX += STEP_X;

                desiredX = Math.max(0, Math.min(100, desiredX));
                desiredY = Math.max(0, Math.min(100, desiredY));

                const safeDest = getSafeTarget(currX, currY, desiredX, desiredY);
                const moveDist = Math.hypot(safeDest.x - currX, safeDest.y - currY);
                if (moveDist < 0.05) {
                    // bloqueado: para de andar (não fica vibrando)
                    stop();
                    return;
                }

                // Mantém animação e direção enquanto segura
                myPlayer.setAttribute('data-dir', dir);
                myPlayer.classList.add('walking');

                // Predição local: aplica o movimento imediatamente no client.
                // Isso remove o "travado"/"vibração" causado por jitter da rede/eco do servidor.
                try {
                    let duration = calcMoveDurationS(currX, currY, safeDest.x, safeDest.y);
                    const minDur = typeof window.__virtualPadTickS === 'number' ? window.__virtualPadTickS : 0;
                    if (minDur > 0) duration = Math.max(duration, minDur);
                    myPlayer.style.transition = `top ${duration}s linear, left ${duration}s linear`;
                    void myPlayer.offsetWidth;
                    myPlayer.style.left = safeDest.x + '%';
                    myPlayer.style.top = safeDest.y + '%';
                    myPlayer.style.zIndex = Math.floor(safeDest.y);
                } catch (_) {}

                enqueueFollowerPosition({ x: safeDest.x, y: safeDest.y, dir });

                emitMovePlayer(safeDest.x, safeDest.y);

                state.vx = safeDest.x;
                state.vy = safeDest.y;
            }

            function start(dir, pointerId) {
                if (!enabled) return;
                if (!window.__virtualPadHolding) {
                    const myPlayer = document.getElementById(`p-${window.myId}`);
                    if (myPlayer) {
                        const x = parseFloat(myPlayer.style.left);
                        const y = parseFloat(myPlayer.style.top);
                        state.vx = Number.isFinite(x) ? x : 50;
                        state.vy = Number.isFinite(y) ? y : 50;
                    }
                }
                setDir(dir, pointerId);
                step(dir);
            }

            function releasePointer(pointerId) {
                if (!state.activePointers.has(pointerId)) return;
                state.activePointers.delete(pointerId);
                state.order = state.order.filter(id => id !== pointerId);

                if (state.activePointers.size === 0) {
                    stop();
                    return;
                }

                if (state.currentPointerId === pointerId) {
                    const nextDir = pickCurrentDir();
                    if (nextDir) setDir(nextDir, state.currentPointerId);
                }
            }

            function findNearestNpc(myX, myY) {
                const list = Array.isArray(window.currentNpcsCache) ? window.currentNpcsCache : (Array.isArray(currentNpcsCache) ? currentNpcsCache : []);
                let best = null;
                let bestDist = Infinity;
                for (const n of list) {
                    if (!n || !n._id) continue;
                    const nx = (typeof n.x === 'number') ? n.x : parseFloat(n.x);
                    const ny = (typeof n.y === 'number') ? n.y : parseFloat(n.y);
                    if (!Number.isFinite(nx) || !Number.isFinite(ny)) continue;
                    const d = Math.hypot(nx - myX, ny - myY);
                    if (d < bestDist) { best = n; bestDist = d; }
                }
                return { npc: best, dist: bestDist };
            }

            function getNpcInteractRange(n) {
                const raw = n && n.interact ? n.interact.range : 0;
                const v = parseFloat(raw);
                return (Number.isFinite(v) && v > 0) ? v : 9;
            }

            function virtualInteract() {
                if (window.isTeleporting || window.isInteracting || window.__menuOpen) return;
                const myPlayer = document.getElementById(`p-${window.myId}`);
                if (!myPlayer) return;
                const myX = parseFloat(myPlayer.style.left);
                const myY = parseFloat(myPlayer.style.top);
                if (!Number.isFinite(myX) || !Number.isFinite(myY)) return;

                const { npc, dist } = findNearestNpc(myX, myY);
                if (!npc || !Number.isFinite(dist) || dist > 30) {
                    return;
                }

                // Se estiver perto, interage direto; se não, anda até ele (sem atravessar parede)
                const interactRange = getNpcInteractRange(npc);
                if (dist <= interactRange) {
                    try { interactWithNPC(npc); } catch (_) {}
                } else {
                    try { moveToAndTalkToNPC(npc); } catch (_) {}
                }
            }

            function virtualInteractMap() {
                if (window.isTeleporting || window.isInteracting || window.__menuOpen) return;
                const myPlayer = document.getElementById(`p-${window.myId}`);
                if (!myPlayer) return;
                const px = parseFloat(myPlayer.style.left);
                const py = parseFloat(myPlayer.style.top);

                const list = Array.isArray(interactsMap) ? interactsMap : [];
                const dir = (myPlayer.getAttribute('data-dir') || 'down').toLowerCase();
                const FRONT = 4.0; // quão "na frente" checar
                let fx = px;
                let fy = py;
                if (dir === 'up') fy -= FRONT;
                else if (dir === 'down') fy += FRONT;
                else if (dir === 'left') fx -= FRONT;
                else if (dir === 'right') fx += FRONT;

                fx = Math.max(0, Math.min(100, fx));
                fy = Math.max(0, Math.min(100, fy));

                // Procura um interact que contenha o ponto à frente.
                // Se houver mais de um, pega o mais próximo do ponto.
                let best = null;
                let bestD = Infinity;
                for (const obj of list) {
                    if (!obj) continue;
                    const ox = (typeof obj.x === 'number') ? obj.x : parseFloat(obj.x) || 0;
                    const oy = (typeof obj.y === 'number') ? obj.y : parseFloat(obj.y) || 0;
                    const ow = (typeof obj.w === 'number') ? obj.w : parseFloat(obj.w) || 0;
                    const oh = (typeof obj.h === 'number') ? obj.h : parseFloat(obj.h) || 0;
                    if (fx < ox || fx > (ox + ow) || fy < oy || fy > (oy + oh)) continue;

                    const cx = ox + (ow / 2);
                    const cy = oy + (oh / 2);
                    const d = Math.hypot(cx - fx, cy - fy);
                    if (d < bestD) { best = obj; bestD = d; }
                }

                if (!best) {
                    return;
                }

                try {
                    handleObjectInteraction(best);
                } catch (_) {
                    if (typeof showToast === 'function') showToast('Erro ao interagir.', { bg: '#e74c3c' });
                }
            }

            // Botão A — quando menu aberto, A confirma (não interage no mapa)
            if (interactBtn) {
                let lastInteractAt = 0;
                interactBtn.addEventListener('pointerdown', (e) => {
                    if (window.__menuOpen) {
                        e.preventDefault(); e.stopPropagation();
                        const startOpen = document.getElementById('startMenuOverlay') && document.getElementById('startMenuOverlay').style.display !== 'none';
                        if (startOpen && window.__startMenuConfirm) window.__startMenuConfirm();
                        else if (window.__menuConfirm) window.__menuConfirm();
                        else if (window.__startMenuConfirm) window.__startMenuConfirm();
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    const now = Date.now();
                    if (now - lastInteractAt < 350) return;
                    lastInteractAt = now;
                    virtualInteract();
                });
                // Click pode disparar atrasado em mobile; deixa como fallback, mas protegido.
                interactBtn.addEventListener('click', (e) => {
                    if (window.__menuOpen) { e.preventDefault(); e.stopPropagation(); return; }
                    e.preventDefault();
                    e.stopPropagation();
                    const now = Date.now();
                    if (now - lastInteractAt < 350) return;
                    lastInteractAt = now;
                    virtualInteract();
                });
            }

            // Botão B — quando menu aberto, B volta/fecha (não interage no mapa)
            if (bBtn) {
                let lastBAt = 0;
                bBtn.addEventListener('pointerdown', (e) => {
                    if (window.__menuOpen) {
                        e.preventDefault(); e.stopPropagation();
                        var startOpen = document.getElementById('startMenuOverlay') && document.getElementById('startMenuOverlay').style.display !== 'none';
                        if (startOpen && window.__startMenuBack) { window.__startMenuBack(); return; }
                        if (window.__menuBack) { window.__menuBack(); return; }
                        if (window.__closeStartMenu) { window.__closeStartMenu(); return; }
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    const now = Date.now();
                    if (now - lastBAt < 350) return;
                    lastBAt = now;
                    virtualInteractMap();
                });
                bBtn.addEventListener('click', (e) => {
                    if (window.__menuOpen) { e.preventDefault(); e.stopPropagation(); return; }
                    e.preventDefault();
                    e.stopPropagation();
                    const now = Date.now();
                    if (now - lastBAt < 350) return;
                    lastBAt = now;
                    virtualInteractMap();
                });
            }

            // Botões do D-pad — quando menu aberto, navegam no menu (não movem)
            wrap.querySelectorAll('[data-vdir]').forEach(btn => {
                btn.addEventListener('pointerdown', (e) => {
                    if (window.__menuOpen) {
                        e.preventDefault(); e.stopPropagation();
                        const dir = btn.getAttribute('data-vdir');
                        const startOpen = document.getElementById('startMenuOverlay') && document.getElementById('startMenuOverlay').style.display !== 'none';
                        if (dir === 'up' || dir === 'left') {
                            if (startOpen && window.__startMenuUp) window.__startMenuUp();
                            else if (window.__menuUp) window.__menuUp();
                        } else if (dir === 'down' || dir === 'right') {
                            if (startOpen && window.__startMenuDown) window.__startMenuDown();
                            else if (window.__menuDown) window.__menuDown();
                        }
                        if (btn.setPointerCapture) try{ btn.setPointerCapture(e.pointerId); }catch(_){}
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    btn.setPointerCapture(e.pointerId);
                    const dir = btn.getAttribute('data-vdir');
                    state.activePointers.set(e.pointerId, dir);
                    state.order.push(e.pointerId);
                    start(dir, e.pointerId);
                });
                btn.addEventListener('pointerup', (e) => { e.preventDefault(); e.stopPropagation(); releasePointer(e.pointerId); });
                btn.addEventListener('pointercancel', (e) => { e.preventDefault(); e.stopPropagation(); releasePointer(e.pointerId); });
                btn.addEventListener('lostpointercapture', (e) => { try { releasePointer(e.pointerId); } catch (_) {} });
            });

            // Segurança: só solta se era um pointer do D-pad
            document.addEventListener('pointerup', (e) => releasePointer(e.pointerId));
            document.addEventListener('pointercancel', (e) => releasePointer(e.pointerId));

            // wrap já está visível por padrão
        })();
        
