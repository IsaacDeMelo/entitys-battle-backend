                    <div class="form-grid">
                        <div class="full-width">
                            <label>Ícone PNG 32x32</label>
                            <input type="file" id="itemIconFile" accept="image/png" onchange="onItemIconSelected(this)">
                            <div id="itemIconPreview" style="margin-top:10px; height:72px; border:1px dashed #444; border-radius:6px; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.2); color:#666; overflow:hidden;">Sem ícone</div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button type="submit" class="btn-save">💾 SALVAR ITEM</button>
                        <button type="button" class="btn-delete" onclick="deleteCatalogItem()">🗑️ EXCLUIR</button>
                    </div>
