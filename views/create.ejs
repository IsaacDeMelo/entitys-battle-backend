    </div>
    
    <script>
        const LAB_USER_ID = '<%= user._id %>';
        let itemCatalog = [];
        let itemCurrentId = '';
        let itemIconBlob = null;

        function switchMode(mode) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active')); 
            document.getElementById('btn-tab-' + mode).classList.add('active');
            document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden')); 
            document.getElementById('tab-' + mode).classList.remove('hidden');
            document.querySelectorAll('.list-container').forEach(l => l.classList.remove('active')); 
            document.getElementById('list-' + mode).classList.add('active');
        }
        
        function previewImage(input, targetId) {
            const container = document.getElementById(targetId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) { container.innerHTML = `<img src="${e.target.result}" style="height:100%;">`; }
                reader.readAsDataURL(input.files[0]);
            } else { container.innerHTML = "Sem imagem"; }
        }

        function renderItemList() {
            const list = document.getElementById('itemList');
            const counter = document.getElementById('itemCount');
            if (!list || !counter) return;
            list.innerHTML = '';
            const sorted = [...(itemCatalog || [])].sort((a, b) => a.name.localeCompare(b.name));
            counter.textContent = sorted.length;

            const datalist = document.getElementById('itemIdSuggestions');
            if (datalist) {
                datalist.innerHTML = sorted.map(it => `<option value="${it.id}"></option>`).join('');
            }

            if (!sorted.length) {
                const empty = document.createElement('div');
                empty.style.color = '#9aa7bd';
                empty.style.fontSize = '0.9rem';
                empty.style.padding = '10px';
                empty.textContent = 'Nenhum item cadastrado.';
                list.appendChild(empty);
                return;
            }

            sorted.forEach(it => {
                const row = document.createElement('div');
                row.className = 'list-item';
                row.onclick = () => loadItem(it);

                if (it.hasIcon) {
                    const img = document.createElement('img');
                    img.src = `/api/items/icon/${encodeURIComponent(it.id)}.png?ts=${it.updatedAt || Date.now()}`;
                    img.alt = it.id;
                    row.appendChild(img);
                } else {
                    const fallback = document.createElement('div');
                    fallback.className = 'npc-thumb';
                    fallback.style.background = '#111';
                    fallback.style.color = '#aaa';
                    fallback.style.display = 'flex';
                    fallback.style.alignItems = 'center';
                    fallback.style.justifyContent = 'center';
                    fallback.textContent = (it.name || it.id || '?').slice(0, 2).toUpperCase();
                    row.appendChild(fallback);
                }

                const info = document.createElement('div');
                info.className = 'item-info';

                const name = document.createElement('div');
                name.className = 'item-name';
                name.textContent = it.name;
                info.appendChild(name);

                const sub = document.createElement('div');
                sub.className = 'item-sub';
                const typeLabel = it.type === 'key' ? 'Item-chave' : 'Consumível';
                sub.textContent = `${typeLabel} • $${it.price || 0}`;
                info.appendChild(sub);

                row.appendChild(info);
                list.appendChild(row);
            });
        }

        async function refreshItemList() {
            try {
                const res = await fetch('/api/items/catalog');
                const json = await res.json();
                if (json && json.success && Array.isArray(json.items)) {
                    itemCatalog = json.items;
                    renderItemList();
                }
            } catch (_) {
                // silencioso
            }
        }

        function clearItemForm() {
            switchMode('item');
            const form = document.getElementById('itemForm');
            if (form) form.reset();
            itemCurrentId = '';
            itemIconBlob = null;
            const idInput = document.getElementById('itemId');
            if (idInput) idInput.disabled = false;
            const file = document.getElementById('itemIconFile');
            if (file) file.value = '';
            const prev = document.getElementById('itemIconPreview');
            if (prev) prev.innerHTML = 'Sem ícone';
        }

        function onItemIconSelected(input) {
            itemIconBlob = (input && input.files && input.files[0]) ? input.files[0] : null;
            previewImage(input, 'itemIconPreview');
        }

        function loadItem(it) {
            if (!it) return;
            switchMode('item');
            itemCurrentId = it.id;
            itemIconBlob = null;
            const form = document.getElementById('itemForm');
            if (form) form.reset();
            const idInput = document.getElementById('itemId');
            if (idInput) { idInput.value = it.id; idInput.disabled = true; }
            const name = document.getElementById('itemName');
            if (name) name.value = it.name || '';
            const type = document.getElementById('itemType');
            if (type) type.value = it.type === 'key' ? 'key' : 'consumable';
            const price = document.getElementById('itemPrice');
            if (price) price.value = Number.isFinite(it.price) ? it.price : 0;
            const file = document.getElementById('itemIconFile');
            if (file) file.value = '';
            const prev = document.getElementById('itemIconPreview');
            if (prev) {
                if (it.hasIcon) {
                    prev.innerHTML = `<img src="/api/items/icon/${encodeURIComponent(it.id)}.png?ts=${it.updatedAt || Date.now()}" style="height:100%; object-fit:contain;">`;
                } else {
                    prev.innerHTML = 'Sem ícone';
                }
            }
        }

        async function uploadItemIcon(itemId) {
            if (!itemIconBlob || !itemId) return true;
            const asDataUrl = await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(itemIconBlob);
            });
            if (!asDataUrl || typeof asDataUrl !== 'string' || !asDataUrl.startsWith('data:image/png')) {
                alert('Ícone precisa ser PNG.');
                return false;
            }
            const pngBase64 = asDataUrl.split(',')[1];
            // Checagem rápida de tamanho via Image
            const ok = await new Promise(resolve => {
                const img = new Image();
                img.onload = () => {
                    resolve(img.width === 32 && img.height === 32);
                };
                img.onerror = () => resolve(false);
                img.src = asDataUrl;
            });
            if (!ok) {
                alert('Use um PNG 32x32.');
                return false;
            }

            const res = await fetch('/api/items/icon/set', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: LAB_USER_ID, itemId, pngBase64 })
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok || !json.success) {
                alert(json && json.error ? json.error : 'Falha ao salvar ícone.');
                return false;
            }
            return true;
        }

        async function saveItem(ev) {
            if (ev) ev.preventDefault();
            const idInput = document.getElementById('itemId');
            const nameInput = document.getElementById('itemName');
            const typeInput = document.getElementById('itemType');
            const priceInput = document.getElementById('itemPrice');
            const id = (idInput?.value || '').trim();
            const name = (nameInput?.value || '').trim();
            const type = typeInput?.value === 'key' ? 'key' : 'consumable';
            const price = Math.max(0, parseInt(priceInput?.value, 10) || 0);
            if (!id || !name) {
                alert('Preencha ID e Nome.');
                return false;
            }

            const res = await fetch('/api/items/upsert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: LAB_USER_ID, item: { id, name, type, price } })
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok || !json.success) {
                alert(json && json.error ? json.error : 'Erro ao salvar item.');
                return false;
            }

            if (itemIconBlob) {
                const ok = await uploadItemIcon(id);
                if (!ok) return false;
                itemIconBlob = null;
                const file = document.getElementById('itemIconFile');
                if (file) file.value = '';
            }

            await refreshItemList();
            const saved = itemCatalog.find(x => x.id === id);
            if (saved) loadItem(saved);
            else clearItemForm();
            return false;
        }

        async function deleteCatalogItem() {
            const idInput = document.getElementById('itemId');
            const id = (idInput?.value || '').trim();
            if (!id) return alert('Selecione um item para excluir.');
            if (!confirm('Tem certeza que deseja excluir este item?')) return;
            const res = await fetch('/api/items/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: LAB_USER_ID, itemId: id })
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok || !json.success) {
                alert(json && json.error ? json.error : 'Erro ao excluir item.');
                return;
            }
            clearItemForm();
            await refreshItemList();
        }

        function clearPokeForm() { 
            document.getElementById('pokeForm').reset(); document.getElementById('existingId').value = ""; 
            document.getElementById('imgPreview').innerHTML = "Sem imagem"; 
            const dexEl = document.getElementById('pokeDexOrder');
            if (dexEl) dexEl.value = '';
            document.querySelectorAll('.move-check').forEach(c => c.checked = false); 
            syncMovePanels();
        }
        
        function loadEntity(p) {
            switchMode('poke'); clearPokeForm(); 
            document.getElementById('existingId').value = p.id; document.getElementById('pokeId').value = p.id;
            document.getElementById('pokeName').value = p.name; document.getElementById('pokeType').value = p.type;
            document.getElementById('statHp').value = p.baseStats.hp; document.getElementById('statEn').value = p.baseStats.energy; 
            document.getElementById('statAtk').value = p.baseStats.attack; document.getElementById('statDef').value = p.baseStats.defense; 
            document.getElementById('statSpd').value = p.baseStats.speed;
            document.getElementById('pokeRate').value = p.catchRate || 0.5; document.getElementById('pokeSpawn').value = p.spawnChance || 10; 
            document.getElementById('pokeLoc').value = p.spawnLocation || '';
            document.getElementById('spawnMin').value = p.minSpawnLevel || 1; document.getElementById('spawnMax').value = p.maxSpawnLevel || 5; 
            document.getElementById('isStarter').checked = !!p.isStarter;
            if(p.evolution) { document.getElementById('evoTarget').value = p.evolution.targetId || ''; document.getElementById('evoLevel').value = p.evolution.level || ''; }
            if(p.sprite) { 
                const src = (p.sprite.startsWith('http') || p.sprite.startsWith('data:')) ? p.sprite : '/uploads/' + p.sprite; 
                document.getElementById('imgPreview').innerHTML = `<img src="${src}" style="height:100%; object-fit:contain;">`; 
            }
            const dexEl = document.getElementById('pokeDexOrder');
            if (dexEl) dexEl.value = Number.isFinite(parseInt(p.dexOrder, 10)) ? parseInt(p.dexOrder, 10) : '';
            if(p.movePool) { p.movePool.forEach(mp => { const check = document.getElementById('chk_' + mp.moveId); const lvlInp = document.getElementById('lvl_' + mp.moveId); if(check) check.checked = true; if(lvlInp) lvlInp.value = mp.level; }); }
            syncMovePanels();
        }
        
        function prepareMoves() { 
            const moves = []; 
            document.querySelectorAll('.move-check').forEach(chk => { if(chk.checked) { const id = chk.getAttribute('data-id'); const lvl = document.getElementById('lvl_' + id).value; moves.push({ moveId: id, level: parseInt(lvl) }); } }); 
            document.getElementById('movesJson').value = JSON.stringify(moves); return true; 
        }
        
        function clearNpcForm() { 
            document.getElementById('npcForm').reset(); document.getElementById('npcId').value = ""; 
