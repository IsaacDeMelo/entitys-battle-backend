        function npcShopSyncJson() {
            const out = (npcShopRowsState || [])
                .filter(x => x && String(x.itemId || '').trim())
                .map(x => ({
                    itemId: String(x.itemId || '').trim(),
                    price: Math.max(0, parseInt(x.price, 10) || 0),
                    qty: Math.max(1, parseInt(x.qty, 10) || 1),
                    oneTimePerUser: !!x.oneTimePerUser
                }))
                .filter(x => x.itemId && x.price > 0);
            document.getElementById('npcInteractShopItemsJson').value = JSON.stringify(out);
        }

        function npcShopLoadFromJson(json) {
            try {
                const arr = JSON.parse(json || '[]');
                if (Array.isArray(arr)) {
                    npcShopRowsState = arr
                        .filter(x => x && (x.itemId || x.id))
                        .map(x => ({
                            itemId: String(x.itemId || x.id).trim(),
                            price: Math.max(0, parseInt(x.price, 10) || 0),
                            qty: Math.max(1, parseInt(x.qty || x.amount, 10) || 1),
                            oneTimePerUser: !!(x.oneTimePerUser === true || x.oneTimePerUser === 'true' || x.unique === true || x.unique === 'true')
                        }));
                } else {
                    npcShopRowsState = [];
                }
            } catch (_) {
                npcShopRowsState = [];
            }
            npcShopRender();
            npcShopSyncJson();
        }

