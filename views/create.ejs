<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratório - Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg: #0b1220; --panel: #121a2a; --panel-soft: rgba(255,255,255,0.03); --accent: #3b82f6; --text: #e2e8f0; 
            --danger: #e74c3c; --success: #2ecc71; --warning: #f1c40f;
            --beast: #a8a878; --flame: #f08030; --aqua: #6890f0; --forest: #78c850;
            --sky: #a890f0; --earth: #e0c068; --mystic: #f85888; --shadow: #705898;
            --metal: #b8b8d0; --venom: #a040a0;
            --normal: #a8a878; --fire: #f08030; --water: #6890f0; --grass: #78c850;
            --electric: #f8d030; --ice: #98d8d8; --fighting: #c03028; --poison: #a040a0;
            --ground: #e0c068; --flying: #a890f0; --psychic: #f85888; --bug: #a8b820;
            --rock: #b8a038; --ghost: #705898; --dragon: #7038f8; --dark: #705848;
            --steel: #b8b8d0; --fairy: #ee99ac;
        }
        * { box-sizing: border-box; }
        body { background: radial-gradient(circle at top, #0f172a 0%, #0b1220 55%, #0a0f1a 100%); color: var(--text); font-family: 'Rajdhani', sans-serif; margin: 0; padding: 20px; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border: 1px solid rgba(255,255,255,0.08); background: rgba(8, 12, 20, 0.75); border-radius: 12px; margin-bottom: 16px; }
        h1 { margin: 0; color: #e5e7eb; font-size: 1.4rem; letter-spacing: 1px; }
        .header-meta { display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; }
        .meta-pill { font-size: 0.7rem; padding: 4px 8px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.1); background: var(--panel-soft); color: #cbd5f5; letter-spacing: 0.4px; }
        .back-btn { text-decoration: none; color: #cbd5f5; font-weight: bold; border: 1px solid rgba(255,255,255,0.12); padding: 8px 12px; border-radius: 10px; transition: 0.2s; background: rgba(15, 23, 42, 0.7); }
        .back-btn:hover { background: rgba(30, 41, 59, 0.9); border-color: rgba(255,255,255,0.2); }
        .main-layout { display: flex; gap: 16px; height: 100%; overflow: hidden; }
        .sidebar { width: 340px; background: rgba(8, 12, 20, 0.55); border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; overflow: hidden; }
        .sidebar-header { padding: 12px; background: rgba(255,255,255,0.03); font-weight: bold; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); letter-spacing: 1px; }
        .list-container { flex: 1; overflow-y: auto; padding: 10px; display: none; }
        .list-container.active { display: flex; flex-direction: column; }
        .search-box { margin: 10px; padding: 10px; background: #0b1220; border: 1px solid #334155; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.9rem; }
        .search-box:focus { border-color: var(--accent); outline: none; }
        .list-item { display: flex; align-items: center; gap: 10px; padding: 10px; border: 1px solid transparent; cursor: pointer; transition: 0.2s; border-radius: 8px; margin-bottom: 6px; background: rgba(255,255,255,0.02); }
        .list-item:hover { background: rgba(59, 130, 246, 0.08); border-color: rgba(59, 130, 246, 0.35); }
        .list-item.active { border-color: rgba(241, 196, 15, 0.5); box-shadow: inset 0 0 0 1px rgba(241,196,15,0.12); }
        .list-item img, .npc-thumb { width: 40px; height: 40px; border-radius: 50%; background-color: rgba(0,0,0,0.3); image-rendering: pixelated; object-fit: contain; flex-shrink: 0; border: 1px solid #444; }
        .npc-thumb { background-size: 400% auto; background-position: 0 0; }
        .skin-thumb { width: 40px; height: 40px; border-radius: 8px; border: 1px solid #444; background: rgba(0,0,0,0.3); object-fit: contain; image-rendering: pixelated; flex-shrink: 0; }
        .item-info { flex: 1; overflow: hidden; }
        .item-name { font-weight: bold; color: #fff; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .item-sub { font-size: 0.7rem; color: #777; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .editor-area { flex: 1; background: rgba(18, 26, 42, 0.85); border-radius: 12px; padding: 22px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.45); }
        .tabs { display: flex; gap: 10px; margin-bottom: 18px; }
        .tab-btn { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); padding: 8px 18px; color: #9aa3b2; font-weight: bold; cursor: pointer; font-size: 0.95rem; border-radius: 999px; transition: 0.2s; }
        .tab-btn:hover { color: #e2e8f0; border-color: rgba(255,255,255,0.2); }
        .tab-btn.active { color: #e2e8f0; border-color: rgba(59,130,246,0.6); background: rgba(59,130,246,0.12); }
        .form-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
        .full-width { grid-column: span 3; }
        .half-width { grid-column: span 2; }
        label { display: block; font-size: 0.75rem; color: #94a3b8; margin-bottom: 6px; text-transform: uppercase; font-weight: bold; letter-spacing: 0.5px; }
        input, select, textarea { width: 100%; background: #0f172a; border: 1px solid #334155; color: white; padding: 10px; border-radius: 6px; font-family: inherit; font-size: 0.9rem; transition: 0.2s; }
        input:focus, select:focus, textarea:focus { border-color: var(--accent); outline: none; background: #162032; }
        input[disabled] { background: #1e293b; color: #555; border-color: #222; }
        .moves-panel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 12px; }
        .moves-column { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        .moves-header { font-size: 0.8rem; font-weight: 800; color: #cbd5f5; letter-spacing: 0.6px; text-transform: uppercase; }
        .moves-wrapper { background: #0f172a; border: 1px solid #333; padding: 10px; border-radius: 8px; max-height: 420px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; }
        .moves-selected { background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(59, 130, 246, 0.4); padding: 10px; border-radius: 8px; min-height: 140px; max-height: 420px; overflow-y: auto; display: grid; grid-template-columns: 1fr; gap: 8px; }
        .move-filter { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; align-items: center; }
        .move-filter input { flex: 1; min-width: 200px; }
        .filter-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; cursor: pointer; border: 2px solid transparent; transition: 0.2s; text-transform: uppercase; letter-spacing: 0.5px; }
        .filter-badge:hover { transform: translateY(-1px); box-shadow: 0 4px 8px rgba(0,0,0,0.3); }
        .filter-badge.active { border-color: #fff; box-shadow: 0 0 10px currentColor; }
        .filter-badge.all { background: #64748b; color: #fff; }
        .filter-badge.beast { background: var(--beast); color: #2d2d2d; }
        .filter-badge.flame { background: var(--flame); color: #fff; }
        .filter-badge.aqua { background: var(--aqua); color: #fff; }
        .filter-badge.forest { background: var(--forest); color: #2d2d2d; }
        .filter-badge.sky { background: var(--sky); color: #fff; }
        .filter-badge.earth { background: var(--earth); color: #2d2d2d; }
        .filter-badge.mystic { background: var(--mystic); color: #fff; }
        .filter-badge.shadow { background: var(--shadow); color: #fff; }
        .filter-badge.metal { background: var(--metal); color: #2d2d2d; }
        .filter-badge.venom { background: var(--venom); color: #fff; }
        .filter-badge.normal { background: var(--normal); color: #2d2d2d; }
        .filter-badge.fire { background: var(--fire); color: #fff; }
        .filter-badge.water { background: var(--water); color: #fff; }
        .filter-badge.grass { background: var(--grass); color: #fff; }
        .filter-badge.electric { background: var(--electric); color: #2d2d2d; }
        .filter-badge.ice { background: var(--ice); color: #2d2d2d; }
        .filter-badge.fighting { background: var(--fighting); color: #fff; }
        .filter-badge.poison { background: var(--poison); color: #fff; }
        .filter-badge.ground { background: var(--ground); color: #2d2d2d; }
        .filter-badge.flying { background: var(--flying); color: #fff; }
        .filter-badge.psychic { background: var(--psychic); color: #fff; }
        .filter-badge.bug { background: var(--bug); color: #fff; }
        .filter-badge.rock { background: var(--rock); color: #fff; }
        .filter-badge.ghost { background: var(--ghost); color: #fff; }
        .filter-badge.dragon { background: var(--dragon); color: #fff; }
        .filter-badge.dark { background: var(--dark); color: #fff; }
        .filter-badge.steel { background: var(--steel); color: #2d2d2d; }
        .filter-badge.fairy { background: var(--fairy); color: #fff; }
        .move-option { display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(255,255,255,0.03); border-radius: 6px; font-size: 0.85rem; cursor: pointer; user-select: none; border: 1px solid transparent; position: relative; transition: 0.2s; }
        .move-option:hover { background: rgba(255,255,255,0.08); border-color: #444; transform: translateY(-1px); }
        .move-option.checked { background: rgba(52, 152, 219, 0.15); border-color: var(--accent); }
        .move-option.selected { border-color: rgba(59,130,246,0.6); background: rgba(59,130,246,0.12); }
        .move-option input[type="checkbox"] { width: auto; margin: 0; cursor: pointer; }
        .move-type-badge { position: absolute; top: 2px; right: 2px; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }
        .move-info { display: flex; flex-direction: column; flex: 1; gap: 2px; }
        .move-name { font-weight: bold; color: #fff; }
        .move-details { font-size: 0.7rem; color: #94a3b8; }
        .move-lvl-input { width: 50px; padding: 4px; font-size: 0.75rem; text-align: center; border: 1px solid #555; background: #000; color: var(--accent); border-radius: 4px; }
        .btn-row { display: flex; gap: 15px; margin-top: 30px; padding-top: 20px; border-top: 1px solid #333; }
        button { cursor: pointer; transition: 0.2s; font-family: 'Rajdhani', sans-serif; text-transform: uppercase; letter-spacing: 1px; }
        button:active { transform: translateY(1px); }
        .btn-save { flex: 1; padding: 12px; border: 1px solid rgba(46,204,113,0.6); border-radius: 8px; font-weight: bold; background: rgba(46,204,113,0.12); color: #b7f7d2; font-size: 0.95rem; }
        .btn-save:hover { background: rgba(46,204,113,0.18); }
        .btn-delete { flex: 0.3; padding: 12px; border: 1px solid rgba(231,76,60,0.6); border-radius: 8px; font-weight: bold; background: rgba(231,76,60,0.12); color: #ffd0cc; font-size: 0.95rem; }
        .btn-delete:hover { background: rgba(231,76,60,0.2); }
        .btn-new { background: rgba(59,130,246,0.12); color: #cbe7ff; margin-bottom: 10px; width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(59,130,246,0.4); font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 5px; }
        .btn-new:hover { background: rgba(59,130,246,0.2); }
        .hidden { display: none; }
        h4 { color: var(--warning); border-bottom: 1px solid #333; padding-bottom: 8px; margin-bottom: 15px; margin-top: 25px; font-size: 1rem; }
        #imgPreview, #npcImgPreview { margin-top:10px; height:80px; border:1px dashed #444; border-radius: 6px; display:flex; align-items:center; justify-content:center; background: rgba(0,0,0,0.2); color: #555; overflow: hidden; }
        #imgPreview img, #npcImgPreview img { height: 100%; object-fit: contain; }
        .code-area { font-family: 'Consolas', monospace; color: #2ecc71; background: #000; border: 1px solid #333; padding: 10px; font-size: 0.85rem; line-height: 1.4; }
        .mini-btn { width: auto; padding: 8px 10px; border-radius: 8px; border: 1px solid #334155; background: rgba(255,255,255,0.06); color: #fff; font-weight: 700; }
        .mini-btn:hover { background: rgba(255,255,255,0.10); }
        .row-list { display:flex; flex-direction:column; gap:8px; }
        .row-item { display:grid; grid-template-columns: 1fr 90px 46px; gap:10px; align-items:center; }
        .row-item.shop { grid-template-columns: 1fr 110px 90px 130px 46px; }
        .row-item input, .row-item textarea { background: #0b1220; color: #fff; border: 1px solid #334155; border-radius: 6px; padding: 9px 10px; font-family: 'Roboto', sans-serif; font-size: 0.95rem; width: 100%; box-sizing: border-box; }
        .row-item textarea { min-height: 50px; resize: vertical; }
        .row-item input:focus, .row-item textarea:focus { border-color: #f1c40f; box-shadow: 0 0 0 2px rgba(241,196,15,0.16); outline: none; }
        .row-remove { background: var(--danger); border: none; color: #fff; border-radius: 8px; height: 40px; }
        /* Novo layout condicional */
        .cond-card { background: rgba(255,255,255,0.04); border: 1px solid #2c374b; border-radius: 12px; padding: 12px; display: grid; grid-template-columns: 220px 1fr; grid-auto-rows: auto; gap: 10px 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); }
        .cond-card .full { grid-column: span 2; }
        .cond-card .flag-prio { display: flex; gap: 10px; align-items: center; }
        .cond-card .flag-prio input[type="number"] { width: 90px; }
        .cond-card .actions { display: flex; justify-content: flex-end; gap: 10px; }
        details.advanced { border: 1px solid #334155; border-radius: 10px; padding: 10px; background: rgba(0,0,0,0.15); }
        details.advanced summary { cursor: pointer; font-weight: 800; color: #94a3b8; }
        .accordion { border: 1px solid #334155; border-radius: 10px; margin-bottom: 15px; background: rgba(0,0,0,0.15); }
        .accordion-header { padding: 12px 15px; cursor: pointer; font-weight: bold; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border-radius: 10px; transition: 0.2s; }
        .accordion-header:hover { background: rgba(255,255,255,0.06); }
        .accordion-header.active { background: rgba(52, 152, 219, 0.1); color: var(--accent); }
        .accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
        .accordion-body.active { max-height: 3000px; padding: 15px; }
        .stats-preview { background: linear-gradient(135deg, rgba(52, 152, 219, 0.1) 0%, rgba(46, 204, 113, 0.1) 100%); border: 1px solid #334155; border-radius: 10px; padding: 15px; margin-top: 15px; }
        .stats-preview h4 { margin-top: 0; color: var(--accent); }
        .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
        .stat-box { background: rgba(0,0,0,0.3); padding: 10px; border-radius: 6px; text-align: center; border-left: 3px solid var(--accent); }
        .stat-label { font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; }
        .stat-value { font-size: 1.5rem; font-weight: bold; color: var(--success); }
        .required-field::after { content: ' *'; color: var(--danger); }
        .tooltip { position: relative; display: inline-block; cursor: help; }
        .tooltip .tooltiptext { visibility: hidden; width: 200px; background-color: #1e293b; color: #fff; text-align: center; border-radius: 6px; padding: 8px; position: absolute; z-index: 1; bottom: 125%; left: 50%; margin-left: -100px; opacity: 0; transition: opacity 0.3s; font-size: 0.75rem; border: 1px solid #334155; }
        .tooltip:hover .tooltiptext { visibility: visible; opacity: 1; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; }
        .badge.consumable { background: #3498db; color: #fff; }
        .badge.key { background: #f1c40f; color: #2d2d2d; }
        .no-results { text-align: center; padding: 20px; color: #64748b; font-size: 0.9rem; }
        @media (max-width: 1200px) {
            .form-grid { grid-template-columns: repeat(2, 1fr); }
            .full-width { grid-column: span 2; }
            .half-width { grid-column: span 2; }
        }
        @media (max-width: 900px) {
            body { padding: 12px; }
            .main-layout { flex-direction: column; }
            .sidebar { width: 100%; height: 280px; }
        }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>LABORATÓRIO</h1>
            <small style="color:#94a3b8">Painel de Criação e Balanceamento</small>
            <div class="header-meta">
                <span class="meta-pill">ENTIDADES: <%= entities.length %></span>
                <span class="meta-pill">NPCS: <%= npcs.length %></span>
                <span class="meta-pill">SKINS: <%= (skins || []).length %></span>
            </div>
        </div>
        <a href="/city?userId=<%= user._id %>" class="back-btn">⬅️ VOLTAR AO JOGO</a>
    </header>

    <div class="main-layout">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div id="list-poke" class="list-container active">
                <div class="sidebar-header">ENTIDADES (<%= entities.length %>)</div>
                <input type="text" class="search-box" id="search-poke" placeholder="🔍 Buscar entidade..." onkeyup="filterList('poke', this.value)">
                <div style="padding:10px;">
                    <button class="btn-new" onclick="clearPokeForm()"><span>+</span> NOVA ENTIDADE</button>
                </div>
                <div id="poke-list-items">
                <% entities.forEach(p => { %>
                    <div class="list-item" data-name="<%= p.name.toLowerCase() %>" data-type="<%= p.type %>" onclick="loadEntity(<%= JSON.stringify(p) %>)">
                        <img src="<%= (p.sprite && (p.sprite.startsWith('http') || p.sprite.startsWith('data:'))) ? p.sprite : '/uploads/' + p.sprite %>" onerror="this.style.display='none'">
                        <div class="item-info">
                            <div class="item-name"><%= p.name %></div>
                            <div class="item-sub">Tipo: <%= p.type %> | Spawn: <%= p.spawnLocation || 'Nenhum' %></div>
                        </div>
                    </div>
                <% }) %>
                </div>
            </div>
            <div id="list-npc" class="list-container">
                <div class="sidebar-header">NPCS (<%= npcs.length %>)</div>
                <input type="text" class="search-box" id="search-npc" placeholder="🔍 Buscar NPC..." onkeyup="filterList('npc', this.value)">
                <div style="padding:10px;">
                    <button class="btn-new" onclick="clearNpcForm()"><span>+</span> NOVO NPC</button>
                </div>
                <div id="npc-list-items">
                <% npcs.forEach(n => { %>
                    <div class="list-item" data-name="<%= n.name.toLowerCase() %>" data-map="<%= n.map %>" onclick="loadNpc(<%= JSON.stringify(n) %>)">
                        <% if(n.isCustomSkin) { %> 
                            <div class="npc-thumb" style="background-image: url('<%= n.skin %>')"></div>
                        <% } else { %> 
                            <div class="npc-thumb" style="background-image: url('/uploads/<%= n.skin || 'char1' %>.png')"></div> 
                        <% } %>
                        <div class="item-info">
                            <div class="item-name"><%= n.name %></div>
                            <div class="item-sub"><%= n.map %> (X:<%= n.x %>, Y:<%= n.y %>)</div>
                        </div>
                    </div>
                <% }) %>
                </div>
            </div>

            <div id="list-item" class="list-container">
                <div class="sidebar-header">ITENS (<span id="itemCount">0</span>)</div>
                <input type="text" class="search-box" id="search-item" placeholder="🔍 Buscar item..." onkeyup="filterList('item', this.value)">
                <div style="padding:10px;">
                    <button class="btn-new" onclick="clearItemForm(); switchMode('item');"><span>+</span> NOVO ITEM</button>
                </div>
                <div id="itemList"></div>
            </div>

            <div id="list-skin" class="list-container">
                <div class="sidebar-header">SKINS (<%= (skins || []).length %>)</div>
                <input type="text" class="search-box" id="search-skin" placeholder="🔍 Buscar skin..." onkeyup="filterList('skin', this.value)">
                <div style="padding:10px;">
                    <button class="btn-new" onclick="clearSkinForm()"><span>+</span> NOVA SKIN</button>
                </div>
                <div id="skin-list-items">
                <% (skins || []).forEach(s => { %>
                    <div class="list-item" data-name="<%= s.name.toLowerCase() %>" onclick="loadSkin(<%= JSON.stringify(s) %>)">
                        <img class="skin-thumb" src="/skins/<%= s._id %>.png" onerror="this.style.display='none'">
                        <div class="item-info">
                            <div class="item-name"><%= s.name %></div>
                            <div class="item-sub">ID: <%= s._id %></div>
                        </div>
                    </div>
                <% }) %>
                </div>
            </div>
</div>

        <!-- EDITOR AREA -->
        <div class="editor-area">
            <div class="tabs">
                <button id="btn-tab-poke" class="tab-btn active" onclick="switchMode('poke')">ENTIDADE</button>
                <button id="btn-tab-npc" class="tab-btn" onclick="switchMode('npc')">NPC</button>
                <button id="btn-tab-item" class="tab-btn" onclick="switchMode('item')">ITENS</button>
                <button id="btn-tab-skin" class="tab-btn" onclick="switchMode('skin')">SKINS</button>
            </div>

            <!-- ================= FORM ENTIDADE ================= -->
            <div id="tab-poke" class="tab-content">
                <form id="pokeForm" action="/lab/create" method="POST" enctype="multipart/form-data" onsubmit="prepareMoves()">
                    <input type="hidden" name="existingId" id="existingId">
                    <input type="hidden" name="movesJson" id="movesJson">
                    
                    <div class="form-grid">
                        <div>
                            <label>ID (Gerado Auto)</label>
                            <input type="text" name="id" id="pokeId" disabled placeholder="Novo">
                        </div>
                        <div>
                            <label>Posicao na Dex</label>
                            <input type="number" name="dexOrder" id="pokeDexOrder" min="1" step="1" placeholder="Ex: 25">
                        </div>
                        <div class="half-width">
                            <label class="required-field">Nome do Monstro</label>
                            <input type="text" name="name" id="pokeName" required autocomplete="off" placeholder="Ex: Flarezard">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div>
                            <label class="required-field">Tipo Elementar</label>
                            <select name="type" id="pokeType">
                                <% Object.keys(types).forEach(t => { %> <option value="<%= t %>"><%= t.toUpperCase() %></option> <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="tooltip">Chance Captura (0.1 - 1.0)
                                <span class="tooltiptext">Chance base de captura. Quanto maior, mais fácil capturar. Ex: 0.3 = 30%, 0.8 = 80%</span>
                            </label>
                            <input type="number" step="0.1" name="catchRate" id="pokeRate" value="0.5" min="0" max="1">
                        </div>
                        <div>
                            <label class="tooltip">Raridade de Spawn (%)
                                <span class="tooltiptext">Peso no spawn ponderado. Valores maiores = mais comum</span>
                            </label>
                            <input type="number" name="spawnChance" id="pokeSpawn" value="10">
                        </div>
                    </div>
                    
                    <h4>📍 SPAWN & EVOLUÇÃO</h4>
                    <div class="form-grid">
                        <div>
                            <label class="tooltip">Local de Spawn (Mapa ou Zona)
                                <span class="tooltiptext">Use o ID do mapa ou a chave da zona de encontro da grama. Ex: city, city_garden, sewer_depths. Deixe vazio se não spawna</span>
                            </label>
                            <input type="text" name="location" id="pokeLoc" placeholder="ex: city, city_garden" list="mapSuggestions">
                            <datalist id="mapSuggestions">
                                <option value="city">Cidade</option>
                                <option value="city_garden">Zona de jardim</option>
                                <option value="city_rooftops">Zona de telhados</option>
                                <option value="sewer_depths">Zona de esgoto</option>
                            </datalist>
                        </div>
                        <div>
                            <label class="tooltip">Nível Mínimo
                                <span class="tooltiptext">Nível mais baixo ao spawnar selvagem</span>
                            </label>
                            <input type="number" name="minLvl" id="spawnMin" value="2" min="1">
                        </div>
                        <div>
                            <label class="tooltip">Nível Máximo
                                <span class="tooltiptext">Nível mais alto ao spawnar selvagem</span>
                            </label>
                            <input type="number" name="maxLvl" id="spawnMax" value="5" min="1">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="full-width">
                            <label class="tooltip">Evolução (ID do Alvo + Nível)
                                <span class="tooltiptext">Configure a evolução: ID da criatura evoluída + nível necessário. Deixe vazio se não evolui</span>
                            </label>
                            <div style="display:flex; gap:10px;">
                                <input type="text" name="evoTarget" id="evoTarget" placeholder="ex: charizard (ID da evolução)" autocomplete="off">
                                <input type="number" name="evoLevel" id="evoLevel" placeholder="Lv 16" style="width:120px;" min="1">
                            </div>
                        </div>
                    </div>

                    <h4>📊 STATUS BASE</h4>
                    <div class="form-grid" style="grid-template-columns: repeat(5, 1fr);">
                        <div><label class="required-field">HP</label><input type="number" name="hp" id="statHp" required value="40" oninput="updateStatsPreview()"></div>
                        <div><label class="required-field">EN (Mana)</label><input type="number" name="energy" id="statEn" required value="100" oninput="updateStatsPreview()"></div>
                        <div><label class="required-field">ATK</label><input type="number" name="atk" id="statAtk" required value="50" oninput="updateStatsPreview()"></div>
                        <div><label class="required-field">DEF</label><input type="number" name="def" id="statDef" required value="40" oninput="updateStatsPreview()"></div>
                        <div><label class="required-field">SPD</label><input type="number" name="spd" id="statSpd" required value="50" oninput="updateStatsPreview()"></div>
                    </div>

                    <div class="stats-preview">
                        <h4>📈 Preview: Stats no Nível <input type="number" id="preview-level" value="50" min="1" max="100" oninput="updateStatsPreview()" style="width: 60px; display: inline; padding: 4px; text-align: center; border-radius: 4px; border: 1px solid #334155; background: #0f172a; color: var(--accent);"></h4>
                        <div class="stats-grid" id="stats-preview-grid">
                            <div class="stat-box">
                                <div class="stat-label">HP</div>
                                <div class="stat-value" id="preview-hp">-</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">Energy</div>
                                <div class="stat-value" id="preview-en">-</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">Attack</div>
                                <div class="stat-value" id="preview-atk">-</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">Defense</div>
                                <div class="stat-value" id="preview-def">-</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">Speed</div>
                                <div class="stat-value" id="preview-spd">-</div>
                            </div>
                        </div>
                        <p style="margin-top: 10px; font-size: 0.85rem; color: #94a3b8; text-align: center;">💡 Esses valores são aproximados baseados na fórmula do jogo</p>
                    </div>

                    <h4>⚔️ MOVEPOOL (Ataques)</h4>
                    <div class="move-filter">
                        <input type="text" id="move-search" placeholder="🔍 Buscar ataque..." onkeyup="filterMoves()" style="padding: 8px; border-radius: 6px; background: #0f172a; border: 1px solid #334155; color: #fff;">
                        <span class="filter-badge all active" onclick="filterMovesByType('all')">TODOS</span>
                        <span class="filter-badge beast" onclick="filterMovesByType('beast')">BEAST</span>
                        <span class="filter-badge flame" onclick="filterMovesByType('flame')">FLAME</span>
                        <span class="filter-badge aqua" onclick="filterMovesByType('aqua')">AQUA</span>
                        <span class="filter-badge forest" onclick="filterMovesByType('forest')">FOREST</span>
                        <span class="filter-badge sky" onclick="filterMovesByType('sky')">SKY</span>
                        <span class="filter-badge earth" onclick="filterMovesByType('earth')">EARTH</span>
                        <span class="filter-badge mystic" onclick="filterMovesByType('mystic')">MYSTIC</span>
                        <span class="filter-badge shadow" onclick="filterMovesByType('shadow')">SHADOW</span>
                        <span class="filter-badge metal" onclick="filterMovesByType('metal')">METAL</span>
                        <span class="filter-badge venom" onclick="filterMovesByType('venom')">VENOM</span>
                    </div>
                    <div class="moves-panel">
                        <div class="moves-column">
                            <div class="moves-header">Disponiveis</div>
                            <div class="moves-wrapper" id="moves-available">
                                <% Object.keys(moves).forEach(moveKey => { const m = moves[moveKey]; %>
                                    <div class="move-option" data-move-id="<%= moveKey %>" data-element="<%= m.element %>" data-name="<%= m.name.toLowerCase() %>">
                                        <input type="checkbox" class="move-check" data-id="<%= moveKey %>" id="chk_<%= moveKey %>" onchange="updateMoveChecked(this)">
                                        <span class="move-type-badge <%= m.element %>" style="background: var(--<%= m.element %>); color: <%= ['beast','forest','earth','metal'].includes(m.element) ? '#2d2d2d' : '#fff' %>;"> <%= m.element.substring(0,3).toUpperCase() %> </span>
                                        <div class="move-info">
                                            <span class="move-name"><%= m.name %></span>
                                            <span class="move-details">💪 <%= m.power || 0 %> | ⚡ <%= m.cost || 0 %> | <%= m.type === 'attack' ? '⚔️' : m.type === 'heal' ? '❤️' : '🛡️' %></span>
                                        </div>
                                        <input type="number" class="move-lvl-input" id="lvl_<%= moveKey %>" value="1" title="Nível para aprender" min="1" max="100">
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                        <div class="moves-column">
                            <div class="moves-header">Selecionados</div>
                            <div class="moves-selected" id="moves-selected"></div>
                        </div>
                    </div>

                    <div class="form-grid" style="margin-top:20px;">
                        <div class="full-width">
                            <label>Sprite (PNG/GIF)</label>
                            <input type="file" name="sprite" accept="image/*" onchange="previewImage(this, 'imgPreview')">
                            <div id="imgPreview">Sem imagem</div>
                        </div>
                    </div>

                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333; margin-top:10px;">
                        <input type="checkbox" name="isStarter" id="isStarter" style="width:auto;"> <span style="font-weight:bold; color:var(--accent);">Disponível como Inicial?</span>
                    </label>
                    
                    <div class="btn-row">
                        <button type="submit" class="btn-save">💾 SALVAR ENTIDADE</button>
                        <button type="button" class="btn-delete" onclick="deleteItem('deleteForm')">🗑️ EXCLUIR</button>
                    </div>
                </form>
                <form id="deleteForm" action="/lab/delete" method="POST" style="display:none;"><input type="hidden" name="id" id="deleteId"></form>
            </div>

            <!-- ================= FORM NPC ================= -->
            <div id="tab-npc" class="tab-content hidden">
                <form id="npcForm" action="/lab/create-npc" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="userId" value="<%= user._id %>">
                    <input type="hidden" name="npcId" id="npcId">
                    
                    <div class="form-grid">
                        <div class="full-width">
                            <label class="required-field">Nome do NPC</label>
                            <input type="text" name="name" id="npcName" required autocomplete="off" placeholder="Ex: Professor Oak">
                        </div>
                    </div>
                    
                    <div class="form-grid">
                        <div>
                            <label class="required-field tooltip">Mapa (ID)
                                <span class="tooltiptext">ID do mapa onde o NPC aparece (ex: city, forest, house1)</span>
                            </label>
                            <input type="text" name="map" id="npcMap" list="mapList" placeholder="ex: city, house1" required autocomplete="off">
                            <datalist id="mapList">
                                <option value="lobby">Lobby</option>
                                <option value="forest">Floresta</option>
                                <option value="city">Cidade</option>
                            </datalist>
                        </div>
                        <div>
                            <label class="required-field tooltip">Posição X (0-100%)
                                <span class="tooltiptext">Posição horizontal no mapa (0 = esquerda, 100 = direita)</span>
                            </label>
                            <input type="number" name="x" id="npcX" value="50" step="0.5" min="0" max="100">
                        </div>
                        <div>
                            <label class="required-field tooltip">Posição Y (0-100%)
                                <span class="tooltiptext">Posição vertical no mapa (0 = topo, 100 = fundo)</span>
                            </label>
                            <input type="number" name="y" id="npcY" value="50" step="0.5" min="0" max="100">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div>
                            <label>Direção Inicial</label>
                            <select name="direction" id="npcDir">
                                <option value="down">Baixo</option>
                                <option value="up">Cima</option>
                                <option value="left">Esquerda</option>
                                <option value="right">Direita</option>
                            </select>
                        </div>
                        <div>
                            <label>Skin Padrão</label>
                            <select name="skinSelect" id="npcSkinSelect">
                                <option value="">-- Personalizada --</option>
                                <% (skins || []).forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label>Recompensa ($)</label>
                            <input type="number" name="money" id="npcMoney" value="100">
                        </div>
                    </div>
                    
                    <div style="margin-bottom:15px;">
                        <label>Ou Upload Skin Própria</label>
                        <input type="file" name="npcSkinFile" accept="image/*" onchange="previewImage(this, 'npcImgPreview')">
                        <div id="npcImgPreview"></div>
                    </div>

                    <!-- BACKGROUND DE BATALHA COM UPLOAD -->
                    <div class="form-grid">
                        <div class="full-width">
                            <label>Cenário de Batalha (Upload Imagem)</label>
                            <input type="file" name="battleBgFile" accept="image/*" onchange="previewImage(this, 'battleBgPreview')">
                            <div id="battleBgPreview" style="margin-top:5px; height:60px; border:1px dashed #555; display:flex; justify-content:center; align-items:center; overflow:hidden;">
                                <span style="font-size:0.7rem; color:#555">Padrão</span>
                            </div>
                        </div>
                    </div>
                    
                    <h4>💬 DIÁLOGOS PADRÃO</h4>
                    <div style="margin-bottom:15px; padding:10px; background:#162032; border-radius:6px; border-left: 4px solid #3498db;">
                        <small style="color:#3498db;"><strong>ℹ️ Como funciona:</strong> Estes textos são usados quando <strong>nenhuma flag condicional está ativa</strong>. Se você configurar diálogos condicionais abaixo, o NPC falará coisas diferentes dependendo das flags do jogador!</small>
                    </div>
                    <div class="form-grid">
                        <div class="full-width">
                            <label>Fala Inicial (Quando nenhuma flag está ativa)</label>
                            <textarea name="dialogue" id="npcDialogue" placeholder="Olá! Este é o meu diálogo padrão." autocomplete="off" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="half-width">
                            <label>Fala de Vitória (Quando jogador vence e nenhuma flag está ativa)</label>
                            <textarea name="winDialogue" id="npcWinDialogue" placeholder="Você me venceu..." autocomplete="off" rows="2"></textarea>
                        </div>
                        <div>
                            <label>Fala em Cooldown (Quando já derrotado e nenhuma flag está ativa)</label>
                            <textarea name="cooldownDialogue" id="npcCdDialogue" placeholder="Volte mais tarde." autocomplete="off" rows="2"></textarea>
                        </div>
                    </div>

                    <h4 style="margin-top:20px;">💬 DIÁLOGOS CONDICIONAIS (POR FLAG)</h4>
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333;">
                        <input type="checkbox" id="npcCondToggle" style="width:auto;"> <span style="font-weight:bold; color:var(--accent);">Habilitar diálogos condicionais</span>
                    </label>

                    <div id="conditionalFields" class="toggle-block" style="display:none;">
                        <div class="form-grid" style="grid-template-columns: repeat(3, 1fr);">
                            <div class="full-width" style="grid-column: span 3; padding:12px; background:#1a2942; border-radius:8px; border-left: 4px solid #2ecc71;">
                                <strong style="color:#2ecc71;">✅ Como usar:</strong>
                                <ul style="margin:8px 0 0 0; padding-left:20px; color:#9aa7bd; font-size:0.9rem; line-height:1.6;">
                                    <li><strong>Com flag ativa:</strong> O NPC usa o texto da condicional</li>
                                    <li><strong>Sem flag ativa:</strong> O NPC usa o texto padrão acima</li>
                                    <li><strong>Prioridade:</strong> Se múltiplas flags estão ativas, a de maior número é usada</li>
                                </ul>
                            </div>
                            <div class="full-width" style="grid-column: span 3; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                                <button type="button" class="mini-btn" onclick="npcCondAddRow()">+ adicionar condição</button>
                                <button type="button" class="mini-btn" onclick="npcCondClear()">limpar todas condições</button>
                                <div style="font-size:0.85rem; color:#9aa7bd;">(gera JSON automaticamente)</div>
                            </div>
                            <div id="npcCondRows" class="row-list" style="grid-column: span 3;"></div>
                            <details class="advanced" style="grid-column: span 3; border-color: #2ecc71;">
                                <summary style="color: #2ecc71;">📖 Ver Exemplo Prático</summary>
                                <div style="padding: 12px; background: #0a1628; border-radius: 6px; color: #9aa7bd; font-size: 0.9rem; line-height: 1.6;">
                                    <strong style="color: #2ecc71;">Exemplo: Guarda de Cidade</strong><br><br>
                                    <strong>Diálogo Padrão (acima):</strong> "Alto lá! Você precisa de uma licença para passar."<br><br>
                                    <strong>Condicional 1:</strong><br>
                                    • flagId: <code style="background:#000; padding:2px 6px; border-radius:3px;">license_obtained</code><br>
                                    • dialogue: "Bem-vindo! Pode passar."<br>
                                    • priority: 10<br><br>
                                    <strong style="color:#f39c12;">Resultado:</strong><br>
                                    → Jogador <strong>sem</strong> a flag = "Alto lá! Você precisa de uma licença..."<br>
                                    → Jogador <strong>com</strong> a flag = "Bem-vindo! Pode passar."
                                </div>
                            </details>
                            <details class="advanced" style="grid-column: span 3;">
                                <summary>Avançado (JSON)</summary>
                                <textarea name="conditionalDialoguesJson" id="npcConditionalDialoguesJson" class="code-area" style="height:110px;" placeholder='[{"flagId":"flag_boss_defeated","dialogue":"Você já me derrotou!","winDialogue":"Ok, entendi.","cooldownDialogue":"Volte amanhã","priority":10}]'></textarea>
                            </details>
                        </div>
                    </div>

                    <h4 style="margin-top:20px;">🎒 EQUIPE DE ENTIDADES</h4>
                    <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px; flex-wrap:wrap;">
                        <button type="button" class="mini-btn" onclick="npcTeamAddRow()">+ adicionar monstro</button>
                        <button type="button" class="mini-btn" onclick="npcTeamClear()">limpar</button>
                        <div style="font-size:0.85rem; color:#9aa7bd;">(gera o JSON automaticamente)</div>
                    </div>

                    <div id="npcTeamRows" class="row-list"></div>

                    <details class="advanced" style="margin-top:10px;">
                        <summary>Avançado (JSON)</summary>
                        <textarea name="teamJson" id="npcTeam" class="code-area" style="height:100px;" placeholder='[{"baseId":"bulbasaur", "level":5}]'></textarea>
                    </details>

                    <select id="npcTeamPokemonOptionsTemplate" class="hidden">
                        <option value="">-- escolha um monstro --</option>
                        <% (entities || []).forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.name %> (<%= p.id %>)</option>
                        <% }) %>
                    </select>

                    <h4 style="margin-top:20px;">🎁 ITEM DE RECOMPENSA (Opcional)</h4>
                    <div class="form-grid">
                        <div><label>Cooldown (Minutos)</label><input type="number" name="cooldownMinutes" id="npcCooldown" value="0" title="0 = Único, >0 = Repetível"></div>
                        <div><label>ID do Item/Entidade</label><input type="text" name="rewardVal" id="npcRewVal" placeholder="ex: captureCube, levelUpCrystal" autocomplete="off"></div>
                        <div><label>Quantidade</label><input type="number" name="rewardQty" id="npcRewQty" value="1"></div>
                        <input type="hidden" name="rewardType" id="npcRewType" value="item">
                    </div>

                    <div class="form-grid" style="grid-template-columns: repeat(3, 1fr);">
                        <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333;">
                            <input type="checkbox" name="rewardKeyItem" id="npcRewardKeyItem" style="width:auto;"> <span style="font-weight:bold; color:var(--accent);">Recompensa é item-chave?</span>
                        </label>
                        <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333;">
                            <input type="checkbox" name="rewardUnique" id="npcRewardUnique" style="width:auto;"> <span style="font-weight:bold; color:var(--accent);">Recompensa única?</span>
                        </label>
                        <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333;">
                            <input type="checkbox" name="blocksMovement" id="npcBlocksMovement" style="width:auto;"> <span style="font-weight:bold; color:var(--accent);">NPC bloqueia caminho?</span>
                        </label>
                    </div>

                    <h4 style="margin-top:20px;">🧩 INTERAÇÃO (Quest / Itens)</h4>
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer; background:#162032; padding:10px; border-radius:6px; border:1px solid #333;">
                        <input type="checkbox" name="interactEnabled" id="npcInteractEnabled" style="width:auto;"> <span style="font-weight:bold; color:var(--warning);">Habilitar interação (além/sem batalha)</span>
                    </label>

                    <div id="interactFields" class="toggle-block" style="display:none;">

                    <div class="form-grid">
                        <div class="full-width">
                            <label>Serviço do NPC (opcional)</label>
                            <select name="interactServiceType" id="npcInteractServiceType">
                                <option value="">Quest / Itens (padrão)</option>
                                <option value="starter">Starter (Escolha inicial)</option>
                                <option value="heal">Curar time</option>
                                <option value="shop">Loja</option>
                                <option value="box">Roleta (Box / Gacha)</option>
                            </select>
                            <div class="hint" style="margin-top:6px; color:#9aa7bd; font-size:0.85rem;">Para "Curar time" e "Loja", a interação NÃO é única por padrão.</div>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div>
                            <label>Alcance de interação (0 = padrão)</label>
                            <input type="number" name="interactRange" id="npcInteractRange" value="0" min="0" step="0.5">
                        </div>
                        <div class="full-width">
                            <div class="hint" style="margin-top:24px; color:#9aa7bd; font-size:0.85rem;">Use para falar com NPC atrás de balcão/barreira (ex: 12 a 18). Se 0, usa o padrão do jogo.</div>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="full-width">
                            <label>Texto de cura (se serviço = Curar time)</label>
                            <input type="text" name="interactHealDialogue" id="npcInteractHealDialogue" placeholder="Posso curar seus monstros!" autocomplete="off">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="full-width">
                            <label>Itens da loja (JSON) (se serviço = Loja)</label>
                            <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px; flex-wrap:wrap;">
                                <button type="button" class="mini-btn" onclick="npcShopAddRow()">+ adicionar item</button>
                                <button type="button" class="mini-btn" onclick="npcShopAddPreset('pokeball', 50)">+ CatchCube</button>
                                <button type="button" class="mini-btn" onclick="npcShopAddPreset('rareCandy', 2000)">+ Rare Candy</button>
                                <button type="button" class="mini-btn" onclick="npcShopClear()">limpar</button>
                            </div>

                            <div class="hint" style="margin-bottom:8px; color:#9aa7bd; font-size:0.85rem;">Cada linha pode vender um lote e também ser marcada como compra única por jogador.</div>

                            <div id="npcShopRows" class="row-list"></div>

                            <details class="advanced" style="margin-top:10px;">
                                <summary>Avançado (JSON)</summary>
                                <textarea name="interactShopItemsJson" id="npcInteractShopItemsJson" placeholder='[{"itemId":"pokeball","price":50,"qty":1,"oneTimePerUser":false}]'></textarea>
                            </details>

                            <datalist id="itemIdSuggestions">
                                <option value="pokeball"></option>
                                <option value="rareCandy"></option>
