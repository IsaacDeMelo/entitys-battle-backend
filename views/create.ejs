            <!-- ================= FORM ITENS ================= -->
            <div id="tab-item" class="tab-content hidden">
                <form id="itemForm" onsubmit="return saveItem(event);">
                    <div class="form-grid">
                        <div>
                            <label>ID (único)</label>
