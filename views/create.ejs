                win.value = row.winDialogue || '';
                win.style.minHeight = '150px';
                win.style.width = '100%';
                win.style.flex = '1';
                win.oninput = () => { npcCondRowsState[idx].winDialogue = win.value; npcCondSyncJson(); };

                const cd = document.createElement('textarea');
                cd.className = 'full';
                cd.placeholder = '⏳ Fala em cooldown (quando tem a flag MAS já falou recentemente)';
                cd.value = row.cooldownDialogue || '';
                cd.style.minHeight = '150px';
                cd.style.width = '100%';
                cd.style.flex = '1';
                cd.oninput = () => { npcCondRowsState[idx].cooldownDialogue = cd.value; npcCondSyncJson(); };

                const priority = document.createElement('input');
                priority.type = 'number';
                priority.step = '1';
                priority.placeholder = 'prioridade';
                priority.style.width = '90px';
                priority.value = String(row.priority || 0);
                priority.oninput = () => { npcCondRowsState[idx].priority = parseInt(priority.value, 10) || 0; npcCondSyncJson(); };

                const rm = document.createElement('button');
                rm.type = 'button';
                rm.className = 'row-remove';
                rm.innerText = 'X';
                rm.onclick = () => { npcCondRowsState.splice(idx, 1); npcCondRender(); npcCondSyncJson(); };

                flagRow.appendChild(flag);
                flagRow.appendChild(priority);
                flagRow.appendChild(rm);

                wrap.appendChild(flagRow);
                wrap.appendChild(dialogue);
                wrap.appendChild(win);
                wrap.appendChild(cd);
                container.appendChild(wrap);
            });

            if (npcCondRowsState.length === 0) {
                const empty = document.createElement('div');
                empty.style.color = '#9aa7bd';
                empty.style.fontSize = '0.9rem';
                empty.innerText = 'Sem condições configuradas.';
                container.appendChild(empty);
            }
        }

        function npcCondSyncJson() {
            const out = (npcCondRowsState || [])
                .filter(x => x && String(x.flagId || '').trim())
                .map(x => ({
                    flagId: String(x.flagId || '').trim(),
                    dialogue: String(x.dialogue || ''),
                    winDialogue: String(x.winDialogue || ''),
                    cooldownDialogue: String(x.cooldownDialogue || ''),
                    priority: parseInt(x.priority, 10) || 0
                }));
            const target = document.getElementById('npcConditionalDialoguesJson');
            if (target) target.value = JSON.stringify(out);
        }

        function npcCondLoadFromJson(json) {
            try {
                const arr = JSON.parse(json || '[]');
                npcCondRowsState = Array.isArray(arr)
                    ? arr.map(x => ({
                        flagId: String((x && x.flagId) || '').trim(),
                        dialogue: String((x && x.dialogue) || ''),
                        winDialogue: String((x && x.winDialogue) || ''),
                        cooldownDialogue: String((x && x.cooldownDialogue) || ''),
                        priority: parseInt(x && x.priority, 10) || 0
                    })).filter(x => x.flagId)
                    : [];
            } catch (_) {
                npcCondRowsState = [];
            }
            npcCondRender();
            npcCondSyncJson();
        }

        function npcCondAddRow() {
            npcCondRowsState.push({ flagId: '', dialogue: '', winDialogue: '', cooldownDialogue: '', priority: 0 });
            npcCondRender();
            npcCondSyncJson();
        }

        function npcCondClear() {
            npcCondRowsState = [];
            npcCondRender();
            npcCondSyncJson();
        }

        function npcCondClearNonConditional() {
            // Limpa os diálogos padrão quando você quer usar APENAS flags
            document.getElementById('npcDialogue').value = '';
            document.getElementById('npcWinDialogue').value = '';
            document.getElementById('npcCdDialogue').value = '';
            if (typeof showToast === 'function') {
                showToast('Diálogos padrão limpos! Use APENAS os diálogos por flag.', { bg: '#3498db' });
            }
        }

        document.addEventListener('input', (e) => {
            if (e && e.target && e.target.id === 'npcConditionalDialoguesJson') {
                npcCondLoadFromJson(e.target.value);
            }
        });

        // ======== TOGGLES (mostrar/ocultar seções opcionais) ========
        function setupToggle(chkId, sectionId, opts = {}) {
            const chk = document.getElementById(chkId);
            const section = document.getElementById(sectionId);
            if (!chk || !section) return;
            const onDisable = typeof opts.onDisable === 'function' ? opts.onDisable : null;
            const apply = () => {
                const on = !!chk.checked;
                section.style.display = on ? 'block' : 'none';
                if (!on && onDisable) onDisable();
            };
            chk.addEventListener('change', apply);
            apply();
        }

        // Inicializa editores (novo NPC)
        setTimeout(() => {
            npcTeamLoadFromJson(document.getElementById('npcTeam')?.value || '[]');
            npcShopLoadFromJson(document.getElementById('npcInteractShopItemsJson')?.value || '[]');
            npcBoxLoadFromJson(document.getElementById('npcInteractBoxRewardsJson')?.value || '[]');
            npcCondLoadFromJson(document.getElementById('npcConditionalDialoguesJson')?.value || '[]');

            // Define estado inicial dos toggles com base nos campos carregados
            const interactChk = document.getElementById('npcInteractEnabled');
            if (interactChk && interactChk.checked) { /* keep */ }
            setupToggle('npcInteractEnabled', 'interactFields');

            const patrolChk = document.getElementById('npcPatrolEnabled');
            setupToggle('npcPatrolEnabled', 'patrolFields');

            const condChk = document.getElementById('npcCondToggle');
            const condText = document.getElementById('npcConditionalDialoguesJson')?.value || '';
            if (condChk) {
                if (condText && condText.trim() && condText.trim() !== '[]') condChk.checked = true;
                setupToggle('npcCondToggle', 'conditionalFields', {
                    onDisable: () => {
                        npcCondRowsState = [];
                        npcCondRender();
                        npcCondSyncJson();
                    }
                });
            }
        }, 0);

        refreshItemList();

        // ======== FILTROS E BUSCA ========
        function filterList(type, query) {
            const container = document.getElementById(`${type}-list-items`) || document.getElementById('itemList');
            if (!container) return;
            
            const items = container.querySelectorAll('.list-item');
            const lowerQuery = query.toLowerCase();
            let visibleCount = 0;
            
            items.forEach(item => {
                const name = item.dataset.name || '';
                const visible = name.includes(lowerQuery);
                item.style.display = visible ? 'flex' : 'none';
                if (visible) visibleCount++;
            });
            
            // Mostra mensagem se não houver resultados
            let noResults = container.querySelector('.no-results');
            if (visibleCount === 0) {
                if (!noResults) {
                    noResults = document.createElement('div');
                    noResults.className = 'no-results';
                    noResults.textContent = '🔍 Nenhum resultado encontrado';
                    container.appendChild(noResults);
                }
            } else if (noResults) {
                noResults.remove();
            }
        }

        let currentMoveFilter = 'all';
        
        function filterMovesByType(type) {
            currentMoveFilter = type;
            
            // Atualiza badges
            document.querySelectorAll('.filter-badge').forEach(badge => {
                badge.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Filtra moves
            filterMoves();
        }
        
        function filterMoves() {
            const searchQuery = (document.getElementById('move-search')?.value || '').toLowerCase();
            const moves = document.querySelectorAll('#moves-available .move-option');
            let visibleCount = 0;
            
            moves.forEach(move => {
                const name = move.dataset.name || '';
                const element = move.dataset.element || '';
                
                const matchesType = currentMoveFilter === 'all' || element === currentMoveFilter;
                const matchesSearch = !searchQuery || name.includes(searchQuery);
                
                const visible = matchesType && matchesSearch;
                move.style.display = visible ? 'flex' : 'none';
                if (visible) visibleCount++;
            });
            
            // Mostra mensagem se não houver resultados
            const wrapper = document.getElementById('moves-available');
            let noResults = wrapper.querySelector('.no-results');
            if (visibleCount === 0) {
                if (!noResults) {
                    noResults = document.createElement('div');
                    noResults.className = 'no-results';
                    noResults.style.gridColumn = '1 / -1';
                    noResults.textContent = '🔍 Nenhum ataque encontrado';
                    wrapper.appendChild(noResults);
                }
            } else if (noResults) {
                noResults.remove();
            }
        }
        
        function syncMovePanels() {
            const available = document.getElementById('moves-available');
            const selected = document.getElementById('moves-selected');
            if (!available || !selected) return;

            document.querySelectorAll('.move-option').forEach(option => {
                const checkbox = option.querySelector('.move-check');
                if (!checkbox) return;
                if (checkbox.checked) {
                    selected.appendChild(option);
                    option.classList.add('checked', 'selected');
                } else {
                    available.appendChild(option);
                    option.classList.remove('checked', 'selected');
                }
            });
            filterMoves();
        }

        function updateMoveChecked(checkbox) {
            const moveOption = checkbox.closest('.move-option');
            if (moveOption) {
                const available = document.getElementById('moves-available');
                const selected = document.getElementById('moves-selected');
                if (checkbox.checked) {
                    selected.appendChild(moveOption);
                    moveOption.classList.add('checked', 'selected');
                } else {
                    available.appendChild(moveOption);
                    moveOption.classList.remove('checked', 'selected');
                }
                filterMoves();
            }
        }

        // ======== PREVIEW DE STATS ========
        function updateStatsPreview() {
            const level = parseInt(document.getElementById('preview-level')?.value || 50);
            const baseHp = parseInt(document.getElementById('statHp')?.value || 40);
            const baseEnergy = parseInt(document.getElementById('statEn')?.value || 100);
            const baseAtk = parseInt(document.getElementById('statAtk')?.value || 50);
            const baseDef = parseInt(document.getElementById('statDef')?.value || 40);
            const baseSpd = parseInt(document.getElementById('statSpd')?.value || 50);

            // Fórmulas baseadas no gameData.js
            const hp = Math.floor((baseHp * 1.5 * level / 100) + level + 10);
            const energy = Math.floor(baseEnergy + (level * 0.1));
            const attack = Math.floor(baseAtk * (1 + level * 0.025));
            const defense = Math.floor(baseDef * (1 + level * 0.025));
            const speed = Math.floor(baseSpd * (1 + level * 0.025));

            document.getElementById('preview-hp').textContent = hp;
            document.getElementById('preview-en').textContent = energy;
            document.getElementById('preview-atk').textContent = attack;
            document.getElementById('preview-def').textContent = defense;
            document.getElementById('preview-spd').textContent = speed;
        }

        // Inicializa preview ao carregar página
        setTimeout(() => {
            updateStatsPreview();
            syncMovePanels();
        }, 100);
    </script>
</body>
</html>
