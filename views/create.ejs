                            <input type="number" name="patrolPingBy" id="npcPatrolBy" value="50" step="0.5">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div>
                            <label>Círculo Centro.x</label>
                            <input type="number" name="patrolCircleCx" id="npcPatrolCx" value="50" step="0.5">
                        </div>
