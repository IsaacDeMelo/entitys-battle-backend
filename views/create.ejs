        function clearSkinForm() {
            switchMode('skin');
            const form = document.getElementById('skinForm');
            if (form) form.reset();
            document.getElementById('skinId').value = '';
            document.getElementById('skinName').value = '';
            const prev = document.getElementById('skinImgPreview');
            if (prev) prev.innerHTML = 'Sem imagem';
            const file = document.querySelector('#skinForm input[name="skinFile"]');
            if (file) file.required = true;
        }

        function loadSkin(s) {
            switchMode('skin');
            clearSkinForm();
            document.getElementById('skinId').value = s._id;
            document.getElementById('deleteSkinId').value = s._id;
            document.getElementById('skinName').value = s.name || '';
            const prev = document.getElementById('skinImgPreview');
            if (prev) prev.innerHTML = `<img src="/skins/${encodeURIComponent(s._id)}.png" style="height:100%; object-fit:contain;">`;

            // Para evitar sobrescrever uma skin existente via /create (que só cria),
            // removemos o required do arquivo quando estamos apenas visualizando.
            const file = document.querySelector('#skinForm input[name="skinFile"]');
            if (file) file.required = false;
        }

        function deleteSkin() {
            const id = document.getElementById('deleteSkinId').value;
            if (!id) return alert('Selecione uma skin na lista primeiro para excluir.');
            if (confirm('Tem certeza que deseja excluir esta skin?')) {
                document.getElementById('deleteSkinForm').submit();
            }
        }
        
        function loadNpc(n) {
            switchMode('npc'); clearNpcForm(); 
            document.getElementById('npcId').value = n._id; document.getElementById('deleteNpcId').value = n._id;
            document.getElementById('npcName').value = n.name; document.getElementById('npcMap').value = n.map; 
            document.getElementById('npcX').value = n.x; document.getElementById('npcY').value = n.y;
            document.getElementById('npcDir').value = n.direction || 'down'; document.getElementById('npcMoney').value = n.moneyReward || 0; 
            document.getElementById('npcDialogue').value = n.dialogue || ''; document.getElementById('npcWinDialogue').value = n.winDialogue || '';
            document.getElementById('npcCdDialogue').value = n.cooldownDialogue || ''; document.getElementById('npcCooldown').value = n.cooldownMinutes || 0;
            if(n.team) { const cleanTeam = n.team.map(t => ({ baseId: t.baseId, level: t.level })); document.getElementById('npcTeam').value = JSON.stringify(cleanTeam); }
            npcTeamLoadFromJson(document.getElementById('npcTeam').value);
            if(!n.isCustomSkin) document.getElementById('npcSkinSelect').value = n.skin; 
            else document.getElementById('npcImgPreview').innerHTML = `<img src="${n.skin}" style="height:100%;">`;
            if(n.battleBackground && n.battleBackground.startsWith('data:')) { document.getElementById('battleBgPreview').innerHTML = `<img src="${n.battleBackground}" style="height:100%;">`; }
            if(n.reward) { 
                document.getElementById('npcRewVal').value = n.reward.value || ''; 
                document.getElementById('npcRewQty').value = n.reward.qty || 1;
                document.getElementById('npcRewardKeyItem').checked = !!n.reward.keyItem;
                document.getElementById('npcRewardUnique').checked = !!n.reward.unique;
            }

            document.getElementById('npcBlocksMovement').checked = !!n.blocksMovement;

            if(n.interact) {
                document.getElementById('npcInteractEnabled').checked = !!n.interact.enabled;
                document.getElementById('npcInteractServiceType').value = n.interact.serviceType || '';
                document.getElementById('npcInteractHealDialogue').value = n.interact.healDialogue || '';
                document.getElementById('npcInteractShopItemsJson').value = n.interact.shopItems ? JSON.stringify(n.interact.shopItems) : '';
                document.getElementById('npcInteractRange').value = (n.interact && n.interact.range) ? n.interact.range : 0;
                npcShopLoadFromJson(document.getElementById('npcInteractShopItemsJson').value);

                const boxPriceEl = document.getElementById('npcInteractBoxPrice');
                if (boxPriceEl) boxPriceEl.value = (n.interact.box && (n.interact.box.price != null)) ? n.interact.box.price : 0;
                const boxJsonEl = document.getElementById('npcInteractBoxRewardsJson');
                if (boxJsonEl) boxJsonEl.value = (n.interact.box && Array.isArray(n.interact.box.rewards)) ? JSON.stringify(n.interact.box.rewards) : '';
                npcBoxLoadFromJson(document.getElementById('npcInteractBoxRewardsJson')?.value || '[]');

                const boxDlgEl = document.getElementById('npcInteractBoxDialogue');
                if (boxDlgEl) boxDlgEl.value = n.interact.boxDialogue || '';
                const boxResDlgEl = document.getElementById('npcInteractBoxResultDialogue');
                if (boxResDlgEl) boxResDlgEl.value = n.interact.boxResultDialogue || '';

                document.getElementById('npcInteractReqId').value = n.interact.requiresItemId || '';
                document.getElementById('npcInteractReqQty').value = n.interact.requiresItemQty || 1;
                document.getElementById('npcInteractConsume').checked = !!n.interact.consumesRequiredItem;
                document.getElementById('npcInteractGivesId').value = n.interact.givesItemId || '';
                document.getElementById('npcInteractGivesQty').value = n.interact.givesItemQty || 1;
                document.getElementById('npcInteractGivesKey').checked = !!n.interact.givesKeyItem;
                document.getElementById('npcInteractGivesUnique').checked = !!n.interact.givesUnique;
                document.getElementById('npcInteractFlag').value = n.interact.flagId || '';
                document.getElementById('npcInteractSuccess').value = n.interact.successDialogue || '';
                document.getElementById('npcInteractNeed').value = n.interact.needItemDialogue || '';
                document.getElementById('npcInteractDone').value = n.interact.alreadyDoneDialogue || '';
                document.getElementById('npcInteractDx').value = n.interact.moveDx || 0;
                document.getElementById('npcInteractDy').value = n.interact.moveDy || 0;
                document.getElementById('npcInteractDir').value = n.interact.moveDirection || '';
            }

            if(n.patrol) {
                document.getElementById('npcPatrolEnabled').checked = !!n.patrol.enabled;
                document.getElementById('npcPatrolMode').value = n.patrol.mode || 'pingpong';
                document.getElementById('npcPatrolSpeed').value = n.patrol.speed || 6;
                document.getElementById('npcPatrolAx').value = (n.patrol.pingPong && n.patrol.pingPong.ax !== undefined) ? n.patrol.pingPong.ax : 50;
                document.getElementById('npcPatrolAy').value = (n.patrol.pingPong && n.patrol.pingPong.ay !== undefined) ? n.patrol.pingPong.ay : 50;
                document.getElementById('npcPatrolBx').value = (n.patrol.pingPong && n.patrol.pingPong.bx !== undefined) ? n.patrol.pingPong.bx : 56;
                document.getElementById('npcPatrolBy').value = (n.patrol.pingPong && n.patrol.pingPong.by !== undefined) ? n.patrol.pingPong.by : 50;
                document.getElementById('npcPatrolCx').value = (n.patrol.circle && n.patrol.circle.cx !== undefined) ? n.patrol.circle.cx : 50;
                document.getElementById('npcPatrolCy').value = (n.patrol.circle && n.patrol.circle.cy !== undefined) ? n.patrol.circle.cy : 50;
                document.getElementById('npcPatrolRadius').value = (n.patrol.circle && n.patrol.circle.radius !== undefined) ? n.patrol.circle.radius : 6;
                document.getElementById('npcPatrolClockwise').checked = !!(n.patrol.circle && n.patrol.circle.clockwise);
            }

            // Diálogos condicionais (garante inicialização segura)
            const condField = document.getElementById('npcConditionalDialoguesJson');
            if (condField) {
                const condList = Array.isArray(n && n.conditionalDialogues) ? n.conditionalDialogues : [];
                condField.value = condList.length ? JSON.stringify(condList) : '';
                npcCondLoadFromJson(condField.value || '[]');
                const condChk = document.getElementById('npcCondToggle');
                if (condChk) condChk.checked = condList.length > 0;
            }
        }
        
        function deleteItem(formId) { 
            const idInput = document.getElementById(formId === 'deleteForm' ? 'existingId' : 'npcId'); 
            if(!idInput.value) return alert('Selecione um item na lista primeiro para excluir.'); 
            if(confirm('Tem certeza absoluta que deseja excluir este item? Essa ação não pode ser desfeita.')) { 
                if(formId === 'deleteForm') document.getElementById('deleteId').value = idInput.value; 
                if(formId === 'deleteNpcForm') document.getElementById('deleteNpcId').value = idInput.value; 
                document.getElementById(formId).submit(); 
            } 
        }

        // ======== EDITOR VISUAL: TEAM ========
        let npcTeamRowsState = [];

        function npcTeamRender() {
            const container = document.getElementById('npcTeamRows');
            if (!container) return;
            container.innerHTML = '';

            npcTeamRowsState.forEach((row, idx) => {
                const wrap = document.createElement('div');
                wrap.className = 'row-item';

                const sel = document.createElement('select');
                sel.innerHTML = document.getElementById('npcTeamPokemonOptionsTemplate').innerHTML;
                sel.value = row.baseId || '';
                sel.onchange = () => { npcTeamRowsState[idx].baseId = sel.value; npcTeamSyncJson(); };

                const lvl = document.createElement('input');
                lvl.type = 'number';
                lvl.min = '1';
                lvl.step = '1';
                lvl.value = String(row.level || 1);
                lvl.oninput = () => { npcTeamRowsState[idx].level = parseInt(lvl.value, 10) || 1; npcTeamSyncJson(); };

                const rm = document.createElement('button');
                rm.type = 'button';
                rm.className = 'row-remove';
                rm.innerText = 'X';
                rm.onclick = () => { npcTeamRowsState.splice(idx, 1); npcTeamRender(); npcTeamSyncJson(); };

                wrap.appendChild(sel);
                wrap.appendChild(lvl);
                wrap.appendChild(rm);
                container.appendChild(wrap);
            });

            if (npcTeamRowsState.length === 0) {
                const empty = document.createElement('div');
                empty.style.color = '#9aa7bd';
                empty.style.fontSize = '0.9rem';
                empty.innerText = 'Sem monstros no time.';
                container.appendChild(empty);
            }
        }

        function npcTeamSyncJson() {
            const out = (npcTeamRowsState || [])
                .filter(x => x && x.baseId)
                .map(x => ({ baseId: String(x.baseId), level: Math.max(1, parseInt(x.level, 10) || 1) }));
            document.getElementById('npcTeam').value = JSON.stringify(out);
        }

        function npcTeamLoadFromJson(json) {
            try {
                const arr = JSON.parse(json || '[]');
                if (Array.isArray(arr)) {
                    npcTeamRowsState = arr
                        .filter(x => x && x.baseId)
                        .map(x => ({ baseId: String(x.baseId), level: Math.max(1, parseInt(x.level, 10) || 1) }));
                } else {
                    npcTeamRowsState = [];
                }
            } catch (_) {
                npcTeamRowsState = [];
            }
            npcTeamRender();
            npcTeamSyncJson();
        }

        function npcTeamAddRow() {
            npcTeamRowsState.push({ baseId: '', level: 5 });
            npcTeamRender();
            npcTeamSyncJson();
        }

        function npcTeamClear() {
            npcTeamRowsState = [];
            npcTeamRender();
            npcTeamSyncJson();
        }

