        function formatPokemonId(num) {
            return String(num).padStart(4, '0');
        }

function obterUrlSprite() {
            const pokemonId = formatPokemonId(document.getElementById('pokemonNum').value);
            const pose = document.getElementById('poseSelect').value;
            const url = `https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite/${pokemonId}/${pose}-Anim.png`;
            return url;
        }

        function atualizarNomePokemon() {
            const numPokemon = parseInt(document.getElementById('pokemonNum').value);
            const nome = pokedexNames[numPokemon] || '???';
            document.getElementById('pokemonName').value = nome;
        }

        function mostrarErro(mensagem) {
            const errorBox = document.getElementById('errorBox');
            errorBox.textContent = '❌ ' + mensagem;
            errorBox.style.display = 'block';
        }

        function limparErro() {
            document.getElementById('errorBox').style.display = 'none';
        }

        const POSES_COM_DIRECAO = ['Idle'];

        function atualizarDirecao() {
            const pose = document.getElementById('poseSelect').value;
            const dirGroup = document.getElementById('directionGroup');
            if (POSES_COM_DIRECAO.includes(pose)) {
                dirGroup.style.display = 'block';
            } else {
                dirGroup.style.display = 'none';
            }
            carregarSprite();
        }

        async function carregarSprite() {
            limparErro();
            const url = obterUrlSprite();
            
            document.getElementById('urlDisplay').textContent = url;

            const pokemonId = formatPokemonId(document.getElementById('pokemonNum').value);
            const pose = document.getElementById('poseSelect').value;

            totalFrames = 1;
            spriteWidth = 48;
            spriteHeight = 48;
            let framesPerDir = 0;
            try {
                const xmlUrl = `https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite/${pokemonId}/AnimData.xml`;
                const res = await fetch(xmlUrl);
                if (res.ok) {
                    const text = await res.text();
                    const parser = new DOMParser();
                    const xml = parser.parseFromString(text, 'text/xml');
                    const anims = xml.querySelectorAll('Anim');
                    for (const anim of anims) {
                        const name = anim.querySelector('Name')?.textContent;
                        if (name === pose) {
                            spriteWidth = parseInt(anim.querySelector('FrameWidth')?.textContent) || 48;
                            spriteHeight = parseInt(anim.querySelector('FrameHeight')?.textContent) || 48;
                            framesPerDir = anim.querySelectorAll('Duration').length || 0;
                            break;
                        }
                    }
                }
            } catch (_) {}

            spriteImage = new Image();
            spriteImage.crossOrigin = 'anonymous';
            
            spriteImage.onload = () => {
                console.log('✓ Spritesheet:', url, spriteImage.width + 'x' + spriteImage.height);
                
                const iw = spriteImage.width;
                const ih = spriteImage.height;
                
                cols = Math.floor(iw / spriteWidth);
                const rows = Math.floor(ih / spriteHeight);
                const isDir = POSES_COM_DIRECAO.includes(pose);

                if (isDir) {
                    rowsPerDirection = Math.floor(rows / 8);
                    totalFrames = framesPerDir || Math.floor(cols * rowsPerDirection);
                    currentDirection = parseInt(document.getElementById('directionSelect').value) || 0;
                } else {
                    rowsPerDirection = 1;
                    totalFrames = cols * rows;
                }

                document.getElementById('frameSlider').max = totalFrames - 1;
                document.getElementById('frameSlider').value = 0;
                currentFrame = 0;
                desenharFrame();
                pararAnimacao();
            };
            
            spriteImage.onerror = () => {
                mostrarErro(`Não consegui carregar: ${pose}-Anim.png para #${pokemonId}`);
            };
            
            spriteImage.src = url;
        }

        function desenharFrame() {
            if (!spriteImage) return;
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Calcular posição do frame atual no grid
            const col = currentFrame % cols;
            const localRow = Math.floor(currentFrame / cols);
            const isDir = POSES_COM_DIRECAO.includes(document.getElementById('poseSelect').value);
            const row = isDir ? (currentDirection * rowsPerDirection + localRow) : localRow;
            
            // Fonte: posição do frame na spritesheet
            const srcX = col * spriteWidth;
            const srcY = row * spriteHeight;
            const srcW = spriteWidth;
            const srcH = spriteHeight;
            
            // Destino: centralizado no canvas, escalado mantendo aspect ratio
            const maxDrawW = canvas.width * 0.9;
            const maxDrawH = canvas.height * 0.9;
            const scale = Math.min(maxDrawW / srcW, maxDrawH / srcH);
            
            const drawW = srcW * scale;
            const drawH = srcH * scale;
            const drawX = (canvas.width - drawW) / 2;
            const drawY = (canvas.height - drawH) / 2;
            
            ctx.imageSmoothingEnabled = false;
            // Desenhar APENAS o frame atual
            ctx.drawImage(spriteImage, srcX, srcY, srcW, srcH, drawX, drawY, drawW, drawH);
            
            // Grid overlay (opcional, para debug) - desenhar grid da spritesheet inteira em miniatura
            const miniScale = 0.15;
            const miniW = spriteImage.width * miniScale;
            const miniH = spriteImage.height * miniScale;
            const miniX = canvas.width - miniW - 10;
            const miniY = 10;
            
            ctx.drawImage(spriteImage, miniX, miniY, miniW, miniH);
            
            // Highlight do frame atual na miniatura
            ctx.strokeStyle = '#38bdf8';
            ctx.lineWidth = 2 / miniScale;
            ctx.strokeRect(
                miniX + srcX * miniScale,
                miniY + srcY * miniScale,
                srcW * miniScale,
                srcH * miniScale
            );
            
            document.getElementById('frameInfo').textContent =
                `${spriteImage.width}x${spriteImage.height}px | ${totalFrames} frames | frame: ${spriteWidth}x${spriteHeight} | pos: ${col},${row}`;
            document.getElementById('frameSlider').value = currentFrame;
        }

        function proximaPose() {
            const poseSelect = document.getElementById('poseSelect');
            const poses = Array.from(poseSelect.options).map(o => o.value);
            const currentIndex = poses.indexOf(poseSelect.value);
            const nextIndex = (currentIndex + 1) % poses.length;
            poseSelect.value = poses[nextIndex];
            carregarSprite();
        }

        function iniciarAnimacao() {
            if (isAnimating || !spriteImage) return;
            
            isAnimating = true;
            const speed = parseInt(document.getElementById('animSpeed').value);
            
            animationInterval = setInterval(() => {
                currentFrame = (currentFrame + 1) % totalFrames;
                desenharFrame();
            }, speed);
        }

        function pararAnimacao() {
            isAnimating = false;
            if (animationInterval) {
                clearInterval(animationInterval);
                animationInterval = null;
            }
        }

        function copiarUrl() {
            const url = obterUrlSprite();
            navigator.clipboard.writeText(url).then(() => {
                alert('URL copiada: ' + url);
            });
        }

        function abrirXml() {
            const pokemonId = formatPokemonId(document.getElementById('pokemonNum').value);
            const xmlUrl = `https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite/${pokemonId}/AnimData.xml`;
            window.open(xmlUrl, '_blank');
        }

        // Event listeners
        document.getElementById('pokemonNum').addEventListener('change', atualizarNomePokemon);
        document.getElementById('pokemonNum').addEventListener('input', atualizarNomePokemon);
        document.getElementById('frameSlider').addEventListener('input', (e) => {
            currentFrame = parseInt(e.target.value);
            desenharFrame();
        });
        document.getElementById('animSpeed').addEventListener('input', () => {
            if (isAnimating) {
                pararAnimacao();
                iniciarAnimacao();
            }
        });

        // Carregar sprite inicial
        setTimeout(() => {
            atualizarNomePokemon();
            atualizarDirecao();
        }, 500);
    </script>
</body>
</html>
