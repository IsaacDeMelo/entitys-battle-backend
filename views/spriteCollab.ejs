<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpriteCollab Viewer</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Rajdhani', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1a1f35 100%);
            color: #e2e8f0;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }

        .panel {
            background: rgba(30, 41, 59, 0.8);
            border: 2px solid rgba(56, 189, 248, 0.3);
            border-radius: 12px;
            padding: 20px;
            backdrop-filter: blur(10px);
        }

        h1 {
            font-family: 'Press Start 2P', monospace;
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: #38bdf8;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        h2 {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.8rem;
            margin: 16px 0 12px 0;
            color: #fbbf24;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #cbd5e1;
        }

        input, select {
            width: 100%;
            padding: 10px 12px;
            background: rgba(15, 23, 42, 0.8);
            border: 2px solid rgba(56, 189, 248, 0.2);
            border-radius: 8px;
            color: #e2e8f0;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
        }

        .button-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 12px;
        }

        button {
            padding: 12px 16px;
            background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.6rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        button:hover {
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.5);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        .viewer-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .canvas-container {
            background: rgba(10, 16, 32, 0.9);
            border: 3px solid rgba(56, 189, 248, 0.4);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 300px;
            position: relative;
            overflow: hidden;
        }

        #spriteCanvas {
            max-width: 100%;
            max-height: 100%;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            border: 2px solid rgba(244, 233, 199, 0.2);
            border-radius: 8px;
        }

        .controls-panel {
            background: rgba(10, 16, 32, 0.9);
            border: 2px solid rgba(56, 189, 248, 0.3);
            border-radius: 8px;
            padding: 16px;
        }

        .control-row {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }

        .control-row label {
            margin: 0;
            min-width: 80px;
            font-size: 0.8rem;
        }

        .control-row input {
            flex: 1;
        }

        .control-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 12px;
        }

        .control-buttons button {
            padding: 8px 12px;
            font-size: 0.5rem;
        }

        .info-box {
            background: rgba(34, 197, 94, 0.1);
            border-left: 4px solid #22c55e;
            padding: 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            color: #cbd5e1;
            line-height: 1.5;
        }

        .error-box {
            background: rgba(239, 68, 68, 0.1);
            border-left: 4px solid #ef4444;
            padding: 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            color: #fca5a5;
            line-height: 1.5;
        }

        .frame-info {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.7rem;
            color: #38bdf8;
            text-align: center;
            padding: 12px;
            background: rgba(56, 189, 248, 0.1);
            border-radius: 6px;
            margin-top: 12px;
        }

        @media (max-width: 1024px) {
            .container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- LEFT PANEL: Controls -->
        <div class="panel">
            <h1>🎨 SpriteCollab Viewer</h1>

            <div class="form-group">
                <label for="pokemonNum">Pokémon ID (1-1025)</label>
                <input type="number" id="pokemonNum" min="1" max="1025" value="1" placeholder="Ex: 1">
            </div>

            <div class="form-group">
                <label for="pokemonName">Nome (opcional)</label>
                <input type="text" id="pokemonName" placeholder="Ex: Bulbasaur" readonly>
            </div>

            <h2>Pose / Animação</h2>
            <div class="form-group">
                <label for="poseSelect">Pose</label>
                <select id="poseSelect" onchange="atualizarDirecao()">
                    <optgroup label="Básicas">
                        <option value="Idle">Idle</option>
                        <option value="Walk">Walk</option>
                    </optgroup>
                    <optgroup label="Combate">
                        <option value="Attack">Attack</option>
                        <option value="Charge">Charge</option>
                        <option value="Double">Double</option>
                        <option value="Swing">Swing</option>
                        <option value="Shoot">Shoot</option>
                        <option value="Pain">Pain</option>
                        <option value="Hurt">Hurt</option>
                        <option value="Faint">Faint</option>
                        <option value="HitGround">HitGround</option>
                    </optgroup>
                    <optgroup label="Movimento">
                        <option value="Hop">Hop</option>
                        <option value="LeapForth">LeapForth</option>
                        <option value="Trip">Trip</option>
                        <option value="Tumble">Tumble</option>
                        <option value="TumbleBack">TumbleBack</option>
                        <option value="LostBalance">LostBalance</option>
                        <option value="Rotate">Rotate</option>
                        <option value="Pull">Pull</option>
                    </optgroup>
                    <optgroup label="Outras">
                        <option value="Float">Float</option>
                        <option value="Eat">Eat</option>
                        <option value="Sleep">Sleep</option>
                        <option value="EventSleep">EventSleep</option>
                        <option value="Wake">Wake</option>
                        <option value="Shake">Shake</option>
                        <option value="DeepBreath">DeepBreath</option>
                        <option value="Nod">Nod</option>
                        <option value="Sit">Sit</option>
                        <option value="Pose">Pose</option>
                        <option value="LookUp">LookUp</option>
                        <option value="Sink">Sink</option>
                        <option value="Laying">Laying</option>
                        <option value="Head">Head</option>
                        <option value="Cringe">Cringe</option>
                    </optgroup>
                </select>
            </div>

            <div class="form-group" id="directionGroup" style="display: none;">
                <label for="directionSelect">Direção</label>
                <select id="directionSelect" onchange="carregarSprite()">
                    <option value="0">↓ S</option>
                    <option value="1">↘ SE</option>
                    <option value="2">← W</option>
                    <option value="3">↗ NE</option>
                    <option value="4">↑ N</option>
                    <option value="5">↖ NW</option>
                    <option value="6">→ E</option>
                    <option value="7">↙ SW</option>
                </select>
            </div>

            <div class="button-group">
                <button onclick="carregarSprite()">▶ Carregar</button>
                <button onclick="proximaPose()">→ Próx Pose</button>
            </div>

            <div class="button-group" style="margin-top: 8px;">
                <button onclick="copiarUrl()">📋 Copiar URL</button>
                <button onclick="abrirXml()">📄 Ver XML</button>
            </div>

            <h2>Animação</h2>
            <div class="control-row">
                <label for="animSpeed">Velocidade</label>
                <input type="range" id="animSpeed" min="50" max="500" value="150" step="10">
            </div>

            <div class="control-buttons">
                <button onclick="iniciarAnimacao()">▶ Play</button>
                <button onclick="pararAnimacao()">⏹ Stop</button>
            </div>

            <h2>Frame</h2>
            <div class="control-row">
                <label for="frameSlider">Frame</label>
                <input type="range" id="frameSlider" min="0" max="7" value="0" step="1">
            </div>

            <div class="frame-info">
                <div id="frameInfo">Frame: 0/8</div>
            </div>

            <div class="info-box" id="infoBox">
                ℹ️ SpriteCollab: spritesheets com frames em grid. Tamanho do frame vem do AnimData.xml (ex: Walk=40x40, Attack=64x72).
            </div>

            <div id="errorBox" class="error-box" style="display: none;"></div>
        </div>

        <!-- RIGHT PANEL: Viewer -->
        <div class="viewer-panel">
            <h1>Visualizador</h1>
            
            <div class="canvas-container">
                <canvas id="spriteCanvas" width="320" height="320"></canvas>
            </div>

            <div class="controls-panel">
                <div class="frame-info">
                    <div id="urlInfo">URL do Sprite:</div>
                    <div id="urlDisplay" style="word-break: break-all; font-size: 0.5rem; margin-top: 8px; color: #94a3b8;"></div>
                </div>
            </div>
        </div>
    </div>

