        function updateDexCounter() {
            const total = DEX_ENTITIES.length;
            const unlocked = DEX_ENTITIES.filter(p => UNLOCKED_IDS.has(String(p.id || p._id))).length;
            const el = document.getElementById('dexCounter');
            if (el) el.textContent = unlocked + ' / ' + total;
        }

        function renderDexGrid() {
            const grid = document.getElementById('dexGrid');
            grid.innerHTML = '';
            DEX_VISIBLE_ENTITIES = [];
            DEX_ENTITIES.forEach(function(p, index) {
                const id = String(p.id || p._id);
                const isUnlocked = UNLOCKED_IDS.has(id);
                const dexNumber = Number.isFinite(parseInt(p.dexOrder, 10)) ? parseInt(p.dexOrder, 10) : (index + 1);
                const sprite = p.sprite || p.icon;
                const name = isUnlocked ? (p.name || '???') : '???';
                DEX_VISIBLE_ENTITIES.push(p);
                grid.innerHTML += '<div class="dex-entry ' + (isUnlocked ? 'unlocked' : 'locked') + '" onclick="selectDexMonster(\'' + id + '\')" data-name="' + (p.name || '').toLowerCase() + '" data-dexidx="' + (DEX_VISIBLE_ENTITIES.length - 1) + '"><span class="dex-num">#' + dexNumber.toString().padStart(3, '0') + '</span><img src="' + resolveImg(sprite) + '" loading="lazy" class="pixel-art" style="width:36px;height:36px;"></div>';
            });
        }

        function selectDexEntry(idx) {
            var entries = document.querySelectorAll('#dexGrid .dex-entry');
            if (!entries.length) return;
            entries.forEach(function(e) { e.classList.remove('keyboard-selected'); });
            idx = Math.max(0, Math.min(idx, entries.length - 1));
            DEX_SELECTED_IDX = idx;
            var id = DEX_VISIBLE_ENTITIES[idx] ? String(DEX_VISIBLE_ENTITIES[idx].id || DEX_VISIBLE_ENTITIES[idx]._id) : null;
            if (id) selectDexMonster(id);
        }

        function selectDexMonster(idStr) {
            var m = RAW_ENTITIES.find(function(x) { return String(x.id || x._id) === idStr; });
            if (!m) return;
            var isUnlocked = UNLOCKED_IDS.has(idStr);
            var bs = m.baseStats || {};
            var hp = Number(bs.hp) || 0, atk = Number(bs.attack) || 0, def = Number(bs.defense) || 0, spd = Number(bs.speed) || 0;
            var pct = function(v) { return Math.min(100, (v / 150) * 100); };
            var statBar = function(l, v, c) {
                return '<div class="dex-stat-row"><span class="dex-stat-label">' + l + '</span><div class="dex-stat-bar-bg"><div class="dex-stat-bar" style="width:' + pct(v) + '%;background:' + c + ';"></div></div><span class="dex-stat-val">' + v + '</span></div>';
            };
            var typeColor = getTypeColor(m.type);
            var movesHtml = '';
            var pool = (m.movePool || m.learnset || []).sort(function(a, b) { return a.level - b.level; });
            if (pool.length > 0) {
                movesHtml = '<div class="dex-moves-section"><h4>Golpes</h4>';
                pool.forEach(function(mv) {
                    var d = GLOBAL_MOVES_LIB[mv.moveId || mv.move] || { name: mv.moveId || mv.move, element: 'normal' };
                    movesHtml += '<div class="dex-move-row"><span class="dex-move-lv">Lv.' + mv.level + '</span><span class="dex-move-name">' + d.name + '</span><span class="dex-move-elem">' + d.element + '</span></div>';
                });
                movesHtml += '</div>';
            }
            var html = '';
            html += '<button class="dex-mobile-close" onclick="document.getElementById(\'dexDetailPanel\').classList.remove(\'show-mobile\')" style="display:none;width:100%;padding:10px;margin-bottom:12px;background:#1e293b;border:2px solid #334155;border-radius:8px;color:#e2e8f0;font-family:Press Start 2P,monospace;font-size:0.5rem;cursor:pointer;">▼ FECHAR</button>';
            html += '<div style="display:flex;flex-direction:column;align-items:center;margin-bottom:16px;width:100%;">';
            html += '<div class="dex-sprite-frame"><img src="' + resolveImg(m.sprite) + '" class="pixel-art" style="' + (!isUnlocked ? 'filter:grayscale(1) brightness(0.4);' : '') + '"></div>';
            html += '<div class="dex-mon-name">' + (isUnlocked ? (m.name || '???') : '???') + '</div>';
            html += '<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">';
            html += '<span class="dex-mon-type" style="background:' + typeColor.bg + ';color:' + typeColor.fg + ';">' + (m.type || '???') + '</span>';
            if (m.type2) html += '<span class="dex-mon-type" style="background:' + getTypeColor(m.type2).bg + ';color:' + getTypeColor(m.type2).fg + ';">' + m.type2 + '</span>';
            html += '</div>';
            html += '<div style="font-family:Press Start 2P,monospace;font-size:0.4rem;color:' + (isUnlocked ? '#10b981' : '#475569') + ';margin-top:8px;">' + (isUnlocked ? 'REGISTRADO' : 'NAO CAPTURADO') + '</div>';
            html += '</div>';
            html += '<div class="dex-stats-section"><h4>Stats Base</h4>';
            html += statBar('HP', hp, '#10b981');
            html += statBar('ATK', atk, '#ef4444');
            html += statBar('DEF', def, '#fbbf24');
            html += statBar('SPD', spd, '#3b82f6');
            html += '</div>';
            html += movesHtml;
            document.getElementById('dexDetailEmpty').style.display = 'none';
            var content = document.getElementById('dexDetailContent');
            content.style.display = 'block';
            content.innerHTML = html;
            if (window.innerWidth <= 600) {
                document.getElementById('dexDetailPanel').classList.add('show-mobile');
            }
        }

        function getTypeColor(type) {
            var colors = {
                fire: { bg: '#f97316', fg: '#fff' }, water: { bg: '#3b82f6', fg: '#fff' },
                grass: { bg: '#22c55e', fg: '#fff' }, electric: { bg: '#eab308', fg: '#1a1a1a' },
                ice: { bg: '#67e8f9', fg: '#1a1a1a' }, fighting: { bg: '#dc2626', fg: '#fff' },
                poison: { bg: '#a855f7', fg: '#fff' }, ground: { bg: '#d97706', fg: '#fff' },
                flying: { bg: '#818cf8', fg: '#fff' }, psychic: { bg: '#ec4899', fg: '#fff' },
                bug: { bg: '#84cc16', fg: '#fff' }, rock: { bg: '#78716c', fg: '#fff' },
                ghost: { bg: '#6366f1', fg: '#fff' }, dragon: { bg: '#7c3aed', fg: '#fff' },
                dark: { bg: '#44403c', fg: '#fff' }, steel: { bg: '#94a3b8', fg: '#1a1a1a' },
                fairy: { bg: '#f472b6', fg: '#fff' }, normal: { bg: '#a1a1aa', fg: '#1a1a1a' }
            };
            return colors[(type || '').toLowerCase()] || { bg: '#6b7280', fg: '#fff' };
        }

        function closeDexDetails() { }

        function filterDex() {
            var v = document.getElementById('dexSearch').value.toLowerCase();
            var entries = document.querySelectorAll('#dexGrid .dex-entry');
            DEX_VISIBLE_ENTITIES = [];
            var newIdx = 0;
            entries.forEach(function(e) {
                var match = e.getAttribute('data-name').includes(v);
                e.style.display = match ? 'flex' : 'none';
                if (match) {
                    var origIdx = parseInt(e.getAttribute('data-dexidx'), 10);
                    DEX_VISIBLE_ENTITIES.push(DEX_ENTITIES[origIdx]);
                    e.setAttribute('data-visible-idx', newIdx);
                    newIdx++;
                }
            });
            DEX_SELECTED_IDX = 0;
            var first = document.querySelector('#dexGrid .dex-entry[style*="flex"]');
            if (first) {
                entries.forEach(function(e) { e.classList.remove('keyboard-selected'); });
                first.classList.add('keyboard-selected');
                var id = DEX_VISIBLE_ENTITIES[0] ? String(DEX_VISIBLE_ENTITIES[0].id || DEX_VISIBLE_ENTITIES[0]._id) : null;
                if (id) selectDexMonster(id);
            }
        }

