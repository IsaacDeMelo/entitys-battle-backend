        // --- EQUIPE / MONSTROS ---
        async function openEntityTeam() {
            const modal = document.getElementById('modalPokemon');
            const listContent = document.getElementById('pokemonListContent');
            const detContent = document.getElementById('pokemonDetailContent');

            if (!modal || !listContent || !detContent) {
                showToast('❌ Erro: Modal da equipe não encontrado');
                return;
            }

            modal.style.display = 'flex';
            window.__menuOpen = true;
            TEAM_SELECTED_IDX = 0;

            const cached = getCachedMe();
            if (cached && Array.isArray(cached.team) && cached.team.length) {
                if (cached.allMoves) GLOBAL_MOVES_LIB = cached.allMoves;
                CURRENT_TEAM_DATA = cached.team;
                if (typeof cached.followingEntityId === 'string') CURRENT_FOLLOWING_ID = String(cached.followingEntityId || '');
                await preloadTeamSprites(cached.team);
                renderPokemonList(cached.team);
            } else {
                CURRENT_TEAM_DATA = [];
                listContent.innerHTML = '<div style="text-align:center; padding:40px 20px; color:#475569; font-size:0.8rem;">Nenhuma criatura na equipe.</div>';
                detContent.innerHTML = '';
            }

            try {
                const r = await fetch(`/api/me?userId=${USER_ID}`);
                const d = await r.json();
                if (d && !d.error) window.__ME_CACHE = d;
                if (d && d.allMoves) GLOBAL_MOVES_LIB = d.allMoves;
                if (d && Array.isArray(d.team)) {
                    CURRENT_TEAM_DATA = d.team;
                    if (typeof d.followingEntityId === 'string') CURRENT_FOLLOWING_ID = String(d.followingEntityId || '');
                    await preloadTeamSprites(d.team);
                    renderPokemonList(d.team);
                } else if (!CURRENT_TEAM_DATA.length) {
                    listContent.innerHTML = '<div style="text-align:center; padding:40px 20px; color:#475569; font-size:0.8rem;">Nenhuma criatura na equipe.</div>';
                    detContent.innerHTML = '';
                }
            } catch (e) {
                console.error('Erro ao abrir equipe:', e);
                if (!CURRENT_TEAM_DATA.length) {
                    listContent.innerHTML = '<div style="text-align:center; padding:40px 20px; color:#ef4444; font-size:0.8rem;">Erro ao carregar a equipe.</div>';
                    detContent.innerHTML = '';
                }
                showToast('⚠️ Erro ao carregar equipe');
            }
        }

        function preloadTeamSprites(team) {
            if(!team || !team.length) return Promise.resolve();
            const urls = new Set();
            team.forEach(p => {
                if(p.sprite) urls.add(p.sprite);
                if(p.icon) urls.add(p.icon);
            });
            return Promise.all([...urls].map(u => new Promise(res => {
                const img = new Image();
                img.onload = img.onerror = () => res();
                img.src = u;
            })));
        }

