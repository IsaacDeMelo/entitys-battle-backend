        async function toggleFollow(instanceId) {
            const nextId = (CURRENT_FOLLOWING_ID && String(CURRENT_FOLLOWING_ID) === String(instanceId)) ? '' : String(instanceId);
            try {
                const res = await fetch('/api/following', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, instanceId: nextId })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) {
                    showToast('Nao foi possivel seguir.');
                    return;
                }
                CURRENT_FOLLOWING_ID = data.followingEntityId || '';
                if (window.__ME_CACHE) window.__ME_CACHE.followingEntityId = CURRENT_FOLLOWING_ID;
                if (typeof window.setFollowingEntityId === 'function') window.setFollowingEntityId(CURRENT_FOLLOWING_ID);
                renderPokemonList(CURRENT_TEAM_DATA);
            } catch (_) {
                showToast('Erro ao salvar seguidor.');
