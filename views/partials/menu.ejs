            var c = {
                fire:{bg:'#fd7d24',fg:'#fff'},water:{bg:'#4592c4',fg:'#fff'},grass:{bg:'#9bcb5c',fg:'#fff'},
                electric:{bg:'#eed535',fg:'#1a1a1a'},ice:{bg:'#51c4e7',fg:'#1a1a1a'},fighting:{bg:'#d56723',fg:'#fff'},
                poison:{bg:'#b763cd',fg:'#fff'},ground:{bg:'#da7c4d',fg:'#fff'},flying:{bg:'#a890f0',fg:'#fff'},
                psychic:{bg:'#f366b9',fg:'#fff'},bug:{bg:'#abb53d',fg:'#fff'},rock:{bg:'#a38c21',fg:'#fff'},
                ghost:{bg:'#7b62a3',fg:'#fff'},dragon:{bg:'#7038f8',fg:'#fff'},dark:{bg:'#705848',fg:'#fff'},
                steel:{bg:'#b8b8d0',fg:'#1a1a1a'},fairy:{bg:'#fdb9e8',fg:'#1a1a1a'},normal:{bg:'#a8a878',fg:'#fff'},
