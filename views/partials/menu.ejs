<script>
const USER_ID = '<%= user._id %>';
const IS_ADMIN = <%= user.isAdmin ? 'true' : 'false' %>;

(function () {
  const safeText = (value) => {
    const text = value == null ? '' : String(value);
    return text.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  };

  const buildModalHtml = (id, title, subtitle, contentId) => `
    <div class="menu-modal-overlay" id="${id}" hidden>
      <div class="menu-modal" role="dialog" aria-modal="true" aria-label="${safeText(title)}">
        <div class="menu-modal-header">
          <div>
            <div class="menu-modal-kicker">${safeText(subtitle)}</div>
            <h3>${safeText(title)}</h3>
          </div>
          <button type="button" class="menu-close" aria-label="Fechar" onclick="closeModal('${id}')">✕</button>
        </div>
        <div class="menu-modal-body" id="${contentId}"></div>
      </div>
    </div>
  `;

  function ensureShell() {
    let shell = document.getElementById('menu-system-shell');
    if (!shell) {
      shell = document.createElement('div');
      shell.id = 'menu-system-shell';
      document.body.appendChild(shell);
    }
    shell.innerHTML = `
      <style>
        #menu-system-shell {
          position: fixed;
          right: 14px;
          bottom: 14px;
          z-index: 1300;
          font-family: 'Rajdhani', 'Roboto', sans-serif;
          pointer-events: none;
        }
        #menu-system-shell * { box-sizing: border-box; }
        .menu-float {
          pointer-events: auto;
          display: flex;
          flex-direction: column;
          gap: 8px;
          align-items: flex-end;
        }
        .menu-toggle {
          border: 2px solid rgba(244, 233, 199, 0.25);
          background: linear-gradient(180deg, rgba(15,23,42,0.96), rgba(20,30,55,0.88));
          color: #f8fafc;
          border-radius: 14px;
          width: 58px;
          height: 58px;
          font-size: 1.1rem;
          font-weight: 900;
          box-shadow: 0 8px 18px rgba(0,0,0,0.28);
          cursor: pointer;
          transition: transform 0.18s ease, box-shadow 0.18s ease;
        }
        .menu-toggle:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(59,130,246,0.15); }
        .menu-actions {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          justify-content: flex-end;
          max-width: 290px;
        }
        .menu-btn {
          border: 1px solid rgba(148,163,184,0.2);
          background: rgba(15, 23, 42, 0.88);
          color: #ebf1ff;
          border-radius: 12px;
          padding: 8px 12px;
          font-size: 0.72rem;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          cursor: pointer;
          min-width: 76px;
          box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        }
        .menu-btn:hover { border-color: rgba(96,165,250,0.6); }
        .menu-modal-overlay {
          position: fixed;
          inset: 0;
          background: rgba(2,6,23,0.58);
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 1500;
          padding: 18px;
        }
        .menu-modal {
          width: min(560px, 92vw);
          max-height: 82vh;
          background: linear-gradient(180deg, rgba(15,23,42,0.98), rgba(30,41,59,0.96));
          border: 1px solid rgba(148,163,184,0.26);
          border-radius: 18px;
          box-shadow: 0 32px 80px rgba(15,23,42,0.75);
          display: flex;
          flex-direction: column;
          overflow: hidden;
        }
        .menu-modal-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 18px 20px 10px;
          border-bottom: 1px solid rgba(148,163,184,0.18);
          background: rgba(15,23,42,0.46);
        }
        .menu-modal-kicker {
          font-size: 0.62rem;
          letter-spacing: 0.12em;
          color: #93c5fd;
          text-transform: uppercase;
        }
        .menu-modal-header h3 {
          margin: 2px 0 0;
          color: #f8fafc;
          font-size: 1.3rem;
        }
        .menu-close {
          border: 1px solid rgba(148,163,184,0.3);
          background: rgba(15,23,42,0.8);
          color: #f8fafc;
          width: 36px;
          height: 36px;
          border-radius: 10px;
          cursor: pointer;
        }
        .menu-modal-body {
          padding: 18px 20px 20px;
          overflow: auto;
        }
        .menu-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
          gap: 12px;
        }
        .menu-card {
          background: linear-gradient(180deg, rgba(30,41,59,0.82), rgba(15,23,42,0.9));
          border: 1px solid rgba(148,163,184,0.2);
          border-radius: 14px;
          padding: 10px;
          color: #e2e8f0;
          min-height: 136px;
        }
        .menu-card-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
        .menu-card-icon {
          width: 34px; height: 34px; border-radius: 10px; background: rgba(59,130,246,0.2); display: grid; place-items: center; font-size: 1.2rem;
        }
        .menu-card h4 { margin: 0; font-size: 1rem; }
        .menu-meta { color: #93c5fd; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
        .menu-state-line { margin-top: 8px; font-size: 0.75rem; color: #dbeafe; }
        .menu-list {
          display: flex; flex-direction: column; gap: 8px;
        }
        .menu-list-item {
          display: flex; align-items: center; justify-content: space-between;
          gap: 10px;
          border: 1px solid rgba(148,163,184,0.18);
          background: rgba(15,23,42,0.45);
          border-radius: 10px;
          padding: 8px 10px;
          color: #e2e8f0;
        }
        .menu-badge {
          background: rgba(96,165,250,0.15);
          color: #dbeafe;
          border: 1px solid rgba(96,165,250,0.24);
          border-radius: 999px;
          padding: 4px 8px;
          font-size: 0.68rem;
          font-weight: 700;
          white-space: nowrap;
        }
        .empty-state {
          padding: 18px;
          border-radius: 12px;
          border: 1px dashed rgba(148,163,184,0.26);
          background: rgba(15,23,42,0.36);
          color: #dfe7f8;
          text-align: center;
          font-weight: 600;
        }
        @media (max-width: 640px) {
          #menu-system-shell { right: 9px; bottom: 10px; }
          .menu-actions { max-width: 240px; }
          .menu-btn { min-width: 68px; padding: 7px 10px; font-size: 0.62rem; }
          .menu-toggle { width: 52px; height: 52px; }
        }
      </style>
      <div class="menu-float">
        <div class="menu-actions" id="menu-actions" hidden>
          <button type="button" class="menu-btn" onclick="openEntityTeam()">Equipe</button>
          <button type="button" class="menu-btn" onclick="openPC()">PC</button>
          <button type="button" class="menu-btn" onclick="openPokedex()">Dex</button>
          <button type="button" class="menu-btn" onclick="openBag()">Bag</button>
          <button type="button" class="menu-btn" onclick="openRank()">Rank</button>
          <button type="button" class="menu-btn" onclick="openCard()">Card</button>
        </div>
        <button type="button" class="menu-toggle" onclick="toggleFloatMenu()" aria-label="Abrir menu">☰</button>
      </div>
      ${buildModalHtml('modalPokemon', 'Equipe', 'time', 'modalPokemonBody')}
      ${buildModalHtml('modalPC', 'PC', 'armazenamento', 'modalPCBody')}
      ${buildModalHtml('modalPokedex', 'Dex', 'caçador', 'modalPokedexBody')}
      ${buildModalHtml('modalBag', 'Bag', 'itens', 'modalBagBody')}
      ${buildModalHtml('modalRank', 'Rank', 'pvp', 'modalRankBody')}
      ${buildModalHtml('modalCard', 'Card', 'perfil', 'modalCardBody')}
    `;
    return shell;
  }

  function setMenuOpenState(isOpen) {
    const actions = document.getElementById('menu-actions');
    if (actions) actions.hidden = !isOpen;
    window.__menuOpen = !!isOpen;
    if (window.MenuSystem && window.MenuSystem.state) {
      window.MenuSystem.state.menuOpen = !!isOpen;
    }
  }

  function fetchJson(url, options = {}) {
    return fetch(url, {
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
      ...options
    }).then(async (res) => {
      const json = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(json && json.error ? String(json.error) : 'Erro de rede');
      }
      return json;
    });
  }

  function showToast(message) {
    let node = document.getElementById('menu-toast');
    if (!node) {
      node = document.createElement('div');
      node.id = 'menu-toast';
      node.style.position = 'fixed';
      node.style.left = '50%';
      node.style.bottom = '84px';
      node.style.transform = 'translateX(-50%)';
      node.style.background = 'rgba(15,23,42,0.92)';
      node.style.color = '#f8fafc';
      node.style.padding = '10px 14px';
      node.style.border = '1px solid rgba(96,165,250,0.3)';
      node.style.borderRadius = '999px';
      node.style.boxShadow = '0 12px 28px rgba(2,6,23,0.35)';
      node.style.zIndex = '1800';
      node.style.fontSize = '0.76rem';
      node.style.fontWeight = '700';
      node.style.fontFamily = 'Rajdhani, Roboto, sans-serif';
      document.body.appendChild(node);
    }
    node.textContent = message;
    node.style.opacity = '1';
    clearTimeout(node._menuTimer);
    node._menuTimer = setTimeout(() => { node.style.opacity = '0'; }, 2000);
  }

  function setModalVisible(id, visible) {
    const modal = document.getElementById(id);
    if (!modal) return false;
    modal.hidden = !visible;
    if (visible) {
      modal.style.display = 'flex';
      window.__menuOpen = true;
      if (window.MenuSystem && window.MenuSystem.state) {
        window.MenuSystem.state.activeModal = id;
      }
    } else {
      modal.style.display = 'none';
      if (window.MenuSystem && window.MenuSystem.state) {
        window.MenuSystem.state.activeModal = null;
      }
    }
    return true;
  }

  function closeModal(id) {
    if (!id) return closeAllModals();
    const modal = document.getElementById(id);
    if (modal) modal.hidden = true;
    return setModalVisible(id, false);
  }

  function closeAllModals() {
    ['modalPokemon', 'modalPC', 'modalPokedex', 'modalBag', 'modalRank', 'modalCard'].forEach((id) => closeModal(id));
    window.__menuOpen = false;
    if (window.MenuSystem && window.MenuSystem.state) {
      window.MenuSystem.state.menuOpen = false;
      window.MenuSystem.state.activeModal = null;
    }
    return true;
  }

  function renderCardSummary(data) {
    const body = document.getElementById('modalCardBody');
    if (!body) return;
    const username = data && data.username ? data.username : 'Treinador';
    const money = data && Number.isFinite(Number(data.money)) ? Number(data.money) : 0;
    const dexCount = Array.isArray(data && data.dex) ? data.dex.length : 0;
    const teamCount = Array.isArray(data && data.team) ? data.team.length : 0;
    const bag = data && data.bag ? Object.entries(data.bag) : [];
    body.innerHTML = `
      <div class="menu-grid">
        <div class="menu-card">
          <div class="menu-card-head"><div class="menu-card-icon">👤</div><div><div class="menu-meta">Perfil</div><h4>${safeText(username)}</h4></div></div>
          <div class="menu-state-line">Time: ${teamCount} criaturas</div>
          <div class="menu-state-line">Dex: ${dexCount} registros</div>
        </div>
        <div class="menu-card">
          <div class="menu-card-head"><div class="menu-card-icon">💰</div><div><div class="menu-meta">Dinheiro</div><h4>${money}</h4></div></div>
          <div class="menu-state-line">Moedas disponíveis</div>
        </div>
        <div class="menu-card" style="grid-column: 1 / -1;">
          <div class="menu-card-head"><div class="menu-card-icon">🎒</div><div><div class="menu-meta">Inventário</div><h4>Itens</h4></div></div>
          ${bag.length ? `<div class="menu-list">${bag.map(([key, qty]) => `<div class="menu-list-item"><span>${safeText(key)}</span><span class="menu-badge">${safeText(qty)}</span></div>`).join('')}</div>` : '<div class="empty-state">Sem itens no inventário.</div>'}
        </div>
      </div>
    `;
  }

  function renderTeamSummary(data) {
    const body = document.getElementById('modalPokemonBody');
    if (!body) return;
    const team = Array.isArray(data && data.team) ? data.team : [];
    if (!team.length) {
      body.innerHTML = '<div class="empty-state">Nenhuma criatura na equipe. Vá ao mapa e escolha um starter.</div>';
      return;
    }
    body.innerHTML = `
      <div class="menu-grid">
        ${team.map((member, index) => `
          <div class="menu-card" onclick="selectTeamMember(${index})" style="cursor:pointer;">
            <div class="menu-card-head">
              <div class="menu-card-icon">${member && member.icon ? '⚡' : '✨'}</div>
              <div>
                <div class="menu-meta">Nível ${safeText(member.level || 1)}</div>
                <h4>${safeText(member.name || 'Monstro')}</h4>
              </div>
            </div>
            <div class="menu-state-line">HP: ${safeText(member.hp || 0)} / ${safeText(member.maxHp || 0)}</div>
            <div class="menu-state-line">XP: ${safeText(member.xp || 0)} / ${safeText(member.xpToNext || 0)}</div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function renderPcSummary(data) {
    const body = document.getElementById('modalPCBody');
    if (!body) return;
    const pc = Array.isArray(data && data.pc) ? data.pc : [];
    if (!pc.length) {
      body.innerHTML = '<div class="empty-state">O PC está vazio.</div>';
      return;
    }
    body.innerHTML = `
      <div class="menu-grid">
        ${pc.map((member, index) => `
          <div class="menu-card" style="cursor:pointer;" onclick="showPCSlot(${index})">
            <div class="menu-card-head">
              <div class="menu-card-icon">🐾</div>
              <div>
                <div class="menu-meta">PC #${index + 1}</div>
                <h4>${safeText(member.name || 'Monstro')}</h4>
              </div>
            </div>
            <div class="menu-state-line">Nível ${safeText(member.level || 1)}</div>
            <div class="menu-state-line">HP: ${safeText(member.hp || 0)} / ${safeText(member.maxHp || 0)}</div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function renderPokedexSummary(data) {
    const body = document.getElementById('modalPokedexBody');
    if (!body) return;
    const entries = Array.isArray(data && data.dex) ? data.dex : [];
    if (!entries.length) {
      body.innerHTML = '<div class="empty-state">Você ainda não registrou nenhuma entidade na dex.</div>';
      return;
    }
    body.innerHTML = `
      <div class="menu-list">
        ${entries.map((id) => `<div class="menu-list-item"><span>${safeText(id)}</span><span class="menu-badge">Registro</span></div>`).join('')}
      </div>
    `;
  }

  function renderBagSummary(data) {
    const body = document.getElementById('modalBagBody');
    if (!body) return;
    const bag = data && data.bag ? data.bag : {};
    const entries = Object.entries(bag);
    if (!entries.length) {
      body.innerHTML = '<div class="empty-state">Sua mochila está vazia.</div>';
      return;
    }
    body.innerHTML = `
      <div class="menu-list">
        ${entries.map(([key, qty]) => `<div class="menu-list-item"><span>${safeText(key)}</span><span class="menu-badge">${safeText(qty)}</span></div>`).join('')}
      </div>
    `;
  }

  function renderRankSummary(data) {
    const body = document.getElementById('modalRankBody');
    if (!body) return;
    const list = Array.isArray(data && data.list) ? data.list : [];
    if (!list.length) {
      body.innerHTML = '<div class="empty-state">Sem ranqueados no momento.</div>';
      return;
    }
    body.innerHTML = `
      <div class="menu-list">
        ${list.map((rank, idx) => `<div class="menu-list-item"><span>#${idx + 1} · ${safeText(rank.username || 'Treinador')}</span><span class="menu-badge">${safeText(rank.pvpPoints || 0)} pts</span></div>`).join('')}
      </div>
    `;
  }

  async function loadUserData() {
    try {
      const data = await fetchJson(`/api/me?userId=${USER_ID}`);
      window.CURRENT_TEAM_DATA = Array.isArray(data.team) ? data.team : [];
      window.MenuSystem = window.MenuSystem || { state: {} };
      window.MenuSystem.state = window.MenuSystem.state || {};
      window.MenuSystem.state.teamData = window.CURRENT_TEAM_DATA;
      renderTeamSummary(data);
      renderPokedexSummary(data);
      renderBagSummary(data);
      renderCardSummary(data);
      return data;
    } catch (error) {
      showToast('Não foi possível carregar os dados do usuário.');
      console.error('loadUserData', error);
      return null;
    }
  }

  async function loadPCData() {
    try {
      const data = await fetchJson(`/api/pc?userId=${USER_ID}`);
      window.__PC_DATA = data || { pc: [] };
      renderPcSummary(data || {});
      return data;
    } catch (error) {
      showToast('Não foi possível carregar o PC.');
      console.error('loadPCData', error);
      return null;
    }
  }

  async function loadRankData() {
    try {
      const data = await fetchJson('/api/rank');
      renderRankSummary(data || {});
      return data;
    } catch (error) {
      console.error('loadRankData', error);
      return null;
    }
  }

  async function openEntityTeam() {
    const data = await loadUserData();
    setModalVisible('modalPokemon', true);
    if (!data) return false;
    renderTeamSummary(data);
    return true;
  }

  async function openPC() {
    await loadPCData();
    setModalVisible('modalPC', true);
    return true;
  }

  async function openPokedex() {
    const data = await loadUserData();
    setModalVisible('modalPokedex', true);
    if (data) renderPokedexSummary(data);
    return true;
  }

  async function openBag() {
    const data = await loadUserData();
    setModalVisible('modalBag', true);
    if (data) renderBagSummary(data);
    return true;
  }

  async function openRank() {
    await loadRankData();
    setModalVisible('modalRank', true);
    return true;
  }

  async function openCard() {
    const data = await loadUserData();
    setModalVisible('modalCard', true);
    if (data) renderCardSummary(data);
    return true;
  }

  function toggleFloatMenu() {
    const actions = document.getElementById('menu-actions');
    if (!actions) return false;
    const next = actions.hidden;
    setMenuOpenState(next);
    return next;
  }

  function selectTeamMember(index) {
    const team = Array.isArray(window.CURRENT_TEAM_DATA) ? window.CURRENT_TEAM_DATA : [];
    const member = team[index];
    if (!member) return false;
    showToast(`${member.name || 'Monstro'} selecionado`);
    return true;
  }

  function showPCSlot(index) {
    const data = window.__PC_DATA || { pc: [] };
    const member = (data.pc || [])[index];
    if (!member) return false;
    showToast(`${member.name || 'Monstro'} no PC`);
    return true;
  }

  window.MenuSystem = {
    state: { menuOpen: false, activeModal: null, teamData: [] },
    setMenuOpen(v) { setMenuOpenState(!!v); },
    openModal(id) { if (id) setModalVisible(id, true); },
    closeModal(id) { if (id) closeModal(id); else closeAllModals(); },
  };

  window.closeModal = closeModal;
  window.closeAllModals = closeAllModals;
  window.toggleFloatMenu = toggleFloatMenu;
  window.openPokemon = openEntityTeam;
  window.openEntityTeam = openEntityTeam;
  window.openPC = openPC;
  window.openPokedex = openPokedex;
  window.openBag = openBag;
  window.openBagScreen = openBag;
  window.dexOpenBag = openBag;
  window.openRank = openRank;
  window.openCard = openCard;
  window.closePokedex = function () { closeModal('modalPokedex'); };
  window.closeDexDetails = function () { closeModal('modalPokedex'); };
  window.toggleFollow = function () { return true; };
  window.setLead = function () { return true; };
  window.prepareMoveEditor = function () { return true; };
  window.showMoveEditor = function () { return true; };
  window.toggleMove = function () { return true; };
  window.saveMoves = function () { return true; };
  window.abandonPokemon = function () { return true; };
  window.openPCAction = function () { return true; };
  window.confirmPCMove = function () { return true; };
  window.closePCAction = function () { return true; };
  window.selectDexMonster = function () { return true; };
  window.selectDexEntry = function () { return true; };
  window.filterDex = function () { return true; };
  window.renderDexGrid = function () { return true; };
  window.updateDexCounter = function () { return true; };
  window.useLevelUpCrystal = function () { return true; };
  window.applyRareCandy = function () { return true; };
  window.startRareCandySelection = function () { return true; };
  window.cancelSelection = function () { return true; };
  window.handleTeamSlotClick = function () { return true; };
  window.selectTeamMember = selectTeamMember;
  window.showTeamDetailMobile = function () { return true; };
  window.hideTeamDetailMobile = function () { return true; };
  window.saveCatalog = function () { return true; };
  window.deleteCatalog = function () { return true; };
  window.startNewCatalogItem = function () { return true; };
  window.devGrant = function () { return true; };
  window.bagTab = function () { return true; };
  window.dexGo = function () { return true; };
  window.dexOpen = function () { return true; };
  window.dexShow = function () { return true; };
  window.dexClose = function () { return true; };
  window.dexPick = function () { return true; };
  window.dexRadialShow = function () { return true; };
  window.dexRadialHide = function () { return true; };
  window.dexToggleQuick = function () { return true; };
  window.__menuOpen = false;
  window.isSelectingMode = false;
  window.CURRENT_TEAM_DATA = [];
  window.__PC_DATA = { pc: [] };

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllModals();
  });

  ensureShell();
  setMenuOpenState(false);
  closeAllModals();
})();
</script>

