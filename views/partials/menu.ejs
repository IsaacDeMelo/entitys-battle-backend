            html += '<div class="team-det-stat-row"><span class="team-det-stat-label">DEF</span><div class="team-det-stat-bar"><div class="team-det-stat-fill" style="width:' + Math.min(100, def) + '%;background:#fbbf24;"></div></div><span class="team-det-stat-val">' + def + '</span></div>';
