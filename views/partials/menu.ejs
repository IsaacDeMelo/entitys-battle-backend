            html += '<div class="team-det-stat-row"><span class="team-det-stat-label">XP</span><div class="team-det-stat-bar"><div class="team-det-stat-fill" style="width:' + xpPct + '%;background:#38bdf8;"></div></div><span class="team-det-stat-val">' + Math.floor(Number(p.xp) || 0) + ' / ' + (p.xpToNext || 100) + '</span></div>';
