<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Game Lobby</title>
    
    <!-- FONTES -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rajdhani:wght@500;600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">

    <!-- ESTILOS OTIMIZADOS -->
    <style>
        :root {
            --bg-core: #0b1222;
            --bg-glass: rgba(26, 43, 74, 0.95);
            --border-glass: rgba(244, 233, 199, 0.2);
            --accent-primary: #3f6fbd;
            --accent-gold: #f3c969;
            --text-main: #f9f4de;
            --text-muted: #a8b7d4;
            --danger: #ef4444;
            --success: #22c55e;
            --radius-lg: 10px;
        }

        /* RESET & BASE */
        * { box-sizing: border-box; outline: none; -webkit-tap-highlight-color: transparent; user-select: none; }
        body { font-family: 'Rajdhani', sans-serif; background: #000; color: var(--text-main); margin: 0; overflow: hidden; }
        
        /* UTILS */
        .pixel-art { image-rendering: pixelated; }
        
        /* TOAST NOTIFICATION */
        #toast-container { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 20000; pointer-events: none; width: 90%; max-width: 300px; text-align: center; }
        .toast { background: rgba(16, 185, 129, 0.95); color: #fff; padding: 12px 20px; border-radius: 50px; margin-bottom: 10px; font-weight: 600; box-shadow: 0 5px 15px rgba(0,0,0,0.5); animation: toastPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); backdrop-filter: blur(4px); font-family: 'Inter', sans-serif; font-size: 0.9rem; }
        @keyframes toastPop { 0% { transform: scale(0.5); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

        /* MODAIS (PADRÃO RETRÔ — igual ao menu/bolsa do City) */
        .modal-overlay { 
            position: fixed; inset: 0;
            background:
                radial-gradient(circle at 30% 20%, rgba(255,255,255,0.06), transparent 55%),
                repeating-linear-gradient(135deg, rgba(255,255,255,0.04) 0 2px, transparent 2px 6px),
                rgba(0,0,0,0.86);
            z-index: 11000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 0;
            pointer-events: auto;
            animation: fadeIn 0.2s ease-out;
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .modal-content { 
            width: min(480px, 95vw);
            max-height: 85vh;
            background: linear-gradient(180deg, #314c7a 0%, #203457 100%);
            border: 4px solid #f4e9c7;
            border-radius: 6px;
            box-shadow: 0 0 0 2px #17223a, 0 12px 32px rgba(0,0,0,0.75);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .modal-header {
            padding: 12px 14px;
            background: linear-gradient(180deg, #3f6fbd 0%, #2c4f8c 100%);
            border-bottom: 3px solid #1a2a46;
            color: #ffffff;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.7rem;
            letter-spacing: 1px;
            text-shadow: 2px 2px 0 rgba(0,0,0,0.7);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }
        .modal-header h2 { 
            margin: 0;
            font-family: 'Press Start 2P', monospace;
            font-weight: 400;
            font-size: 0.72rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .close-icon-btn {
            background: #1b2b47;
            color: #f9f4de;
            border: 2px solid #f4e9c7;
            border-radius: 6px;
            padding: 10px 14px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.8rem;
            box-shadow: 0 3px 0 #101a2c;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .close-icon-btn:active { transform: translateY(2px); box-shadow: none; }

        .modal-body { 
            padding: 16px;
            overflow-y: auto;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            background:
                repeating-linear-gradient(0deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 3px),
                linear-gradient(180deg, rgba(10,16,32,0.35), rgba(10,16,32,0.6));
            -webkit-overflow-scrolling: touch;
        }

        .modal-footer-close {
            padding: 12px 14px;
            background: transparent;
            border-top: 3px solid #1a2940;
            flex-shrink: 0;
        }

        .btn-big-close {
            width: 100%;
            background: linear-gradient(180deg, #f9f2d5 0%, #e7d8a5 100%);
            color: #1a2436;
            border: 3px solid #fff2c2;
            border-radius: 6px;
            padding: 14px 16px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            box-shadow: 0 4px 0 #1a2436, inset 0 1px 0 rgba(255,255,255,0.85);
            transition: all 0.1s;
            position: relative;
        }
        .btn-big-close:hover { filter: brightness(1.03); border-color: #fff7d6; }
        .btn-big-close:active { transform: translateY(3px); box-shadow: 0 1px 0 #1a2436; }
        .btn-big-close::before { content: ''; }

        /* CARDS - MOBILE OPTIMIZED */
        .mon-card { 
            background: rgba(20, 32, 58, 0.75); border: 2px solid rgba(244, 233, 199, 0.22);
            border-radius: 12px; padding: 14px; margin-bottom: 14px;
            display: flex; flex-direction: column; gap: 12px;
            position: relative; overflow: hidden;
            transition: transform 0.2s;
        }
        .mon-card-top { display: flex; gap: 12px; align-items: center; width: 100%; }
        .mon-card:active { transform: scale(0.98); background: rgba(63, 111, 189, 0.18); }
        .mon-card.leader { border-color: var(--accent-gold); box-shadow: inset 0 0 0 2px rgba(243, 201, 105, 0.15); }
        
        .mon-avatar { 
            width: 65px; height: 65px; background: rgba(0,0,0,0.45); flex-shrink: 0;
            border-radius: 8px; display: flex; align-items: center; justify-content: center;
            border: 2px solid rgba(244, 233, 199, 0.22);
        }
        .mon-avatar img { width: 50px; height: 50px; }
        
        .mon-stats { display: flex; flex-direction: column; justify-content: center; gap: 6px; flex: 1; min-width: 0; }
        .mon-name { font-weight: 800; font-size: 1.1rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mon-lvl { font-size: 0.75rem; color: var(--accent-gold); background: rgba(251,191,36,0.15); padding: 2px 8px; border-radius: 6px; margin-left: 6px; }
        
        .bar-wrapper { display: flex; align-items: center; gap: 8px; font-size: 0.7rem; color: var(--text-muted); font-weight: 700; }
        .bar-track { flex: 1; height: 8px; background: rgba(0,0,0,0.6); border-radius: 4px; overflow: hidden; position: relative; }
        .bar-fill { height: 100%; border-radius: 4px; transition: width 0.5s; }
        .hp-fill { background: linear-gradient(90deg, #22c55e, #10b981); }
        .xp-fill { background: linear-gradient(90deg, #06b6d4, #3b82f6); }
        
        .mon-actions { display: flex; flex-direction: row; gap: 10px; width: 100%; margin-top: 4px; }
        .icon-btn { 
            flex: 1; height: 44px; border-radius: 8px; border: 2px solid rgba(244, 233, 199, 0.2);
            background: rgba(255,255,255,0.06); color: #fff; font-size: 1.2rem;
            display: flex; align-items: center; justify-content: center; cursor: pointer;
            box-shadow: 0 2px 0 #101a2c; transition: all 0.1s;
        }
        .icon-btn:active { transform: translateY(2px); box-shadow: none; background: rgba(255,255,255,0.1); }
        .icon-btn.following { background: rgba(251, 191, 36, 0.18); border-color: rgba(251, 191, 36, 0.6); color: #fbbf24; }

        /* =========================================
           EQUIPE (TEAM) - POKÉDEX SCIENTIFIC ANALYSIS
           ========================================= */
        #modalPokemon .modal-content,
        #modalPokedex .modal-content,
        #modalBag .modal-content,
        #modalRank .modal-content,
        #modalPC .modal-content {
            width: 100vw;
            height: 100vh;
            max-width: none;
            border-radius: 0;
            background: linear-gradient(180deg, #101827 0%, #0a0f1d 100%);
            border: none;
            box-shadow: none;
        }

        #modalBag .modal-content,
        #modalRank .modal-content,
        #modalPC .modal-content {
            display: flex;
            flex-direction: column;
        }

        #modalBag .modal-header,
        #modalRank .modal-header,
        #modalPC .modal-header,
        #modalPokedex .dex-topbar,
        .team-topbar {
            background: linear-gradient(135deg, #1a1f35 0%, #0d1220 100%);
            border-bottom: 2px solid #2a3555;
            box-shadow: 0 2px 12px rgba(0,0,0,0.4);
            padding: 14px 16px;
            min-height: 68px;
        }

        #modalBag .modal-header h2,
        #modalRank .modal-header h2,
        #modalPC .modal-header h2,
        #modalPokedex .dex-topbar h2,
        .team-topbar h2 {
            color: #e8e8e8;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.7rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #modalBag .modal-header .close-icon-btn,
        #modalRank .modal-header .close-icon-btn,
        #modalPC .modal-header .close-icon-btn,
        .team-exit-btn,
        .dex-exit-btn {
            background: rgba(56, 189, 248, 0.1);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 8px;
            padding: 10px 14px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.5rem;
            letter-spacing: 1px;
            box-shadow: none;
        }

        #modalBag .modal-body,
        #modalRank .modal-body,
        #modalPC .modal-body {
            background: linear-gradient(180deg, rgba(10,16,32,0.5), rgba(10,16,32,0.8));
            padding: 16px;
            overflow-y: auto;
            flex: 1;
            width: 100%;
        }

        .team-fullscreen { display: flex; flex-direction: column; height: 100%; color: #e2e8f0; font-family: 'Segoe UI', system-ui, sans-serif; }
        .team-topbar {
            display: flex; align-items: center; gap: 12px; padding: 14px 16px;
            background: linear-gradient(135deg, #1a1f35 0%, #0d1220 100%);
            border-bottom: 2px solid #2a3555; flex-shrink: 0;
            box-shadow: 0 2px 12px rgba(0,0,0,0.4);
        }
        .team-topbar h2 { margin: 0; font-family: 'Press Start 2P', monospace; font-size: 0.75rem; color: #e8e8e8; flex: 1; letter-spacing: 2px; }
        .team-topbar h2::before { content: '◆ '; color: #38bdf8; }
        .team-exit-btn {
            background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 8px; padding: 12px 18px; cursor: pointer; font-family: 'Press Start 2P', monospace;
            font-size: 0.55rem; transition: 0.15s; letter-spacing: 1px;
        }
        .team-exit-btn:active { background: rgba(56, 189, 248, 0.25); transform: scale(0.96); }
        .team-body { display: flex; flex: 1; overflow: hidden; }

        /* LISTA - ESQUERDA */
        .team-list-panel {
            width: 40%; max-width: 400px; overflow-y: auto; padding: 12px;
            display: flex; flex-direction: column; gap: 10px;
            border-right: 2px solid #1a2240; background: #0c1020;
        }
        .team-slot {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(20, 30, 55, 0.7) 100%);
            border: 2px solid #1e2d4a; border-radius: 14px; padding: 14px;
            display: flex; gap: 12px; align-items: center; cursor: pointer;
            transition: all 0.2s; position: relative; overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .team-slot::before {
            content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 100%;
            background: transparent; transition: background 0.2s; border-radius: 0 2px 2px 0;
        }
        .team-slot:active { transform: scale(0.98) translateY(2px); background: rgba(56, 189, 248, 0.06); box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
        .team-slot.active { border-color: #38bdf8; background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(30, 58, 138, 0.1) 100%); box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.1), 0 2px 8px rgba(56, 189, 248, 0.2); }
        .team-slot.active::before { background: linear-gradient(180deg, #38bdf8, #0f6fe8); }
        .team-slot-avatar {
            width: 52px; height: 52px; background: rgba(0,0,0,0.5); border-radius: 12px;
            display: flex; justify-content: center; align-items: center;
            border: 1px solid rgba(255,255,255,0.08); flex-shrink: 0;
        }
        .team-slot-avatar img { width: 40px; height: 40px; image-rendering: pixelated; }
        .team-slot-info { flex: 1; min-width: 0; }
        .team-slot-name {
            font-weight: 700; font-size: 0.85rem; color: #e2e8f0;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 6px;
        }
        .team-slot-name .lvl { color: #94a3b8; font-size: 0.7rem; margin-left: 6px; }
        .team-slot-bar-wrap { display: flex; align-items: center; gap: 6px; margin-bottom: 3px; }
        .team-slot-bar-label { font-size: 0.55rem; font-weight: 700; width: 22px; text-transform: uppercase; }
        .team-slot-bar { flex: 1; height: 6px; background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden; }
        .team-slot-bar-fill { height: 100%; border-radius: 3px; transition: width 0.4s; }

        /* DETALHE - DIREITA */
        .team-detail-panel {
            flex: 1; background: #0d1220; overflow-y: auto; padding: 20px;
            display: flex; flex-direction: column; position: relative;
        }
        .team-det-header {
            display: flex; gap: 20px; margin-bottom: 20px; align-items: center;
            padding: 16px; background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 58, 138, 0.4) 100%); border-radius: 16px;
            border: 2px solid rgba(56, 189, 248, 0.3);
            box-shadow: 0 4px 16px rgba(56, 189, 248, 0.1);
        }
        .team-det-avatar {
            width: 100px; height: 100px; background: radial-gradient(circle, #1a2540 0%, #0f172a 100%);
            border-radius: 50%; border: 3px solid #2a3a5a; display: flex; justify-content: center;
            align-items: center; flex-shrink: 0; box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
        }
        .team-det-avatar img { width: 64px; height: 64px; image-rendering: pixelated; transform: scale(1.4); }
        .team-det-title h3 {
            margin: 0 0 8px 0; font-family: 'Press Start 2P', monospace;
            font-size: 0.9rem; color: #f1f5f9; text-transform: uppercase; line-height: 1.4;
        }
        .team-det-title .tag {
            display: inline-block; background: rgba(56, 189, 248, 0.12); color: #7dd3fc;
            padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 0.7rem;
            border: 1px solid rgba(56, 189, 248, 0.2); font-family: 'Press Start 2P', monospace;
        }
        .team-det-title .evo-ready {
            display: block; margin-top: 8px; color: #4ade80; font-size: 0.75rem;
            font-weight: 700; font-family: 'Press Start 2P', monospace;
        }
        .team-det-title .evo-hint {
            display: block; margin-top: 6px; color: #64748b; font-size: 0.7rem;
            font-family: 'Press Start 2P', monospace;
        }

        /* STATS BLOCO */
        .team-det-stats {
            background: rgba(15, 23, 42, 0.5); border-radius: 14px; padding: 16px;
            margin-bottom: 16px; border: 1px solid #1e2d4a;
        }
        .team-det-stats h4 {
            margin: 0 0 12px 0; font-family: 'Press Start 2P', monospace;
            font-size: 0.5rem; color: #64748b; letter-spacing: 2px; text-transform: uppercase;
        }
        .team-det-stat-row {
            display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
            font-family: 'Press Start 2P', monospace; font-size: 0.5rem;
        }
        .team-det-stat-label { width: 40px; color: #94a3b8; font-weight: 700; }
        .team-det-stat-bar { flex: 1; height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
        .team-det-stat-fill { height: 100%; border-radius: 4px; transition: width 0.5s; }
        .team-det-stat-val { width: 80px; text-align: right; color: #cbd5e1; font-size: 0.45rem; }

        /* GOLPES */
        .team-det-moves { margin-bottom: 16px; }
        .team-det-moves h4 {
            margin: 0 0 10px 0; font-family: 'Press Start 2P', monospace;
            font-size: 0.5rem; color: #64748b; letter-spacing: 2px; text-transform: uppercase;
        }
        .team-move-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.7) 0%, rgba(20, 30, 55, 0.4) 100%); border: 1px solid #1e2d4a; border-radius: 10px;
            padding: 12px; margin-bottom: 8px; display: flex; justify-content: space-between;
            align-items: center; transition: all 0.2s;
        }
        .team-move-card:hover { border-color: #2a4a6a; background: linear-gradient(135deg, rgba(20, 30, 55, 0.8) 0%, rgba(30, 45, 75, 0.5) 100%); }
        .team-move-name { color: #e2e8f0; font-weight: 700; font-size: 0.8rem; }
        .team-move-type {
            font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
            padding: 3px 8px; border-radius: 6px; letter-spacing: 0.5px;
        }
        .team-move-empty {
            color: #475569; font-size: 0.75rem; font-weight: 600; padding: 16px;
            text-align: center; border: 1px dashed #1e2d4a; border-radius: 10px;
        }

        /* AÇÕES */
        .team-det-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: auto; padding-top: 16px; }
        .team-action-btn {
            background: linear-gradient(180deg, rgba(20, 30, 55, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%); color: #e2e8f0; border: 2px solid #2a3555;
            padding: 18px 10px; border-radius: 14px; font-weight: 700; font-size: 0.8rem;
            display: flex; flex-direction: column; align-items: center; text-align: center;
            gap: 8px; cursor: pointer; transition: 0.15s;
            font-family: 'Segoe UI', system-ui, sans-serif;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .team-action-btn:active { transform: scale(0.96) translateY(2px); background: rgba(56, 189, 248, 0.15); box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
        .team-action-btn .btn-icon { font-size: 1.6rem; }
        .team-action-btn .btn-label { font-size: 0.65rem; letter-spacing: 0.5px; }
        .team-action-btn.primary { border-color: rgba(56, 189, 248, 0.4); color: #7dd3fc; background: rgba(56, 189, 248, 0.08); }
        .team-action-btn.primary:active { background: rgba(56, 189, 248, 0.2); }
        .team-action-btn.danger { border-color: rgba(239, 68, 68, 0.3); color: #fca5a5; background: rgba(239, 68, 68, 0.06); }
        .team-action-btn.danger:active { background: rgba(239, 68, 68, 0.15); }
        .team-action-btn.gold { border-color: rgba(251, 191, 36, 0.4); color: #fde68a; background: rgba(251, 191, 36, 0.08); }
        .team-action-btn.gold:active { background: rgba(251, 191, 36, 0.2); }
        .team-action-btn.leader-active { border-color: rgba(251, 191, 36, 0.4); color: #fde68a; background: rgba(251, 191, 36, 0.08); opacity: 0.5; cursor: default; }

        /* GAVETA MOBILE */
        .close-team-detail-mobile { display: none; }
        @media (max-width: 768px) {
            .team-body { flex-direction: column; position: relative; }
            .team-list-panel { width: 100%; max-width: none; border-right: none; padding-bottom: 80px; }
            .team-detail-panel {
                position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                z-index: 10; transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
                background: #0a0e1a; padding: 16px; padding-top: env(safe-area-inset-top, 16px);
            }
            .team-detail-panel.show { transform: translateY(0); }
            .close-team-detail-mobile {
                display: flex; align-items: center; justify-content: center; gap: 8px;
                width: 100%; background: rgba(56, 189, 248, 0.1); color: #38bdf8;
                border: 1px solid rgba(56, 189, 248, 0.3); padding: 16px; border-radius: 12px;
                font-family: 'Press Start 2P', monospace; font-size: 0.55rem;
                margin-bottom: 16px; cursor: pointer; letter-spacing: 1px;
            }
            .close-team-detail-mobile:active { background: rgba(56, 189, 248, 0.25); }
            .team-det-actions { grid-template-columns: 1fr; }
            .team-det-header { padding: 12px; gap: 14px; }
            .team-det-avatar { width: 80px; height: 80px; }
            .team-det-avatar img { width: 50px; height: 50px; transform: scale(1.3); }
            .team-det-title h3 { font-size: 0.75rem; }
        }

        /* PC SYSTEM */
        .pc-layout { display: flex; flex-direction: column; gap: 15px; height: 100%; width: 100%; }
        .pc-box-container {
            background: rgba(10, 16, 32, 0.5); border: 2px solid rgba(244, 233, 199, 0.18); border-radius: 8px;
            padding: 10px; flex: 1; overflow-y: auto; display: flex; flex-direction: column;
        }
        .pc-header { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px; font-weight: 700; display:flex; justify-content:space-between; }
        .pc-grid { 
            display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); 
            gap: 10px; padding-bottom: 20px; 
        }
        .pc-slot { 
            aspect-ratio: 1; background: linear-gradient(135deg, rgba(20, 30, 55, 0.6) 0%, rgba(15, 23, 42, 0.8) 100%); 
            border-radius: 8px; border: 2px solid rgba(244, 233, 199, 0.18);
            display: flex; align-items: center; justify-content: center; 
            position: relative; cursor: grab; transition: all 0.15s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .pc-slot[draggable="true"]:active { cursor: grabbing; }
        .pc-slot:hover { border-color: rgba(244, 233, 199, 0.35); box-shadow: 0 2px 12px rgba(244, 233, 199, 0.2); }
        .pc-slot:active { background: rgba(56, 189, 248, 0.15); transform: scale(0.95) translateY(2px); border-color: #38bdf8; box-shadow: 0 1px 4px rgba(56, 189, 248, 0.3); }
        .pc-slot img { width: 50px; height: 50px; }
        .pc-slot .lvl-badge { position: absolute; bottom: 2px; right: 2px; background: #000; color: #fbbf24; font-size: 0.6rem; padding: 2px 4px; border-radius: 4px; font-weight: bold; }

        .pc-team-strip {
            background: rgba(34, 197, 94, 0.08); border: 2px solid rgba(34, 197, 94, 0.25);
            border-radius: 8px; padding: 12px; display: flex; gap: 10px; overflow-x: auto;
            flex-shrink: 0; min-height: 90px; align-items: center;
            transition: background 0.15s, border-color 0.15s;
        }
        .pc-team-strip.drag-over {
            background: rgba(34, 197, 94, 0.25);
            border-color: rgba(34, 197, 94, 0.5);
        }
        .pc-grid.drag-over {
            background: rgba(244, 233, 199, 0.05);
            border-color: rgba(244, 233, 199, 0.3);
        }
        .pc-slot.dragging { opacity: 0.5; transform: scale(0.9); }
        .pc-slot.drag-over { background: rgba(56, 189, 248, 0.2); border-color: #38bdf8; box-shadow: 0 0 12px rgba(56, 189, 248, 0.4); }

        /* ACTION MENU PC */
        #pcActionMenu {
            position: absolute; bottom: 0; left: 0; width: 100%; 
            background: #162643; border-top: 3px solid var(--accent-primary);
            border-radius: 16px 16px 0 0;
            padding: 20px 20px max(20px, env(safe-area-inset-bottom));
            z-index: 12000;
            display: none; flex-direction: column; gap: 10px;
            box-shadow: 0 -10px 50px rgba(0,0,0,0.8);
            animation: slideUp 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        #pcActionMenu.active { display: flex; }
        .pc-action-title { color: #fff; text-align: center; margin-bottom: 10px; font-size: 1.1rem; }
        .btn-pc-action {
            width: 100%;
            min-height: 48px;
            background: linear-gradient(180deg, #f9f2d5 0%, #e7d8a5 100%);
            color: #1a2436;
            border: 3px solid #fff2c2;
            border-radius: 10px;
            padding: 14px 16px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            box-shadow: 0 4px 0 #1a2436, inset 0 1px 0 rgba(255,255,255,0.85);
            transition: all 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
        }
        .btn-pc-action:hover { filter: brightness(1.03); border-color: #fff7d6; }
        .btn-pc-action:active { transform: translateY(3px); box-shadow: 0 1px 0 #1a2436; }
        .btn-pc-action::before { content: ''; }
        .btn-move-team { }
        .btn-move-box { }
        .btn-cancel-action { }

        /* POKEDEX - FULLSCREEN */
        #modalPokedex { z-index: 14000; }
        .dex-fullscreen { display: flex; flex-direction: column; height: 100%; color: #e2e8f0; }
        .dex-topbar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #111827; border-bottom: 2px solid #1e293b; flex-shrink: 0; }
        .dex-topbar h2 { margin: 0; font-family: 'Press Start 2P', monospace; font-size: 0.7rem; color: #f87171; flex: 1; }
        .dex-topbar .dex-counter { font-family: 'Press Start 2P', monospace; font-size: 0.55rem; color: #94a3b8; }
        .dex-exit-btn { background: #1e293b; color: #e2e8f0; border: 2px solid #334155; border-radius: 6px; padding: 8px 14px; cursor: pointer; font-family: 'Press Start 2P', monospace; font-size: 0.5rem; flex-shrink: 0; }
        .dex-exit-btn:active { background: #334155; }
        .dex-search-bar { padding: 10px 16px; background: #0f172a; border-bottom: 1px solid #1e293b; flex-shrink: 0; }
        .dex-search-bar input { width: 100%; padding: 10px 14px; background: #1e293b; border: 1px solid #334155; border-radius: 8px; color: #e2e8f0; font-family: 'Press Start 2P', monospace; font-size: 0.5rem; outline: none; }
        .dex-search-bar input:focus { border-color: #f87171; }
        .dex-body { display: flex; flex: 1; overflow: hidden; }
        .dex-list-panel { flex: 1; overflow-y: auto; padding: 12px; }
        .dex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 8px; }
        .dex-entry { aspect-ratio: 1; background: #1e293b; border-radius: 8px; border: 2px solid #334155; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; position: relative; transition: all 0.15s; box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
        .dex-entry:hover { border-color: #475569; box-shadow: 0 2px 12px rgba(0,0,0,0.4); }
        .dex-entry.unlocked { border-color: #3b82f6; background: rgba(59, 130, 246, 0.15); box-shadow: 0 0 12px rgba(59, 130, 246, 0.2); }
        .dex-entry.locked { opacity: 0.5; }
        .dex-entry.locked img { filter: grayscale(1) brightness(0.7); }
        .dex-entry .dex-num { font-family: 'Press Start 2P', monospace; font-size: 0.4rem; color: #64748b; position: absolute; top: 3px; left: 5px; }
        .dex-detail-panel { width: 45%; max-width: 400px; background: #0f172a; border-left: 2px solid #1e293b; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        .dex-detail-empty { display: flex; align-items: center; justify-content: center; height: 100%; color: #475569; font-family: 'Press Start 2P', monospace; font-size: 0.5rem; text-align: center; }
        #dexDetailContent { display: flex; flex-direction: column; align-items: center; width: 100%; }
        .dex-sprite-frame { width: 120px; height: 120px; background: #1e293b; border-radius: 16px; border: 3px solid #334155; display: flex; justify-content: center; flex-direction: column; align-items: center; margin-bottom: 16px; }
        .dex-sprite-frame img { image-rendering: pixelated; transform: scale(2); }
        .dex-mon-name { font-family: 'Press Start 2P', monospace; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px; text-align: center; }
        .dex-mon-type { display: inline-block; padding: 3px 10px; border-radius: 12px; font-family: 'Press Start 2P', monospace; font-size: 0.45rem; text-transform: uppercase; margin-bottom: 16px; font-weight: bold; }
        .dex-stats-section { width: 100%; margin-bottom: 14px; }
        .dex-stats-section h4 { font-family: 'Press Start 2P', monospace; font-size: 0.45rem; color: #64748b; margin: 0 0 8px 0; text-transform: uppercase; }
        .dex-stat-row { display: flex; align-items: center; margin-bottom: 5px; font-family: 'Press Start 2P', monospace; font-size: 0.45rem; }
        .dex-stat-label { width: 36px; color: #94a3b8; font-weight: bold; }
        .dex-stat-bar-bg { flex: 1; height: 6px; background: #1e293b; border-radius: 3px; margin: 0 8px; overflow: hidden; }
        .dex-stat-bar { height: 100%; border-radius: 3px; transition: width 0.3s; }
        .dex-stat-val { width: 28px; text-align: right; color: #e2e8f0; }
        .dex-moves-section { width: 100%; }
        .dex-moves-section h4 { font-family: 'Press Start 2P', monospace; font-size: 0.45rem; color: #64748b; margin: 0 0 8px 0; text-transform: uppercase; }
        .dex-move-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid #1e293b; font-family: 'Press Start 2P', monospace; font-size: 0.4rem; }
        .dex-move-lv { color: #fbbf24; margin-right: 8px; }
        .dex-move-name { flex: 1; color: #e2e8f0; }
        .dex-move-elem { color: #64748b; }
        @media (max-width: 600px) {
            .dex-body { display: block; position: relative; }
            .dex-detail-panel { 
                position: absolute; bottom: 0; left: 0; width: 100%; 
                height: 85%; max-height: none;
                border-left: none; border-top: 4px solid #f87171;
                border-radius: 16px 16px 0 0;
                transform: translateY(100%); 
                transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
                box-shadow: 0 -10px 40px rgba(0,0,0,0.9);
                z-index: 50;
            }
            .dex-detail-panel.show-mobile { transform: translateY(0); }
            .dex-detail-panel .dex-mobile-close { display: block !important; }
            .dex-grid { gap: 12px; }
            .dex-entry { aspect-ratio: 1; border-width: 3px; }
        }

        /* RANK */
        .rank-list { display: flex; flex-direction: column; gap: 8px; width: 100%; }
        .rank-row { display: grid; grid-template-columns: 50px 1fr 80px 70px 70px; gap: 8px; align-items: center; padding: 8px 10px; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; background: rgba(15, 23, 42, 0.6); font-size: 0.85rem; }
        .rank-row.header { background: rgba(63, 111, 189, 0.25); text-transform: uppercase; font-weight: 800; letter-spacing: 0.6px; }
        .rank-num { color: var(--accent-gold); font-weight: 900; }
        .rank-points { color: #38bdf8; font-weight: 800; }
        .rank-wins { color: #22c55e; font-weight: 800; }
        .rank-losses { color: #ef4444; font-weight: 800; }
        .rank-empty { text-align: center; padding: 20px; color: var(--text-muted); }
        
        /* MENU FLUTUANTE */
        .float-container { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(100px, env(safe-area-inset-bottom) + 90px); z-index: 10000; display: flex; flex-direction: column-reverse; align-items: center; gap: 14px; }
        .float-btn { width: 66px; height: 66px; border-radius: 50%; background: #F8F8F8; border: 3px solid #181010; color: #181010; font-family: 'Press Start 2P', monospace; font-size: 0.38rem; cursor: pointer; box-shadow: 3px 3px 0 #181010; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center; line-height: 1; transition: all 0.12s; }
        .float-btn .menu-png { width: 28px; height: 28px; object-fit: contain; display: block; image-rendering: pixelated; flex-shrink: 0; filter: drop-shadow(0 0 2px rgba(0,0,0,0.5)); }
        .float-btn span { display: block; text-align: center; width: 100%; text-shadow: 1px 1px 2px rgba(0,0,0,0.7); }
        .float-btn:active { transform: translate(2px,2px) scale(0.95); box-shadow: 1px 1px 0 #181010; }
        .float-btn:hover { filter: brightness(1.1); }
        .float-btn.main-toggle { width: 72px; height: 72px; font-size: 1.5rem; background: var(--accent-primary); color: white; border-color: #1a2a46; box-shadow: 0 4px 15px rgba(0,0,0,0.5); animation: pulse-btn 2s infinite; }
        @keyframes pulse-btn { 0%, 100% { box-shadow: 0 4px 15px rgba(63, 111, 189, 0.5); } 50% { box-shadow: 0 4px 25px rgba(63, 111, 189, 0.8); } }
        .float-menu-items { display: none; flex-direction: column-reverse; gap: 14px; align-items: center; }
        .float-menu-items.show { display: flex; animation: slideUp 0.2s; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* DEX DETAILS */
        .dex-details { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #111827; z-index: 20; transform: translateX(110%); transition: transform 0.3s; display: flex; flex-direction: column; }
        .dex-details.active { transform: translateX(0); }
        .back-btn-dex {
            width: 100%;
            background: linear-gradient(180deg, #f9f2d5 0%, #e7d8a5 100%);
            color: #1a2436;
            border: 3px solid #fff2c2;
            border-radius: 6px;
            padding: 14px 16px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            box-shadow: 0 4px 0 #1a2436, inset 0 1px 0 rgba(255,255,255,0.85);
            transition: all 0.1s;
        }
        .back-btn-dex:hover { filter: brightness(1.03); border-color: #fff7d6; }
        .back-btn-dex:active { transform: translateY(3px); box-shadow: 0 1px 0 #1a2436; }

        /* BAG */
        .bag-header-money { text-align:center; padding:15px; font-size:1.1rem; color:var(--accent-gold); border-bottom:2px solid rgba(244, 233, 199, 0.2); margin-bottom:15px; background: rgba(0,0,0,0.2); border-radius: 8px; }
        .bag-item-row { display: flex; align-items: center; background: linear-gradient(135deg, rgba(20, 30, 55, 0.5) 0%, rgba(15, 23, 42, 0.7) 100%); padding: 15px; border-radius: 8px; margin-bottom: 10px; border: 2px solid var(--border-glass); transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
        .bag-item-row:active { transform: translateY(2px); background: rgba(56, 189, 248, 0.08); border-color: rgba(56, 189, 248, 0.3); }
        .bag-tabs { display:flex; gap:10px; margin: 10px 0 15px 0; }
        .bag-tab { flex:1; padding: 12px; border-radius: 8px; border: 2px solid var(--border-glass); background: rgba(255,255,255,0.03); color:#fff; font-weight: 800; cursor:pointer; text-transform: uppercase; }
        .bag-tab.active { background: rgba(243, 201, 105, 0.18); border-color: rgba(243, 201, 105, 0.4); color:var(--accent-gold); }
        .bag-item-icon { width: 42px; height: 42px; margin-right: 15px; image-rendering: pixelated; object-fit: contain; }
        .bag-empty { padding: 20px; text-align:center; color:#aaa; background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15); border-radius: 12px; }
        
        /* SKILL EDITOR */
        .skill-item { background:#1f2937; padding:12px; border-radius:8px; border:1px solid transparent; cursor:pointer; transition: 0.2s; }
        .skill-item.active { border-color: #10b981; background: rgba(16, 185, 129, 0.1); }
        .keyboard-selected { outline: none !important; }
        .menu-png { image-rendering: pixelated; }
    </style>
</head>
<body>
    <div id="toast-container"></div>

    <!-- MENU FLUTUANTE -->
    <div class="float-container" id="floatMenu">
        <div id="menuItems" class="float-menu-items">
            <button class="float-btn" onclick="openBag()"><img class="menu-png" data-menu="bag" src="/uploads/menu_bolsa.png" alt="" style="width:28px;height:28px;image-rendering:pixelated;" onerror="this.style.display='none'"><span style="font-size:0.45rem;">BAG</span></button>
            <button class="float-btn" onclick="openPokemon()"><img class="menu-png" data-menu="equipe" src="/uploads/menu_equipe.png" alt="" style="width:28px;height:28px;image-rendering:pixelated;" onerror="this.style.display='none'"><span style="font-size:0.45rem;">EQUIPE</span></button>
            <button class="float-btn" onclick="openPC()"><img class="menu-png" data-menu="pc" src="/uploads/menu_pc.png" alt="" style="width:28px;height:28px;image-rendering:pixelated;" onerror="this.style.display='none'"><span style="font-size:0.45rem;">PC</span></button>
            <button class="float-btn" onclick="openPokedex()"><img class="menu-png" data-menu="pokedex" src="/uploads/menu_pokedex.png" alt="" style="width:28px;height:28px;image-rendering:pixelated;" onerror="this.style.display='none'"><span style="font-size:0.45rem;">DEX</span></button>
        </div>
        <button class="float-btn main-toggle" onclick="toggleFloatMenu()">☰</button>
    </div>

    <!-- MODAL: MEU TIME (FULLSCREEN DETALHADO) -->
    <div class="modal-overlay" id="modalPokemon">
        <div class="modal-content">
            <div class="team-fullscreen">
                <div class="team-topbar">
                    <h2>EQUIPE</h2>
                    <button class="team-exit-btn" onclick="closeModal('modalPokemon')">FECHAR</button>
                </div>
                <div class="team-body">
                    <div class="team-list-panel" id="pokemonListContent">
                        <!-- Cards do time entram aqui via JS -->
                    </div>
                    <div class="team-detail-panel" id="pokemonDetailContent">
                        <!-- Análise detalhada entra aqui via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: POKEDEX (FULLSCREEN) -->
    <div class="modal-overlay" id="modalPokedex">
        <div class="modal-content">
            <div class="dex-fullscreen">
                <div class="dex-topbar">
                    <h2>POKéDEX</h2>
                    <span class="dex-counter" id="dexCounter">0 / 0</span>
                    <button class="dex-exit-btn" onclick="closePokedex()">SAIR</button>
                </div>
                <div class="dex-search-bar">
                    <input type="text" id="dexSearch" placeholder="Buscar..." oninput="filterDex()">
                </div>
                <div class="dex-body">
                    <div class="dex-list-panel" id="dexListPanel">
                        <div class="dex-grid" id="dexGrid"></div>
                    </div>
                    <div class="dex-detail-panel" id="dexDetailPanel">
                        <div class="dex-detail-empty" id="dexDetailEmpty">Selecione um Pokemon</div>
                        <div id="dexDetailContent" style="display:none; width:100%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: RANK -->
    <div class="modal-overlay" id="modalRank">
        <div class="modal-content" style="height:70vh;">
            <div class="modal-header">
                <h2><span style="color:#fbbf24;">★</span> Rank PvP</h2>
                <button class="close-icon-btn" onclick="closeModal('modalRank')">×</button>
            </div>
            <div class="modal-body">
                <div id="rankContent" class="rank-list" style="width:100%;">Carregando...</div>
            </div>
        </div>
    </div>

    <!-- MODAL: PC STORAGE -->
    <div class="modal-overlay" id="modalPC">
        <div class="modal-content">
            <div class="modal-header">
                <h2><span style="color:#22c55e;">●</span> PC Storage</h2>
                <button class="close-icon-btn" onclick="closeModal('modalPC')">×</button>
            </div>
            <div class="modal-body" style="padding:15px;">
                <div class="pc-layout">
                    <!-- BOX AREA -->
                    <div class="pc-box-container">
                        <div class="pc-header"><span>BOX 01</span> <span style="font-size:0.7rem; color:#94a3b8;">Arraste para mover</span></div>
                        <div class="pc-grid" id="pcStorageArea">Carregando...</div>
                    </div>
                    
                    <!-- TEAM AREA -->
                    <div style="flex-shrink:0;">
                        <div class="pc-header" style="color:#22c55e;"><span>TIME ATUAL (Max 6)</span> <span style="font-size:0.7rem; color:#94a3b8;">Arraste para mover</span></div>
                        <div class="pc-team-strip" id="pcTeamArea"></div>
                    </div>
                </div>
                
                <!-- POPUP DE AÇÃO DO PC -->
                <div id="pcActionMenu">
                    <div id="pcActionTitle" class="pc-action-title">Selecionado: ???</div>
                    <div id="pcActionButtons" style="display:flex; flex-direction:column; gap:10px;"></div>
                    <button class="btn-pc-action btn-cancel-action" onclick="closePCAction()">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: MOCHILA -->
    <div class="modal-overlay" id="modalBag">
        <div class="modal-content" style="height:70vh;">
            <div class="modal-header">
                <h2><span style="color:#fbbf24;">●</span> Mochila</h2>
                <button class="close-icon-btn" onclick="closeModal('modalBag')">×</button>
            </div>
            <div class="modal-body">
                <div id="bagItemsContent" style="width:100%;">Carregando...</div>
            </div>
        </div>
    </div>

    <datalist id="itemCatalogDatalist"></datalist>

    <script>
        const USER_ID = '<%= user._id %>';
        const IS_ADMIN = <%= user.isAdmin ? 'true' : 'false' %>;
        let isSelectingMode = false;
        let currentMonId = null;
        let GLOBAL_MOVES_LIB = {};
        let CURRENT_TEAM_DATA = []; // Cache do time para acesso seguro
        let CACHED_PC_DATA = null;
        
        // DADOS E HISTÓRICO
        const RAW_ENTITIES = <%- JSON.stringify(entities || []) %>;
        const RAW_TEAM = <%- JSON.stringify(user.entityTeam || user.pokemonTeam || []) %>;
        const RAW_PC = <%- JSON.stringify(user.pc || []) %>;
        const REGISTERED_DEX_HISTORY = <%- JSON.stringify(user.dex || []) %>;

        const DEX_ENTITIES = [...RAW_ENTITIES].sort((a, b) => {
            const da = parseInt(a.dexOrder, 10);
            const db = parseInt(b.dexOrder, 10);
            const aHas = Number.isFinite(da);
            const bHas = Number.isFinite(db);
            if (aHas && bHas && da !== db) return da - db;
            if (aHas && !bHas) return -1;
            if (!aHas && bHas) return 1;
            const an = String(a.name || '').toLowerCase();
            const bn = String(b.name || '').toLowerCase();
            if (an < bn) return -1;
            if (an > bn) return 1;
            return 0;
        });
        
        const UNLOCKED_IDS = new Set([
            ...REGISTERED_DEX_HISTORY,
            ...RAW_TEAM.map(p => String(p.baseId||p.id)), 
            ...RAW_PC.map(p => String(p.baseId||p.id))
        ]);

        let CURRENT_FOLLOWING_ID = (window.__ME_CACHE && window.__ME_CACHE.followingEntityId) ? String(window.__ME_CACHE.followingEntityId) : '';

        function resolveImg(s) {
            return s ? s : '/uploads/placeholder.png'; // Fallback se imagem faltar
        }

        // UTILS
        function showToast(msg) {
            const div = document.createElement('div'); div.className = 'toast'; div.innerText = msg;
            document.getElementById('toast-container').appendChild(div);
            setTimeout(() => div.remove(), 2500);
        }

        window.MenuSystem = {
            state: {
                menuOpen: false,
                activeModal: null,
                lastFocused: null
            },
            setMenuOpen(value) {
                this.state.menuOpen = Boolean(value);
                window.__menuOpen = this.state.menuOpen;
                if (!this.state.menuOpen) {
                    const menu = document.getElementById('menuItems');
                    if (menu) menu.classList.remove('show');
                }
            },
            openModal(id) {
                const ids = ['modalPokemon','modalBag','modalPC','modalPokedex','modalRank'];
                ids.forEach(mid => {
                    const el = document.getElementById(mid);
                    if (el) el.style.display = (mid === id) ? 'flex' : 'none';
                });
                const target = document.getElementById(id);
                if (!target) return false;
                this.state.activeModal = id;
                this.setMenuOpen(Boolean(id));
                if (id === 'modalPokemon') isSelectingMode = false;
                if (id === 'modalPC') closePCAction();
                return true;
            },
            closeModal(id) {
                const el = document.getElementById(id);
                if (el) el.style.display = 'none';
                if (this.state.activeModal === id) this.state.activeModal = null;
                const anyOpen = ['modalPokemon','modalBag','modalPC','modalPokedex','modalRank'].some(mid => {
                    const modal = document.getElementById(mid);
                    return modal && modal.style.display !== 'none';
                });
                if (!anyOpen) this.setMenuOpen(false);
                if (id === 'modalPokemon') isSelectingMode = false;
                if (id === 'modalPC') closePCAction();
                document.querySelectorAll('.keyboard-selected').forEach(e => e.classList.remove('keyboard-selected'));
            }
        };

