        /* --- PC SYSTEM --- */
        async function openPC(forceRefresh = false) { 
            window.MenuSystem.openModal('modalPC');
            closePCAction();
            if (CACHED_PC_DATA && !forceRefresh) { renderPCLayout(CACHED_PC_DATA.team, CACHED_PC_DATA.pc); return; }
            try { 
                document.getElementById('pcStorageArea').innerHTML = '<div style="padding:20px; text-align:center; color:#aaa;">Carregando...</div>';
                const r = await fetch(`/api/pc?userId=${USER_ID}`); 
                const d = await r.json(); 
                CACHED_PC_DATA = d; 
                await preloadPCSprites(d);
                renderPCLayout(d.team, d.pc); 
            } catch(e) { console.error(e); }
        }

        function preloadPCSprites(d) {
            const urls = new Set();
            (d.team || []).concat(d.pc || []).forEach(p => {
                if(p.sprite) urls.add(p.sprite);
                if(p.icon) urls.add(p.icon);
            });
            return Promise.all([...urls].map(u => new Promise(res => {
                const img = new Image();
                img.onload = img.onerror = () => res();
                img.src = u;
            })));
        }

        function renderPCLayout(team, pc) {
            const boxHtml = pc.map(p => `
                <div class="pc-slot" draggable="true" data-pokemon-id="${p.instanceId}" data-pokemon-name="${p.name}" data-pokemon-source="pc" onclick="openPCAction('${p.instanceId}', '${p.name}', 'pc')">
                    <img src="${resolveImg(p.icon || p.sprite)}" class="pixel-art">
                    <div class="lvl-badge">Lv.${p.level}</div>
                </div>`).join('') + Array(10).fill('<div class="pc-slot" style="opacity:0.2; cursor:default;"></div>').join('');
            const storageArea = document.getElementById('pcStorageArea');
            if (storageArea) {
                storageArea.innerHTML = boxHtml;
                storageArea.addEventListener('dragover', handlePCDragOver);
                storageArea.addEventListener('dragleave', handlePCDragLeave);
                storageArea.addEventListener('drop', handlePCDrop);
                storageArea.querySelectorAll('[draggable="true"]').forEach(slot => {
                    slot.addEventListener('dragstart', handlePCDragStart);
                    slot.addEventListener('dragend', handlePCDragEnd);
                });
            }

            const teamHtml = team.map(p => `
                <div class="pc-slot" style="min-width:60px; border-color:#10b981;" draggable="true" data-pokemon-id="${p.instanceId}" data-pokemon-name="${p.name}" data-pokemon-source="team" onclick="openPCAction('${p.instanceId}', '${p.name}', 'team')">
                    <img src="${resolveImg(p.icon || p.sprite)}" class="pixel-art">
                    <div class="lvl-badge">Lv.${p.level}</div>
                </div>`).join('') + (team.length < 6 ? '<div class="pc-slot" style="min-width:60px; border:1px dashed #555; opacity:0.5;"></div>' : '');
            const teamArea = document.getElementById('pcTeamArea');
            if (teamArea) {
                teamArea.innerHTML = teamHtml;
                teamArea.addEventListener('dragover', handlePCDragOver);
                teamArea.addEventListener('dragleave', handlePCDragLeave);
                teamArea.addEventListener('drop', handlePCDrop);
                teamArea.querySelectorAll('[draggable="true"]').forEach(slot => {
                    slot.addEventListener('dragstart', handlePCDragStart);
                    slot.addEventListener('dragend', handlePCDragEnd);
                });
            }
        }

        let pcDragData = null;

        function handlePCDragStart(e) {
            const slot = e.target.closest('[draggable="true"]');
            pcDragData = {
                pokemonId: slot.getAttribute('data-pokemon-id'),
                pokemonName: slot.getAttribute('data-pokemon-name'),
                source: slot.getAttribute('data-pokemon-source')
            };
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', JSON.stringify(pcDragData));
            slot.classList.add('dragging');
        }

        function handlePCDragEnd(e) {
            document.querySelectorAll('.pc-slot').forEach(el => el.classList.remove('dragging'));
            document.querySelectorAll('#pcStorageArea, #pcTeamArea').forEach(el => el.classList.remove('drag-over'));
        }

        function handlePCDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            e.currentTarget.classList.add('drag-over');
        }

        function handlePCDragLeave(e) {
            if (e.currentTarget === e.target) {
                e.currentTarget.classList.remove('drag-over');
            }
        }

        async function handlePCDrop(e) {
            e.preventDefault();
            const container = e.currentTarget;
            container.classList.remove('drag-over');
            
            if (!pcDragData) return;
            
            const targetType = container.id === 'pcTeamArea' ? 'team' : 'pc';
            if (pcDragData.source === targetType) {
                showToast('Ja esta nessa area!');
                return;
            }
            
            showToast('Movendo...');
            try {
                const res = await fetch('/api/pc/move', { 
                    method: 'POST', 
                    headers: {'Content-Type':'application/json'}, 
                    body: JSON.stringify({ 
                        userId: USER_ID, 
                        pokemonId: pcDragData.pokemonId, 
                        from: pcDragData.source, 
                        to: targetType 
                    }) 
                });
                const data = await res.json();
                if(data.success) { 
                    showToast('✓ Movido com sucesso!');
                    closePCAction();
                    openPC(true);
                } else { 
                    showToast(data.error || 'Erro ao mover.');
                }
            } catch(e) { 
                showToast('Erro de conexao');
            }
            pcDragData = null;
        }

        let selectedPCData = null;
        function openPCAction(pokeId, name, source) {
            selectedPCData = { pokeId, source };
            document.getElementById('pcActionTitle').innerText = name;
            const btnContainer = document.getElementById('pcActionButtons');
            if (source === 'pc') {
                btnContainer.innerHTML = `<button class="btn-pc-action btn-move-team" onclick="confirmPCMove('team')">📥 MOVER PARA O TIME</button>`;
            } else {
                btnContainer.innerHTML = `<button class="btn-pc-action btn-move-box" onclick="confirmPCMove('pc')">📤 MOVER PARA O BOX</button>`;
            }
            document.getElementById('pcActionMenu').classList.add('active');
        }

        function closePCAction() { 
            const menu = document.getElementById('pcActionMenu');
            if (menu) menu.classList.remove('active'); 
            selectedPCData = null; 
        }

        async function confirmPCMove(targetContainer) {
            if (!selectedPCData) return;
            const { pokeId, source } = selectedPCData;
            closePCAction();
            showToast("Movendo...");
            try {
                const res = await fetch('/api/pc/move', { 
                    method: 'POST', headers: {'Content-Type':'application/json'}, 
                    body: JSON.stringify({ userId: USER_ID, pokemonId: pokeId, from: source, to: targetContainer }) 
                });
                const data = await res.json();
                if(data.success) { showToast("✓ Sucesso!"); openPC(true); } 
                else { showToast(data.error || "Erro ao mover."); }
            } catch(e) { showToast("Erro de conexao"); }
        }

        /* --- MOCHILA (AGORA COM DINHEIRO) --- */
        function attachDevItemHandlers() {
            if (!IS_ADMIN) return;

            const grantBtn = document.getElementById('devGrantBtn');
            const revokeBtn = document.getElementById('devRevokeBtn');
            const devId = document.getElementById('devItemId');
            const devQty = document.getElementById('devItemQty');

            async function doGrant(isGrant) {
                const itemId = devId ? String(devId.value || '').trim() : '';
                const qty = devQty ? Math.max(1, parseInt(devQty.value, 10) || 1) : 1;
                if (!itemId) return alert('Informe o itemId.');
                const url = isGrant ? '/api/dev/inventory/grant' : '/api/dev/inventory/revoke';
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, itemId, qty })
                });
                const data = await resp.json().catch(() => ({}));
                if (!data || !data.success) return alert(data.error || 'Falha.');
                openBag();
            }

            if (grantBtn) grantBtn.onclick = () => doGrant(true);
            if (revokeBtn) revokeBtn.onclick = () => doGrant(false);

            const catSaveBtn = document.getElementById('catSaveBtn');
            const catDeleteBtn = document.getElementById('catDeleteBtn');
            const catNewConsumableBtn = document.getElementById('catNewConsumableBtn');
            const catNewKeyBtn = document.getElementById('catNewKeyBtn');
            const catId = document.getElementById('catItemId');
            const catName = document.getElementById('catItemName');
            const catType = document.getElementById('catItemType');
            const catIcon = document.getElementById('catItemIcon');

            function startNewCatalogItem(type) {
                if (catId) catId.value = '';
                if (catName) catName.value = '';
                if (catType) catType.value = type || 'consumable';
                if (catIcon) catIcon.value = '';
                try { if (catId) catId.focus(); } catch (_) {}
            }

            async function saveCatalog() {
                const id = catId ? String(catId.value || '').trim() : '';
                const name = catName ? String(catName.value || '').trim() : '';
                const type = catType ? String(catType.value || 'consumable') : 'consumable';
                if (!id) return alert('Informe o id do item.');

                const r1 = await fetch('/api/items/upsert', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, item: { id, name, type } })
                });
                const d1 = await r1.json().catch(() => ({}));
                if (!d1 || !d1.success) return alert(d1.error || 'Falha ao salvar item.');

                if (catIcon && catIcon.files && catIcon.files[0]) {
                    const f = catIcon.files[0];
                    if (f.type !== 'image/png') return alert('Ícone precisa ser PNG.');
                    const reader = new FileReader();
                    const b64 = await new Promise((resolve, reject) => {
                        reader.onload = () => resolve(String(reader.result || ''));
                        reader.onerror = reject;
                        reader.readAsDataURL(f);
                    });
                    const stripped = b64.replace(/^data:image\/png;base64,/, '');
                    const r2 = await fetch('/api/items/icon/set', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId: USER_ID, itemId: id, pngBase64: stripped })
                    });
                    const d2 = await r2.json().catch(() => ({}));
                    if (!d2 || !d2.success) return alert(d2.error || 'Falha ao salvar ícone.');
                }

                await loadItemCatalog(true);
                openBag();
            }

            async function deleteCatalog() {
                const id = catId ? String(catId.value || '').trim() : '';
                if (!id) return alert('Informe o id do item.');
                const r1 = await fetch('/api/items/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, itemId: id })
                });
                const d1 = await r1.json().catch(() => ({}));
                if (!d1 || !d1.success) return alert(d1.error || 'Falha ao deletar.');
                await loadItemCatalog(true);
                openBag();
            }

            if (catSaveBtn) catSaveBtn.onclick = saveCatalog;
            if (catDeleteBtn) catDeleteBtn.onclick = deleteCatalog;
            if (catNewConsumableBtn) catNewConsumableBtn.onclick = () => startNewCatalogItem('consumable');
            if (catNewKeyBtn) catNewKeyBtn.onclick = () => startNewCatalogItem('key');
        }

        async function openBag() { 
            window.MenuSystem.openModal('modalBag');

            const renderBagFromMe = async (d) => {
                await loadItemCatalog(true);
                await preloadBagIcons();

                let html = `<div class="bag-header-money">💰 Dinheiro: <b>$${d.money || 0}</b></div>`;
                html += `
                    <div class="bag-tabs">
                        <button id="bagTabItems" class="bag-tab active" type="button">ITENS</button>
                        <button id="bagTabKeys" class="bag-tab" type="button">KEY ITENS</button>
                    </div>
                    <div id="bagTabBody"></div>
                `;

                document.getElementById('bagItemsContent').innerHTML = html;

                const tabItems = document.getElementById('bagTabItems');
                const tabKeys = document.getElementById('bagTabKeys');
                const body = document.getElementById('bagTabBody');

                function itemRow(meta, nome, qtd, actionHtml, overrideId) {
                    const itemId = overrideId || (meta ? String(meta.id || '') : '');
                    const icon = getItemIconUrl(itemId);
                    const iconHtml = icon ? `<img src="${icon}" class="bag-item-icon pixel-art" onerror="this.style.display='none'" />` : `<div class="bag-item-icon" style="display:flex;align-items:center;justify-content:center;background:#111;">?</div>`;
                    const qtyHtml = (qtd !== null && qtd !== undefined) ? `<div style="color:#aaa; font-size:0.85rem;">x${qtd}</div>` : '';
                    return `
                        <div class="bag-item-row">
                            ${iconHtml}
                            <div style="flex:1;">
                                <div style="font-weight:700; font-size:1.1rem; color:#fff;">${nome}</div>
                                ${qtyHtml}
                            </div>
                            ${actionHtml || ''}
                        </div>
                    `;
                }

                function getMeta(id) {
                    return getItemMeta(id);
                }

                function renderItemsTab() {
                    if (!body) return;
                    const parts = [];
                    const inv = (d && d.inventory && typeof d.inventory === 'object') ? d.inventory
                              : ((d && d.bag && typeof d.bag === 'object') ? d.bag : {});

                    const metaBall = getMeta('pokeball');
                    parts.push(itemRow(metaBall, (metaBall && metaBall.name) ? metaBall.name : 'CatchCube', d.pokeballs || 0, '', 'pokeball'));

                    const metaCandy = getMeta('rareCandy');
                    const btn = `<button onclick="startRareCandySelection()" style="background:var(--accent-primary); border:none; padding:8px 16px; border-radius:8px; color:white; font-weight:bold;">USAR</button>`;
                    parts.push(itemRow(metaCandy, (metaCandy && metaCandy.name) ? metaCandy.name : 'Rare Candy', d.rareCandy || 0, ((d.rareCandy || 0) > 0 ? btn : ''), 'rare-candy'));

                    const metaCrystal = getMeta('levelUpCrystal');
                    const btnCrystal = `<button onclick="startLevelUpCrystalSelection()" style="background:var(--accent-primary); border:none; padding:8px 16px; border-radius:8px; color:white; font-weight:bold;">USAR</button>`;
                    const qtyCrystal = (inv && inv.levelUpCrystal) ? parseInt(inv.levelUpCrystal, 10) || 0 : 0;
                    parts.push(itemRow(metaCrystal, (metaCrystal && metaCrystal.name) ? metaCrystal.name : 'Level Up Crystal', qtyCrystal, (qtyCrystal > 0 ? btnCrystal : ''), 'levelUpCrystal'));

                    const keys = Object.keys(inv);
                    keys.sort((a, b) => a.localeCompare(b));
                    keys.forEach(id => {
                        const qty = parseInt(inv[id], 10);
                        if (!Number.isFinite(qty) || qty <= 0) return;
                        const meta = getMeta(id);
                        const name = (meta && meta.name) ? meta.name : id;
                        parts.push(itemRow(meta, name, qty, '', id));
                    });

                    body.innerHTML = parts.length ? parts.join('') : `<div class="bag-empty">Sem itens.</div>`;
                }

                function renderKeysTab() {
                    if (!body) return;
                    const keys = Array.isArray(d && d.keyItems) ? d.keyItems.slice() : [];
                    keys.sort((a, b) => String(a).localeCompare(String(b)));
                    if (!keys.length) {
                        body.innerHTML = `<div class="bag-empty">Sem key itens.</div>`;
                        return;
                    }
                    const parts = keys.map(id => {
                        const meta = getMeta(id);
                        const name = (meta && meta.name) ? meta.name : String(id);
                        return itemRow(meta, name, null, '', id);
                    });
                    body.innerHTML = parts.join('');
                }

                function renderAdminPanel() {
                    if (!IS_ADMIN) return '';
                    return `
                        <div style="margin-top:16px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.08);">
                            <div style="color:#fbbf24; font-weight:900; margin-bottom:8px;">DEV MODE — ITENS</div>

                            <div style="display:grid; grid-template-columns: 1fr 100px; gap:10px; margin-bottom:10px;">
                                <input id="devItemId" list="itemCatalogDatalist" placeholder="itemId (ex: pokeball, key_porta1)" style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;" />
                                <input id="devItemQty" type="number" min="1" step="1" value="1" style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;" />
                            </div>
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button id="devGrantBtn" class="btn-pc-action" style="background: var(--success); color:#fff; width:auto; padding:12px 14px;">+ DAR</button>
                                <button id="devRevokeBtn" class="btn-pc-action" style="background: #ef4444; color:#fff; width:auto; padding:12px 14px;">- TIRAR</button>
                            </div>

                            <div style="margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.08);">
                                <div style="color:#fff; font-weight:900; margin-bottom:8px;">CATÁLOGO (DB) — CRIAR/EDITAR</div>
                                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
                                    <button id="catNewConsumableBtn" class="btn-pc-action" style="background:#1f2937; color:#fff; width:auto; padding:10px 12px;">NOVO CONSUMÍVEL</button>
                                    <button id="catNewKeyBtn" class="btn-pc-action" style="background:#1f2937; color:#fff; width:auto; padding:10px 12px;">NOVO KEY ITEM</button>
                                </div>
                                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:10px;">
                                    <input id="catItemId" list="itemCatalogDatalist" placeholder="id (ex: key_porta1)" style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;" />
                                    <input id="catItemName" placeholder="nome" style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;" />
                                </div>
                                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:10px;">
                                    <select id="catItemType" style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;">
                                        <option value="consumable">consumível</option>
                                        <option value="key">key item</option>
                                    </select>
                                    <input id="catItemIcon" type="file" accept="image/png" style="padding:10px; border-radius:12px; border:1px solid rgba(255,255,255,0.12); background:rgba(0,0,0,0.25); color:#fff;" />
                                </div>
                                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                    <button id="catSaveBtn" class="btn-pc-action" style="background: var(--accent-primary); color:#fff; width:auto; padding:12px 14px;">SALVAR/CRIAR</button>
                                    <button id="catDeleteBtn" class="btn-pc-action" style="background: #334155; color:#fff; width:auto; padding:12px 14px;">DELETAR</button>
                                </div>
                                <div style="margin-top:8px; color:#aaa; font-size:0.8rem;">Ícone precisa ser PNG 32x32.</div>
                            </div>
                        </div>
                    `;
                }

                function setActive(which) {
                    if (!tabItems || !tabKeys) return;
                    tabItems.classList.toggle('active', which === 'items');
                    tabKeys.classList.toggle('active', which === 'keys');
                    if (which === 'keys') renderKeysTab(); else renderItemsTab();
                }

                if (tabItems) tabItems.onclick = () => setActive('items');
                if (tabKeys) tabKeys.onclick = () => setActive('keys');
                setActive('items');

                const adminPanel = renderAdminPanel();
                if (adminPanel) {
                    body.insertAdjacentHTML('beforeend', adminPanel);
                    attachDevItemHandlers();
                }
            };

            const cached = getCachedMe();
            if (cached) await renderBagFromMe(cached);
            else document.getElementById('bagItemsContent').innerHTML = '';

            try {
                const r = await fetch(`/api/me?userId=${USER_ID}`); 
                const d = await r.json(); 
                if (d && !d.error) window.__ME_CACHE = d;
                await renderBagFromMe(d);
            } catch(e) {
                if (!cached) document.getElementById('bagItemsContent').innerHTML = 'Erro ao carregar itens.';
            }
        }

        function startRareCandySelection() { closeModal('modalBag'); isSelectingMode = true; openEntityTeam(); }

        async function useLevelUpCrystal(targetId) {
            try {
                const r = await fetch('/api/use-item', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, itemId: 'levelUpCrystal', pokemonId: targetId, qty: 1 })
                });
                const d = await r.json().catch(() => ({}));
                if (!d || d.error) return alert(d && d.error ? d.error : 'Erro ao usar item.');
                // Atualiza bag client-side com retorno do servidor (defensivo)
                if (typeof window !== 'undefined') {
                    if (d && d.bag && typeof d.bag === 'object') {
                        window.USER_BAG = d.bag;
                    } else {
                        if (!window.USER_BAG) window.USER_BAG = {};
                        if (typeof d.levelUpCrystal === 'number') window.USER_BAG.levelUpCrystal = d.levelUpCrystal;
                    }
                }
                const levelsGained = d && d.progression ? (parseInt(d.progression.levelsGained, 10) || 0) : 0;
                const evoCount = d && d.progression && Array.isArray(d.progression.evolutions) ? d.progression.evolutions.length : 0;
                const learnedCount = d && d.progression && Array.isArray(d.progression.learnedMoves) ? d.progression.learnedMoves.length : 0;
                const parts = [];
                if (levelsGained > 0) parts.push(`+${levelsGained} nivel` + (levelsGained > 1 ? 's' : ''));
                if (evoCount > 0) parts.push('evoluiu');
                if (learnedCount > 0) parts.push(`aprendeu ${learnedCount} golpe` + (learnedCount > 1 ? 's' : ''));
                showToast(parts.length ? parts.join(' | ') : 'Level Up Crystal usado!');
                isSelectingMode = false;
                openEntityTeam();
            } catch (e) {
                alert('Erro ao usar item.');
            }
        }

        function startLevelUpCrystalSelection() {
            closeModal('modalBag');
            isSelectingMode = true;
            // Reaproveita openEntityTeam, mas intercepta clique para usar o crystal
            openEntityTeam();
            // Monkey-patch applyRareCandy to use crystal instead
            window.applyRareCandy = (pid) => useLevelUpCrystal(pid);
        }
        function cancelSelection() { isSelectingMode = false; openEntityTeam(); }

        /* --- SKILLS & EDITOR --- */
        // Nova função segura para preparar o editor
        function prepareMoveEditor(instanceId) {
            // Busca a criatura nos dados carregados
            const entity = CURRENT_TEAM_DATA.find(p => p.instanceId === instanceId);
            if (!entity) return alert("Erro ao carregar criatura.");
            
            showMoveEditor(entity);
        }

        function showMoveEditor(p) {
            currentMonId = p.instanceId;
            document.getElementById('pokemonDetailContent').classList.remove('show');
            const pool = (p.learnedMoves && p.learnedMoves.length > 0) ? p.learnedMoves : p.moves;
            const equipped = p.moves;

            let html = `<div style="text-align:center; margin-bottom:15px;">
                <h3 style="margin:0; color:#fff;">${p.name}</h3>
                <small style="color:#aaa;">Selecione de 1 a 4 golpes</small>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">`;
            
            pool.forEach(mid => {
                const isEquipped = equipped.includes(mid);
                const d = GLOBAL_MOVES_LIB[mid] || {name: mid, element: 'normal'};
                html += `
                <div onclick="toggleMove(this)" class="skill-item ${isEquipped?'active':''}" data-id="${mid}">
                    <div style="font-weight:bold; color:#fff;">${d.name}</div>
                    <div style="font-size:0.7rem; color:#888; text-transform:uppercase;">${d.element}</div>
                </div>`;
            });
            
            html += `</div><button onclick="saveMoves()" class="btn-big-close" style="background:#10b981; margin-top:15px;">SALVAR GOLPES</button>`;
            document.getElementById('pokemonListContent').innerHTML = html;
        }

        function toggleMove(el) {
            if(el.classList.contains('active')) { 
                if(document.querySelectorAll('.skill-item.active').length <= 1) return alert('Mínimo 1 golpe!'); 
                el.classList.remove('active'); 
            } else { 
                if(document.querySelectorAll('.skill-item.active').length >= 4) return alert('Máximo 4 golpes!'); 
                el.classList.add('active'); 
            }
        }

        async function saveMoves() {
            const moves = Array.from(document.querySelectorAll('.skill-item.active')).map(c => c.getAttribute('data-id'));
            showToast("Salvando...");
            await fetch('/api/equip-move', { 
                method:'POST', 
                headers:{'Content-Type':'application/json'}, 
                body:JSON.stringify({ userId:USER_ID, pokemonId:currentMonId, moves }) 
            });
            showToast("Salvo!");
            openEntityTeam(); // Recarrega a lista
        }

        async function setLead(id) { 
            await fetch('/api/set-lead', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId:USER_ID, entityId:id }) }); 
            openEntityTeam(); 
        }
        async function abandonPokemon(id) {
            if (!id) return;
            const target = CURRENT_TEAM_DATA && CURRENT_TEAM_DATA.find(p => String(p.instanceId) === String(id));
            const name = target ? target.name : 'esta criatura';
            const confirmed = window.confirm('⚠️ Liberar ' + name + '? Esta ação é permanente e não pode ser desfeita.');
            if (!confirmed) return;

            try {
                const res = await fetch('/api/abandon-pokemon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID, pokemonId: id })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data || data.error) {
                    showToast('❌ Não foi possível liberar a criatura');
                    return;
                }
                showToast('✅ Criatura liberada');
                openEntityTeam();
            } catch (e) {
                console.error('Erro ao liberar criatura:', e);
                showToast('❌ Erro ao liberar criatura');
            }
        }
        async function applyRareCandy(pokeId) {
            if(!confirm('Usar Rare Candy?')) return;
            try {
                const res = await fetch('/api/use-item', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ userId: USER_ID, itemId: 'rareCandy', pokemonId: pokeId, qty: 1 }) });
                const data = await res.json();
                if (data && data.bag && typeof data.bag === 'object') window.USER_BAG = data.bag;
                if(data.success) { showToast(data.evolved ? '✨ Evoluiu! ✨' : '🆙 Subiu de Nível!'); isSelectingMode = false; openEntityTeam(); } 
                else { alert(data.error); }
            } catch(e) { alert("Erro."); isSelectingMode = false; openEntityTeam(); }
        }
    </script>
</body>
</html>
